+content::WebContents*
+DeveloperPrivateLoadCrxFunction::GetVerifiedUblockPromptContents() {
+  auto* contents = GetSenderWebContents();
+  if (!contents || browser_context()->IsOffTheRecord() ||
+      render_frame_host() != contents->GetPrimaryMainFrame() ||
+      contents->GetLastCommittedURL() != GURL("chrome://extensions/?sandium=manage")) {
+    return nullptr;
+  }
+  auto* data = static_cast<raws::ExtensionsManagerContentsData*>(
+      contents->GetUserData(&raws::kExtensionsManagerContentsKey));
+  auto* owner = data ? data->source.get() : nullptr;
+  auto* tab = owner ? tabs::TabInterface::MaybeGetFromContents(owner) : nullptr;
+  if (!owner || owner->GetBrowserContext() != browser_context() || !tab ||
+      !tab->IsActivated()) {
+    return nullptr;
+  }
+  return contents;
+}
+
+ExtensionFunction::ResponseAction
+DeveloperPrivateLoadCrxFunction::StartVerifiedUblock() {
+  if (!GetVerifiedUblockPromptContents()) {
+    return RespondNow(Error("Open the Sandium Extension Manager to install uBlock Origin."));
+  }
+  const auto* registered = ExtensionRegistry::Get(browser_context());
+  const base::Version installed = registered->GetStoredVersion(raws_pinned_ubo::kExtensionId);
+  if (installed.IsValid() &&
+      installed.CompareTo(base::Version(raws_pinned_ubo::kVersion)) >= 0) {
+    return RespondNow(WithArguments("installed"));
+  }
+  constexpr auto traffic_annotation = net::DefineNetworkTrafficAnnotation(
+      "raws_verified_ublock_install", R"(
+        semantics {
+          sender: "Sandium Extensions Manager"
+          description: "Download the verified uBlock Origin CRX from its official release."
+          trigger: "The user presses Install or Update on the uBlock Origin card."
+          data: "Only a fixed package URL. No cookies, referrer or page data."
+          destination: OTHER
+          destination_other: "GitHub releases and its download CDN."
+        }
+        policy {
+          cookies_allowed: NO
+          setting: "Nothing is downloaded unless the user presses Install or Update."
+          policy_exception_justification: "Uses the existing extension installation policy, and cannot install silently."
+        })");
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL(raws_pinned_ubo::kDownloadUrl);
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  verified_ublock_ = true;
+  ublock_loader_ = network::SimpleURLLoader::Create(std::move(request), traffic_annotation);
+  ublock_loader_->SetTimeoutDuration(base::Minutes(2));
+  AddRef();  // Balanced by Finish(), as for the file-picker route.
+  ublock_loader_->DownloadToString(
+      browser_context()->GetDefaultStoragePartition()->GetURLLoaderFactoryForBrowserProcess().get(),
+      base::BindOnce(&DeveloperPrivateLoadCrxFunction::OnUblockDownloaded, this),
+      7 * 1024 * 1024);
+  return did_respond() ? AlreadyResponded() : RespondLater();
+}
+
+void DeveloperPrivateLoadCrxFunction::OnUblockDownloaded(
+    std::optional<std::string> bytes) {
+  const GURL final_url = bytes ? ublock_loader_->GetFinalURL() : GURL();
+  ublock_loader_.reset();
+  if (!bytes || !final_url.SchemeIs("https") ||
+      (final_url.host() != "github.com" &&
+       final_url.host() != "release-assets.githubusercontent.com") ||
+      !GetVerifiedUblockPromptContents()) {
+    Finish(WithArguments("failed"));
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&DeveloperPrivateLoadCrxFunction::WriteVerifiedUblockFile,
+                     std::move(*bytes)),
+      base::BindOnce(&DeveloperPrivateLoadCrxFunction::OnVerifiedUblockFileReady,
+                     this));
+}
+
+base::FilePath DeveloperPrivateLoadCrxFunction::WriteVerifiedUblockFile(
+    std::string bytes) {
+  // Compare binary digest before writing anything. The CrxInstaller independently
+  // validates CRX3 proof, exact archive, expected extension ID, and version again.
+  if (bytes.size() != 6127282u) {
+    return {};
+  }
+  const std::string digest = crypto::SHA256HashString(bytes);
+  if (base::HexEncodeLower(base::as_byte_span(digest)) !=
+      raws_pinned_ubo::kCrxSha256) {
+    return {};
+  }
+  base::FilePath path;
+  if (!base::CreateTemporaryFile(&path)) {
+    return {};
+  }
+  if (!base::WriteFile(path, bytes)) {
+    base::DeleteFile(path);
+    return {};
+  }
+  return path;
+}
+
+void DeveloperPrivateLoadCrxFunction::OnVerifiedUblockFileReady(
+    base::FilePath path) {
+  auto* contents = GetVerifiedUblockPromptContents();
+  if (!contents || path.empty()) {
+    if (!path.empty()) {
+      base::ThreadPool::PostTask(
+          FROM_HERE, {base::MayBlock()},
+          base::BindOnce([](const base::FilePath& file) { base::DeleteFile(file); }, path));
+    }
+    Finish(WithArguments("failed"));
+    return;
+  }
+  auto prompt = std::make_unique<ExtensionInstallPrompt>(
+      contents, std::make_unique<extensions::InstallPromptData>(
+                    extensions::InstallPromptData::UNSET_PROMPT_TYPE));
+  installer_ = CrxInstaller::Create(browser_context(), std::move(prompt));
+  installer_->set_allow_silent_install(false);
+  installer_->set_expected_id(raws_pinned_ubo::kExtensionId);
+  installer_->set_expected_version(base::Version(raws_pinned_ubo::kVersion), true);
+  installer_->set_error_on_unsupported_requirements(true);
+  installer_->set_off_store_install_allow_reason(
+      CrxInstaller::OffStoreInstallAllowedFromSettingsPage);
+  installer_->set_install_immediately(true);
+  installer_->set_delete_source(true);
+  installer_->AddInstallerCallback(
+      base::BindOnce(&DeveloperPrivateLoadCrxFunction::OnInstalled, this));
+  installer_->InstallCrx(path);
+}
