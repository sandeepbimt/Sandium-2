+void ExtensionActionPopupContents::SetRawSPhonePresentation(
+    bool dark,
+    int max_width_dp,
+    int max_height_dp) {
+  const gfx::Size maximum(
+      std::clamp(max_width_dp, kMinSize.width(), kMaxSize.width()),
+      std::clamp(max_height_dp, kMinSize.height(), kMaxSize.height()));
+  if (raws_phone_dark_ == dark && raws_phone_max_size_ == maximum) {
+    return;
+  }
+  raws_phone_dark_ = dark;
+  raws_phone_max_size_ = maximum;
+  ApplyRawSPhoneColorScheme();
+  auto* frame = host_->host_contents()->GetPrimaryMainFrame();
+  if (frame->IsRenderFrameLive() && frame->GetView()) {
+    SetUpNewMainFrame(frame);
+  }
+}
+
+void ExtensionActionPopupContents::ApplyRawSPhoneColorScheme() {
+  if (!raws_phone_dark_.has_value()) {
+    return;
+  }
+  auto* contents = host_->host_contents();
+  auto preferences = contents->GetOrCreateWebPreferences();
+  const auto scheme = *raws_phone_dark_
+                          ? blink::mojom::PreferredColorScheme::kDark
+                          : blink::mojom::PreferredColorScheme::kLight;
+  if (preferences.preferred_color_scheme != scheme ||
+      preferences.preferred_root_scrollbar_color_scheme != scheme) {
+    preferences.preferred_color_scheme = scheme;
+    preferences.preferred_root_scrollbar_color_scheme = scheme;
+    contents->SetWebPreferences(preferences);
+  }
+}
+
