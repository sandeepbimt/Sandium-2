+    min-height: 42px;
+    min-width: 0;
+    padding: 0;
+    text-align: start;
+  }
+
+  .compact-entry > span:first-child {
+    overflow: hidden;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+  }
+
+  .compact-state {
+    align-items: center;
+    color: var(--cr-secondary-text-color);
+    display: flex;
+    gap: 4px;
+    white-space: nowrap;
+  }
+
+  #compact-controls {
+    --cr-dialog-width: calc(100vw - 16px);
+    --cr-dialog-border-radius: 24px 24px 0 0;
+  }
+
+  #compact-controls::part(dialog) {
+    inset-block: auto 0;
+    margin: 0 auto;
+    max-height: 83dvh;
+    position: fixed;
+  }
+
+  .compact-action-list {
+    display: grid;
+    gap: 8px;
+  }
+
+  .compact-action,
+  .compact-action-list > cr-button {
+    align-items: center;
+    background: var(--cr-card-background-color);
+    border-radius: 12px;
+    display: flex;
+    gap: 12px;
+    justify-content: space-between;
+    min-height: 48px;
+    padding: 4px 12px;
+    text-align: start;
+  }
+
+  .compact-action > cr-toggle {
+    flex: none;
+  }
+
+  .compact-remove {
+    color: var(--error-color);
+  }
+}
+
