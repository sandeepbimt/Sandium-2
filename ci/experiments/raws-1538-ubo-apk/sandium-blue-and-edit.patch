+    private View headerIconButton(Drawable drawable, String label, String tag, Runnable action) {
+        android.widget.FrameLayout button = new android.widget.FrameLayout(getContext());
+        ImageView glyph = new ImageView(getContext());
+        glyph.setScaleType(ImageView.ScaleType.FIT_CENTER);
+        glyph.setImageDrawable(drawable);
+        glyph.setImageTintList(android.content.res.ColorStateList.valueOf(mHeaderActionColor));
+        glyph.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
+        button.addView(glyph, new android.widget.FrameLayout.LayoutParams(
+                dp(24), dp(24), Gravity.CENTER));
+        button.setContentDescription(label);
+        button.setTooltipText(label);
+        button.setTag(tag);
+        button.setFocusable(true);
+        bindPressFeedback(button);
+        button.setOnClickListener(view -> action.run());
+        return button;
+    }
