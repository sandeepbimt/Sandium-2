+                canvas.translate(getBounds().left, getBounds().top);
+                canvas.scale(getBounds().width() / 24f, getBounds().height() / 24f);
+                mPaint.setColor(mHeaderActionColor);
+                mPaint.setStyle(android.graphics.Paint.Style.STROKE);
+                mPaint.setStrokeWidth(2.1f);
+                mPaint.setStrokeJoin(android.graphics.Paint.Join.ROUND);
+                mPaint.setStrokeCap(android.graphics.Paint.Cap.ROUND);
+                android.graphics.Path path = new android.graphics.Path();
+                path.moveTo(3.5f, 20.5f);
+                path.lineTo(4.4f, 15.8f);
+                path.lineTo(16.5f, 3.7f);
+                path.quadTo(17.3f, 2.9f, 18.1f, 3.7f);
+                path.lineTo(20.3f, 5.9f);
+                path.quadTo(21.1f, 6.7f, 20.3f, 7.5f);
+                path.lineTo(8.2f, 19.6f);
+                path.close();
+                canvas.drawPath(path, mPaint);
+                canvas.drawLine(14.5f, 5.7f, 18.3f, 9.5f, mPaint);
+                canvas.restore();
+            }
+
+            @Override public void setAlpha(int alpha) { mPaint.setAlpha(alpha); invalidateSelf(); }
