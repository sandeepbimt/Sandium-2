+// An address-bar-free manager must never let unrelated content masquerade as
+// Chrome settings. Do not share this rule with ordinary tabs.
+class RawSExtensionsManagerThrottle final : public content::NavigationThrottle {
+ public:
+  explicit RawSExtensionsManagerThrottle(
+      content::NavigationThrottleRegistry& registry)
+      : content::NavigationThrottle(registry) {}
+
+  static void MaybeAdd(content::NavigationThrottleRegistry& registry) {
+    auto& handle = registry.GetNavigationHandle();
+    if (handle.GetWebContents()->GetUserData(&raws::kExtensionsManagerContentsKey)) {
+      registry.AddThrottle(
+          std::make_unique<RawSExtensionsManagerThrottle>(registry));
+    }
+  }
+
+  ThrottleCheckResult WillStartRequest() override { return CheckDestination(); }
+  ThrottleCheckResult WillRedirectRequest() override {
+    return CheckDestination();
+  }
+  ThrottleCheckResult WillCommitWithoutUrlLoader() override {
+    return CheckDestination();
+  }
+
+  const char* GetNameForLogging() override {
+    return "RawSExtensionsManagerThrottle";
+  }
+
+ private:
+  ThrottleCheckResult CheckDestination() {
+    const auto& url = navigation_handle()->GetURL();
+    return url.is_valid() && url.GetWithEmptyPath() == GURL("chrome://extensions/")
+               ? PROCEED
+               : CANCEL_AND_IGNORE;
+  }
+};
