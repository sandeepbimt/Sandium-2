+import org.chromium.chrome.browser.content.WebContentsFactory;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.chrome.browser.tabmodel.TabCreator;
+import org.chromium.chrome.browser.tab.TabLaunchType;
+import org.chromium.components.embedder_support.delegate.WebContentsDelegateAndroid;
+import org.chromium.components.embedder_support.view.ContentView;
+import org.chromium.components.thinwebview.ThinWebView;
+import org.chromium.components.thinwebview.ThinWebViewAttachParams;
+import org.chromium.components.thinwebview.ThinWebViewConstraints;
+import org.chromium.components.thinwebview.ThinWebViewFactory;
+import org.chromium.content_public.browser.LoadUrlParams;
+import org.chromium.content_public.browser.WebContents;
+import org.chromium.ui.base.ActivityWindowAndroid;
+import org.chromium.ui.base.IntentRequestTracker;
+import org.chromium.ui.base.PageTransition;
+import org.chromium.ui.base.ViewAndroidDelegate;
+import org.chromium.ui.base.WindowAndroid;
+import org.chromium.ui.interpolators.Interpolators;
+import org.chromium.ui.modaldialog.ModalDialogManager;
+import org.chromium.url.GURL;
+
+/** A native full-screen host for the browser's extension settings, never a visible browser tab. */
+@NullMarked
+final class RawSExtensionsManagerDialog extends Dialog {
+    private static final String MANAGE_URL = "chrome://extensions/?sandium=manage";
+    private static final String STORE_URL = "https://chromewebstore.google.com/category/extensions";
+    private static final String TEST_UBO_URL =
+            "https://github.com/gorhill/uBlock/releases/download/1.75.0/uBlock0_1.75.0.chromium.crx";
+    private static final int ENTER_MS = 350;
+    private static final int EXIT_MS = 250;
+
+    private final ActivityWindowAndroid mIsolatedWindow;
+    private final ThinWebView mView;
+    private final WebContents mContents;
+    private final LinearLayout mRoot;
+    private final Tab mSourceTab;
+    private final TabCreator mTabCreator;
+    private @Nullable Runnable mAfterClose;
+    private boolean mClosing;
+    private boolean mDestroyed;
+
+    RawSExtensionsManagerDialog(
+            Activity activity,
+            WindowAndroid hostWindow,
+            IntentRequestTracker tracker,
+            Tab sourceTab,
+            TabCreator tabCreator) {
+        super(activity, android.R.style.Theme_Material_NoActionBar);
+        mSourceTab = sourceTab;
+        mTabCreator = tabCreator;
+        requestWindowFeature(Window.FEATURE_NO_TITLE);
+        boolean dark = (activity.getResources().getConfiguration().uiMode
+                        & Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES;
+        int surface = dark ? 0xFF000000 : 0xFFFCFCFC;
+        int ink = dark ? 0xFFFAFAFA : 0xFF1A1A1A;
+
+        mContents = WebContentsFactory.createRawSExtensionsManager(sourceTab.getProfile());
+        ContentView contentView = ContentView.createContentView(activity, mContents);
+        mIsolatedWindow =
+                new ActivityWindowAndroid(activity, /* listenToActivityState= */ true, tracker,
+                        /* insetObserver= */ null, /* occlusionTrackingAllowed= */ true) {
+                    @Override
+                    public @Nullable ModalDialogManager getModalDialogManager() {
+                        return hostWindow.getModalDialogManager();
+                    }
+                };
+        mContents.setDelegates(VersionInfo.getProductVersion(),
+                ViewAndroidDelegate.createBasicDelegate(contentView), contentView,
+                mIsolatedWindow, WebContents.createDefaultInternalsHolder());
+
+        // Own an isolated compositor; never attach over the tab's compositor.
+        var constraints = new ThinWebViewConstraints();
+        constraints.supportsOpacity = true;
+        mView = ThinWebViewFactory.create(activity, constraints, mIsolatedWindow);
+        mView.attachWebContents(mContents, contentView,
+                new ThinWebViewAttachParams.Builder()
+                        .setSupportTheming(true)
+                        .setEnableBrowserAutofill(false)
+                        .setWebContentsDelegate(new WebContentsDelegateAndroid() {
+                            @Override
+                            public boolean shouldCreateWebContents(GURL targetUrl) {
+                                return false;
+                            }
+                        })
+                        .build());
+
+        mRoot = new LinearLayout(activity);
+        mRoot.setOrientation(LinearLayout.VERTICAL);
+        mRoot.setBackgroundColor(surface);
+        LinearLayout header = new LinearLayout(activity);
+        header.setOrientation(LinearLayout.HORIZONTAL);
+        Button back = navButton("Back", ink);
+        back.setOnClickListener(v -> onBackPressed());
+        header.addView(back);
+        android.view.View spacer = new android.view.View(activity);
+        header.addView(spacer, new LinearLayout.LayoutParams(0, 1, 1));
+        Button testUbo = navButton("uBlock Origin (test)", ink);
+        testUbo.setOnClickListener(v -> openInBrowser(TEST_UBO_URL));
+        header.addView(testUbo);
+        Button store = navButton("Web Store", ink);
+        store.setOnClickListener(v -> openInBrowser(STORE_URL));
+        header.addView(store);
+        mRoot.addView(header);
+        mRoot.addView(mView.getView(), new LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, 0, 1));
+        setContentView(mRoot);
+        Window window = getWindow();
+        if (window != null) {
+            window.setBackgroundDrawable(new ColorDrawable(surface));
+            window.setSoftInputMode(WindowManager.LayoutParams.SOFT_INPUT_ADJUST_RESIZE);
+            window.setWindowAnimations(0);
+        }
+    }
+
+    private Button navButton(String title, int color) {
+        Button button = new Button(getContext(), null, android.R.attr.borderlessButtonStyle);
+        button.setText(title);
+        button.setTextColor(color);
+        button.setAllCaps(false);
+        return button;
+    }
+
+    private void openInBrowser(String exactUrl) {
+        if (mClosing) return;
+        mAfterClose = () -> {
+            if (!mSourceTab.isDestroyed()) {
+                mTabCreator.createNewTab(new LoadUrlParams(exactUrl, PageTransition.AUTO_TOPLEVEL),
+                        TabLaunchType.FROM_CHROME_UI, mSourceTab);
+            }
+        };
+        closeAnimated();
+    }
+
+    @Override
+    public void show() {
+        super.show();
+        Window window = getWindow();
+        if (window != null) {
+            window.setLayout(ViewGroup.LayoutParams.MATCH_PARENT,
+                    ViewGroup.LayoutParams.MATCH_PARENT);
+        }
+        if (ValueAnimator.areAnimatorsEnabled()) {
+            mRoot.setTranslationY(dp(64));
+            mRoot.animate().translationY(0).setDuration(ENTER_MS)
+                    .setInterpolator(Interpolators.EMPHASIZED).start();
+        }
+        mContents.getNavigationController().loadUrl(
+                new LoadUrlParams(MANAGE_URL, PageTransition.AUTO_TOPLEVEL));
+    }
+
+    @Override
+    public void onBackPressed() {
+        if (mClosing) return;
+        var frame = mContents.getFocusedFrame();
+        if (frame != null && frame.signalCloseWatcherIfActive()) return;
+        var navigation = mContents.getNavigationController();
+        if (navigation.canGoBack()) {
+            navigation.goBack();
+        } else {
+            closeAnimated();
+        }
+    }
+
+    private float dp(int value) {
+        return value * getContext().getResources().getDisplayMetrics().density;
+    }
+
