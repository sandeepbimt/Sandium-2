+static ScopedJavaLocalRef<jobject> JNI_WebContentsFactory_CreateRawSExtensionsManager(
+    JNIEnv* env,
+    Profile* profile) {
+  content::WebContents::CreateParams params(profile);
+  params.initially_hidden = true;
+  auto contents = content::WebContents::Create(params);
+  contents->SetUserData(&raws::kExtensionsManagerContentsKey,
+                        std::make_unique<base::SupportsUserData::Data>());
+  return contents.release()->GetJavaWebContents();
+}
+
 DEFINE_JNI(WebContentsFactory)
