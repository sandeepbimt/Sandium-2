+    private Entry headerExtension() {
+        Entry entry = mCatalog.get(EXTENSIONS);
+        // The header is only a presentation of the existing eligible native command.
+        return entry != null && !entry.nativeRow && enabled(entry.model)
+                && entry.model.containsKey(AppMenuItemProperties.CLICK_HANDLER)
+                && entry.model.get(AppMenuItemProperties.CLICK_HANDLER) != null ? entry : null;
+    }
+
+    private View extensionsHeaderButton(Entry entry) {
+        ImageView icon = new ImageView(getContext());
+        icon.setScaleType(ImageView.ScaleType.CENTER_INSIDE);
+        Drawable drawable = entry.model.containsKey(AppMenuItemProperties.ICON)
+                ? entry.model.get(AppMenuItemProperties.ICON) : null;
+        if (drawable == null) {
+            drawable = puzzleIcon();
+        } else if (drawable.getConstantState() != null) {
+            drawable = drawable.getConstantState().newDrawable(getResources()).mutate();
+        }
+        icon.setImageDrawable(drawable);
+        icon.setImageTintList(android.content.res.ColorStateList.valueOf(mHeaderActionColor));
+        icon.setContentDescription(title(entry));
+        icon.setTooltipText(title(entry));
+        icon.setTag("action:" + EXTENSIONS);
+        icon.setFocusable(true);
+        bindPressFeedback(icon);
+        icon.setOnClickListener(v -> activate(EXTENSIONS, entry.model));
+        return icon;
+    }
+
+    private Drawable puzzleIcon() {
+        return new Drawable() {
+            private final android.graphics.Paint mPaint =
+                    new android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG);
+            @Override public int getIntrinsicWidth() { return dp(24); }
+            @Override public int getIntrinsicHeight() { return dp(24); }
+            @Override public void draw(Canvas canvas) {
+                canvas.save();
+                canvas.translate(getBounds().left, getBounds().top);
+                canvas.scale(getBounds().width() / 24f, getBounds().height() / 24f);
+                android.graphics.Path path = new android.graphics.Path();
+                path.moveTo(4, 7);
+                path.lineTo(9.5f, 7);
+                path.cubicTo(9.5f, 2.5f, 15f, 2.5f, 15f, 7);
+                path.lineTo(20, 7);
+                path.lineTo(20, 12);
+                path.cubicTo(24, 12, 24, 17, 20, 17);
+                path.lineTo(20, 21);
+                path.lineTo(14.5f, 21);
+                path.cubicTo(14.5f, 17.3f, 9.5f, 17.3f, 9.5f, 21);
+                path.lineTo(4, 21);
+                path.close();
+                mPaint.setColor(mHeaderActionColor);
+                canvas.drawPath(path, mPaint);
+                canvas.restore();
+            }
+            @Override public void setAlpha(int alpha) { mPaint.setAlpha(alpha); invalidateSelf(); }
+            @Override public void setColorFilter(android.graphics.ColorFilter filter) {
+                mPaint.setColorFilter(filter); invalidateSelf();
+            }
+            @Override public int getOpacity() { return android.graphics.PixelFormat.TRANSLUCENT; }
+        };
+    }
