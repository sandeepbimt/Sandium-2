+  /** Compact only the source notice, not a safety finding or allowlist alert. */
+  protected useCompactOffStoreNotice_(): boolean {
+    const [item] = this.unsafeExtensions_;
+    return this.lensManager && this.unsafeExtensions_.length === 1 &&
+        !!item && item.id === RAWS_UBLOCK_ID && item.version === '1.77.2' &&
+        !item.blocklistText && !item.showSafeBrowsingAllowlistWarning &&
+        item.safetyCheckWarningReason ===
+            chrome.developerPrivate.SafetyCheckWarningReason.OFFSTORE;
+  }
+
