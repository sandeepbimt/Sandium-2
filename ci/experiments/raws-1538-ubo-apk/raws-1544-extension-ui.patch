diff --git a/chrome/browser/resources/extensions/item_list.css b/chrome/browser/resources/extensions/item_list.css
index 05cc88e..5c4e378 100644
--- a/chrome/browser/resources/extensions/item_list.css
+++ b/chrome/browser/resources/extensions/item_list.css
@@ -120,3 +120,27 @@ managed-footnote {
    * is clickable. */
   z-index: 1;
 }
+
+/* Match RawS phone surfaces without changing Chromium's card actions. */
+@media (max-width: 600px) {
+  #content-wrapper {
+    min-width: 0;
+    padding: 12px 14px 32px;
+    --cr-card-border-radius: 18px;
+  }
+
+  .items-container {
+    grid-template-columns: minmax(0, 1fr);
+    max-width: none;
+  }
+
+  extensions-item {
+    display: block;
+    min-width: 0;
+  }
+
+  .section-header-contents {
+    flex-wrap: wrap;
+    gap: 8px;
+  }
+}
