+    "vKKTxNb2VbPlTOi5MyzPowWV8hHJEOkwq2dQIDAQAB";
+
+// This predicate alone is *not* proof of signature. It may only recognize an
+// installed internal extension whose packed path checked the exact signed CRX.
+constexpr bool IsPinnedManifest(int manifest_version,
+                                bool is_internal_extension,
+                                std::string_view id,
+                                std::string_view version,
+                                std::string_view key) {
+  return manifest_version == 2 && is_internal_extension && id == kExtensionId &&
+         version == kVersion && key == kSigningPublicKey;
+}
+
+}  // namespace extensions::raws_pinned_ubo
