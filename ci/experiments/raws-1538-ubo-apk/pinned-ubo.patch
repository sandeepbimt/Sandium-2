+void CrxInstaller::SetRawSPinnedUboDownload() {
+#if BUILDFLAG(IS_ANDROID)
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  // Neither this entry point nor missing prompt UI can permit silent install.
+  if (!client_ || !was_triggered_by_user_download() || approved_) {
+    return;
+  }
+  expected_id_ = raws_pinned_ubo::kExtensionId;
+  set_expected_version(base::Version(raws_pinned_ubo::kVersion), true);
+  raws_pinned_ubo_download_ = true;
+#endif
+}
