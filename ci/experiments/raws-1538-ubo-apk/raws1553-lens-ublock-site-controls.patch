+    private void configureUblockSiteControls() {
+        var tab = mSiteTab;
+        var contents = mSiteWebContents;
+        var url = mCommittedSiteUrl;
+        if (tab == null || contents == null || url == null
+                || !(ContextUtils.activityFromContext(mContent.getContext())
+                        instanceof ChromeActivity activity)) {
+            return;
+        }
+        var toolbar = activity.getToolbarManager();
+        var extensions = toolbar == null ? null : toolbar.getExtensionsToolbarCoordinator();
+        if (extensions == null || !extensions.canOpenRawSUblockSiteControls(tab)) return;
+        TextView row = mContent.findViewById(R.id.raws_shields_ublock_site_controls);
+        row.setVisibility(View.VISIBLE);
+        mContent.findViewById(R.id.raws_shields_ublock_divider).setVisibility(View.VISIBLE);
+        row.setOnClickListener(view -> {
+            if (!isCurrent() || !stillOwnsSite() || !ElementAction.isResumed(activity)
+                    || !extensions.canOpenRawSUblockSiteControls(tab)) {
+                return;
+            }
+            String document = RawsProtectionCopy.elementDocumentToken(contents);
+            if (document.isEmpty()) return;
+            close(true);
+            var controller = mController;
+            long deadline = SystemClock.uptimeMillis() + 650;
+            ElementAction.sHandler.post(() ->
+                    openUblockAfterClose(activity, controller, this, tab, contents, url,
+                            document, deadline));
+        });
+    }
+
+    private static void openUblockAfterClose(
+            ChromeActivity activity, BottomSheetController controller,
+            BottomSheetContent closingSheet, Tab tab, WebContents contents,
+            GURL url, String document, long deadline) {
+        if (!ElementAction.isResumed(activity) || !activity.hasWindowFocus()
+                || activity.getActivityTab() != tab || tab.isDestroyed() || tab.isHidden()
+                || contents.isDestroyed() || tab.getWebContents() != contents
+                || !url.equals(contents.getLastCommittedUrl())
+                || !document.equals(RawsProtectionCopy.elementDocumentToken(contents))) {
+            return;
+        }
+        var shown = controller.getCurrentSheetContent();
+        if (shown != null && shown != closingSheet) return;
+        if (SystemClock.uptimeMillis() >= deadline) return;
+        if (shown != null || controller.getSheetState() != BottomSheetController.SheetState.HIDDEN) {
+            ElementAction.sHandler.postDelayed(() ->
+                    openUblockAfterClose(activity, controller, closingSheet, tab, contents,
+                            url, document, deadline), 16);
+            return;
+        }
+        var toolbar = activity.getToolbarManager();
+        var extensions = toolbar == null ? null : toolbar.getExtensionsToolbarCoordinator();
+        if (extensions != null) extensions.openRawSUblockSiteControls(tab);
+    }
