+// The address-bar-free options host exposes no WebUI privileges and admits
+// only the selected extension's origin, even on redirects or local commits.
+class RawSExtensionOptionsThrottle final : public content::NavigationThrottle {
+ public:
+  explicit RawSExtensionOptionsThrottle(
+      content::NavigationThrottleRegistry& registry)
+      : content::NavigationThrottle(registry) {}
+
+  static void MaybeAdd(content::NavigationThrottleRegistry& registry) {
+    if (registry.GetNavigationHandle().GetWebContents()->GetUserData(
+            &raws::kExtensionOptionsContentsKey)) {
+      registry.AddThrottle(
+          std::make_unique<RawSExtensionOptionsThrottle>(registry));
+    }
+  }
+
+  ThrottleCheckResult WillStartRequest() override { return Check(true); }
+  ThrottleCheckResult WillRedirectRequest() override { return Check(false); }
+  ThrottleCheckResult WillFailRequest() override { return CANCEL_AND_IGNORE; }
+  ThrottleCheckResult WillCommitWithoutUrlLoader() override {
+    return Check(false);
+  }
+  const char* GetNameForLogging() override {
+    return "RawSExtensionOptionsThrottle";
+  }
+
+ private:
+  ThrottleCheckResult Check(bool allow_external_link) {
+    auto& handle = *navigation_handle();
+    auto* contents = handle.GetWebContents();
+    const auto* data = static_cast<const raws::ExtensionOptionsContentsData*>(
+        contents->GetUserData(&raws::kExtensionOptionsContentsKey));
+    if (!data) {
+      return CANCEL_AND_IGNORE;
+    }
+    const GURL& url = handle.GetURL();
+    if (data->origin.IsSameOriginWith(url)) {
+      return PROCEED;
+    }
+    if (!handle.IsInMainFrame() &&
+        (url.IsAboutBlank() || url.IsAboutSrcdoc()) &&
+        handle.GetInitiatorOrigin() == data->origin) {
+      return PROCEED;
+    }
+    // Do not turn an automatic redirect, POST, or iframe load into a browser
+    // tab. Explicit links from this page open in the ordinary browsing UI.
+    if (allow_external_link && handle.IsInPrimaryMainFrame() &&
+        handle.IsRendererInitiated() && handle.HasUserGesture() &&
+        !handle.IsPost() && url.SchemeIsHTTPOrHTTPS() &&
+        handle.GetInitiatorOrigin() == data->origin) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE,
+          base::BindOnce(
+              [](base::WeakPtr<content::WebContents> current,
+                 raws::OpenExtensionOptionsLink open_link, GURL target) {
+                if (current) {
+                  open_link.Run(target);
+                }
+              },
+              contents->GetWeakPtr(), data->open_external_link, url));
+    }
+    return CANCEL_AND_IGNORE;
+  }
+};
 #endif  // BUILDFLAG(IS_ANDROID)
 
