+.raws-detail-fold > summary {
+  display: none;
+}
+
+[data-raws-compact] .page-content {
+  --cr-section-padding: 14px;
+  --cr-section-vertical-padding: 8px;
+  --cr-section-min-height: 44px;
+  box-sizing: border-box;
+  inline-size: min(100%, 560px);
+  min-inline-size: 0;
+  padding-inline: 14px;
+}
+
+[data-raws-compact] .message-container {
+  align-items: start;
+  border-radius: 14px;
+  box-sizing: border-box;
+  flex-wrap: wrap;
+  padding: 10px 12px;
+}
+
+[data-raws-compact] .message-text {
+  margin-inline-start: 8px;
+  min-inline-size: 0;
+  overflow-wrap: anywhere;
+}
+
+[data-raws-compact] .raws-detail-fold > summary {
+  display: list-item;
+  min-block-size: 44px;
+  padding: 12px 14px;
+}
+
+[data-raws-compact] .section-content {
+  overflow-wrap: anywhere;
+}
