+
+#if BUILDFLAG(IS_ANDROID)
+// static
+bool OpenTabHelper::IsOwnAndroidOptionsPage(const GURL& url,
+                                           const Extension& extension) {
+  return url.SchemeIs(kExtensionScheme) && url.host() == extension.id() &&
+         url.EqualsIgnoringRef(OptionsPageInfo::GetOptionsPage(&extension));
+}
+
+// static
+content::WebContents* OpenTabHelper::GetAndroidOptionsOpener(
+    BrowserWindowInterface& browser,
+    const ExtensionFunction& function) {
+  if (browser.GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+      function.browser_context() != browser.GetProfile() ||
+      browser.GetProfile()->IsOffTheRecord()) {
+    return nullptr;
+  }
+  auto* tab_list = TabListInterface::From(&browser);
+  auto* tab = tab_list ? tab_list->GetActiveTab() : nullptr;
+  auto* opener = tab ? tab->GetContents() : nullptr;
+  // Never form an opener chain between extension dashboards.
+  if (!opener || opener->GetBrowserContext() != browser.GetProfile() ||
+      opener->GetLastCommittedURL().SchemeIs(kExtensionScheme)) {
+    return nullptr;
+  }
+  return opener;
+}
+#endif
 
