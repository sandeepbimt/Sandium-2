+TEST_F(BlurTransitionAnimationManagerTest,
+       KeepsExistingBlurDuringAutomaticSameOriginFollowup) {
+  NavigationSimulator::NavigateAndCommitFromBrowser(
+      web_contents(), GURL("https://source.test"));
+  auto first = NavigationSimulator::CreateBrowserInitiated(
+      GURL("https://example.com/intermediate"), web_contents());
+  first->Start();
+  EXPECT_CALL(*mock_delegate_, ShouldShowBlurTransitionAnimation(_))
+      .WillOnce(Return(true));
+  first->ReadyToCommit();
+  SimulateRFHActivation(first.get());
+  first->Commit();
+
+  ASSERT_EQ(GetAnimationState(), AnimationState::kBlurShown);
+  const auto layer = view_android_->GetLayer()->children().front();
+
+  MockNavigationHandle next(GURL("https://example.com/final"),
+                            web_contents()->GetPrimaryMainFrame());
+  next.set_is_in_primary_main_frame(true);
+  next.set_is_renderer_initiated(true);
+  EXPECT_CALL(next, HasUserGesture()).WillOnce(Return(false));
+  EXPECT_CALL(*mock_delegate_, GetCurrentSurfaceId()).Times(0);
+  manager_->ReadyToCommitNavigation(&next);
+
+  ASSERT_EQ(GetAnimationState(), AnimationState::kBlurShown);
+  EXPECT_EQ(view_android_->GetLayer()->children().front(), layer);
+  manager_->DidFirstVisuallyNonEmptyPaint();
+  EXPECT_EQ(GetAnimationState(), AnimationState::kFadeOut);
+}
