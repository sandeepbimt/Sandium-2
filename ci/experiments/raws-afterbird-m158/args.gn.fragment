# Afterbird-inspired isolated extension experiment, not used by official158 CI.
is_desktop_android = true
chrome_public_manifest_package = "io.github.sandeepbimt.raws"
proprietary_codecs = true
ffmpeg_branding = "Chrome"
media_use_openh264 = false
enable_hls_demuxer = false
enable_hevc_parser_and_hw_decoder = false
