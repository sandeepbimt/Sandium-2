# Baseline full Chromium Android browser, no Brave imports or extensions hacks.
target_os = "android"
target_cpu = "arm64"
is_debug = false
is_component_build = false
symbol_level = 1
is_official_build = false
# Shared authorized BuildBuddy service; independently identified RawS outputs.
use_remoteexec = true
use_siso = true
use_reclient = false
# BuildBuddy forbids parent-relative declared outputs. GN's supported override
# keeps compiler crash reports inside the action working directory.
clang_diagnostic_dir = "clang-crashreports"
