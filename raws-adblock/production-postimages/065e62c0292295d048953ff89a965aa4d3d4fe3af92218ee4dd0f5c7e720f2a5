#ifndef COMPONENTS_SANDIUM_ADBLOCK_DOCUMENT_SUBRESOURCE_FACTORY_H_
#define COMPONENTS_SANDIUM_ADBLOCK_DOCUMENT_SUBRESOURCE_FACTORY_H_

#include <cstddef>
#include <cstdint>
#include <memory>
#include <string>
#include <optional>
#include <vector>
#include "base/functional/callback.h"
#include "url/gurl.h"

namespace network {
class URLLoaderFactoryBuilder;
}

namespace url {
class Origin;
}

namespace sandium::adblock_native {

// Browser-owned additional rules only. Replies run on the UI sequence.
bool CheckSubframe(GURL,const url::Origin&,base::OnceCallback<void(bool)>);
bool OfflineRulesReady();
// Values are consumed by RawS protection Java via JNI.
enum class OfflineRulesPhase : int {
  kUnknown = 0, kFailed = 1, kLoading = 2, kReady = 3,
};
OfflineRulesPhase GetOfflineRulesPhase();
// Bound the source-specific exception to the approved Online Malicious URL
// Blocklist. The browser asserts that this index is still that exact source.
inline constexpr size_t kUrlhausVivaldiOnlineIndex = 9;
inline constexpr size_t kLargeSubscriptionBytes = 16u << 20;
inline constexpr size_t SubscriptionRulesLimit(size_t catalog_index) {
  return catalog_index == kUrlhausVivaldiOnlineIndex
             ? kLargeSubscriptionBytes
             : 8u << 20;
}
// Synchronous parser check: call only on the subscription worker.
std::optional<int> InspectSubscription(const std::string&, size_t catalog_index);
// The returned revision represents exactly these bodies, not a download receipt.
// Zero means the built-in engine cannot accept a subscription build.
struct SubscriptionInput {
  size_t catalog_index;
  std::string body;
};
struct AdmittedSubscriptionStats {
  size_t catalog_index;
  size_t source_bytes;
  size_t network_rules;
  size_t cosmetic_rules;
};
using SubscriptionStats = std::vector<AdmittedSubscriptionStats>;
void InvalidatePendingAdditionalRules();
uint64_t InstallAdditionalRules(std::vector<SubscriptionInput>);
const SubscriptionStats& ActiveSubscriptionStats();
OfflineRulesPhase AdditionalRulesPhase(uint64_t revision);
void QueryPopup(GURL,GURL,base::OnceCallback<void(bool)>);
void QueryHideStyles(GURL,base::OnceCallback<void(std::string)>);

// Browser startup only; call on the browser UI sequence. Supply an approved,
// locally embedded and integrity-checked UTF-8 rules asset. This API does not
// read from URLs, files, preferences, renderer messages, or command-line flags.
// Empty, malformed or repeated inputs do not enable or replace the engine.
void InitializeDocumentSubresourceRules(std::string verified_rules);

// Bounded, profile-owned native matcher. It cannot change the shipped shared
// snapshot and is never selected from renderer or URL-supplied profile data.
using ScopedUserRuleQuery = base::RepeatingCallback<bool(
    GURL, int, url::Origin, std::string, base::OnceCallback<void(bool)>)>;
class ScopedUserRules {
 public:
  ScopedUserRules();
  ~ScopedUserRules();
  ScopedUserRules(const ScopedUserRules&) = delete;
  ScopedUserRules& operator=(const ScopedUserRules&) = delete;

  bool Replace(std::string rules, base::OnceCallback<void(bool)> completion);
  bool Query(GURL url, int resource, url::Origin initiator, std::string method,
             base::OnceCallback<void(bool)> result);
  void QueryStyles(GURL url, base::OnceCallback<void(std::string)> reply);

 private:
  class Impl;
  std::unique_ptr<Impl> impl_;
};

// Browser UI only. Caller must supply only the document-subresource factory
// and the browser-supplied non-opaque origin of that document factory.
void MaybeAppendDocumentSubresourceFactory(
    network::URLLoaderFactoryBuilder& builder,
    const url::Origin& document_origin,
    base::RepeatingCallback<bool()> site_gate = {},
    ScopedUserRuleQuery scoped_user_rules = {},
    base::RepeatingClosure on_document_request_blocked = {});

}  // namespace sandium::adblock_native
#endif  // COMPONENTS_SANDIUM_ADBLOCK_DOCUMENT_SUBRESOURCE_FACTORY_H_
