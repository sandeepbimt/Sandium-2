<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android">

    <org.chromium.components.browser_ui.settings.ChromeBasePreferenceCategory
        android:key="raws_parity_navigation"
        android:order="0"
        android:title="@string/raws_settings_navigation" />

    <org.chromium.components.browser_ui.settings.ChromeBasePreference
        android:fragment="org.chromium.chrome.browser.night_mode.settings.ThemeSettingsFragment"
        android:key="ui_theme"
        android:order="1"
        android:title="@string/theme_settings" />

    <org.chromium.components.browser_ui.settings.ChromeSwitchPreference
        android:key="raws_parity_dynamic_colors"
        android:order="2"
        android:title="@string/raws_settings_dynamic_colors"
        android:enabled="false"
        android:selectable="false"
        android:persistent="false"
        android:summary="@string/raws_settings_not_available" />

    <org.chromium.components.browser_ui.settings.ChromeBasePreference
        android:key="raws_ui_customize_menu"
        android:order="3"
        android:title="@string/raws_ui_customize_menu" />

    <org.chromium.components.browser_ui.settings.ChromeBasePreference
        android:fragment="org.chromium.chrome.browser.toolbar.adaptive.settings.AdaptiveToolbarSettingsFragment"
        android:key="toolbar_shortcut"
        android:order="4"
        android:title="@string/toolbar_shortcut" />

    <org.chromium.components.browser_ui.settings.ChromeBasePreference
        android:fragment="org.chromium.chrome.browser.toolbar.settings.AddressBarSettingsFragment"
        android:key="address_bar"
        android:order="5"
        android:title="@string/address_bar_settings" />

    <org.chromium.components.browser_ui.settings.ChromeSwitchPreference
        android:key="raws_parity_bottom_toolbar"
        android:order="6"
        android:title="@string/raws_settings_nav_toolbar"
        android:enabled="false"
        android:selectable="false"
        android:persistent="false"
        android:summary="@string/raws_settings_not_available" />

    <org.chromium.components.browser_ui.settings.ChromeSwitchPreference
        android:key="raws_parity_multiple_windows"
        android:order="7"
        android:title="@string/raws_settings_multiple_windows"
        android:enabled="false"
        android:selectable="false"
        android:persistent="false"
        android:summary="@string/raws_settings_not_available" />

    <org.chromium.components.browser_ui.settings.ChromeBasePreferenceCategory
        android:key="raws_parity_general"
        android:order="8"
        android:title="@string/raws_settings_general" />

    <org.chromium.components.browser_ui.settings.ChromeSwitchPreference
        android:key="raws_parity_night_mode"
        android:order="9"
        android:title="@string/raws_settings_night_mode"
        android:enabled="false"
        android:selectable="false"
        android:persistent="false"
        android:summary="@string/raws_settings_not_available" />

    <androidx.preference.ListPreference
        android:key="raws_parity_transition_blur"
        android:order="10"
        android:title="@string/raws_settings_transition_blur"
        android:enabled="false"
        android:selectable="false"
        android:persistent="false"
        android:summary="@string/raws_settings_not_available"
        android:entries="@array/raws_settings_blur_entries"
        android:entryValues="@array/raws_settings_blur_values" />

    <org.chromium.components.browser_ui.settings.ChromeSwitchPreference
        android:key="raws_parity_darken_transition"
        android:order="11"
        android:title="@string/raws_settings_darken_transition"
        android:enabled="false"
        android:selectable="false"
        android:persistent="false"
        android:summary="@string/raws_settings_not_available" />

    <org.chromium.components.browser_ui.settings.ChromeSwitchPreference
        android:key="raws_parity_sharing_hub"
        android:order="12"
        android:title="@string/raws_settings_sharing_hub"
        android:enabled="false"
        android:selectable="false"
        android:persistent="false"
        android:summary="@string/raws_settings_not_available" />

    <org.chromium.components.browser_ui.settings.ChromeBasePreference
        android:fragment="org.chromium.chrome.browser.appearance.settings.BookmarkBarSettingsFragment"
        android:key="bookmark_bar"
        android:order="14"
        android:title="@string/bookmark_bar_setting" />

    <org.chromium.components.browser_ui.settings.ChromeSwitchPreference
        android:key="bookmark_bar_switch"
        android:order="14"
        android:title="@string/bookmark_bar_setting"
        android:summary="@string/bookmark_bar_setting_subtitle" />

    <org.chromium.components.browser_ui.settings.ChromeSwitchPreference
        android:key="raws_parity_open_group"
        android:order="15"
        android:title="@string/raws_settings_open_group"
        android:enabled="false"
        android:selectable="false"
        android:persistent="false"
        android:summary="@string/raws_settings_not_available" />

    <org.chromium.components.browser_ui.settings.ChromeSwitchPreference
        android:key="raws_parity_undo_tabs"
        android:order="16"
        android:title="@string/raws_settings_undo_tabs"
        android:enabled="false"
        android:selectable="false"
        android:persistent="false"
        android:summary="@string/raws_settings_not_available" />

    <org.chromium.components.browser_ui.settings.ChromeBasePreferenceCategory
        android:key="raws_parity_native_options"
        android:order="17"
        android:title="@string/raws_settings_native_options" />

    <org.chromium.components.browser_ui.settings.ChromeSwitchPreference
        android:key="bottom_bar_switch"
        android:order="18"
        android:title="@string/bottom_bar_setting_title"
        android:summary="@string/bottom_bar_setting_summary" />

    <org.chromium.components.browser_ui.settings.ChromeBasePreference
        android:fragment="org.chromium.chrome.browser.homepage.settings.HomepageSettings"
        android:key="homepage"
        android:order="19"
        android:title="@string/options_homepage_title" />

    <org.chromium.components.browser_ui.settings.ChromeBasePreference
        android:fragment="org.chromium.chrome.browser.appearance.settings.TabPositionSettingsFragment"
        android:key="tab_position"
        android:order="20"
        android:title="@string/tab_position_settings_title" />

</PreferenceScreen>
