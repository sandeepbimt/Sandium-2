namespace {
constexpr size_t kRawSGenericRecords = 64;
constexpr size_t kRawSGenericToken = 64;
constexpr size_t kRawSGenericRecord = 1 + kRawSGenericToken;
constexpr size_t kRawSGenericHeader = 2;
constexpr size_t kRawSGenericWire =
    kRawSGenericHeader + kRawSGenericRecords * kRawSGenericRecord;

bool IsRawSGenericDiscoveryKey(std::string_view key) {
  const auto initial = [](char c) {
    return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || c == '_';
  };
  return key.size() >= 2 && key.size() <= kRawSGenericRecord &&
         (key[0] == '.' || key[0] == '#') && initial(key[1]) &&
         std::all_of(key.begin() + 2, key.end(), [&](char c) {
           return initial(c) || (c >= '0' && c <= '9') || c == '-';
         });
}

std::vector<uint8_t> PackRawSGenericDiscoveryRound(std::string_view text) {
  // Browser must independently validate this canonical fixed-size wire before
  // using keys. Neither the JS nor native renderer is a trusted authority.
  std::vector<uint8_t> wire(kRawSGenericWire);
  const auto reject = [] { return std::vector<uint8_t>(kRawSGenericWire); };
  constexpr size_t kMaxText = 1 + kRawSGenericRecords * (1 + kRawSGenericRecord);
  if (text.empty() || text.size() > kMaxText ||
      text[0] < '0' || text[0] > '2') {
    return wire;
  }
  wire[0] = static_cast<uint8_t>(text[0] - '0');
  text.remove_prefix(1);
  std::set<std::string_view> used;
  while (!text.empty()) {
    if (text[0] != '\n' || wire[1] >= kRawSGenericRecords) return reject();
    text.remove_prefix(1);
    const auto next = text.find('\n');
    const auto key = text.substr(0, next);
    if (!IsRawSGenericDiscoveryKey(key) || !used.insert(key).second)
      return reject();
    const size_t pos =
        kRawSGenericHeader + wire[1] * kRawSGenericRecord;
    for (size_t i = 0; i < key.size(); ++i)
      wire[pos + i] = static_cast<uint8_t>(key[i]);
    ++wire[1];
    text.remove_prefix(key.size());
  }
  return wire;
}

