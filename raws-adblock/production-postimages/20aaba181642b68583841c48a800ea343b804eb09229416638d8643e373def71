      ":is(article,main,header,footer,nav,h1,h2,h3,h4,h5,h6,p,pre,"
      "blockquote,ol,ul,table,figure,figcaption,img,picture,svg,canvas,iframe,"
      "frame,embed,object,[aria-modal],[aria-live])";
