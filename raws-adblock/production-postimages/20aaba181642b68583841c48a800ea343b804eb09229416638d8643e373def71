void ChromeRenderFrameObserver::SetRawSDisableAmp(
    const base::UnguessableToken& token,
    const GURL& expected_url,
    chrome::mojom::RawSDisableAmpMode mode) {
  using Mode = chrome::mojom::RawSDisableAmpMode;
  auto* frame = render_frame()->GetWebFrame();
  if (!frame || !render_frame()->IsMainFrame() || frame->Parent() ||
      frame->IsInFencedFrameTree() || frame->IsProvisional() ||
      frame->GetEmbeddingToken() != token) {
    return;
  }
  auto doc = frame->GetDocument();
  if (doc.IsNull() || !doc.IsActive() || !doc.IsHTMLDocument() ||
      !GURL(doc.Url()).SchemeIs(url::kHttpsScheme)) {
    return;
  }
  if (GURL(doc.Url()) != expected_url ||
      raws_disable_amp_document_ == token) {
    return;
  }
  std::string_view invocation;
  switch (mode) {
    case Mode::kGoogleSearch: invocation = "(1)"; break;
    case Mode::kGoogleNews: invocation = "(2)"; break;
    case Mode::kPublisher: invocation = "(3)"; break;
    case Mode::kTurbo: invocation = "(4)"; break;
    case Mode::kOff: return;
  }
  raws_disable_amp_document_ = token;
  frame->ExecuteScriptInIsolatedWorld(
      ISOLATED_WORLD_ID_RAWS_DISABLE_AMP,
      blink::WebScriptSource(
          blink::WebString::FromUtf8(base::StrCat({kRawSDisableAmp, invocation}))),
      blink::BackForwardCacheAware::kAllow);
}

void ChromeRenderFrameObserver::StopRawSMobilePlayerFiltering(
    const base::UnguessableToken& token) {
  auto* frame = render_frame()->GetWebFrame();
  if (frame && render_frame()->IsMainFrame() &&
      frame->GetEmbeddingToken() == token &&
      frame->GetDocumentLoader() &&
      frame->GetDocumentLoader()->RawSMobilePlayerFiltering()) {
    RunRawSMobilePlayerFiltering(*frame, /*enabled=*/false);
  }
}

void ChromeRenderFrameObserver::SetRawSProceduralCosmetic(
    const base::UnguessableToken& token, uint32_t audited_rule) {
  namespace cosmetic = ::raws::cosmetic;
  auto* frame = render_frame()->GetWebFrame();
  if (!frame || frame->Parent() || frame->IsInFencedFrameTree() ||
      frame->IsProvisional() || frame->GetEmbeddingToken() != token)
    return;
  auto doc = frame->GetDocument();
  if (doc.IsNull() || !doc.IsActive() || !doc.IsHTMLDocument()) return;

  // Use a separate user-origin key; no other ad rules or site DOM are altered.
  const auto key = blink::WebString::FromUtf8("raws-procedural-cosmetic-v1");
  doc.RemoveInsertedStyleSheet(key, blink::WebCssOrigin::kUser);
  std::string script = cosmetic::kStopRawSProceduralCosmetic;
  if (audited_rule == cosmetic::kAmazonSearchSponsoredCard &&
      cosmetic::RuleForDocument(GURL(doc.Url())) == audited_rule) {
    // Blink receives only compiled text plus this random upper-hex token.
    // Publisher DOM, search strings and filter lists cannot become JS or CSS.
    const auto nonce = base::UnguessableToken::Create().ToString();
    script = base::StrCat({cosmetic::kRawSProcedureCallBefore,
                           cosmetic::kRawSDynamicCosmeticScheduler, ",",
                           cosmetic::kRawSProceduralCosmeticMatcher, ",",
                           cosmetic::kAmazonRuleConfig, ",\"", nonce,
                           cosmetic::kRawSProcedureCallAfter});
    doc.InsertStyleSheet(
        blink::WebString::FromUtf8(
            base::StrCat({cosmetic::kAmazonRuleCssBeforeNonce, nonce,
                          cosmetic::kAmazonRuleCssAfterNonce})),
        &key, blink::WebCssOrigin::kUser);
  }
  const blink::WebScriptSource sources[] = {
      blink::WebScriptSource(blink::WebString::FromUtf8(script))};
  frame->RequestExecuteScript(
      ISOLATED_WORLD_ID_CHROME_INTERNAL, sources,
      blink::mojom::UserActivationOption::kDoNotActivate,
      blink::mojom::EvaluationTiming::kAsynchronous,
      blink::mojom::LoadEventBlockingOption::kDoNotBlock,
      blink::WebScriptExecutionCallback(), blink::BackForwardCacheAware::kAllow,
      blink::mojom::WantResultOption::kNoResult,
      blink::mojom::PromiseResultOption::kDoNotWait, blink::WebString());
}

