void RawSColorRenderer::InstallIsolatedSelectionBinding(
    v8::Local<v8::Context> context) {
  // Blink calls DidCreateScriptContext inside its entered ScriptState::Scope.
  auto* isolate = v8::Isolate::TryGetCurrent();
  if (!isolate) return;
  v8::Context::Scope scope(context);
  v8::Local<v8::Function> function;
  if (!gin::CreateFunctionTemplate(
          isolate,
          base::BindRepeating(
              [](base::WeakPtr<RawSColorRenderer> self, v8::Isolate* isolate,
                 v8::Local<v8::Value> value) {
                return self && self->OnDomSelection(isolate, value);
              },
              weak_.GetWeakPtr()))
           ->GetFunction(context).ToLocal(&function)) {
    return;
  }
  [[maybe_unused]] const bool installed =
      context->Global()
          ->DefineOwnProperty(
              context, gin::StringToSymbol(isolate, "__rawsPickColorNode"),
              function, static_cast<v8::PropertyAttribute>(v8::ReadOnly | v8::DontDelete))
          .FromMaybe(false);
}

void RawSColorRenderer::Select(const base::UnguessableToken& embedding,
                               const base::UnguessableToken& request,
                               const gfx::PointF& /*reserved_wire_point*/,
                               SelectCallback reply) {
  auto current = Current(embedding);
  if (!current || request.is_empty() || request_ || picking_) {
    std::move(reply).Run(nullptr, false, false);
    return;
  }
  selected_document_ = *current;
  request_ = request;
  picking_ = std::move(reply);
  frame_->GetWebFrame()->ExecuteScriptInIsolatedWorld(
      ISOLATED_WORLD_ID_CHROME_INTERNAL,
      blink::WebScriptSource(blink::WebString::FromUtf8(kRawSColorDomPicker)),
      blink::BackForwardCacheAware::kAllow);
}

bool RawSColorRenderer::OnDomSelection(v8::Isolate* isolate,
                                      v8::Local<v8::Value> value) {
  if (!picking_ || !selected_document_ || !request_) return false;
  if (value->IsNull()) {
    auto callback = std::move(picking_);
    EndSelection();
    std::move(callback).Run(nullptr, false, false);
    return true;
  }
  const auto* frame = frame_->GetWebFrame();
  if (!frame || frame->IsProvisional() || !selected_document_->IsActive() ||
      frame->GetDocument() != *selected_document_)
    return false;
  auto node = blink::WebElement::FromV8Value(isolate, value);
  if (node.IsNull() || !node.IsConnected() ||
      node.GetDocument() != *selected_document_ || !node.CanSandiumCorrectColor())
    return false;
  auto candidate = Describe(node, *selected_document_, IdIndex(*selected_document_));
  // Blink's CanSandiumCorrectColor already rejects shadow trees,
  // frames, editable/interactive elements, insecure documents and forced colors.
  // A missing durable path does not preclude editing the exact in-document node.
  if (!candidate && ElementTag(node).empty()) return false;
  selected_ = node;
  visit_only_ = !candidate;
  identity_ = std::move(candidate);
  const bool artwork = node.HasHTMLTagName(blink::WebString::FromUtf8("img"));
  std::move(picking_).Run(identity_ ? identity_.Clone() : nullptr, visit_only_, artwork);
  return true;
}

bool RawSColorRenderer::ValidVisitChoice(wire::RawSColorProperty property,
                                        uint32_t rgb) const {
  return rgb <= 0xffffff && selected_.CanSandiumCorrectColor() &&
      (property == wire::RawSColorProperty::kForeground ||
       property == wire::RawSColorProperty::kBackground ||
       (property == wire::RawSColorProperty::kImageArtwork &&
        selected_.HasHTMLTagName(blink::WebString::FromUtf8("img"))));
}

void RawSColorRenderer::CloseDomSelectionOverlay() {
  frame_->GetWebFrame()->ExecuteScriptInIsolatedWorld(
      ISOLATED_WORLD_ID_CHROME_INTERNAL,
      blink::WebScriptSource(blink::WebString::FromUtf8(
          "globalThis.__rawsCancelColorPicker?.()")),
      blink::BackForwardCacheAware::kAllow);
}

void RawSColorRenderer::Preview(const base::UnguessableToken& embedding,
             const base::UnguessableToken& request,
             wire::RawSColorProperty property, uint32_t rgb,
             PreviewCallback reply) {
  auto current = MatchingSelection(embedding, request);
  bool applied = current &&
      (visit_only_ ? ValidVisitChoice(property, rgb) : ValidColor(property, rgb, *identity_)) &&
      selected_.SandiumPreviewColor(static_cast<int>(property), rgb);
  if (current) confirmed_.reset();
  std::move(reply).Run(applied);
}

void RawSColorRenderer::ConfirmIdentity(const base::UnguessableToken& embedding,
                     const base::UnguessableToken& request,
                     wire::RawSColorProperty property, uint32_t rgb,
                     ConfirmIdentityCallback reply) {
  auto current = MatchingSelection(embedding, request);
  if (!current || !identity_ || !ValidColor(property, rgb, *identity_) ||
      !selected_.CanSandiumCorrectColor()) {
    std::move(reply).Run(nullptr);
    return;
  }
  const auto actual = Describe(selected_, *current, IdIndex(*current));
  if (!actual || !SameIdentity(*identity_, *actual)) {
    EndSelection();
    std::move(reply).Run(nullptr);
    return;
  }
  confirmed_ = property;
  confirmed_rgb_ = rgb;
  std::move(reply).Run(identity_.Clone());
}

void RawSColorRenderer::Commit(const base::UnguessableToken& embedding,
            const base::UnguessableToken& request,
            wire::RawSColorProperty property, uint32_t rgb,
            CommitCallback reply) {
  auto current = MatchingSelection(embedding, request);
  if (!current || !identity_ || confirmed_ != property ||
      confirmed_rgb_ != rgb || !ValidColor(property, rgb, *identity_)) {
    std::move(reply).Run(false);
    return;
  }
  const auto actual = Describe(selected_, *current, IdIndex(*current));
  bool applied = actual && SameIdentity(*actual, *identity_) &&
      selected_.SandiumCommitColor(static_cast<int>(property), rgb);
  if (applied) MarkBound(*identity_, property, selected_, rgb);
  EndSelection();
  std::move(reply).Run(applied);
}

void RawSColorRenderer::CommitForVisit(
    const base::UnguessableToken& embedding,
    const base::UnguessableToken& request, wire::RawSColorProperty property,
    uint32_t rgb, CommitForVisitCallback reply) {
  auto current = MatchingSelection(embedding, request);
  if (!current || !ValidVisitChoice(property, rgb)) {
    std::move(reply).Run(false);
    return;
  }
  if (!visit_only_) {
    // The only durable-to-visit fallback is after exact confirmation and
    // browser store refusal, never a changed node or stale serialized locator.
    const auto actual = Describe(selected_, *current, IdIndex(*current));
    if (!identity_ || confirmed_ != property || confirmed_rgb_ != rgb ||
        !actual || !SameIdentity(*actual, *identity_)) {
      EndSelection();
      std::move(reply).Run(false);
      return;
    }
  }
  // Avoid a delayed old restore overwriting the new visit-only correction.
  // There is no future matching for this correction; Blink holds only a weak
  // exact node reference in the existing document-owned color supplement.
  const bool applied = selected_.SandiumCommitColor(static_cast<int>(property), rgb);
  if (applied) StopObservingTargets();
  EndSelection();
  std::move(reply).Run(applied);
}

void RawSColorRenderer::Cancel(const base::UnguessableToken& embedding,
            const base::UnguessableToken& request) {
  if (Current(embedding) && request_ == request) {
    const bool was_picking = !!picking_;
    auto callback = std::move(picking_);
    EndSelection();
    if (was_picking) CloseDomSelectionOverlay();
    if (callback) std::move(callback).Run(nullptr, false, false);
  }
}

bool RawSColorRenderer::AlreadyBound(const wire::RawSColorIdentity& id,
                                     wire::RawSColorProperty property,
                                     const blink::WebElement& node,
                                     uint32_t rgb) const {
  return std::ranges::any_of(bound_, [&](const auto& value) {
    if (value.property != property || !SameIdentity(*value.identity, id)) {
      return false;
    }
    if (value.node_id == node.GetDomNodeId()) return value.rgb == rgb;
    // Rebind only if the previously confirmed element is genuinely gone.
    // Blink's node-id registry is weak, so detached trees are not held.
    const auto prior = blink::WebNode::FromDomNodeId(value.node_id);
    return !prior.IsNull() && prior.IsConnected() &&
           prior.GetDocument() == node.GetDocument();
  });
}

void RawSColorRenderer::MarkBound(const wire::RawSColorIdentity& id,
                                wire::RawSColorProperty property,
                                const blink::WebElement& node,
                                uint32_t rgb) {
  // Replace a detached or superseded binding rather than accumulating nodes.
  for (auto& binding : bound_) {
    if (binding.property == property && SameIdentity(*binding.identity, id)) {
      binding.node_id = node.GetDomNodeId();
      binding.rgb = rgb;
      return;
    }
  }
  if (bound_.size() < kMaxRules * 3) {
    bound_.push_back({id.Clone(), property, node.GetDomNodeId(), rgb});
  }
}

void RawSColorRenderer::ApplyRestoreRules(blink::WebDocument& current) {
  if (request_ || restore_rules_.empty()) return;
  const IdIndex index(current);
  for (const auto& rule : restore_rules_) {
    auto node = Match(*rule->identity, current, index);
    if (node.IsNull() || AlreadyBound(*rule->identity, rule->property,
                                      node, rule->rgb)) continue;
    if (node.SandiumCommitColor(static_cast<int>(rule->property), rule->rgb)) {
      MarkBound(*rule->identity, rule->property, node, rule->rgb);
    }
  }
}

void RawSColorRenderer::StopObservingTargets() {
  rebind_timer_.Stop();
  observation_deadline_.Stop();
  if (observed_document_) observed_document_->SandiumStopObservingElementColorTargets();
  observed_document_.reset();
  restore_embedding_.reset();
  restore_rules_.clear();
  rebinds_remaining_ = 0;
}

void RawSColorRenderer::ScheduleTargetRebind() {
  if (!observed_document_ || !rebinds_remaining_ || rebind_timer_.IsRunning()) {
    return;
  }
  rebind_timer_.Start(FROM_HERE, base::Milliseconds(400),
      base::BindOnce(&RawSColorRenderer::RebindTargets, GetWeakPtr()));
}

void RawSColorRenderer::RebindTargets() {
  if (!restore_embedding_ || !observed_document_ || !rebinds_remaining_) return;
  // Current() may tear down the observation if the token no longer owns it.
  auto embedding = *restore_embedding_;
  auto current = Current(embedding);
  if (!current || !observed_document_ || *current != *observed_document_) {
    StopObservingTargets();
    return;
  }
  ApplyRestoreRules(*current);
  if (--rebinds_remaining_ == 0) StopObservingTargets();
}

void RawSColorRenderer::Restore(const base::UnguessableToken& embedding,
                               uint64_t generation,
                               std::vector<wire::RawSColorRulePtr> rules) {
  auto current = Current(embedding);
  if (!current || !generation || generation < generation_ ||
      rules.empty() || rules.size() > kMaxRules ||
      !std::ranges::all_of(rules, [](const auto& rule) {
        return rule && rule->identity && ValidIdentity(*rule->identity) &&
               ValidColor(rule->property, rule->rgb, *rule->identity);
      })) {
    return;
  }

  if (generation != generation_) StopObservingTargets();
  generation_ = generation;
  restore_rules_ = std::move(rules);
  ApplyRestoreRules(*current);
  if (!observed_document_ &&
      current->SandiumObserveElementColorTargets(base::BindRepeating(
          &RawSColorRenderer::ScheduleTargetRebind, GetWeakPtr()))) {
    observed_document_ = *current;
    restore_embedding_ = embedding;
    rebinds_remaining_ = 24;
    observation_deadline_.Start(FROM_HERE, base::Seconds(60),
        base::BindOnce(&RawSColorRenderer::StopObservingTargets, GetWeakPtr()));
  }
}

void RawSColorRenderer::PauseRestore(const base::UnguessableToken& embedding,
                                    uint64_t generation) {
  if (!Current(embedding) || !generation || generation < generation_) return;
  generation_ = generation;
  StopObservingTargets();
}

void RawSColorRenderer::Clear(const base::UnguessableToken& embedding, uint64_t generation,
           ClearCallback reply) {
  auto current = Current(embedding);
  if (!current || !generation || generation < generation_) {
    std::move(reply).Run(false);
    return;
  }
  generation_ = generation;
  StopObservingTargets();
  EndSelection();
  current->SandiumClearElementColors();
  bound_.clear();
  std::move(reply).Run(true);
}

