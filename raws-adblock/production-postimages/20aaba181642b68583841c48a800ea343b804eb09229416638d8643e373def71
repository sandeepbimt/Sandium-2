    out.append(":is(").append(group).append(")").append(kEligible);
    out.append(":not(").append(kInteractive).append(",");
    out.append(kInteractive).append(" *,").append(kAccess).append(",");
    out.append(kAccess).append(" *,").append(kContent).append(")");
    // Do not remove a wrapper that contains a legitimate control, access
    // prompt, article/media content, or unknown embedded document.
    out.append(":not(:has(").append(kInteractive).append(",");
    out.append(kAccess).append(",").append(kContent).append("))");
    out.append(kDeclaration);
    css.remove_prefix(end + kDeclaration.size());
  }
  return out;
}

WebLocalFrame* RawSGenericDiscoveryFrame(
    RenderFrame* render_frame, const base::UnguessableToken& token) {
  auto* frame = render_frame->GetWebFrame();
  if (!frame || !render_frame->IsMainFrame() || frame->Parent() ||
      frame->IsInFencedFrameTree() || frame->IsProvisional() ||
      frame->GetEmbeddingToken() != token) {
    return nullptr;
  }
  const auto doc = frame->GetDocument();
  if (doc.IsNull() || !doc.IsActive() || !doc.IsHTMLDocument() ||
      !GURL(doc.Url()).SchemeIsHTTPOrHTTPS()) {
    return nullptr;
  }
  return frame;
}
