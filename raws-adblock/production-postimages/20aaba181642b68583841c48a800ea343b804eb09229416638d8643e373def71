      "[class*=\"consent\" i],[id*=\"consent\" i],"
      "[class*=\"subscription\" i],[id*=\"subscription\" i],"
      "[class*=\"subscribe\" i],[id*=\"subscribe\" i],"
      "[class*=\"sign-in\" i],[id*=\"sign-in\" i],"
      "[class*=\"login\" i],[id*=\"login\" i])";
