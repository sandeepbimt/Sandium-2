void ChromeRenderFrameObserver::CollectRawSGenericDiscoveryRound(
    const base::UnguessableToken& token,
    CollectRawSGenericDiscoveryRoundCallback callback) {
  auto* frame = RawSGenericDiscoveryFrame(render_frame(), token);
  if (!frame) {
    std::move(callback).Run(std::vector<uint8_t>(kRawSGenericWire));
    return;
  }
  const blink::WebScriptSource sources[] = {blink::WebScriptSource(
      blink::WebString::FromUtf8(kRawSGenericDiscoveryRound))};
  frame->RequestExecuteScript(
      ISOLATED_WORLD_ID_CHROME_INTERNAL, sources,
      blink::mojom::UserActivationOption::kDoNotActivate,
      blink::mojom::EvaluationTiming::kAsynchronous,
      blink::mojom::LoadEventBlockingOption::kDoNotBlock,
      base::BindOnce(
          [](CollectRawSGenericDiscoveryRoundCallback done,
             std::optional<base::Value> result, base::TimeTicks) {
            const std::string* text = result ? result->GetIfString() : nullptr;
            std::move(done).Run(PackRawSGenericDiscoveryRound(
                text ? std::string_view(*text) : std::string_view()));
          },
          std::move(callback)),
      blink::BackForwardCacheAware::kAllow,
      blink::mojom::WantResultOption::kWantResult,
      blink::mojom::PromiseResultOption::kDoNotWait, blink::WebString());
}

void ChromeRenderFrameObserver::StopRawSGenericDiscovery(
    const base::UnguessableToken& token) {
  auto* frame = RawSGenericDiscoveryFrame(render_frame(), token);
  if (!frame) return;
  const blink::WebScriptSource sources[] = {blink::WebScriptSource(
      blink::WebString::FromUtf8(
          "globalThis.__rawsGenericDiscoveryV1?.stop();"
          "delete globalThis.__rawsGenericDiscoveryV1;"))};
  frame->RequestExecuteScript(
      ISOLATED_WORLD_ID_CHROME_INTERNAL, sources,
      blink::mojom::UserActivationOption::kDoNotActivate,
      blink::mojom::EvaluationTiming::kAsynchronous,
      blink::mojom::LoadEventBlockingOption::kDoNotBlock,
      blink::WebScriptExecutionCallback(), blink::BackForwardCacheAware::kAllow,
      blink::mojom::WantResultOption::kNoResult,
      blink::mojom::PromiseResultOption::kDoNotWait, blink::WebString());
}


void ChromeRenderFrameObserver::ApplyRawSObservedGenericStyles(
    const base::UnguessableToken& token, const GURL& expected_url,
    const std::string& css) {
  if (css.size() > 256 * 1024) return;
  auto* frame = RawSGenericDiscoveryFrame(render_frame(), token);
  if (!frame) return;
  auto doc = frame->GetDocument();
  // PushState preserves the embedding token. Nonempty payload must additionally
  // identify the exact committed URL, including path/query/fragment. Empty
  // payloads may remove stale keyed CSS from this document after a route change.
  if (!css.empty() && GURL(doc.Url()) != expected_url) return;
  const auto guarded = RawSGuardObservedGenericStyle(css);
  if (!guarded) return;
  const auto key =
      blink::WebString::FromUtf8("sandium-observed-generic-rules-v1");
  doc.RemoveInsertedStyleSheet(key, blink::WebCssOrigin::kUser);
  if (!guarded->empty())
    doc.InsertStyleSheet(blink::WebString::FromUtf8(*guarded), &key,
                         blink::WebCssOrigin::kUser);
}

void ChromeRenderFrameObserver::ApplyRawSHideStyles(
    const base::UnguessableToken& token, const std::string& css) {
  auto* frame = render_frame()->GetWebFrame();
  if (!frame || frame->IsProvisional() || frame->GetEmbeddingToken() != token ||
      css.size() > 512 * 1024) return;
