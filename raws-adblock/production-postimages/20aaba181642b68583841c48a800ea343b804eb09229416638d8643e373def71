void ChromeRenderFrameObserver::BeginRawSElementPicker(
    const base::UnguessableToken& token,
    BeginRawSElementPickerCallback callback) {
  auto* frame = render_frame()->GetWebFrame();
  if (!frame || frame->Parent() || frame->IsInFencedFrameTree() ||
      frame->IsProvisional() || frame->GetEmbeddingToken() != token) {
    std::move(callback).Run(false);
    return;
  }
  auto doc = frame->GetDocument();
  if (doc.IsNull() || !doc.IsActive() || !doc.IsHTMLDocument()) {
    std::move(callback).Run(false);
    return;
  }
  const blink::WebScriptSource sources[] = {
      blink::WebScriptSource(blink::WebString::FromUtf8(raws::cosmetic::kRawSElementPicker))};
  frame->RequestExecuteScript(
      ISOLATED_WORLD_ID_CHROME_INTERNAL, sources,
      blink::mojom::UserActivationOption::kDoNotActivate,
      blink::mojom::EvaluationTiming::kAsynchronous,
      blink::mojom::LoadEventBlockingOption::kDoNotBlock,
      base::BindOnce(
          [](BeginRawSElementPickerCallback done,
             std::optional<base::Value> value, base::TimeTicks) {
            std::move(done).Run(value && value->GetIfBool().value_or(false));
          },
          std::move(callback)),
      blink::BackForwardCacheAware::kAllow,
      blink::mojom::WantResultOption::kWantResult,
      blink::mojom::PromiseResultOption::kDoNotWait, blink::WebString());
}

void ChromeRenderFrameObserver::WatchRawSElementPicker(
    const base::UnguessableToken& token,
    uint32_t after_revision,
    WatchRawSElementPickerCallback callback) {
  auto* frame = render_frame()->GetWebFrame();
  if (!frame || frame->Parent() || frame->IsInFencedFrameTree() ||
      frame->IsProvisional() || frame->GetEmbeddingToken() != token ||
      after_revision > 65535) {
    std::move(callback).Run(0, "");
    return;
  }
  auto doc = frame->GetDocument();
  if (doc.IsNull() || !doc.IsActive() || !doc.IsHTMLDocument()) {
    std::move(callback).Run(0, "");
    return;
  }
  const std::string script = base::StrCat({
      "globalThis.__rawsWatchElementPicker?.(",
      base::NumberToString(after_revision), ") ?? 0"});
  const blink::WebScriptSource sources[] = {
      blink::WebScriptSource(blink::WebString::FromUtf8(script))};
  frame->RequestExecuteScript(
      ISOLATED_WORLD_ID_CHROME_INTERNAL, sources,
      blink::mojom::UserActivationOption::kDoNotActivate,
      blink::mojom::EvaluationTiming::kAsynchronous,
      blink::mojom::LoadEventBlockingOption::kDoNotBlock,
      base::BindOnce(
          [](WatchRawSElementPickerCallback done, uint32_t after_revision,
             std::optional<base::Value> value, base::TimeTicks) {
            const auto* status = value ? value->GetIfList() : nullptr;
            if (!status || status->size() != 2) {
              std::move(done).Run(0, "");
              return;
            }
            const int revision = (*status)[0].GetIfInt().value_or(0);
            const std::string* selector = (*status)[1].GetIfString();
            if (revision < 1 || revision > 65535 || !selector ||
                selector->size() > 96 ||
                static_cast<uint32_t>(revision) <= after_revision) {
              std::move(done).Run(0, "");
              return;
            }
            std::move(done).Run(revision, *selector);
          },
          std::move(callback), after_revision),
      blink::BackForwardCacheAware::kAllow,
      blink::mojom::WantResultOption::kWantResult,
      blink::mojom::PromiseResultOption::kAwait, blink::WebString());
}

