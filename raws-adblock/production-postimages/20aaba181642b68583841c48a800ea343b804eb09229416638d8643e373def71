      "select,label,video,audio,[role],[tabindex],[contenteditable],[inert],"
      "[aria-label],[aria-labelledby],[aria-describedby],[aria-expanded],"
      "[aria-controls],[onclick],[onkeydown],[onkeyup],[onpointerdown],"
