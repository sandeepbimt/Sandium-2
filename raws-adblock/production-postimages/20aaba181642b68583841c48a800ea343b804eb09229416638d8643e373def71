IdIndex::IdIndex(const blink::WebDocument& document) : document_(document) {}

blink::WebElement IdIndex::Unique(const std::string& id) const {
  if (!Text(id, 128, false)) return blink::WebElement();
  const auto it = nodes_.find(id);
  if (it != nodes_.end()) return it->second;
  constexpr size_t kMaxIdsPerRequest = kMaxDepth * kMaxRules * 2;
  if (nodes_.size() >= kMaxIdsPerRequest) return blink::WebElement();
  auto element = document_.GetUniqueElementByIdForSandiumColor(
      blink::WebString::FromUtf8(id));
  nodes_.try_emplace(id, element);
  return element;
}

IdIndex::IdIndex(const IdIndex&) = default;
IdIndex::IdIndex(IdIndex&&) noexcept = default;
IdIndex& IdIndex::operator=(const IdIndex&) = default;
IdIndex& IdIndex::operator=(IdIndex&&) noexcept = default;
IdIndex::~IdIndex() = default;

namespace {
constexpr char kRawSColorDomPicker[] = R"COLORJS(// Adapted from Sandium #1442's trusted isolated document color picker.
(() => {
  const cancelKey = '__rawsCancelColorPicker';
  const select = globalThis.__rawsPickColorNode;
  if (typeof globalThis[cancelKey] === 'function') globalThis[cancelKey]();
  if (typeof select !== 'function' || !document.documentElement ||
      document.contentType !== 'text/html') return;
  const stop = event => {
    event.preventDefault();
    event.stopImmediatePropagation();
  };
  const cover = document.createElement('div');
  cover.style.cssText = 'position:fixed!important;inset:0!important;z-index:2147483647!important;display:block!important;pointer-events:auto!important;';
  const root = cover.attachShadow({mode:'closed'});
  const panel = document.createElement('div');
  panel.style.cssText = 'position:fixed;inset:0;pointer-events:auto;background:rgba(0,0,0,.08);cursor:crosshair;touch-action:none;';
  const hint = document.createElement('span');
  hint.setAttribute('role', 'status');
  hint.style.cssText = 'position:fixed;bottom:18px;left:16px;right:82px;max-width:max-content;padding:8px 12px;border-radius:10px;pointer-events:none;color:white;background:#202124;font:14px system-ui;';
  hint.textContent = 'Tap the element to correct';
  const quit = document.createElement('button');
  quit.type = 'button';
  quit.textContent = 'Cancel';
  quit.style.cssText = 'position:fixed;right:16px;bottom:12px;min-height:44px;padding:0 12px;border-radius:7px;font:14px system-ui;';
  root.append(panel, hint, quit);
  let timer, closed = false;
  const close = () => {
    if (closed) return;
    closed = true;
    clearTimeout(timer);
    cover.remove();
    window.removeEventListener('pagehide', close);
    window.removeEventListener('keydown', escape, true);
    if (globalThis[cancelKey] === close) delete globalThis[cancelKey];
  };
  const escape = event => {
    if (!event.isTrusted || event.key !== 'Escape') return;
    stop(event);
    select(null);
    close();
  };
  quit.addEventListener('click', event => {
    stop(event);
    if (!event.isTrusted) return;
    select(null);
    close();
  });
  // The renderer overlay occupies the viewport and consumes its own
  // gestures; selection never forwards input to the selected node.
  for (const type of ['pointerdown', 'pointerup', 'pointercancel',
                      'mousedown', 'mouseup', 'contextmenu']) {
    panel.addEventListener(type, stop, true);
  }
  panel.addEventListener('click', event => {
    stop(event);
    if (!event.isTrusted) return;
    cover.style.setProperty('display', 'none', 'important');
    const hit = document.elementFromPoint(event.clientX, event.clientY);
    cover.style.setProperty('display', 'block', 'important');
    if (!hit || !select(hit)) {
      hint.textContent = 'This element cannot be remembered. Tap another.';
      return;
    }
    close();
  }, true);
  // Keep control input usable but out of the page's bubble listeners.
  for (const type of ['pointerdown', 'pointerup', 'click', 'input']) {
    root.addEventListener(type, event => event.stopPropagation());
  }
  window.addEventListener('pagehide', close, {once:true});
  window.addEventListener('keydown', escape, true);
  globalThis[cancelKey] = close;
  timer = setTimeout(close, 60000);
  document.documentElement.appendChild(cover);
})()
)COLORJS";
