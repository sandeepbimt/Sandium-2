    /**
     * Constructs a new FeedSurfaceCoordinator.
     *
     * @param activity The containing {@link Activity}.
     * @param snackbarManager The {@link SnackbarManager} displaying Snackbar UI.
     * @param windowAndroid The window of the page.
     * @param snapScrollHelper The {@link SnapScrollHelper} for the New Tab Page.
     * @param ntpHeader The extra header on top of the feeds for the New Tab Page.
     * @param toolbarHeight The height of the toolbar which overlaps Feed content at the top of the
     *     view.
     * @param showDarkBackground Whether is shown on dark background.
     * @param delegate The constructing {@link FeedSurfaceDelegate}.
     * @param profile The current user profile.
     * @param bottomSheetController The bottom sheet controller.
     * @param shareDelegateSupplier The supplier for the share delegate used to share articles.
     * @param privacyPreferencesManager Manages the privacy preferences.
     * @param toolbarSupplier Supplies the {@link Toolbar}.
     * @param embeddingSurfaceCreatedTimeNs Timestamp of creation of the UI surface.
     * @param swipeRefreshLayout The layout to support pull-to-refresh.
     * @param overScrollDisabled Whether the overscroll effect is disabled.
     * @param createActionDelegate Factory for creating the implementation of Feed actions.
     * @param tabStripHeightSupplier Supplier for the tab strip height.
     * @param edgeToEdgeControllerSupplier Supplier for the {@link EdgeToEdgeController} instance.
     * @param moduleRegistry The instance of {@link ModuleRegistry}.
     */
    public FeedSurfaceCoordinator(
            Activity activity,
            SnackbarManager snackbarManager,
            WindowAndroid windowAndroid,
            @Nullable SnapScrollHelper snapScrollHelper,
            @Nullable View ntpHeader,
            @Px int toolbarHeight,
            boolean showDarkBackground,
            FeedSurfaceDelegate delegate,
            Profile profile,
            BottomSheetController bottomSheetController,
            Supplier<@Nullable ShareDelegate> shareDelegateSupplier,
            @Nullable ScrollableContainerDelegate externalScrollableContainerDelegate,
            PrivacyPreferencesManagerImpl privacyPreferencesManager,
            Supplier<Toolbar> toolbarSupplier,
            long embeddingSurfaceCreatedTimeNs,
            FeedSwipeRefreshLayout swipeRefreshLayout,
            boolean overScrollDisabled,
            ActionDelegateFactory createActionDelegate,
            NonNullObservableSupplier<Integer> tabStripHeightSupplier,
            MonotonicObservableSupplier<EdgeToEdgeController> edgeToEdgeControllerSupplier,
            @Nullable ModuleRegistry moduleRegistry) {
        mActivity = activity;
        mSnackbarManager = snackbarManager;
        mNtpHeader = ntpHeader;
        mShowDarkBackground = showDarkBackground;
        mDelegate = delegate;
        mBottomSheetController = bottomSheetController;
        mProfile = profile;
        mWindowAndroid = windowAndroid;
        mShareSupplier = shareDelegateSupplier;
        mScrollableContainerDelegate = externalScrollableContainerDelegate;
        mPrivacyPreferencesManager = privacyPreferencesManager;
        mToolbarSupplier = toolbarSupplier;
        mSwipeRefreshLayout = swipeRefreshLayout;
        mOverScrollDisabled = overScrollDisabled;
        mActionDelegate = createActionDelegate.createActionDelegate();
        mEmbeddingSurfaceCreatedTimeNs = embeddingSurfaceCreatedTimeNs;
        mHeaderIndex = 0;
        mTabStripHeightSupplier = tabStripHeightSupplier;
        mUseStaggeredLayout = DeviceFormFactor.isNonMultiDisplayContextOnTablet(mActivity);
        mIsNewTabPageCustomizationV2Enabled =
                NtpCustomizationUtils.isNtpThemeCustomizationEnabled();
        mDefaultBackgroundColor = ChromeSemanticColorUtils.getHomeSurfaceBackgroundColor(mActivity);

        mRawSHomeNativeBackdropColor = mDefaultBackgroundColor;
        mRawSHomeBrandShadowPaint.setColor(Color.BLACK);
        mRawSHomeBrandShadowPaint.setAlpha(52);

        mRootView = new RootView(mActivity);
        mRootView.setPadding(0, mTabStripHeightSupplier.get(), 0, 0);

        mTabStripHeightChangeCallback =
                newHeight ->
                        mRootView.setPadding(
                                mRootView.getPaddingLeft(),
                                newHeight,
                                mRootView.getPaddingRight(),
                                mRootView.getPaddingBottom());
        mTabStripHeightSupplier.addSyncObserverAndPostIfNonNull(mTabStripHeightChangeCallback);

        mUiConfig = new UiConfig(mRootView);
        mRecyclerView = setUpView();
        mFeedStreamViewResizer =
                FeedStreamViewResizer.createAndAttach(mActivity, mRecyclerView, mUiConfig);

        mIsNtpCustomizationV2Enabled = NtpCustomizationUtils.isNtpThemeCustomizationEnabled();
        if (mIsNewTabPageCustomizationV2Enabled) {
            mNtpBackgroundImageCoordinator =
                    new NtpBackgroundImageCoordinator(
                            mActivity, mRootView, mUiConfig, mDefaultBackgroundColor);
        }

        // Pull-to-refresh set up.
        if (mSwipeRefreshLayout != null && mSwipeRefreshLayout.getParent() == null) {
            mSwipeRefreshLayout.addView(mRecyclerView);
            mRootView.addView(mSwipeRefreshLayout);
        } else {
            mRootView.addView(mRecyclerView);
        }
        if (mSwipeRefreshLayout != null) {
            mSwipeRefreshLayout.addOnRefreshListener(this);
        }

        // The NTP customization button needs to be added after the RecyclerView to make it float
        // above the RecyclerView.
        if (mUseStaggeredLayout) {
            mNtpCustomizationButton =
                    NtpCustomizationUtils.createNtpCustomizationButton(
                            mActivity,
                            v -> {
                                showNtpCustomizationBottomSheet(moduleRegistry);
                            });
            mRootView.addView(mNtpCustomizationButton);
        }

        if (mIsNtpCustomizationV2Enabled) {
            mNtpCustomizationConfigManager = NtpCustomizationConfigManager.getInstance();
            mHomepageStateListener =
                    new HomepageStateListener() {
                        @Override
                        public void onBackgroundImageChanged(
                                Bitmap originalBitmap,
                                BackgroundImageInfo backgroundImageInfo,
                                boolean fromInitialization,
                                @NtpBackgroundType int oldType,
                                @NtpBackgroundType int newType) {
                            setBackground(originalBitmap, backgroundImageInfo, newType);
                        }

                        @Override
                        public void onBackgroundColorChanged(
                                @Nullable NtpThemeColorInfo ntpThemeColorInfo,
                                @ColorInt int backgroundColor,
                                boolean fromInitialization,
                                @NtpBackgroundType int oldType,
                                @NtpBackgroundType int newType) {
                            setBackgroundColor(backgroundColor);
                        }

                        @Override
                        public void onBackgroundReset(@NtpBackgroundType int oldType) {
                            setBackgroundColor(mDefaultBackgroundColor);
                        }
                    };

            mNtpCustomizationConfigManager.addListener(
                    mHomepageStateListener, activity, /* skipNotify= */ false);
        } else {
            setBackgroundColor(mDefaultBackgroundColor);
        }

        mHandler = new Handler(Looper.getMainLooper());

        // MVC setup for feed header.
        mHeaderView =
                LayoutInflater.from(mActivity)
                        .inflate(R.layout.new_tab_page_feed_header, null, false);
        mHeaderView.setAccessibilityLiveRegion(View.ACCESSIBILITY_LIVE_REGION_POLITE);

        if (mNtpHeader != null && ChromeFeatureList.isEnabled(ChromeFeatureList.FEED_CONTAINMENT)) {
            int bottomPadding = NewTabPageUtils.getNtpSectionPaddingPx(activity.getResources());
            mNtpHeader.setPadding(
                    mNtpHeader.getPaddingLeft(),
                    mNtpHeader.getPaddingTop(),
                    mNtpHeader.getPaddingRight(),
                    bottomPadding);

            updateNtpHeaderMargins();
        }

        // Mediator should be created before any Stream changes.
        mMediator =
                new FeedSurfaceMediator(
                        this, mActivity, snapScrollHelper, mActionDelegate, profile);

        FeedSurfaceTracker.getInstance().trackSurface(this);

        // Set up edge to edge
        mEdgePadAdjuster =
                EdgeToEdgeControllerFactory.createForViewAndObserveSupplier(
                        mRecyclerView, edgeToEdgeControllerSupplier);

        // Creates streams, initiates content changes.
        mMediator.updateContent();
    }

    /** Decorative default only; never intercepts touch, changes geometry or sets a theme pref. */
    @SuppressWarnings("UseSharedPreferencesManagerFromChromeCheck")
    public void useRawSHomeWallpaper(
            View nativeSearch,
            @Nullable View nativeTiles,
            int drawable,
            int brandDrawable,
            boolean wallpaperIncludesBrand) {
        if (mRawSHomeWallpaperSearch != null || mNtpHeader == null
                || mUseStaggeredLayout || mProfile.isOffTheRecord()) {
            return;
        }
        SharedPreferences preferences = ContextUtils.getAppSharedPreferences();
        if (preferences == null) return;
        mRawSHomeWallpaperPreferences = preferences;
        preferences.registerOnSharedPreferenceChangeListener(mRawSHomeWallpaperPrefListener);
        mRawSHomeWallpaperSearch = nativeSearch;
        mRawSHomeWallpaperTiles = nativeTiles;
        mRawSHomeWallpaperIncludesBrand = wallpaperIncludesBrand;
        connectRawSHomeWallpaper();
        Resources resources = mActivity.getApplicationContext().getResources();
        Handler ui = mHandler;
        WeakReference<FeedSurfaceCoordinator> weakOwner = new WeakReference<>(this);
        PostTask.postTask(
                TaskTraits.USER_VISIBLE_MAY_BLOCK,
                () -> {
                    Bitmap bitmap =
                            decodeRawSHomeWallpaper(resources, drawable, wallpaperIncludesBrand);
                    RawSHomeBrandAsset brand = decodeRawSHomeBrand(resources, brandDrawable);
                    if (bitmap == null && brand == null) return;
                    ui.post(() -> {
                        FeedSurfaceCoordinator owner = weakOwner.get();
                        if (owner == null || owner.mRawSHomeWallpaperSearch == null) return;
                        owner.mRawSHomeWallpaperBitmap = bitmap;
                        owner.mRawSHomeBrand = brand;
                        owner.mRootView.invalidate();
                    });
                });
    }

    public boolean canOfferRawSHomeImageUpload() {
        return !mActivity.isFinishing() && !mActivity.isDestroyed()
                && !mProfile.isOffTheRecord() && mRootView.isAttachedToWindow()
                && NtpCustomizationUtils.isNtpThemeCustomizationEnabled(
                        mWindowAndroid, /* isLff= */ false);
    }

    /** Starts the standard Android image picker and Chromium's own crop-and-Apply dialog. */
    public boolean startRawSHomeImageUpload(BooleanSupplier stillCurrentHome) {
        if (!canOfferRawSHomeImageUpload() || !stillCurrentHome.getAsBoolean()
                || mRawSImagePickerCallback != null || mRawSImageDecoding
                || mRawSImagePreview != null) {
            return false;
        }

        long generation = ++mRawSImagePickerGeneration;
        BooleanSupplier ownsHome = () -> generation == mRawSImagePickerGeneration
                && canOfferRawSHomeImageUpload() && stillCurrentHome.getAsBoolean();
        WindowAndroid.IntentCallback callback = (resultCode, data) -> {
            if (generation != mRawSImagePickerGeneration) return;
            mRawSImagePickerCallback = null;
            mRawSImagePickerRequest = -1;
            if (!ownsHome.getAsBoolean() || resultCode != Activity.RESULT_OK || data == null) {
                return;
            }
            var uri = data.getData();
            if (uri == null) return;
            mRawSImageDecoding = true;
            NtpCustomizationUtils.getBitmapFromUriAsync(
                    mActivity, uri, (bitmap, fileIdHash) -> {
                        if (generation != mRawSImagePickerGeneration) return;
                        mRawSImageDecoding = false;
                        if (bitmap == null || !ownsHome.getAsBoolean()) return;
                        mRawSImagePreview = new UploadImagePreviewCoordinator(
                                mActivity,
                                mProfile,
                                bitmap,
                                ChromeFeatureList.sNewTabPageCustomizationThemeSync.isEnabled()
                                        ? fileIdHash : null,
                                (applied, differentTheme) -> {});
                        mRawSImagePreview.setRawSHomeUploadLifecycle(
                                ownsHome, () -> mHandler.post(() -> {
                                    if (generation == mRawSImagePickerGeneration) {
                                        cancelRawSHomeImageUpload();
                                    }
                                }));
                    });
        };
        mRawSImagePickerCallback = callback;
        Intent picker = new Intent(Intent.ACTION_GET_CONTENT)
                .addCategory(Intent.CATEGORY_OPENABLE)
                .setType("image/*");
        int request = mWindowAndroid.showCancelableIntent(picker, callback, /* errorId= */ null);
        if (request < 0) {
            cancelRawSHomeImageUpload();
            return false;
        }
        if (mRawSImagePickerCallback == callback) mRawSImagePickerRequest = request;
        return true;
    }

    private void cancelRawSHomeImageUpload() {
        mRawSImagePickerGeneration++;
        var callback = mRawSImagePickerCallback;
        mRawSImagePickerCallback = null;
        int request = mRawSImagePickerRequest;
        mRawSImagePickerRequest = -1;
        if (callback != null) mWindowAndroid.removeIntentCallback(callback);
        if (request >= 0) mWindowAndroid.cancelIntent(request);
        mRawSImageDecoding = false;
        var preview = mRawSImagePreview;
        mRawSImagePreview = null;
        if (preview != null) preview.destroy();
    }

    private static synchronized @Nullable Bitmap decodeRawSHomeWallpaper(
            Resources resources, int drawable, boolean wallpaperIncludesBrand) {
        int expectedWidth =
                wallpaperIncludesBrand
                        ? RAWS_LEGACY_BRANDED_WALLPAPER_WIDTH
                        : RAWS_HOME_WALLPAPER_WIDTH;
        int expectedHeight =
                wallpaperIncludesBrand
                        ? RAWS_LEGACY_BRANDED_WALLPAPER_HEIGHT
                        : RAWS_HOME_WALLPAPER_HEIGHT;
        Bitmap cached = sRawSHomeWallpaperBitmap;
        if (cached != null && cached.getWidth() == expectedWidth
                && cached.getHeight() == expectedHeight) {
            return cached;
        }
        Bitmap decoded = BitmapFactory.decodeResource(resources, drawable);
        if (decoded == null || decoded.getWidth() != expectedWidth
                || decoded.getHeight() != expectedHeight) {
            return null;
        }
        sRawSHomeWallpaperBitmap = decoded;
        return decoded;
    }

    private static synchronized @Nullable RawSHomeBrandAsset decodeRawSHomeBrand(
            Resources resources, int drawable) {
        if (sRawSHomeBrand == null) {
            Bitmap bitmap = BitmapFactory.decodeResource(resources, drawable);
            if (bitmap != null && bitmap.getWidth() == RAWS_HOME_BRAND_SOURCE_WIDTH + 2
                    && bitmap.getHeight() == RAWS_HOME_BRAND_SOURCE_HEIGHT) {
                // Derive a tiny soft draw layer from alpha only. Keep the supplied RGBA pixels
                // unchanged, including their raised relief and color. Cached off the UI thread.
                Paint mask = new Paint();
                mask.setMaskFilter(new BlurMaskFilter(4f, BlurMaskFilter.Blur.NORMAL));
                int[] offset = new int[2];
                Bitmap clipped = Bitmap.createBitmap(bitmap, 0, 0,
                        RAWS_HOME_BRAND_SOURCE_WIDTH, RAWS_HOME_BRAND_SOURCE_HEIGHT);
                Bitmap shadow = clipped.extractAlpha(mask, offset);
                sRawSHomeBrand = new RawSHomeBrandAsset(bitmap, shadow, offset[0], offset[1]);
            }
        }
        return sRawSHomeBrand;
    }

    private void connectRawSHomeWallpaper() {
        if (mRawSHomeWallpaperSearch == null || mRawSHomeWallpaperObserver != null
                || !mRootView.isAttachedToWindow()) {
            return;
        }
        ViewTreeObserver observer = mRootView.getViewTreeObserver();
        observer.addOnPreDrawListener(mRawSHomeWallpaperPreDraw);
        mRawSHomeWallpaperObserver = observer;
    }

    private void disconnectRawSHomeWallpaper() {
        ViewTreeObserver observer = mRawSHomeWallpaperObserver;
        mRawSHomeWallpaperObserver = null;
        if (observer != null && observer.isAlive()) {
            observer.removeOnPreDrawListener(mRawSHomeWallpaperPreDraw);
        }
    }

    private void invalidateRawSHomeWallpaper() {
        mRootView.invalidate();
    }

    private void disposeRawSHomeWallpaper() {
        disconnectRawSHomeWallpaper();
        mRawSHomeWallpaperSearch = null;
        mRawSHomeWallpaperTiles = null;
        SharedPreferences preferences = mRawSHomeWallpaperPreferences;
        mRawSHomeWallpaperPreferences = null;
        if (preferences != null) {
            preferences.unregisterOnSharedPreferenceChangeListener(
                    mRawSHomeWallpaperPrefListener);
        }
        mRawSHomeWallpaperBitmap = null;
        mRawSHomeBrand = null;
        stopPaintingRawSHomeWallpaper();
        updateRawSHomeBrand();
    }

    /** Don't paint over Chromium's current or still-loading custom color or image. */
    private boolean canUseRawSDefaultWallpaper() {
        if (!mShowDarkBackground || !NtpCustomizationUtils.isNtpThemeCustomizationEnabled()) {
            return false;
        }
        NtpCustomizationConfigManager manager = mNtpCustomizationConfigManager;
        if (manager != null && manager.getBackgroundType() != NtpBackgroundType.DEFAULT) {
            return false;
        }
        return NtpCustomizationUtils.getNtpBackgroundType() == NtpBackgroundType.DEFAULT;
    }

    private void stopPaintingRawSHomeWallpaper() {
        if (!mRawSHomeWallpaperPainting) return;
        mRawSHomeWallpaperPainting = false;
        mRawSHomeWallpaperDirty = true;
        mRootView.invalidate();
    }

    private void setPaintingRawSHomeWallpaper(boolean show) {
        if (show == mRawSHomeWallpaperPainting) return;
        if (show) {
            mRawSHomeWallpaperPainting = true;
            mRawSHomeWallpaperDirty = true;
            mRecyclerView.setBackgroundColor(Color.TRANSPARENT);
            if (mNtpHeader != null) mNtpHeader.setBackgroundColor(Color.TRANSPARENT);
        } else {
            stopPaintingRawSHomeWallpaper();
            // The caller only restores the default in the default theme. Native color/image
            // callbacks always remain the exclusive owner of custom theme layers.
            restoreRawSHomeNativeBackdrop();
        }
        mRootView.invalidate();
    }

    private boolean updateRawSHomeWallpaper() {
        updateRawSHomeWallpaperGeometry();
        updateRawSHomeBrand();
        return true;
    }

    private boolean updateRawSHomeWallpaperGeometry() {
        View search = mRawSHomeWallpaperSearch;
        Bitmap wallpaper = mRawSHomeWallpaperBitmap;
        if (search == null || wallpaper == null) return true;
        if (!canUseRawSDefaultWallpaper()) {
            // Chromium's custom image/color callbacks own their backing layers. Suppress the
            // bundled paint without ever restoring a default color over a known custom theme.
            stopPaintingRawSHomeWallpaper();
            return true;
        }
        if (!isRawSHomeWallpaperEnabled()) {
            setPaintingRawSHomeWallpaper(false);
            return true;
        }
        int width = mRootView.getWidth();
        int height = mRootView.getHeight();
        boolean sameViewport = width == mRawSHomeWallpaperWidth
                && height == mRawSHomeWallpaperHeight;
        if (width <= 0 || height <= width) {
            setPaintingRawSHomeWallpaper(false);
            return true;
        }

        // Do not repaint the authored artwork when scrolling or changing focus in the
        // same viewport. A restored scroll position must still be able to paint its first frame.
        if (sameViewport && mRawSHomeWallpaperPainting
                && (mRecyclerView.canScrollVertically(-1) || search.isLayoutRequested())) {
            return true;
        }

        // The bundled background is not a Navigation or Toolbar state. In particular, a
        // GONE/INVISIBLE fakebox does not occupy a rectangle just because the browser hasn't
        // reported that its previously attached URL field committed the native handoff.
        mRawSHomeWallpaperVisible.set(0, 0, width, height);
        float searchTop = height;
        float tilesTop = height;
        float tilesBottom = height;
        View tiles = mRawSHomeWallpaperTiles;
        if (mRootView.getLocalVisibleRect(mRawSHomeWallpaperVisible)) {
            mRootView.getLocationInWindow(mRawSHomeRootLocation);
            if (search.isShown() && search.isLaidOut() && !search.isLayoutRequested()) {
                search.getLocationInWindow(mRawSHomeSearchLocation);
                searchTop = Math.min(height, mRawSHomeSearchLocation[1] - mRawSHomeRootLocation[1]);
            }
            if (tiles != null && tiles.isShown() && tiles.isLaidOut()) {
                tiles.getLocationInWindow(mRawSHomeSearchLocation);
                tilesTop = mRawSHomeSearchLocation[1] - mRawSHomeRootLocation[1];
                tilesBottom = tilesTop + tiles.getHeight();
            }
        }
        float gap = 12f * mRootView.getResources().getDisplayMetrics().density;
        if (!mRawSHomeWallpaperIncludesBrand
                || !chooseRawSHomeWallpaper(
                        width, height, mRawSHomeWallpaperVisible, searchTop, tilesTop,
                        tilesBottom, gap, mRawSHomeWallpaperCandidate)) {
            // Center-cover unbranded artwork without the old baked-wordmark crop constraints.
            // A bundled image never changes the native search, tray or inset geometry.
            centerRawSHomeWallpaper(
                    width, height, wallpaper.getWidth(), wallpaper.getHeight(),
                    mRawSHomeWallpaperIncludesBrand, mRawSHomeWallpaperCandidate);
        }

        if (!mRawSHomeWallpaperCandidate.equals(mRawSHomeWallpaperDest)) {
            mRawSHomeWallpaperDest.set(mRawSHomeWallpaperCandidate);
            mRawSHomeWallpaperDirty = true;
            mRootView.invalidate();
        }
        mRawSHomeWallpaperWidth = width;
        mRawSHomeWallpaperHeight = height;
        setPaintingRawSHomeWallpaper(true);
        return true;
    }

    // The shipped bitmap is untouched. Choose the closest center-cover crop that keeps the
    // entire baked wordmark away from the existing native tray, within visible artwork,
    // and above the separate input only on configurations where Chromium must retain it.
    // Shift only the bitmap's drawing rectangle and never any native view or reserved inset.
    private static boolean chooseRawSHomeWallpaper(
            int width, int height, Rect visible, float searchTop, float tilesTop,
            float tilesBottom, float gap, RectF out) {
        if (width <= 0 || height <= width || searchTop <= gap || gap <= 0) return false;
        float scale = Math.max(width / 819f, height / 1920f);
        float x = Math.max(width - 819f * scale, Math.min(0f, width / 2f - 409f * scale));
        if (x + 207 * scale < visible.left || x + 638 * scale > visible.right) return false;
        float minY = Math.max(height - 1920 * scale, visible.top + gap - 381 * scale);
        float maxY = Math.min(0f, Math.min(searchTop - gap, visible.bottom - gap) - 491 * scale);
        if (maxY < minY) return false;
        float centeredY = height / 2f - 960 * scale;
        float y = Math.max(minY, Math.min(centeredY, maxY));
        if (tilesBottom > tilesTop && y + 491 * scale > tilesTop - gap
                && y + 381 * scale < tilesBottom + gap) {
            float above = Math.min(maxY, tilesTop - gap - 491 * scale);
            float below = Math.max(minY, tilesBottom + gap - 381 * scale);
            if (above < minY && below > maxY) return false;
            if (above >= minY
                    && (below > maxY || Math.abs(above - centeredY) <= Math.abs(below - centeredY))) {
                y = above;
            } else {
                y = below;
            }
        }
        out.set(x, y, x + 819 * scale, y + 1920 * scale);
        return true;
    }

    private static void centerRawSHomeWallpaper(
            int width, int height, int sourceWidth, int sourceHeight,
            boolean wallpaperIncludesBrand, RectF out) {
        float scale = Math.max((float) width / sourceWidth, (float) height / sourceHeight);
        float focalX = wallpaperIncludesBrand ? 409f : sourceWidth / 2f;
        float x = Math.max(width - sourceWidth * scale, Math.min(0f, width / 2f - focalX * scale));
        float y = (height - sourceHeight * scale) / 2f;
        out.set(x, y, x + sourceWidth * scale, y + sourceHeight * scale);
    }

    private boolean isRawSHomeWallpaperEnabled() {
        SharedPreferences preferences = mRawSHomeWallpaperPreferences;
        return preferences != null && preferences.getBoolean(RAWS_HOME_WALLPAPER_PREFERENCE, true);
    }

    private void drawRawSHomeWallpaper(Canvas canvas) {
        Bitmap bitmap = mRawSHomeWallpaperBitmap;
        if (!mRawSHomeWallpaperPainting || bitmap == null) return;
        canvas.drawBitmap(bitmap, null, mRawSHomeWallpaperDest, mRawSHomeWallpaperPaint);
    }

    private void updateRawSHomeBrand() {
        var brand = mRawSHomeBrand;
        View search = mRawSHomeWallpaperSearch;
        int width = mRootView.getWidth();
        int height = mRootView.getHeight();
        boolean show = brand != null && search != null && width > 0 && height > width
                && !(mRawSHomeWallpaperPainting && mRawSHomeWallpaperIncludesBrand);
        boolean keepGeometry = mRawSHomeBrandPainting && width == mRawSHomeBrandViewportWidth
                && height == mRawSHomeBrandViewportHeight
                && (mRecyclerView.canScrollVertically(-1)
                        || (search != null && search.isLayoutRequested()));
        if (show && search != null && brand != null && !keepGeometry) {
            mRawSHomeBrandViewportWidth = width;
            mRawSHomeBrandViewportHeight = height;
            float gap = 12f * mRootView.getResources().getDisplayMetrics().density;
            mRootView.getLocationInWindow(mRawSHomeRootLocation);
            float end = height;
            if (search.isShown() && search.isLaidOut()) {
                search.getLocationInWindow(mRawSHomeSearchLocation);
                end = Math.min(end, mRawSHomeSearchLocation[1] - mRawSHomeRootLocation[1]);
            }
            View tiles = mRawSHomeWallpaperTiles;
            if (tiles != null && tiles.isShown() && tiles.isLaidOut()) {
                tiles.getLocationInWindow(mRawSHomeSearchLocation);
                end = Math.min(end, mRawSHomeSearchLocation[1] - mRawSHomeRootLocation[1]);
            }
            show = placeRawSHomeBrand(width, height, end, gap, mRawSHomeBrandCandidate);
            if (show && !mRawSHomeBrandCandidate.equals(mRawSHomeBrandDest)) {
                mRawSHomeBrandDest.set(mRawSHomeBrandCandidate);
                Bitmap shadow = brand.shadow();
                if (shadow != null) {
                    float scale = mRawSHomeBrandDest.width() / RAWS_HOME_BRAND_SOURCE_WIDTH;
                    float left = mRawSHomeBrandDest.left + brand.shadowOffsetX() * scale;
                    float top = mRawSHomeBrandDest.top + brand.shadowOffsetY() * scale
                            + 1.5f * mRootView.getResources().getDisplayMetrics().density;
                    mRawSHomeBrandShadowDest.set(left, top,
                            left + shadow.getWidth() * scale, top + shadow.getHeight() * scale);
                }
                mRawSHomeWallpaperDirty = true;
                mRootView.invalidate();
            }
        }

        if (show != mRawSHomeBrandPainting) {
            mRawSHomeBrandPainting = show;
            mRawSHomeWallpaperDirty = true;
            mRootView.invalidate();
        }
        if (show && !mRawSHomeWallpaperPainting
                && !mRawSHomeNativeImageActive && !mRawSHomeSolidBackdropMoved) {
            // In solid themes the existing content containers are opaque. Move only those same
            // flat pixels to the background stage, so our mark remains below real controls.
            mRawSHomeSolidBackdropMoved = true;
            mRecyclerView.setBackgroundColor(Color.TRANSPARENT);
            if (mNtpHeader != null) mNtpHeader.setBackgroundColor(Color.TRANSPARENT);
        } else if ((!show || mRawSHomeWallpaperPainting) && mRawSHomeSolidBackdropMoved) {
            mRawSHomeSolidBackdropMoved = false;
            if (!mRawSHomeWallpaperPainting) restoreRawSHomeNativeBackdrop();
        }
    }

    private void restoreRawSHomeNativeBackdrop() {
        int color = mRawSHomeNativeImageActive ? Color.TRANSPARENT : mRawSHomeNativeBackdropColor;
        mRawSHomeSolidBackdropMoved = false;
        mRecyclerView.setBackgroundColor(color);
        if (mNtpHeader != null) {
            mNtpHeader.setBackgroundColor(color == mDefaultBackgroundColor
                    ? mDefaultBackgroundColor : Color.TRANSPARENT);
        }
    }

    private static boolean placeRawSHomeBrand(
            int width, int height, float bottomLimit, float gap, RectF out) {
        if (width <= 0 || height <= width || gap <= 0 || bottomLimit <= 2 * gap) return false;
        // Match the donor horizon layout; keep the 353px-wide strong-alpha mark centered.
        float cover = Math.max(width / 819f, height / 1920f);
        float scale = Math.min(431f * cover, width * .57f) / 353f;
        scale = Math.min(scale, (bottomLimit - 2 * gap) / RAWS_HOME_BRAND_SOURCE_HEIGHT);
        if (scale <= 0) return false;
        float left = width / 2f - 176.5f * scale;
        float top = height / 2f - 524f * cover - 55f * scale;
        float brandHeight = RAWS_HOME_BRAND_SOURCE_HEIGHT * scale;
        top = Math.max(gap, Math.min(top, bottomLimit - gap - brandHeight));
        out.set(left, top, left + RAWS_HOME_BRAND_SOURCE_WIDTH * scale, top + brandHeight);
        return true;
    }

    private void drawRawSHomeBrand(Canvas canvas) {
        var brand = mRawSHomeBrand;
        if (!mRawSHomeBrandPainting || brand == null
                || (mRawSHomeWallpaperPainting && mRawSHomeWallpaperIncludesBrand)) return;
        if (mRawSHomeSolidBackdropMoved) canvas.drawColor(mRawSHomeNativeBackdropColor);
        Bitmap shadow = brand.shadow();
        if (shadow != null) canvas.drawBitmap(shadow, null, mRawSHomeBrandShadowDest,
                mRawSHomeBrandShadowPaint);
        canvas.drawBitmap(brand.image(), mRawSHomeBrandSource, mRawSHomeBrandDest,
                mRawSHomeWallpaperPaint);
    }

    // Sets the background image for the embedder NTP.
    private void setBackground(
            Bitmap originalBitmap,
            BackgroundImageInfo backgroundImageInfo,
            @NtpBackgroundType int backgroundType) {
        stopPaintingRawSHomeWallpaper();
        mRawSHomeNativeImageActive = true;
        mRawSHomeSolidBackdropMoved = false;
        if (mRawSHomeWallpaperSearch != null) mRawSHomeWallpaperDirty = true;
        if (mNtpHeader != null) {
            mNtpHeader.setBackgroundColor(Color.TRANSPARENT);
        }

        mRecyclerView.setBackgroundColor(Color.TRANSPARENT);
        assumeNonNull(mNtpBackgroundImageCoordinator)
                .setBackground(originalBitmap, backgroundImageInfo, backgroundType);
    }

    /**
     * Sets the background color for the embedder NTP.
     *
     * @param backgroundColor The customized background color.
     */
    private void setBackgroundColor(@ColorInt int backgroundColor) {
        stopPaintingRawSHomeWallpaper();
        mRawSHomeNativeImageActive = false;
        mRawSHomeNativeBackdropColor = backgroundColor;
        mRawSHomeSolidBackdropMoved = false;
        if (mRawSHomeWallpaperSearch != null) mRawSHomeWallpaperDirty = true;
        mRecyclerView.setBackgroundColor(backgroundColor);
        if (mNtpBackgroundImageCoordinator != null) {
            mNtpBackgroundImageCoordinator.clearBackground();
        }

        if (mNtpHeader != null) {
            if (backgroundColor != mDefaultBackgroundColor) {
                mNtpHeader.setBackgroundColor(Color.TRANSPARENT);
            } else {
                mNtpHeader.setBackgroundColor(mDefaultBackgroundColor);
            }
        }
    }

    void updateNtpHeaderMargins() {
        if (mNtpHeader == null) {
            return;
        }

        int margin =
                FeedStreamViewResizerUtils.getFeedNtpCompensationMargin(
                        mRootView.getResources(), mUiConfig);

        FrameLayout.LayoutParams layoutParams =
                new FrameLayout.LayoutParams(
                        ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
        layoutParams.setMarginStart(margin);
        layoutParams.setMarginEnd(margin);
        mNtpHeader.setLayoutParams(layoutParams);
    }

