        private void updateRawSLowerShortcutsViewport(int heightMeasureSpec) {
            if (mNtpHeader instanceof NewTabPageLayout header) {
                int viewportHeight = 0;
                boolean imeVisible = false;
                if (android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.R) {
                    var insets = getRootWindowInsets();
                    imeVisible = insets != null && insets.isVisible(android.view.WindowInsets.Type.ime());
                }
                if (!imeVisible && MeasureSpec.getMode(heightMeasureSpec) == MeasureSpec.EXACTLY
                        && getResources().getConfiguration().orientation
                                == Configuration.ORIENTATION_PORTRAIT) {
                    viewportHeight = MeasureSpec.getSize(heightMeasureSpec);
                }
                if (header.setRawSLowerShortcutsViewport(viewportHeight)) {
                    // RecyclerView can reuse child measurement when width is unchanged.
                    // Flag the existing header/wrappers inside this measure pass, not a
                    // second posted layout or translation of its hit/accessibility bounds.
                    for (View current = header; current != this; ) {
                        current.forceLayout();
                        if (!(current.getParent() instanceof View parent)) break;
                        current = parent;
                    }
                }
            }
        }

        @Override
        protected void onAttachedToWindow() {
            super.onAttachedToWindow();
            connectRawSHomeWallpaper();
        }

        @Override
        protected void onDetachedFromWindow() {
            disconnectRawSHomeWallpaper();
            cancelRawSHomeImageUpload();
            super.onDetachedFromWindow();
        }

        @Override
        protected void dispatchDraw(Canvas canvas) {
            super.dispatchDraw(canvas);
            mHasDrawnFrame = true;
        }

        @Override
        protected boolean drawChild(Canvas canvas, View child, long drawingTime) {
            // Chromium's full-size, opaque NTP background child has already been drawn.
            // Keep the Galaxy painter above it and below the real scrolling/input controls.
            if (child == mRecyclerView || child == mSwipeRefreshLayout) {
                drawRawSHomeWallpaper(canvas);
                drawRawSHomeBrand(canvas);
            }
            return super.drawChild(canvas, child, drawingTime);
        }

        @Override
        protected void onConfigurationChanged(Configuration newConfig) {
            super.onConfigurationChanged(newConfig);
            mUiConfig.updateDisplayStyle();
        }

        @Override
        protected void onSizeChanged(int width, int height, int oldWidth, int oldHeight) {
            super.onSizeChanged(width, height, oldWidth, oldHeight);
            if (ChromeFeatureList.isEnabled(ChromeFeatureList.FEED_CONTAINMENT)) {
                mRecyclerView.post(mRecyclerView::invalidateItemDecorations);
                updateNtpHeaderMargins();
            }
            if (mUseStaggeredLayout) {
                updateNtpCustomizationButtonVisibility();
            }
            if (mUiConfig != null) mUiConfig.updateDisplayStyle();
        }

        @Override
        public boolean onInterceptTouchEvent(MotionEvent ev) {
            // This is for caching the last touch position on the NTP. {@link
            // ViewGroup#onInterceptTouchEvent} is called for every motion event that will be
            // consumed by this view or any of its child views. This location allows us to cache
            // the last touch before any views actually perform an intercept or handle the touch
            // event. Placing this call later in the method would mean at least a subset of events
            // would be missed.
            mDelegate.sendMotionEventForInputTracking(ev);
            // Defocus any other view (such as the Omnibox / UrlBar) when tapping on the empty
            // background surface.
            if (ev.getActionMasked() == MotionEvent.ACTION_DOWN) {
                requestFocus();
            }

            if (super.onInterceptTouchEvent(ev)) return true;
            if (mMediator != null && !mMediator.getTouchEnabled()) return true;

            return mDelegate.onInterceptTouchEvent(ev);
        }

        @Override
        public void onMeasure(int x, int y) {
            try (TraceEvent e = TraceEvent.scoped("Feed.RootView.onMeasure")) {
                updateRawSLowerShortcutsViewport(y);
                super.onMeasure(x, y);
            }
        }

        @Override
        public void onLayout(boolean a, int b, int c, int d, int e) {
            try (TraceEvent e1 = TraceEvent.scoped("Feed.RootView.onLayout")) {
                super.onLayout(a, b, c, d, e);
            }
        }

        @Override
        public void onDraw(Canvas canvas) {
            try (TraceEvent e = TraceEvent.scoped("Feed.RootView.onDraw")) {
                super.onDraw(canvas);
            }
        }
    }

