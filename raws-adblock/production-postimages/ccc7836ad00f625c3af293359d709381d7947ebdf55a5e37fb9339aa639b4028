namespace sandium::adblock_native {

inline bool CanUseElementRules(content::RenderFrameHost* frame) {
  return frame && frame->IsInPrimaryMainFrame() && frame->IsActive() &&
         frame->IsRenderFrameLive() && !frame->IsErrorDocument() &&
         frame->GetLastCommittedURL().SchemeIsHTTPOrHTTPS() &&
         ElementRulesOriginKey(frame->GetLastCommittedOrigin()).has_value() &&
         frame->GetEmbeddingToken().has_value();
}

inline bool ApplyCurrentElementRules(content::RenderFrameHost* frame,
                                     bool clear_if_empty = false) {
  if (!CanUseElementRules(frame)) return false;
  auto* profile = Profile::FromBrowserContext(frame->GetBrowserContext());
  if (!profile) return false;
  const auto css = BuildPickedSelectorStyles(
      ReadElementRules(*profile, frame->GetLastCommittedOrigin()));
  if (css.empty() && !clear_if_empty) return true;
  mojo::AssociatedRemote<chrome::mojom::ChromeRenderFrame> remote;
  frame->GetRemoteAssociatedInterfaces()->GetInterface(&remote);
  remote->ApplyRawSUserElementRules(*frame->GetEmbeddingToken(), css);
  return true;
}

// Only a trusted browser-owned Block action can authorize one selector read
// and commit. Renderer updates alone neither save nor hide anything.
class RawSElementPicker final
    : public content::WebContentsObserver,
      public content::WebContentsUserData<RawSElementPicker> {
 public:
  using Started = base::OnceCallback<void(std::string)>;
  using Readiness = base::OnceCallback<void(std::string)>;
  using Committed = base::OnceCallback<void(bool)>;
  ~RawSElementPicker() override;

  bool Begin(Started started) {
    auto* frame = web_contents()->GetPrimaryMainFrame();
    if (!started || embedding_ ||
        web_contents()->GetVisibility() != content::Visibility::VISIBLE ||
        !CanUseElementRules(frame)) return false;
    document_ = frame->GetWeakDocumentPtr();
    embedding_ = frame->GetEmbeddingToken();
    session_ = base::UnguessableToken::Create().ToString();
    started_ = std::move(started);
    frame->GetRemoteAssociatedInterfaces()->GetInterface(&remote_);
    remote_.set_disconnect_handler(
        base::BindOnce(&RawSElementPicker::Cancel, weak_.GetWeakPtr()));
    timer_.Start(FROM_HERE, base::Seconds(62),
                 base::BindOnce(&RawSElementPicker::Cancel, weak_.GetWeakPtr()));
    remote_->BeginRawSElementPicker(
        *embedding_,
        base::BindOnce(&RawSElementPicker::OnStarted, weak_.GetWeakPtr()));
    return true;
  }

  bool Watch(const std::string& session, Readiness changed) {
    if (!changed || !CurrentFrame() || started_ || watch_ ||
        session != session_) return false;
    watch_ = std::move(changed);
    remote_->WatchRawSElementPicker(
        *embedding_, revision_,
        base::BindOnce(&RawSElementPicker::OnWatch, weak_.GetWeakPtr()));
    return true;
  }

  // Only the existing browser chrome button calls this. Renderer changes are
  // readiness-only; they can never authorize a persistent write.
  bool Commit(const std::string& session, Committed completed) {
    if (!completed || !CurrentFrame() || candidate_.empty() || commit_ ||
        session != session_) {
      return false;
    }
    authorized_ = candidate_;  // Freeze the last accepted browser preview.
    commit_ = std::move(completed);
    remote_->ReadRawSElementPickerSelection(
        *embedding_,
        base::BindOnce(&RawSElementPicker::OnCommit, weak_.GetWeakPtr()));
    return true;
  }

  bool Clear(const std::string& expected_document) {
    auto* frame = web_contents()->GetPrimaryMainFrame();
    if (web_contents()->GetVisibility() != content::Visibility::VISIBLE ||
        !CanUseElementRules(frame) ||
        frame->GetEmbeddingToken()->ToString() != expected_document)
      return false;
    Cancel();
    auto* profile = Profile::FromBrowserContext(frame->GetBrowserContext());
    return profile && ClearElementRules(*profile, frame->GetLastCommittedOrigin()) &&
           ApplyCurrentElementRules(frame, true);
  }

  void Cancel() {
    weak_.InvalidateWeakPtrs();
    timer_.Stop();
    if (remote_.is_bound() && embedding_)
      remote_->CancelRawSElementPicker(*embedding_);
    remote_.reset();
    document_.reset();
    embedding_.reset();
    session_.clear();
    revision_ = 0;
    candidate_.clear();
    authorized_.clear();
    if (!started_ && !watch_ && !commit_) return;
    auto task_runner = base::SequencedTaskRunner::GetCurrentDefault();
    // Rollover cannot reenter this controller or a closing WebContents.
    if (started_) {
      task_runner->PostTask(
          FROM_HERE, base::BindOnce(std::move(started_), std::string()));
    }
    if (watch_) {
      task_runner->PostTask(
          FROM_HERE, base::BindOnce(std::move(watch_), std::string()));
    }
    if (commit_) {
      task_runner->PostTask(
          FROM_HERE, base::BindOnce(std::move(commit_), false));
    }
  }

 private:
  friend class content::WebContentsUserData<RawSElementPicker>;
  explicit RawSElementPicker(content::WebContents* contents);

  content::RenderFrameHost* CurrentFrame() const {
    if (!document_ || !embedding_ ||
        web_contents()->GetVisibility() != content::Visibility::VISIBLE)
      return nullptr;
    auto* frame = document_->AsRenderFrameHostIfValid();
    return CanUseElementRules(frame) &&
                   frame == web_contents()->GetPrimaryMainFrame() &&
                   frame->GetEmbeddingToken() == embedding_
               ? frame : nullptr;
  }

  void OnStarted(bool active) {
    if (!active || !started_ || !CurrentFrame()) {
      Cancel();
      return;
    }
    std::move(started_).Run(session_);
  }

  void OnWatch(uint32_t revision, const std::string& selector) {
    if (!watch_ || !CurrentFrame() || revision <= revision_ ||
        revision > 65535 ||
        (!selector.empty() && !IsSafePickedSelector(selector))) {
      Cancel();
      return;
    }
    revision_ = revision;
    candidate_ = selector;
    std::move(watch_).Run(candidate_.empty() ? "0" : "1");
  }

  void OnCommit(const std::string& selector) {
    if (!commit_) return;
    auto* frame = CurrentFrame();
    auto completed = std::move(commit_);
    auto authorized = std::exchange(authorized_, std::string());
    if (!frame) {
      Cancel();
      std::move(completed).Run(false);
      return;
    }
    if (selector != authorized || !IsSafePickedSelector(selector)) {
      // A repick or DOM change can invalidate the displayed match. Nothing is
      // persisted; the pending Watch can publish the new visible picker state.
      std::move(completed).Run(false);
      return;
    }
    auto* profile = Profile::FromBrowserContext(frame->GetBrowserContext());
    Cancel();  // Consume the one-shot document session before persisting.
    const bool changed =
        profile && !profile->ShutdownStarted() &&
        AddElementRule(*profile, frame->GetLastCommittedOrigin(), selector) &&
        ApplyCurrentElementRules(frame, true);
    std::move(completed).Run(changed);
  }

  void PrimaryPageChanged(content::Page&) override;
  void OnVisibilityChanged(content::Visibility visibility) override;

  std::optional<content::WeakDocumentPtr> document_;
  std::optional<base::UnguessableToken> embedding_;
  std::string session_;
  uint32_t revision_ = 0;
  std::string candidate_;
  std::string authorized_;
  Started started_;
  Readiness watch_;
  Committed commit_;
  base::OneShotTimer timer_;
  mojo::AssociatedRemote<chrome::mojom::ChromeRenderFrame> remote_;
  base::WeakPtrFactory<RawSElementPicker> weak_{this};

  WEB_CONTENTS_USER_DATA_KEY_DECL();
};

}  // namespace sandium::adblock_native
#endif  // CHROME_BROWSER_RAWS_RAW_ELEMENT_PICKER_BROWSER_H_
