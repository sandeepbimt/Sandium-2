constexpr size_t kMaxDepth = 24;
constexpr size_t kMaxNodes = 4096;
constexpr size_t kMaxRules = 32;

inline bool Text(const std::string& s, size_t max, bool empty = true) {
  if (s.size() > max || (!empty && s.empty())) return false;
  for (unsigned char c : s)
    if (c < 32 || c == 127) return false;
  return true;
}
inline bool Tag(const std::string& tag) {
  return Text(tag, 64, false) && std::ranges::all_of(tag, [](char c) {
    return (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-';
  });
}
inline bool ValidStep(const wire::RawSColorStep& step) {
  if (!Tag(step.tag) || !Text(step.role, 64) || step.classes.size() > 12 ||
      !std::ranges::is_sorted(step.classes) ||
      !std::ranges::all_of(step.classes, [](const std::string& x) {
        return Text(x, 64, false);
      })) {
    return false;
  }
  return (step.ordinal == 0 && step.sibling_count == 0) ||
      (step.ordinal >= 1 && step.sibling_count >= 2 &&
       step.ordinal <= step.sibling_count && step.sibling_count <= kMaxNodes);
}
inline bool ValidIdentity(const wire::RawSColorIdentity& id) {
  if (!Tag(id.tag) || !Text(id.id, 128) || !Text(id.role, 64) ||
      id.ancestors.empty() || id.ancestors.size() >= kMaxDepth ||
      !id.ancestors.front() || id.ancestors.front()->tag != "body" ||
      !std::ranges::all_of(id.ancestors, [](const auto& a) {
        return a && Tag(a->tag) && Text(a->id, 128);
      })) {
    return false;
  }
  if (!id.locator) return !id.id.empty();
  return id.id.empty() && Text(id.locator->anchor_id, 128) &&
      !id.locator->steps.empty() && id.locator->steps.size() <= kMaxDepth &&
      std::ranges::all_of(id.locator->steps, [](const auto& step) {
        return step && ValidStep(*step);
      });
}
inline bool ValidColor(wire::RawSColorProperty property, uint32_t rgb,
                       const wire::RawSColorIdentity& id) {
  return rgb <= 0xffffff &&
         (property == wire::RawSColorProperty::kForeground ||
          property == wire::RawSColorProperty::kBackground ||
          (property == wire::RawSColorProperty::kImageArtwork && id.tag == "img"));
}
inline bool SameStep(const wire::RawSColorStep& a, const wire::RawSColorStep& b) {
  return a.tag == b.tag && a.role == b.role && a.classes == b.classes;
}
inline bool SameIdentity(const wire::RawSColorIdentity& a,
                         const wire::RawSColorIdentity& b) {
  if (a.tag != b.tag || a.id != b.id || a.role != b.role ||
      a.ancestors.size() != b.ancestors.size() || !!a.locator != !!b.locator) return false;
  for (size_t i = 0; i < a.ancestors.size(); ++i)
    if (a.ancestors[i]->tag != b.ancestors[i]->tag ||
        a.ancestors[i]->id != b.ancestors[i]->id) return false;
  if (!a.locator) return true;
  if (a.locator->anchor_id != b.locator->anchor_id ||
      a.locator->steps.size() != b.locator->steps.size()) return false;
  for (size_t i = 0; i < a.locator->steps.size(); ++i) {
    const auto& x = *a.locator->steps[i];
    const auto& y = *b.locator->steps[i];
    if (!SameStep(x, y) || x.ordinal != y.ordinal ||
        x.sibling_count != y.sibling_count) return false;
  }
  return true;
}

inline std::string ElementTag(const blink::WebElement& element) {
  if (element.IsNull()) return {};
  std::string tag = base::ToLowerASCII(element.TagName().Utf8());
  if (!Tag(tag) || !element.HasHTMLTagName(blink::WebString::FromUtf8(tag)))
    return {};
  return tag;
}
inline std::string Attr(const blink::WebElement& element, std::string_view name) {
  return element.GetAttribute(blink::WebString::FromUtf8(name)).Utf8();
}
inline blink::WebElement AsElement(blink::WebNode node) {
  return node.IsNull() ? blink::WebElement() : node.DynamicTo<blink::WebElement>();
}

// Bounded light-tree traversal; no CSS or script parser and no unbounded query
// result. If the cap is reached, refuse to claim that an ID is unique.
class IdIndex {
 public:
  explicit IdIndex(const blink::WebDocument& document) {
    blink::WebNode root = document.DocumentElement();
    size_t visited = 0;
    for (blink::WebNode node = root; !node.IsNull();) {
      if (++visited > kMaxNodes) {
        nodes_.clear();
        return;
      }
      auto element = AsElement(node);
      if (!element.IsNull()) {
        std::string id = Attr(element, "id");
        if (Text(id, 128, false)) {
          auto [at, inserted] = nodes_.try_emplace(std::move(id), element);
          // Null is a definitive duplicate, never the first matching node.
          if (!inserted) at->second = blink::WebElement();
        }
      }
      if (!node.FirstChild().IsNull()) {
        node = node.FirstChild();
        continue;
      }
      while (node != root && node.NextSibling().IsNull())
        node = node.ParentNode();
      if (node == root) return;
      node = node.NextSibling();
    }
  }
  blink::WebElement Unique(const std::string& id) const {
    auto it = nodes_.find(id);
    return it == nodes_.end() ? blink::WebElement() : it->second;
  }

  bool TakeSiblingVisit() const {
    if (!sibling_visits_) return false;
    --sibling_visits_;
    return true;
  }

 private:
  // One bounded index per browser request, including all its restore rules.
  std::map<std::string, blink::WebElement> nodes_;
  mutable size_t sibling_visits_ = 8192;
};
inline wire::RawSColorStepPtr GetStep(const blink::WebElement& element) {
  if (element.IsNull()) return {};
  auto step = wire::RawSColorStep::New();
  step->tag = ElementTag(element);
  step->role = Attr(element, "role");
  // Check the input size before splitting. Never send or keep unbounded data.
  auto raw_classes = Attr(element, "class");
  if (raw_classes.size() > 800) return {};
  step->classes = base::SplitString(raw_classes, " \t\n\r\f",
                                    base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
  std::ranges::sort(step->classes);
  if (!ValidStep(*step)) return {};
  return step;
}
inline std::optional<std::vector<blink::WebElement>> MatchingSiblings(
    const blink::WebElement& parent, const wire::RawSColorStep& expected,
    const IdIndex& index) {
  if (parent.IsNull()) return std::nullopt;
  std::vector<blink::WebElement> matches;
  size_t visited = 0;
  for (auto n = parent.FirstChild(); !n.IsNull(); n = n.NextSibling()) {
    if (++visited > kMaxNodes || !index.TakeSiblingVisit()) return std::nullopt;
    auto element = AsElement(n);
    auto step = GetStep(element);
    if (step && SameStep(*step, expected)) matches.push_back(element);
  }
  return matches;
}
inline wire::RawSColorIdentityPtr Describe(
    const blink::WebElement& node, const blink::WebDocument& doc, const IdIndex& index) {
  if (node.IsNull() || !node.IsConnected() || node.GetDocument() != doc) return {};
  const auto root = doc.DocumentElement();
  if (root.IsNull() || node == root) return {};
  auto id = wire::RawSColorIdentity::New();
  id->tag = ElementTag(node);
  id->role = Attr(node, "role");
  id->id = Attr(node, "id");
  if (!Tag(id->tag) || !Text(id->id,128) || !Text(id->role,64)) return {};
  auto parent = AsElement(node.ParentNode());
  for (; !parent.IsNull() && parent != root; parent = AsElement(parent.ParentNode())) {
    if (id->ancestors.size() >= kMaxDepth - 1) return {};
    auto ancestor = wire::RawSColorAncestor::New();
    ancestor->tag = ElementTag(parent);
    ancestor->id = Attr(parent,"id");
    if (!Tag(ancestor->tag) || !Text(ancestor->id,128)) return {};
    id->ancestors.push_back(std::move(ancestor));
  }
  if (parent != root) return {};  // Includes closed/open shadow roots.
  std::reverse(id->ancestors.begin(),id->ancestors.end());
  if (!id->id.empty() && index.Unique(id->id) == node) {
    if (!ValidIdentity(*id)) return {};
    return id;
  }

  id->id.clear();
  id->locator = wire::RawSColorLocator::New();
  for (auto cursor = node; cursor != root; cursor = AsElement(cursor.ParentNode())) {
    if (cursor.IsNull() || id->locator->steps.size() >= kMaxDepth) return {};
    const std::string possible_anchor = Attr(cursor,"id");
    if (cursor != node && !possible_anchor.empty() &&
        Text(possible_anchor,128,false) && index.Unique(possible_anchor) == cursor) {
      id->locator->anchor_id = possible_anchor;
      break;
    }
    auto step = GetStep(cursor);
    if (!step) return {};
    auto matches = MatchingSiblings(AsElement(cursor.ParentNode()), *step, index);
    if (!matches || matches->empty()) return {};
    auto it = std::find(matches->begin(), matches->end(), cursor);
    if (it == matches->end()) return {};
    if (matches->size() > 1) {
      step->ordinal = static_cast<uint32_t>(it - matches->begin() + 1);
      step->sibling_count = static_cast<uint32_t>(matches->size());
    }
    id->locator->steps.push_back(std::move(step));
  }
  std::reverse(id->locator->steps.begin(),id->locator->steps.end());
  if (!ValidIdentity(*id)) return {};
  return id;
}
inline blink::WebElement Match(const wire::RawSColorIdentity& id,
                               const blink::WebDocument& doc, const IdIndex& index) {
  if (!ValidIdentity(id)) return {};
  blink::WebElement node;
  if (!id.id.empty()) node = index.Unique(id.id);
  else {
    node = id.locator->anchor_id.empty()
        ? doc.DocumentElement() : index.Unique(id.locator->anchor_id);
    for (const auto& step : id.locator->steps) {
      auto matches = MatchingSiblings(node, *step, index);
      if (!matches) return {};
      if (step->ordinal == 0) {
        if (matches->size() != 1) return {};
        node = matches->front();
      } else {
        if (matches->size() != step->sibling_count) return {};
        node = (*matches)[step->ordinal - 1];
      }
    }
  }
  auto actual = Describe(node,doc,index);
  return actual && SameIdentity(*actual,id) ? node : blink::WebElement();
}

