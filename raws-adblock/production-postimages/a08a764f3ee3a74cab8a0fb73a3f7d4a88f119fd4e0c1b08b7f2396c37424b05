bool CanObserveColorTargets(const Document& document) {
  const Settings* settings = document.GetSettings();
  return document.IsActive() && settings && settings->GetForceDarkModeEnabled() &&
         !document.InForcedColorsMode() && document.documentElement();
}
// Avoid whole-document effects and effects spanning separate rendering contexts.
bool CanCompositeArtwork(const Element& element) {
  auto crosses_boundary = [](const Element& e) {
    return e.GetShadowRoot() || e.IsFrameOwnerElement() ||
           e.HasTagName(html_names::kObjectTag) ||
           e.HasTagName(html_names::kEmbedTag);
  };
  if (&element == element.GetDocument().documentElement() ||
      element.HasTagName(html_names::kBodyTag) || crosses_boundary(element)) {
    return false;
  }
  unsigned count = 0;
  for (const Element& child : ElementTraversal::DescendantsOf(element)) {
    if (++count > 64 || crosses_boundary(child)) return false;
  }
  return true;
}

void ApplyArtwork(const Element& element, uint32_t rgb,
                  ComputedStyleBuilder& builder) {
  if (element.HasTagName(html_names::kImgTag)) {
    builder.SetSandiumImageForeground(0xff000000u | rgb);
    return;
  }
  const unsigned red = (rgb >> 16) & 255u;
  const unsigned green = (rgb >> 8) & 255u;
  const unsigned blue = rgb & 255u;
  if (CanCompositeArtwork(element) && builder.Display() != EDisplay::kContents) {
    // An opaque RGB constant with the original alpha for each pixel. Appending
    // to the native operations retains any authored filters and never loads
    // a URL/resource. A fresh style builder receives at most one such effect.
    Vector<float> matrix{
        0, 0, 0, 0, red / 255.f,
        0, 0, 0, 0, green / 255.f,
        0, 0, 0, 0, blue / 255.f,
        0, 0, 0, 1, 0,
    };
    builder.MutableFilterOperations().push_back(
        MakeGarbageCollected<ColorMatrixFilterOperation>(
            std::move(matrix), FilterOperation::OperationType::kColorMatrix));
    return;
  }

  // Structural selections still get a colorable own-box affordance, never a
  // document-wide tint, embedded document tint, or inherited descendant CSS.
  // Keep the browser/author's outline geometry if it already has one.
  builder.SetOutlineColor(StyleColor(Color(red, green, blue)));
  if (builder.OutlineStyle() == EBorderStyle::kNone) {
    builder.SetOutlineStyle(EBorderStyle::kSolid);
    builder.SetOutlineWidth(1);
  }
}
