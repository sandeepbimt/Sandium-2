class SandiumElementColors::TargetObserver final
    : public MutationObserver::Delegate {
 public:
  TargetObserver(Document& document, base::RepeatingClosure changed);
  ~TargetObserver() override;
  ExecutionContext* GetExecutionContext() const override;
  void Deliver(const MutationRecordVector&, MutationObserver&) override;
  void Trace(Visitor*) const override;
  void Disconnect();

 private:
  WeakMember<Document> document_;
  Member<MutationObserver> observer_;
  base::RepeatingClosure changed_;
};

SandiumElementColors::TargetObserver::TargetObserver(
    Document& document, base::RepeatingClosure changed)
    : document_(&document),
      observer_(MutationObserver::Create(this)),
      changed_(std::move(changed)) {
  auto* options = MutationObserverInit::Create();
  options->setChildList(true);
  options->setSubtree(true);
  options->setAttributes(true);
  options->setAttributeFilter(
      Vector<String>{String("id"), String("class"), String("role")});
  observer_->observe(document.documentElement(), options, ASSERT_NO_EXCEPTION);
}

SandiumElementColors::TargetObserver::~TargetObserver() = default;

ExecutionContext* SandiumElementColors::TargetObserver::GetExecutionContext() const {
  return document_ ? document_->GetExecutionContext() : nullptr;
}

void SandiumElementColors::TargetObserver::Deliver(
    const MutationRecordVector& records, MutationObserver&) {
  if (!document_ || !CanObserveColorTargets(*document_)) {
    Disconnect();
    return;
  }
  // Do not examine or export page text or mutation records.
  if (!records.empty() && changed_) changed_.Run();
}

void SandiumElementColors::TargetObserver::Disconnect() {
  changed_.Reset();
  if (observer_) observer_->disconnect();
  observer_.Clear();
}

void SandiumElementColors::TargetObserver::Trace(Visitor* visitor) const {
  visitor->Trace(document_);
  visitor->Trace(observer_);
  MutationObserver::Delegate::Trace(visitor);
}

bool SandiumElementColors::ObserveTargets(
    Document& document, base::RepeatingClosure changed) {
  StopObservingTargets();
  if (!changed || !CanObserveColorTargets(document)) return false;
  target_observer_ = MakeGarbageCollected<TargetObserver>(document, std::move(changed));
  return true;
}

void SandiumElementColors::StopObservingTargets() {
  if (target_observer_) target_observer_->Disconnect();
  target_observer_.Clear();
}

const char SandiumElementColors::kSupplementName[] = "SandiumElementColors";
SandiumElementColors::SandiumElementColors(Document& document)
    : Supplement<Document>(document) {}
SandiumElementColors* SandiumElementColors::GetIfExists(Document& document) {
  return Supplement<Document>::From<SandiumElementColors>(document);
}
SandiumElementColors& SandiumElementColors::From(Document& document) {
  auto* value = GetIfExists(document);
  if (!value) {
    value = MakeGarbageCollected<SandiumElementColors>(document);
    Supplement<Document>::ProvideTo(document, value);
  }
  return *value;
}
bool SandiumElementColors::Valid(int property, uint32_t rgb) {
  return (property == 0 || property == 1 || property == 2) && rgb <= 0xffffff;
}
bool SandiumElementColors::Eligible(const Element& element) const {
  const Document& document = element.GetDocument();
  // A browser-owned manual selection may style any hit element in the active
  // page document. Never enter a separate document or an internal shadow tree.
  return &document == GetSupplementable() && document.IsInOutermostMainFrame() &&
         document.IsActive() && document.Url().ProtocolIsInHttpFamily() &&
         element.isConnected() && !element.IsInShadowTree();
}
bool SandiumElementColors::CanCorrect(const Element& element) const {
  const Settings* settings = element.GetDocument().GetSettings();
  return settings && settings->GetForceDarkModeEnabled() &&
         !element.GetDocument().InForcedColorsMode() && Eligible(element);
}
void SandiumElementColors::Invalidate(Element& element) {
  element.SetNeedsStyleRecalc(kSubtreeStyleChange,
      StyleChangeReasonForTracing::Create(style_change_reason::kInspector));
}
void SandiumElementColors::Prune() {
  for (wtf_size_t i = saved_.size(); i > 0; --i) {
    if (!saved_[i - 1]->element || !Eligible(*saved_[i - 1]->element))
      saved_.EraseAt(i - 1);
  }
}
bool SandiumElementColors::Preview(Element& element, int property, uint32_t rgb) {
  if (!Valid(property, rgb) || !CanCorrect(element)) return false;
  CancelPreview();
  preview_ = MakeGarbageCollected<Entry>(&element);
  (property == 0 ? preview_->foreground :
      property == 1 ? preview_->background : preview_->image_foreground) = rgb;
  Invalidate(element);
  return true;
}
bool SandiumElementColors::Commit(Element& element, int property, uint32_t rgb) {
  if (!Valid(property, rgb) || !CanCorrect(element)) return false;
  Prune();
  Entry* entry = nullptr;
  for (const auto& candidate : saved_) {
    if (candidate->element == &element) { entry = candidate.Get(); break; }
  }
  if (!entry) {
    if (saved_.size() >= 32) return false;
    entry = MakeGarbageCollected<Entry>(&element);
    saved_.push_back(entry);
  }
  (property == 0 ? entry->foreground :
      property == 1 ? entry->background : entry->image_foreground) = rgb;
  // Same renderer task: style cannot paint between the saved change and preview clear.
  CancelPreview();
  Invalidate(element);
  return true;
}
void SandiumElementColors::ArtworkStructureChanged(const Element& changed) {
  // Recheck before drawing after structure changes, including shadow attachment.
  // Only existing exact targets can be invalidated; no new nodes are selected.
  auto refresh = [&](Entry* entry) {
    if (entry && entry->element && entry->image_foreground &&
        !entry->element->HasTagName(html_names::kImgTag) &&
        entry->element->contains(&changed)) {
      Invalidate(*entry->element);
    }
  };
  refresh(preview_.Get());
  for (const auto& entry : saved_) refresh(entry.Get());
}

void SandiumElementColors::CancelPreview() {
  if (preview_ && preview_->element) Invalidate(*preview_->element);
  preview_ = nullptr;
}
void SandiumElementColors::Remove(Element& element) {
  bool removed_override = preview_ && preview_->element == &element;
  if (removed_override) preview_ = nullptr;
  for (wtf_size_t i = saved_.size(); i > 0; --i) {
    const auto& entry = saved_[i - 1];
    if (entry->element == &element) removed_override = true;
    if (!entry->element || entry->element == &element)
      saved_.EraseAt(i - 1);
  }
  // Atomic moves retain computed style. Invalidate only actually corrected
  // nodes affected by an atomic move; never other nodes in the document.
  if (removed_override && element.GetDocument().StatePreservingAtomicMoveInProgress())
    Invalidate(element);
}
void SandiumElementColors::Clear() {
  CancelPreview();
  for (const auto& entry : saved_) if (entry->element) Invalidate(*entry->element);
  saved_.clear();
}
void SandiumElementColors::ApplyEntry(const Entry& entry, ComputedStyleBuilder& builder) {
  auto color = [](uint32_t rgb) { return StyleColor(Color((rgb >> 16) & 255,
      (rgb >> 8) & 255, rgb & 255)); };
  if (entry.foreground) {
    builder.SetColor(color(*entry.foreground));
    builder.SetInternalVisitedColor(color(*entry.foreground));
  }
  if (entry.background) builder.SetBackgroundColor(color(*entry.background));
}
void SandiumElementColors::Apply(Element& element, ComputedStyleBuilder& builder) {
  bool has_override = preview_ && preview_->element == &element;
  for (const auto& entry : saved_) has_override |= entry->element == &element;
  if (!has_override) return;
  if (!Eligible(element)) {
    // Never revive a correction after an observed eligibility loss.
    if (preview_ && preview_->element == &element) preview_ = nullptr;
    for (wtf_size_t i = saved_.size(); i > 0; --i)
      if (!saved_[i - 1]->element || saved_[i - 1]->element == &element) saved_.EraseAt(i - 1);
    return;
  }
  // Explicit Dark Pages OFF suppresses manual colours too. Keep saved_/preview_
  // intact so enabling the policy restores them during the next style recalc.
  // The setting invalidates Style and Paint; fresh style builders contain the
  // authored values, not the previous corrected foreground/background/image.
  const Settings* settings = element.GetDocument().GetSettings();
  if (!settings || !settings->GetForceDarkModeEnabled() ||
      builder.InForcedColorsMode()) {
    return;
  }
  // This runs after native adjustments in the uncacheable per-element path.
  // It never overrules the browser's Forced Colors accessibility mode.
  bool has_surface_override = preview_ && preview_->element == &element &&
      (preview_->foreground || preview_->background);
  for (const auto& entry : saved_)
    if (entry->element == &element)
      has_surface_override |= entry->foreground.has_value() || entry->background.has_value();
  // An image-only tint must not change the element/page background dark policy.
  if (has_surface_override) {
    builder.SetSandiumManualColorOverride(true);
  }
  std::optional<uint32_t> artwork;
  for (const auto& entry : saved_) {
    if (entry->element == &element) {
      ApplyEntry(*entry, builder);
      artwork = entry->image_foreground;
    }
  }
  if (preview_ && preview_->element == &element) {
    ApplyEntry(*preview_, builder);
    if (preview_->image_foreground) artwork = preview_->image_foreground;
  }
  if (artwork) ApplyArtwork(element, *artwork, builder);
}
void SandiumElementColors::Trace(Visitor* visitor) const {
  visitor->Trace(saved_);
  visitor->Trace(preview_);
  visitor->Trace(target_observer_);
  Supplement<Document>::Trace(visitor);
}
