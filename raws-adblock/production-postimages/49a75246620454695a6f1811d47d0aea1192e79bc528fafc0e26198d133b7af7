import org.chromium.chrome.browser.settings.RawsProtectionCopy.AdSubscriptionState;
import org.chromium.chrome.browser.signin.FullscreenSigninAndHistorySyncActivityBase;
import org.chromium.chrome.browser.ui.desktop_windowing.BasicAppHeaderStateProvider;
import org.chromium.components.browser_ui.desktop_windowing.AppHeaderStateProvider;
import org.chromium.components.browser_ui.widget.gesture.BackPressHandler;

/** Base class for First Run Experience. */
@NullMarked
public abstract class FirstRunActivityBase extends FullscreenSigninAndHistorySyncActivityBase
        implements BackPressHandler {
    private static final String TAG = "FirstRunActivity";

    public static final String EXTRA_COMING_FROM_CHROME_ICON = "Extra.ComingFromChromeIcon";
    public static final String EXTRA_CHROME_LAUNCH_INTENT_IS_CCT =
            "Extra.FreChromeLaunchIntentIsCct";
    public static final String EXTRA_FRE_INTENT_CREATION_ELAPSED_REALTIME_MS =
            "Extra.FreIntentCreationElapsedRealtimeMs";

    // The intent to send once the FRE completes.
    public static final String EXTRA_FRE_COMPLETE_LAUNCH_INTENT = "Extra.FreChromeLaunchIntent";

    // Use PendingIntent (as opposed to Intent) to start activity after FRE completion.
    // TODO(crbug.com/381107767): Always use Intent. For now, only Custom Tab uses Intent.
    public static final String EXTRA_FRE_USE_PENDING_INTENT = "Extra.FreUsePendingIntent";

    // The extras on the intent which initiated first run. (e.g. the extras on the intent
    // received by ChromeLauncherActivity.)
    public static final String EXTRA_CHROME_LAUNCH_INTENT_EXTRAS =
            "Extra.FreChromeLaunchIntentExtras";
    static final String SHOW_SEARCH_ENGINE_PAGE = "ShowSearchEnginePage";
    static final String SHOW_HISTORY_SYNC_PAGE = "ShowHistorySync";

    public static final boolean DEFAULT_METRICS_AND_CRASH_REPORTING = true;

    private boolean mNativeInitialized;
    private boolean mRawSProtectionResumed;
    private boolean mRawSProtectionReleased;
    private final Handler mRawSProtectionUi = new Handler(Looper.getMainLooper());
    private final Runnable mRawSProtectionPoll = this::pollRawSProtection;
    private @Nullable Runnable mRawSProtectionContinuation;
    private @Nullable AlertDialog mRawSProtectionDialog;
    private long mRawSLastRetryMs = -1000;
    private @Nullable CharSequence mRawSLastProtectionMessage;
    private @Nullable AppHeaderStateProvider mAppHeaderStateProvider;

    @Override
    protected boolean requiresFirstRunToBeCompleted(Intent intent) {
        // The user is already in First Run.
        return false;
    }

    // Activity:
    @Override
    public void onPostCreate() {
        super.onPostCreate();
        if (VERSION.SDK_INT >= VERSION_CODES.R) {
            mAppHeaderStateProvider = createAppHeaderStateProvider();
        }
    }

    @RequiresApi(VERSION_CODES.R)
    protected @Nullable AppHeaderStateProvider createAppHeaderStateProvider() {
        return new BasicAppHeaderStateProvider(this, getInsetObserver());
    }

    @Override
    public void onPause() {
        mRawSProtectionResumed = false;
        mRawSProtectionUi.removeCallbacks(mRawSProtectionPoll);
        super.onPause();
        // As with onResume() below, for historical reasons the FRE has been able to report
        // background time before post-native initialization, unlike other activities. See
        // http://crrev.com/436530.
        UmaUtils.recordBackgroundTimeWithNative();
        flushPersistentData();
    }

    @Override
    public void onResume() {
        SimpleStartupForegroundSessionDetector.discardSession();
        super.onResume();
        // Since the FRE may be shown before any tab is shown, mark that this is the point at which
        // Chrome went to foreground. Other activities can only
        // recordForegroundStartTimeWithNative() after the post-native initialization has started.
        // See http://crrev.com/436530.
        UmaUtils.recordForegroundStartTimeWithNative();
        mRawSProtectionResumed = true;
        if (mRawSProtectionContinuation != null) {
            mRawSProtectionUi.post(mRawSProtectionPoll);
        }
    }

    @Override
    public void onDestroy() {
        mRawSProtectionContinuation = null;
        mRawSProtectionUi.removeCallbacks(mRawSProtectionPoll);
        dismissRawSProtectionDialog();
        super.onDestroy();
    }

    static boolean isRawSProtectionReady(RawsProtectionCopy.AdSubscriptionState state) {
        return state.phase == RawsProtectionCopy.AD_FILTER_READY
                && state.enabled > 0
                && state.cached == state.enabled
                && state.active == state.enabled
                && RawsProtectionCopy.adFilteringPhase() == RawsProtectionCopy.AD_FILTER_READY;
    }

    CharSequence rawSProtectionMessage(
            @Nullable AdSubscriptionState state) {
        if (state != null && isRawSProtectionReady(state)) {
            return getString(R.string.raws_setup_ready, state.enabled);
        }
        int enabled = state == null ? 0 : state.enabled;
        if (enabled > 0 && state != null && state.cached < enabled && isRawSOffline()) {
            return getString(R.string.raws_setup_offline, state.cached, enabled);
        }
        if (RawsProtectionCopy.adFilteringPhase() == RawsProtectionCopy.AD_FILTER_FAILED) {
            return getString(R.string.raws_setup_bundled_failed);
        }
        if (state != null && state.phase == RawsProtectionCopy.AD_FILTER_FAILED) {
            return getString(R.string.raws_setup_failed);
        }
        if (enabled > 0 && state != null) {
            return getString(R.string.raws_setup_counts, state.active, enabled);
        }
        return getString(isRawSOffline()
                ? R.string.raws_setup_offline_unknown : R.string.raws_setup_preparing);
    }

    boolean canRetryRawSProtection(@Nullable AdSubscriptionState state) {
        return state != null && state.phase == RawsProtectionCopy.AD_FILTER_FAILED
                && RawsProtectionCopy.adFilteringPhase() == RawsProtectionCopy.AD_FILTER_READY
                && !isRawSOffline();
    }

    private boolean isRawSOffline() {
        ConnectivityManager manager = getSystemService(ConnectivityManager.class);
        if (manager == null) return false;
        try {
            return manager.getActiveNetwork() == null;
        } catch (SecurityException ignored) {
            // No permission to classify; keep backend status authoritative.
            return false;
        }
    }

    private @Nullable Profile getRawSReadinessProfile() {
        if (!mNativeInitialized) return null;
        var provider = getProfileProviderSupplier().get();
        return provider == null ? null : provider.getOriginalProfile();
    }

    /**
     * Gate only RawS's own first-run completion. The stock intent remains untouched in the
     * originating Activity and no completed/skipped marker may be written while this waits.
     */
    final boolean waitForRawSProtection(Runnable continuation) {
        if (!"io.github.sandeepbimt.raws".equals(getPackageName()) || DeviceInfo.isAutomotive()) {
            return false;
        }
        if (mRawSProtectionReleased) return true;
        Profile profile = getRawSReadinessProfile();
        if (mRawSProtectionResumed && profile != null
                && isRawSProtectionReady(RawsProtectionCopy.adSubscriptionState(profile))) {
            mRawSProtectionReleased = true;
            mRawSProtectionContinuation = null;
            mRawSProtectionUi.removeCallbacks(mRawSProtectionPoll);
            dismissRawSProtectionDialog();
            return false;
        }
        if (mRawSProtectionContinuation == null && !isFinishing() && !isDestroyed()) {
            mRawSProtectionContinuation = continuation;
            mRawSProtectionUi.post(mRawSProtectionPoll);
        }
        return true;
    }

    private void pollRawSProtection() {
        Runnable continuation = mRawSProtectionContinuation;
        if (!mRawSProtectionResumed || isFinishing() || isDestroyed() || continuation == null) {
            return;
        }
        Profile profile = getRawSReadinessProfile();
        var state = profile == null ? null : RawsProtectionCopy.adSubscriptionState(profile);
        if (state != null && isRawSProtectionReady(state)) {
            mRawSProtectionContinuation = null;
            dismissRawSProtectionDialog();
            continuation.run(); // Rechecks current native state before crossing the normal exit.
            return;
        }
        if (mRawSProtectionDialog == null) {
            mRawSProtectionDialog = new AlertDialog.Builder(this)
                    .setTitle(R.string.raws_setup_wait_title)
                    .setMessage(rawSProtectionMessage(state))
                    .setPositiveButton(R.string.raws_setup_retry, null)
                    .setNegativeButton(android.R.string.cancel, (dialog, which) -> cancelRawSWait())
                    .setOnCancelListener(dialog -> cancelRawSWait())
                    .create();
            mRawSProtectionDialog.setCanceledOnTouchOutside(false);
            mRawSProtectionDialog.show();
            mRawSProtectionDialog.getButton(AlertDialog.BUTTON_POSITIVE)
                    .setOnClickListener(view -> {
                        Profile original = getRawSReadinessProfile();
                        if (mRawSProtectionResumed && original != null && canRetryRawSProtection(
                                    RawsProtectionCopy.adSubscriptionState(original))
                                && canRetryRawSNow()) {
                            mRawSLastRetryMs = SystemClock.uptimeMillis();
                            if (!RawsProtectionCopy.retryAdSubscriptions(original)) {
                                android.widget.Toast.makeText(FirstRunActivityBase.this,
                                        R.string.raws_setup_retry_unavailable,
                                        android.widget.Toast.LENGTH_SHORT).show();
                            }
                        }
                    });
        }
        CharSequence message = rawSProtectionMessage(state);
        if (!android.text.TextUtils.equals(message, mRawSLastProtectionMessage)) {
            mRawSProtectionDialog.setMessage(message);
            mRawSLastProtectionMessage = message;
        }
        mRawSProtectionDialog.getButton(AlertDialog.BUTTON_POSITIVE)
                .setEnabled(canRetryRawSProtection(state) && canRetryRawSNow());
        mRawSProtectionUi.postDelayed(mRawSProtectionPoll, 400);
    }

    private boolean canRetryRawSNow() {
        return SystemClock.uptimeMillis() - mRawSLastRetryMs >= 1000;
    }

    private void cancelRawSWait() {
        mRawSProtectionContinuation = null;
        mRawSProtectionUi.removeCallbacks(mRawSProtectionPoll);
        dismissRawSProtectionDialog();
        finish();
        notifyCustomTabCallbackFirstRunIfNecessary(getIntent(), false);
    }

    private void dismissRawSProtectionDialog() {
        AlertDialog dialog = mRawSProtectionDialog;
        mRawSProtectionDialog = null;
        mRawSLastProtectionMessage = null;
        if (dialog != null) dialog.dismiss();
    }

    @Override
    public void finishNativeInitialization() {
        super.finishNativeInitialization();
        mNativeInitialized = true;
    }

    protected void flushPersistentData() {
        if (mNativeInitialized) {
            ProfileManagerUtils.flushPersistentDataForAllProfiles();
        }
    }

    /**
     * Sends Intent (or PendingIntent) included with the EXTRA_FRE_COMPLETE_LAUNCH_INTENT extra.
     *
     * @return Whether an intent was sent.
     */
    protected final boolean sendFirstRunCompleteIntent() {
        boolean usePendingIntent =
                IntentUtils.safeGetBooleanExtra(getIntent(), EXTRA_FRE_USE_PENDING_INTENT, true);
        return usePendingIntent
                ? sendFirstRunCompletePendingIntent()
                : sendFirstRunCompleteOriginalIntent();
    }

    private boolean sendFirstRunCompletePendingIntent() {
        PendingIntent pendingIntent =
                IntentUtils.safeGetParcelableExtra(getIntent(), EXTRA_FRE_COMPLETE_LAUNCH_INTENT);
        if (pendingIntent == null) return false;

        try {
            PendingIntent.OnFinished onFinished = null;
            boolean pendingIntentIsCct =
                    IntentUtils.safeGetBooleanExtra(
                            getIntent(), EXTRA_CHROME_LAUNCH_INTENT_IS_CCT, false);
            if (pendingIntentIsCct) {
                // After the PendingIntent has been sent, send a first run callback to custom tabs
                // if necessary.
                onFinished =
                        (_, _, _, _, _) -> {
                            // Use {@link FirstRunActivityBase#getIntent()} instead of {@link
                            // intent} parameter in order to use a more similar code path for
                            // completing first run and for aborting first run.
                            notifyCustomTabCallbackFirstRunIfNecessary(getIntent(), true);
                        };
            }

            // Use the PendingIntent to send the intent that originally launched Chrome. The intent
            // will go back to the ChromeLauncherActivity, which will route it accordingly.
            ActivityOptions options = makeOptionsForPendingIntent();
            if (options != null) {
                pendingIntent.send(
                        this,
                        Activity.RESULT_OK,
                        /* intent= */ null,
                        onFinished,
                        /* handler= */ null,
                        /* requiredPermission= */ null,
                        options.toBundle());
            } else {
                pendingIntent.send(Activity.RESULT_OK, onFinished, /* handler= */ null);
            }

            // Use fade-out animation for the transition from this activity to the original intent.
            overridePendingTransition(android.R.anim.fade_in, android.R.anim.fade_out);
            return true;
        } catch (CanceledException e) {
            Log.e(TAG, "Unable to send PendingIntent.", e);
        }
        return false;
    }

    private @Nullable ActivityOptions makeOptionsForPendingIntent() {
        boolean isFeatureListInitialized = FeatureList.isNativeInitialized();
        if (!isFeatureListInitialized) {
            Log.w(TAG, "Pending intent sent before feature list initialized.");
            return null;
        }

        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.R
                || !ChromeFeatureList.isEnabled(
                        ChromeFeatureList.ANDROID_FIRST_RUN_LAUNCH_BOUNDS)) {
            return null;
        }

        boolean isInDesktopWindow =
                mAppHeaderStateProvider != null
                        && mAppHeaderStateProvider.getAppHeaderState() != null
                        && mAppHeaderStateProvider.getAppHeaderState().isInDesktopWindow();
        if (!isInDesktopWindow) {
            return null;
        }

        ActivityOptions options = ActivityOptions.makeBasic();
        WindowMetrics windowMetrics = getWindow().getWindowManager().getCurrentWindowMetrics();
        options.setLaunchBounds(windowMetrics.getBounds());
        return options;
    }

    /**
     * Sends the original Intent included with the EXTRA_FRE_COMPLETE_LAUNCH_INTENT extra.
     *
     * @return Whether an intent was sent.
     */
    private boolean sendFirstRunCompleteOriginalIntent() {
        Intent intent =
                IntentUtils.safeGetParcelableExtra(getIntent(), EXTRA_FRE_COMPLETE_LAUNCH_INTENT);
        if (intent == null) return false;

        try {
            // Certain types of CCT (namely AuthTab) needs to forward the activity result back
            // to the client app.
            intent.addFlags(Intent.FLAG_ACTIVITY_FORWARD_RESULT);
            intent.setFlags(intent.getFlags() & ~Intent.FLAG_ACTIVITY_NEW_TASK);
            startActivity(intent);

            // Use {@link FirstRunActivityBase#getIntent()} instead of {@link intent} parameter in
            // order to use a more similar code path for completing first run and for aborting
            // first run.
            notifyCustomTabCallbackFirstRunIfNecessary(getIntent(), true);

            // Use fade-out animation for the transition from this activity to the original intent.
            overridePendingTransition(android.R.anim.fade_in, android.R.anim.fade_out);
            return true;
        } catch (ActivityNotFoundException e) {
            Log.e(TAG, "Unable to send Intent.", e);
        }
        return false;
    }

    /**
     * If the first run activity was triggered by a custom tab, notify app associated with custom
     * tab whether first run was completed.
     *
     * @param freIntent First run activity intent.
     * @param complete Whether first run completed successfully.
     */
    public static void notifyCustomTabCallbackFirstRunIfNecessary(
            Intent freIntent, boolean complete) {
        boolean launchedByCct =
                IntentUtils.safeGetBooleanExtra(
                        freIntent, EXTRA_CHROME_LAUNCH_INTENT_IS_CCT, false);
        if (!launchedByCct) return;

        Bundle launchIntentExtras =
                IntentUtils.safeGetBundleExtra(freIntent, EXTRA_CHROME_LAUNCH_INTENT_EXTRAS);
        CustomTabsConnection.getInstance()
                .sendFirstRunCallbackIfNecessary(launchIntentExtras, complete);
    }
}
