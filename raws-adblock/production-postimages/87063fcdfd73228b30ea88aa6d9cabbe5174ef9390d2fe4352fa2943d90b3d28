#ifndef CHROME_COMMON_RAWS_PROCEDURAL_COSMETIC_RULES_H_
#define CHROME_COMMON_RAWS_PROCEDURAL_COSMETIC_RULES_H_

#include <cstdint>
#include <string_view>

#include "url/gurl.h"

namespace raws::cosmetic {

// Only independently reviewed, checked-in exact-page decisions belong here.
// A numeric ID is never reused for a different rule. Zero only clears paint.
// No network list, renderer observations or query strings enter executable code.
inline constexpr uint32_t kAmazonSearchSponsoredCard = 1;
inline constexpr char kAmazonHost[] = "www.amazon.com";
inline constexpr char kAmazonRuleConfig[] =
    R"RAWS(["https://www.amazon.com","/s","s-results-list-atf","div","s-result-item","div","s-item-container","h5","s-sponsored-list-header","sponsored"])RAWS";
inline constexpr char kAmazonRuleCssBeforeNonce[] =
    "#s-results-list-atf > div.s-result-item[data-raws-procedural-ad-card=\"";
inline constexpr char kAmazonRuleCssAfterNonce[] =
    "\"]:not(:has(form,input,select,textarea,button,iframe,dialog,"
    "[role=dialog i],[role=alertdialog i],[aria-modal],[contenteditable]))"
    "{display:none!important;}";

inline bool MayHaveProceduralCosmetic(const GURL& url) {
  return url.is_valid() && url.SchemeIs("https") &&
         !url.has_username() && !url.has_password() && !url.has_port() &&
         url.host() == kAmazonHost;
}

inline uint32_t RuleForDocument(const GURL& url) {
  if (!MayHaveProceduralCosmetic(url) || url.path() != "/s" || url.has_ref())
    return 0;
  const std::string_view query = url.query();
  if (!query.starts_with("k=") || query.size() <= 2 || query.size() > 512 ||
      query.find_first_of("&;") != std::string_view::npos)
    return 0;
  return kAmazonSearchSponsoredCard;
}

}  // namespace raws::cosmetic

#endif  // CHROME_COMMON_RAWS_PROCEDURAL_COSMETIC_RULES_H_
