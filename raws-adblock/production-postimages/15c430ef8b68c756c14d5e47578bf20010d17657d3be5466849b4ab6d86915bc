package org.chromium.chrome.browser.sandium.video;

import android.content.Context;
import android.view.MotionEvent;
import android.view.View;
import android.view.ViewConfiguration;

/**
 * Opt-in surface above an already playing Chromium fullscreen video, never a second player.
 * The owner must detach this view and cancel on tab/navigation/fullscreen/PiP/lifecycle changes.
 * Visible accessible buttons outside this surface must expose Play/Pause and Return to site controls.
 */
public final class SandiumVideoGestureView extends View {
    public interface Host {
        /** Recheck tab, WebContents, fullscreen video and MediaSession before each action. */
        boolean isEligible();
        /** Changes on tab, video/session replacement, navigation and fullscreen/lifecycle changes. */
        long generation();
        /** Finite duration, known position and currently supported seeking, not inferred from URL. */
        boolean canSeek();
        void togglePlayback();
        /** Tap wakes the controls. Play/pause remains an explicit accessible button. */
        void onTap();
        void seekBy(long milliseconds);
        /** Capture window brightness and STREAM_MUSIC volume once per gesture. */
        void beginAdjustment();
        /** Preview only: called on moves; no playback seeks or setting writes until release. */
        void preview(SandiumVideoGestureState.Kind kind, double delta);
        /** Host clamps against captured values and the system's current valid ranges. */
        void adjustBrightness(double fraction);
        void adjustVolume(double fraction);
        void clearPreview();
    }

    private final Host mHost;
    private final SandiumVideoGestureState mState;
    private boolean mTracking;
    private long mGeneration;

    public SandiumVideoGestureView(Context context, Host host) {
        super(context);
        mHost = host;
        float density = getResources().getDisplayMetrics().density;
        mState = new SandiumVideoGestureState(
                ViewConfiguration.get(context).getScaledTouchSlop(), 24 * density);
        // Gesture surface has no semantic action; real accessible buttons are owned by the host.
        setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_NO);
    }

    @Override
    public boolean onTouchEvent(MotionEvent event) {
        if (!mHost.isEligible() || (mTracking && mGeneration != mHost.generation())) {
            cancelGesture(); return false;
        }
        switch (event.getActionMasked()) {
            case MotionEvent.ACTION_DOWN:
                mTracking = mState.down(event.getX(), event.getY(), getWidth(), getHeight(),
                        event.getEventTime());
                if (mTracking) {
                    mGeneration = mHost.generation();
                    mHost.beginAdjustment();
                }
                return mTracking;
            case MotionEvent.ACTION_POINTER_DOWN:
            case MotionEvent.ACTION_CANCEL:
                boolean wasTracking = mTracking;
                cancelGesture();
                return wasTracking;
            case MotionEvent.ACTION_MOVE:
                if (!mTracking) return false;
                var preview = mState.move(event.getX(), event.getY(), event.getPointerCount(),
                        mHost.canSeek());
                mHost.preview(preview.kind, preview.delta);
                return true;
            case MotionEvent.ACTION_UP:
                if (!mTracking) return false;
                var result = mState.up(event.getX(), event.getY(), event.getEventTime(),
                        mHost.canSeek());
                mTracking = false;
                mHost.clearPreview();
                if (!result.commit || !mHost.isEligible() || mGeneration != mHost.generation()) {
                    return true;
                }
                switch (result.kind) {
                    case TAP: performClick(); break;
                    case SEEK:
                        long delta = Math.round(result.delta);
                        if (delta != 0 && mHost.canSeek()) mHost.seekBy(delta);
                        break;
                    case BRIGHTNESS: mHost.adjustBrightness(result.delta); break;
                    case VOLUME: mHost.adjustVolume(result.delta); break;
                    default: break;
                }
                return true;
            default:
                return mTracking;
        }
    }

    @Override
    public boolean performClick() {
        super.performClick();
        if (mHost.isEligible()) mHost.onTap();
        return true;
    }

    public void cancelGesture() {
        mTracking = false;
        mState.cancel();
        mState.forgetTap();
        mHost.clearPreview();
    }

    @Override
    protected void onSizeChanged(int width, int height, int oldWidth, int oldHeight) {
        cancelGesture();
        super.onSizeChanged(width, height, oldWidth, oldHeight);
    }

    @Override
    protected void onDetachedFromWindow() {
        cancelGesture();
        super.onDetachedFromWindow();
    }
}
