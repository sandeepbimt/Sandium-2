namespace {
constexpr char kRawSElementPicker[] = R"RAWSJS(// SPDX-License-Identifier: MPL-2.0
// Static input for a Chrome-owned isolated-world execution with awaited result.
// Only offers a candidate: actual mutation/persistence requires native confirm.
(() => new Promise(resolve => {
  const cancelKey = '__rawsCancelElementPicker';
  if (typeof globalThis[cancelKey] === 'function') globalThis[cancelKey]();
  if (!document.documentElement || document.contentType !== 'text/html') {
    resolve('');
    return;
  }
  const cover = document.createElement('div');
  cover.style.cssText = 'position:fixed!important;inset:0!important;z-index:2147483647!important;display:block!important;pointer-events:auto!important;';
  const shadow = cover.attachShadow({mode: 'closed'});
  const panel = document.createElement('div');
  panel.style.cssText = 'position:fixed;inset:0;background:rgba(200,168,111,.09);cursor:crosshair;pointer-events:auto;touch-action:none;';
  shadow.appendChild(panel);
  const exclude = 'html,body,input,textarea,select,button,form,label,a,iframe,frame,video,audio,object,embed,[contenteditable]';
  const identifier = /^[A-Za-z_][A-Za-z_0-9-]{0,63}$/;
  const safeTag = /^[a-z][a-z0-9-]{0,30}$/;
  let done = false, watchdog, initialTap = null;
  const settle = selection => {
    if (done) return;
    done = true;
    clearTimeout(watchdog);
    window.removeEventListener('pagehide', cancel);
    window.removeEventListener('keydown', escape, true);
    cover.remove();
    if (globalThis[cancelKey] === cancel) delete globalThis[cancelKey];
    resolve(selection);
  };
  const cancel = () => settle('');
  const stop = event => {
    event.preventDefault();
    event.stopImmediatePropagation();
  };
  const escape = event => {
    if (event.isTrusted && event.key === 'Escape') {
      stop(event);
      cancel();
    }
  };
  // Hit-test only the current main document. Interactive controls and frame
  // contents are not picker candidates; no script may choose its own target.
  const candidate = element => {
    if (!element || element.closest(exclude)) return '';
    if (identifier.test(element.id) && document.getElementById(element.id) === element)
      return '#' + element.id;
    const tag = element.localName;
    if (!safeTag.test(tag)) return '';
    for (const className of element.classList) {
      if (identifier.test(className)) return tag + '.' + className;
    }
    return '';
  };
  panel.addEventListener('pointerdown', event => {
    stop(event);
    if (event.isTrusted && event.isPrimary && event.button === 0)
      initialTap = {id: event.pointerId, x: event.clientX, y: event.clientY};
  }, true);
  panel.addEventListener('contextmenu', stop, true);
  panel.addEventListener('pointerup', event => {
    stop(event);
    if (!event.isTrusted || !event.isPrimary || event.button !== 0) return;
    const down = initialTap;
    initialTap = null;
    if (!down || event.pointerId !== down.id ||
        Math.hypot(event.clientX - down.x, event.clientY - down.y) > 12) return;
    cover.style.setProperty('pointer-events', 'none', 'important');
    panel.style.pointerEvents = 'none';
    const selected = candidate(document.elementFromPoint(event.clientX, event.clientY));
    // Defer disposal so Chromium's click synthesis cannot hit the page beneath
    // this same gesture. The covering node, not the page, receives the click.
    cover.style.setProperty('pointer-events', 'auto', 'important');
    panel.style.pointerEvents = 'auto';
    setTimeout(() => settle(selected), 0);
  }, true);
  panel.addEventListener('click', stop, true);
  panel.addEventListener('pointercancel', cancel, true);
  window.addEventListener('pagehide', cancel, {once: true});
  window.addEventListener('keydown', escape, true);
  globalThis[cancelKey] = cancel;
  watchdog = setTimeout(cancel, 15000);
  document.documentElement.appendChild(cover);
}))()
)RAWSJS";
}

void ChromeRenderFrameObserver::BeginRawSElementPicker(
    const base::UnguessableToken& token,
    BeginRawSElementPickerCallback callback) {
  auto* frame = render_frame()->GetWebFrame();
  if (!frame || frame->IsProvisional() ||
      frame->GetEmbeddingToken() != token) {
    std::move(callback).Run("");
    return;
  }
  auto doc = frame->GetDocument();
  if (doc.IsNull() || !doc.IsActive() || !doc.IsHTMLDocument()) {
    std::move(callback).Run("");
    return;
  }
  const blink::WebScriptSource sources[] = {
      blink::WebScriptSource(blink::WebString::FromUtf8(kRawSElementPicker))};
  frame->RequestExecuteScript(
      ISOLATED_WORLD_ID_CHROME_INTERNAL, sources,
      blink::mojom::UserActivationOption::kDoNotActivate,
      blink::mojom::EvaluationTiming::kAsynchronous,
      blink::mojom::LoadEventBlockingOption::kDoNotBlock,
      base::BindOnce(
          [](BeginRawSElementPickerCallback done,
             std::optional<base::Value> value, base::TimeTicks) {
            const std::string* selector = value ? value->GetIfString() : nullptr;
            std::move(done).Run(selector && selector->size() <= 97
                                    ? *selector
                                    : std::string());
          },
          std::move(callback)),
      blink::BackForwardCacheAware::kAllow,
      blink::mojom::WantResultOption::kWantResult,
      blink::mojom::PromiseResultOption::kAwait, blink::WebString());
}

void ChromeRenderFrameObserver::CancelRawSElementPicker(
    const base::UnguessableToken& token) {
  auto* frame = render_frame()->GetWebFrame();
  if (!frame || frame->IsProvisional() ||
      frame->GetEmbeddingToken() != token) return;
  const blink::WebScriptSource sources[] = {blink::WebScriptSource(
      blink::WebString::FromUtf8(
          "if (typeof globalThis.__rawsCancelElementPicker === 'function') "
          "globalThis.__rawsCancelElementPicker();"))};
  frame->RequestExecuteScript(
      ISOLATED_WORLD_ID_CHROME_INTERNAL, sources,
      blink::mojom::UserActivationOption::kDoNotActivate,
      blink::mojom::EvaluationTiming::kAsynchronous,
      blink::mojom::LoadEventBlockingOption::kDoNotBlock,
      blink::WebScriptExecutionCallback(), blink::BackForwardCacheAware::kAllow,
      blink::mojom::WantResultOption::kNoResult,
      blink::mojom::PromiseResultOption::kDoNotWait, blink::WebString());
}

