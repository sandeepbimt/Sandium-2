IdIndex::IdIndex(const blink::WebDocument& document) {
  blink::WebNode root = document.DocumentElement();
  size_t visited = 0;
  for (blink::WebNode node = root; !node.IsNull();) {
    if (++visited > kMaxNodes) {
      nodes_.clear();
      return;
    }
    auto element = AsElement(node);
    if (!element.IsNull()) {
      std::string id = Attr(element, "id");
      if (Text(id, 128, false)) {
        auto [at, inserted] = nodes_.try_emplace(std::move(id), element);
        // Null is a definitive duplicate, never the first matching node.
        if (!inserted) at->second = blink::WebElement();
      }
    }
    if (!node.FirstChild().IsNull()) {
      node = node.FirstChild();
      continue;
    }
    while (node != root && node.NextSibling().IsNull())
      node = node.ParentNode();
    if (node == root) return;
    node = node.NextSibling();
  }
}

IdIndex::IdIndex(const IdIndex&) = default;
IdIndex::IdIndex(IdIndex&&) noexcept = default;
IdIndex& IdIndex::operator=(const IdIndex&) = default;
IdIndex& IdIndex::operator=(IdIndex&&) noexcept = default;
IdIndex::~IdIndex() = default;

void RawSColorRenderer::Select(const base::UnguessableToken& embedding,
            const base::UnguessableToken& request,
            const gfx::PointF& point,
            SelectCallback reply) {
  auto current = Current(embedding);
  if (!current || request.is_empty() ||
      !std::isfinite(point.x()) || !std::isfinite(point.y()) ||
      point.x() < 0 || point.y() < 0 ||
      point.x() > 16384 || point.y() > 16384) {
    std::move(reply).Run(nullptr);
    return;
  }
  EndSelection();
  auto* widget = frame_->GetWebFrame()->FrameWidget();
  if (!widget) {
    std::move(reply).Run(nullptr);
    return;
  }
  auto node = widget->HitTestResultAt(widget->DIPsToBlinkSpace(point)).GetElement();
  if (node.IsNull() || !node.CanSandiumCorrectColor()) {
    std::move(reply).Run(nullptr);
    return;
  }
  auto candidate = Describe(node, *current, IdIndex(*current));
  if (!candidate) {
    // Never enter a "visit only" workflow disguised as a retained correction.
    std::move(reply).Run(nullptr);
    return;
  }
  selected_ = node;
  selected_document_ = *current;
  identity_ = std::move(candidate);
  request_ = request;
  std::move(reply).Run(identity_.Clone());
}

void RawSColorRenderer::Preview(const base::UnguessableToken& embedding,
             const base::UnguessableToken& request,
             wire::RawSColorProperty property, uint32_t rgb,
             PreviewCallback reply) {
  auto current = MatchingSelection(embedding, request);
  bool applied = current && ValidColor(property, rgb, *identity_) &&
      selected_.SandiumPreviewColor(static_cast<int>(property), rgb);
  if (current) confirmed_.reset();
  std::move(reply).Run(applied);
}

void RawSColorRenderer::ConfirmIdentity(const base::UnguessableToken& embedding,
                     const base::UnguessableToken& request,
                     wire::RawSColorProperty property, uint32_t rgb,
                     ConfirmIdentityCallback reply) {
  auto current = MatchingSelection(embedding, request);
  if (!current || !ValidColor(property, rgb, *identity_) ||
      !selected_.CanSandiumCorrectColor()) {
    std::move(reply).Run(nullptr);
    return;
  }
  const auto actual = Describe(selected_, *current, IdIndex(*current));
  if (!actual || !SameIdentity(*identity_, *actual)) {
    EndSelection();
    std::move(reply).Run(nullptr);
    return;
  }
  confirmed_ = property;
  confirmed_rgb_ = rgb;
  std::move(reply).Run(identity_.Clone());
}

void RawSColorRenderer::Commit(const base::UnguessableToken& embedding,
            const base::UnguessableToken& request,
            wire::RawSColorProperty property, uint32_t rgb,
            CommitCallback reply) {
  auto current = MatchingSelection(embedding, request);
  if (!current || confirmed_ != property || confirmed_rgb_ != rgb || !ValidColor(property, rgb, *identity_)) {
    std::move(reply).Run(false);
    return;
  }
  const auto actual = Describe(selected_, *current, IdIndex(*current));
  bool applied = actual && SameIdentity(*actual, *identity_) &&
      selected_.SandiumCommitColor(static_cast<int>(property), rgb);
  if (applied && !AlreadyBound(*identity_, property)) MarkBound(*identity_, property);
  EndSelection();
  std::move(reply).Run(applied);
}

void RawSColorRenderer::Cancel(const base::UnguessableToken& embedding,
            const base::UnguessableToken& request) {
  if (Current(embedding) && request_ == request) EndSelection();
}

void RawSColorRenderer::Restore(const base::UnguessableToken& embedding, uint64_t generation,
             std::vector<wire::RawSColorRulePtr> rules) {
  auto current = Current(embedding);
  if (!current || !generation || generation < generation_ ||
      rules.empty() || rules.size() > kMaxRules ||
      !std::ranges::all_of(rules, [](const auto& rule) {
        return rule && rule->identity && ValidIdentity(*rule->identity) &&
               ValidColor(rule->property, rule->rgb, *rule->identity);
      })) {
    return;
  }
  generation_ = generation;
  const IdIndex index(*current);
  for (const auto& rule : rules) {
    if (AlreadyBound(*rule->identity, rule->property)) continue;
    const auto node = Match(*rule->identity, *current, index);
    if (node.IsNull()) continue;
    auto target = node;
    if (target.SandiumCommitColor(static_cast<int>(rule->property), rule->rgb))
      MarkBound(*rule->identity, rule->property);
  }
}

void RawSColorRenderer::Clear(const base::UnguessableToken& embedding, uint64_t generation,
           ClearCallback reply) {
  auto current = Current(embedding);
  if (!current || !generation || generation < generation_) {
    std::move(reply).Run(false);
    return;
  }
  generation_ = generation;
  EndSelection();
  current->SandiumClearElementColors();
  bound_.clear();
  std::move(reply).Run(true);
}

