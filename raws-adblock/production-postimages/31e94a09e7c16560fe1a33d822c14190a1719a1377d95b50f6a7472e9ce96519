                            std::string method,
                            base::OnceCallback<void(bool)> result) {
  return impl_->Query(std::move(url), resource, std::move(initiator),
                      std::move(method), std::move(result));
}

void ScopedUserRules::QueryStyles(
    GURL url, base::OnceCallback<void(std::string)> reply) {
  impl_->QueryStyles(std::move(url), std::move(reply));
}

void InitializeDocumentSubresourceRules(std::string verified_rules) {
  auto& state = GetState();
  if (state.attempted || verified_rules.empty() ||
      verified_rules.size() > kMaxRulesBytes) {
    return;
  }
  state.attempted = true;
  state.packaged_rules = std::move(verified_rules);
  state.snapshot = base::SequenceBound<RuleSnapshot>(
      base::ThreadPool::CreateSequencedTaskRunner({base::TaskPriority::USER_VISIBLE}));
  state.snapshot.AsyncCall(&RuleSnapshot::Initialize)
      .WithArgs(state.packaged_rules, std::vector<SubscriptionInput>{}, true)
      .Then(base::BindOnce(&OnInitialized));
}

bool OfflineRulesReady() { return GetState().ready; }
OfflineRulesPhase GetOfflineRulesPhase() {
  const auto& state = GetState();
  if (state.failed)
    return OfflineRulesPhase::kFailed;
  if (state.ready)
    return OfflineRulesPhase::kReady;
  return state.attempted ? OfflineRulesPhase::kLoading
                         : OfflineRulesPhase::kUnknown;
}
std::optional<int> InspectSubscription(const std::string& text,
                                       size_t catalog_index) {
  const auto first = text.find_first_not_of(" \t\r\n");
  if (first == text.npos || text.size() > SubscriptionRulesLimit(catalog_index) ||
      text.find('\0') != text.npos || !base::IsStringUTF8(text))
    return std::nullopt;
  DATFileDataBuffer bytes(text.begin(), text.end());
  // Metadata comes from original bytes; match admission reflects the same
  // in-memory preprocessing and permission mask as the active rule engine.
  const auto meta = adblock::read_list_metadata(bytes);
  PruneSandiumSubscription(bytes);
  auto filters = adblock::new_filter_set(false);
  if (filters->add_filter_list_with_permissions(bytes, 0).result_kind !=
      adblock::ResultKind::Success)
    return std::nullopt;
  auto parsed = adblock::engine_from_filter_set(std::move(filters));
  if (parsed.result_kind != adblock::ResultKind::Success)
    return std::nullopt;
  // The pinned add_filter_list result is only ingestion metadata. Actual
  // parser counts are exposed on the compiled engine, even with debug=false.
  const auto report = parsed.value->get_debug_info();
  if (report.source_info.size() != 1)
    return std::nullopt;
  const auto& feed = report.source_info[0];
  if (feed.network_filter_count == 0 && feed.cosmetic_filter_count == 0)
    return std::nullopt;
  return meta.expires_hours.has_value && meta.expires_hours.value <= 336
             ? meta.expires_hours.value
             : 168;
}
const SubscriptionStats& ActiveSubscriptionStats() {
  return GetState().active_subscription_stats;
}

void InvalidatePendingAdditionalRules() {
  auto& state = GetState();
  ++state.refresh_revision;
  state.queued_refresh.reset();
}

uint64_t InstallAdditionalRules(std::vector<SubscriptionInput> bodies) {
  auto& state = GetState();
  if (!state.attempted || state.failed) return 0;
  const uint64_t revision = ++state.refresh_revision;
  state.queued_refresh = std::move(bodies);
  StartQueuedRefresh();
  return revision;
}

OfflineRulesPhase AdditionalRulesPhase(uint64_t revision) {
  const auto& state = GetState();
  if (!revision || revision != state.refresh_revision)
    return OfflineRulesPhase::kUnknown;
  if (state.failed || revision == state.failed_refresh_revision)
    return OfflineRulesPhase::kFailed;
  if (revision == state.active_refresh_revision)
    return OfflineRulesPhase::kReady;
  return OfflineRulesPhase::kLoading;
}
// UI-sequence-only, like State::pending. A busy document must not exhaust
// all admissions for popup checks. This is not a second matcher or task runner.
unsigned& PendingPopupChecks() {
  static unsigned pending = 0;
  return pending;
}
void QueryPopup(GURL target, GURL frame, base::OnceCallback<void(bool)> reply) {
  auto& state = GetState();
  constexpr unsigned kMaxPendingPopups = 8;
  if (!state.ready || PendingPopupChecks() >= kMaxPendingPopups) {
    TRACE_EVENT_INSTANT("navigation", "RawS.PopupAdmissionSkipped", "ready", state.ready);
    // Reply asynchronously even when admission fails: Check() must return DEFER first.
    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
        FROM_HERE, base::BindOnce(std::move(reply), false));
    return;
  }
  ++PendingPopupChecks();
  state.snapshot.AsyncCall(&RuleSnapshot::Popup)
      .WithArgs(std::move(target), std::move(frame))
      .Then(base::BindOnce([](base::OnceCallback<void(bool)> cb, bool block) {
        --PendingPopupChecks();
        TRACE_EVENT_INSTANT("navigation", "RawS.PopupEngineResult", "blocked", block);
        std::move(cb).Run(block);
      }, std::move(reply)));
}
void QueryHideStyles(GURL url,base::OnceCallback<void(std::string)> reply) {
  auto& s=GetState();
  if (!s.ready) {
    if (s.attempted && !s.failed && url.spec().size() <= 16 * 1024)
      s.cosmetic_waiters.Push(base::TimeTicks::Now(),
          base::BindOnce(&QueryHideStyles, std::move(url), std::move(reply)));
    return;
  }
  if (s.pending>=kMaxPendingChecks) return;
  ++s.pending;
  s.snapshot.AsyncCall(&RuleSnapshot::Style).WithArgs(std::move(url)).Then(
     base::BindOnce([](base::OnceCallback<void(std::string)> cb,std::string css){--GetState().pending;std::move(cb).Run(std::move(css));},std::move(reply)));
}
bool CheckSubframe(GURL target,const url::Origin& initiator,base::OnceCallback<void(bool)> reply) {
  auto& s=GetState();if(!s.ready || s.pending>=kMaxPendingChecks) return false;
  ++s.pending;s.snapshot.AsyncCall(&RuleSnapshot::Evaluate).WithArgs(std::move(target),Resource::kSubFrame,initiator,std::string("GET")).Then(
    base::BindOnce([](base::OnceCallback<void(bool)> cb,Action result){--GetState().pending;std::move(cb).Run(result==Action::kBlock);},std::move(reply)));
  return true;
}

void MaybeAppendDocumentSubresourceFactory(
    network::URLLoaderFactoryBuilder& builder,
    const url::Origin& document_origin,
    base::RepeatingCallback<bool()> site_gate,
    ScopedUserRuleQuery scoped_user_rules,
    base::RepeatingClosure on_document_request_blocked) {
  const auto& state = GetState();
  if (!state.attempted || state.failed || document_origin.opaque() ||
      (document_origin.scheme() != "http" && document_origin.scheme() != "https")) {
    return;
  }
  auto [receiver, downstream] = builder.Append();
  mojo::MakeSelfOwnedReceiver(
      std::make_unique<RequestFactory>(std::move(downstream), document_origin,
                                       std::move(site_gate), std::move(scoped_user_rules),
                                       std::move(on_document_request_blocked)),
      std::move(receiver));
}

