using DATFileDataBuffer = std::vector<uint8_t>;
// uBO list dialect on Chromium Android. Extension identity here selects list
// syntax; the native engine remains authoritative for individual rules and
// scriptlet permissions. See uBlock's static-filtering-parser.js preparser.
std::string_view TrimSubscriptionSpace(std::string_view text) {
  constexpr std::string_view spaces = " \t\v\f\r";
  const auto start = text.find_first_not_of(spaces);
  if (start == text.npos) {
    return {};
  }
  return text.substr(start, text.find_last_not_of(spaces) - start + 1);
}

std::optional<bool> SubscriptionConditionToken(std::string_view token) {
  const bool invert = token.starts_with('!');
  if (invert) {
    token.remove_prefix(1);
  }
  if (token == "ext_ublock" || token == "env_chromium" ||
      token == "env_brave" || token == "env_mobile" ||
      token == "adguard_ext_chromium" || token == "adguard_ext_opera") {
    return !invert;
  }
  // Like uBO, unknown cap_* values are false. Unknown ordinary names are
  // indeterminate, so unfamiliar directives do not silently drop both arms.
  constexpr std::string_view absent[] = {
      "ext_ubol", "ext_devbuild", "env_edge", "env_firefox", "env_legacy",
      "env_mv3", "env_safari", "false", "ext_abp", "adguard",
      "adguard_app_android", "adguard_app_cli", "adguard_app_ios",
      "adguard_app_mac", "adguard_app_windows", "adguard_ext_android_cb",
      "adguard_ext_chromium_mv3", "adguard_ext_edge", "adguard_ext_firefox",
      "adguard_ext_safari"};
  if (token.starts_with("cap_")) {
    return invert;
  }
  for (const auto name : absent) {
    if (token == name) {
      return invert;
    }
  }
  return std::nullopt;
}

std::optional<bool> EvaluateSubscriptionCondition(std::string_view expression) {
  expression = TrimSubscriptionSpace(expression);
  if (expression.starts_with('(') && expression.ends_with(')')) {
    expression = TrimSubscriptionSpace(expression.substr(1, expression.size() - 2));
  }
  constexpr std::string_view spaces = " \t\v\f\r";
  const auto next_word = [&expression, spaces]() {
    const auto end = expression.find_first_of(spaces);
    auto word = expression.substr(0, end);
    expression.remove_prefix(word.size());
    return word;
  };
  const auto first = next_word();
  if (first.empty() || first.starts_with('|') || first.starts_with('&')) {
    return std::nullopt;
  }
  auto result = SubscriptionConditionToken(first);
  while (!(expression = TrimSubscriptionSpace(expression)).empty()) {
    const auto op = next_word();
    if ((op != "&&" && op != "||") || !expression.starts_with(' ')) {
      return std::nullopt;
    }
    const auto start = expression.find_first_not_of(' ');
    if (start == expression.npos) {
      return std::nullopt;
    }
    expression.remove_prefix(start);
    const auto value = SubscriptionConditionToken(next_word());
    if (!value) {
      return std::nullopt;
    }
    // The maintainer's grammar evaluates operators left to right.
    if (op == "||") {
      result = result.value_or(false) || *value;
    } else if (result.has_value()) {
      result = *result && *value;
    }
  }
  return result;
}

void PruneSandiumSubscription(DATFileDataBuffer& buffer) {
  if (buffer.empty()) {
    return;
  }
  const std::string_view text(reinterpret_cast<const char*>(buffer.data()),
                              buffer.size());
  const auto first = text.find("!#if");
  if (first == text.npos) {
    return;
  }
  const auto preceding_lf = text.rfind('\n', first);
  size_t read = preceding_lf == text.npos ? 0 : preceding_lf + 1;
  size_t written = read;
  std::vector<std::optional<bool>> branches;
  size_t disabled = 0;

  while (read < text.size()) {
    const auto lf = text.find('\n', read);
    const size_t end = lf == text.npos ? text.size() : lf + 1;
    auto line = text.substr(read, (lf == text.npos ? end : lf) - read);
    if (line.starts_with("!#")) {
      line.remove_prefix(2);
      const auto word_end = line.find_first_not_of(
          "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_");
      const auto directive = line.substr(0, word_end);
      if (directive == "if") {
        const auto state = EvaluateSubscriptionCondition(line.substr(2));
        branches.push_back(state);
        if (state == false) {
          ++disabled;
        }
      } else if (!branches.empty() && directive == "else") {
        auto& state = branches.back();
        if (state.has_value()) {
          if (*state) {
            ++disabled;
          } else {
            --disabled;
          }
          state = !*state;
        }
      } else if (!branches.empty() && directive == "endif") {
        if (branches.back() == false) {
          --disabled;
        }
        branches.pop_back();
      }
    }

    // Rewrite in place, retaining LF/CRLF and original line numbers for
    // metadata and rule diagnostics. Reuse the original bytes on enabled spans.
    size_t from = read;
    if (disabled) {
      from = lf == text.npos ? end : lf;
      if (from > read && text[from - 1] == '\r') {
        --from;
      }
    }
    const size_t count = end - from;
    if (count && written != from) {
      auto bytes = base::span(buffer);
      bytes.subspan(written, count).copy_from(bytes.subspan(from, count));
    }
    written += count;
    read = end;
  }
  buffer.resize(written);
}


class RuleSnapshot {
 public:
  std::optional<SubscriptionStats> Initialize(
      std::string text, std::vector<SubscriptionInput> additional,
      bool initialize_resolver) {
    if (!base::IsStringUTF8(text) ||
        text.find('\0') != std::string::npos ||
        (initialize_resolver && !adblock::set_domain_resolver())) {
      return std::nullopt;
    }
    auto primary = adblock::new_filter_set(false);
    const std::vector<uint8_t> bytes(text.begin(), text.end());
    const auto admitted = primary->add_filter_list(bytes);
    if (admitted.result_kind != adblock::ResultKind::Success) return std::nullopt;
    auto primary_engine = adblock::engine_from_filter_set(std::move(primary));
    if (primary_engine.result_kind != adblock::ResultKind::Success) {
      return std::nullopt;
    }
    ::sandium::port1442::SimpleGenericCensus keys(
        ::sandium::port1442::kPackagedGenericCandidateLimit,
        ::sandium::port1442::kPackagedGenericCandidateLimit / 2);
    for (auto selector : ::sandium::port1442::kPackagedGenericAdSlots) {
      keys.Add(selector);
    }
    keys.AddList(text, ::sandium::port1442::kPackagedGenericCandidateLimit);
    auto admitted_subscriptions = Install(std::move(additional));
    if (!admitted_subscriptions) return std::nullopt;
    generic_selectors_ = ::sandium::port1442::MergeSimpleGeneric(
        ResolveGenericKeys(*primary_engine.value, keys),
        std::move(generic_selectors_));
    primary_.emplace(std::move(primary_engine.value));
    return admitted_subscriptions;
  }

  static std::vector<std::string> ResolveGenericKeys(
      const adblock::Engine& engine,
      const ::sandium::port1442::SimpleGenericCensus& keys) {
    return keys.Resolve([&](const auto& classes, const auto& ids) {
      // An empty exception vector is correct at compile time: the exact
      // exception union is enforced when this document's CSS is generated.
      std::vector<std::string> matches;
      auto result = engine.hidden_class_id_selectors(
          classes, ids, std::vector<std::string>{});
      if (result.result_kind == adblock::ResultKind::Success) {
        for (const auto& selector : result.value) {
          matches.emplace_back(selector);
        }
      }
      return matches;
    });
  }

  std::vector<std::string> generic_selectors_;

  std::optional<SubscriptionStats> Install(
      std::vector<SubscriptionInput> bodies) {
    // Build off to the side: malformed input never clears the live engine.
    auto fs = adblock::new_filter_set(false);
    ::sandium::port1442::SimpleGenericCensus keys(
        ::sandium::port1442::kSubscriptionGenericCandidateLimit);
    size_t left = 96u << 20;
    auto add = [&](const std::string& text, bool preprocess, size_t limit) {
      if (text.empty() || text.size() > left || text.size() > limit ||
          !base::IsStringUTF8(text) || text.find('\0') != std::string::npos) return false;
      left -= text.size();
      DATFileDataBuffer bytes(text.begin(),text.end());
      if (preprocess) PruneSandiumSubscription(bytes);
      if (fs->add_filter_list_with_permissions(bytes, 0).result_kind !=
          adblock::ResultKind::Success) return false;
      if (preprocess && !bytes.empty()) {
        keys.AddList(
            std::string_view(reinterpret_cast<const char*>(bytes.data()), bytes.size()),
            ::sandium::port1442::kSubscriptionGenericPerList);
      }
      return true;
    };
    if (!add("! Title: Sandium player ad resources\n||ohjpfawpaap.in^$third-party,script,subdocument,image\n",false,kMaxRulesBytes)) return std::nullopt;
    if (!add(::sandium::port1442::kPlayerIncidentRules, false, kMaxRulesBytes)) return std::nullopt;
    for (const auto& source : bodies) {
      if (!add(source.body, true, SubscriptionRulesLimit(source.catalog_index)))
        return std::nullopt;
    }
    auto result = adblock::engine_from_filter_set(std::move(fs));
    if (result.result_kind != adblock::ResultKind::Success) return std::nullopt;
    // Native ingestion accepts feeds containing no supported rules. Do not
    // let those masquerade as active lists in the first-run readiness signal.
    const auto report = result.value->get_debug_info();
    constexpr size_t kBuiltInSources = 2;
    if (report.source_info.size() != kBuiltInSources + bodies.size())
      return std::nullopt;
    SubscriptionStats admitted;
    admitted.reserve(bodies.size());
    for (size_t i = 0; i < bodies.size(); ++i) {
      // The pinned adapter preserves FilterSet source order. The first two
      // inputs are compiled-in policy, not URL catalogue entries.
      const auto& source = report.source_info[kBuiltInSources + i];
      if (source.network_filter_count == 0 && source.cosmetic_filter_count == 0)
        return std::nullopt;
      admitted.push_back({bodies[i].catalog_index, bodies[i].body.size(),
                          source.network_filter_count,
                          source.cosmetic_filter_count});
    }
    generic_selectors_ = ResolveGenericKeys(*result.value, keys);
    additional_.emplace(std::move(result.value));
    return admitted;
  }
  bool Popup(GURL target, GURL frame) {
    if (!primary_ || !additional_ || !target.SchemeIsHTTPOrHTTPS() || !frame.SchemeIsHTTPOrHTTPS()) return false;
    namespace d = net::registry_controlled_domains;
    const bool third = !d::SameDomainOrHost(target,frame,d::INCLUDE_PRIVATE_REGISTRIES);
    auto pass = [&](const adblock::Engine& e, bool matched, bool check_exceptions) {
      return e.matches(target.spec(),std::string(target.host()),std::string(frame.host()),
                       "popup",third,"GET",matched,check_exceptions);
    };
    return ::sandium::port1442::PopupMatch(pass(**primary_,false,true),
        [&](bool matched,bool exceptions){ return pass(**additional_,matched,exceptions); });
  }
  std::string Style(GURL url) {
    if (!primary_ || !additional_ || !url.SchemeIsHTTPOrHTTPS()) return {};
    std::set<std::string> hide, except;
    bool suppress_generic = false;
    for (const adblock::Engine* engine : {&**primary_, &**additional_}) {
      auto raw = engine->url_cosmetic_resources(url.spec());
      auto info = base::JSONReader::ReadDict(std::string_view(raw.data(),raw.size()),base::JSON_PARSE_RFC);
      if (!info) return {};
      suppress_generic |= info->FindBool("generichide").value_or(false);
      for (auto pair : {std::pair{"hide_selectors", &hide}, std::pair{"exceptions", &except}}) {
        if (auto* items=info->FindList(pair.first)) for (const auto& item : *items)
          if (item.is_string()) pair.second->insert(item.GetString());
      }
    }
    auto css = ::sandium::port1442::HideStyles(hide, except);
    ::sandium::port1442::AppendSimpleGenericStyles(
        css, suppress_generic, generic_selectors_, hide, except);
    return css;
  }

  Action Evaluate(GURL url, Resource type, url::Origin initiator,
                  std::string method) {
    if (!primary_ || !additional_) return Action::kNotEvaluated;
    return DecideDocumentSubresource(&**primary_, &**additional_, url, type,
                                     initiator, method);
  }

 private:
  std::optional<rust::Box<adblock::Engine>> primary_;
  std::optional<rust::Box<adblock::Engine>> additional_;
};

// UI-sequence owned. There is no mutable renderer- or profile-controlled state.
// The bounded worker never receives a Mojo endpoint or a raw frame pointer.
// Start-up-only buffer on the browser UI sequence. Normal navigation and
// network loading do not call it or wait for it. As in the warm path, the
// reply is scoped to the original WeakDocumentPtr at the call site.
class CosmeticReadinessQueue {
 public:
  CosmeticReadinessQueue();
  ~CosmeticReadinessQueue();

  void Push(base::TimeTicks now, base::OnceClosure query) {
    if (queries_.size() < 8) {
      queries_.emplace_back(now, std::move(query));
    }
  }
  void Finish(bool ready, base::TimeTicks now) {
    auto queries = std::move(queries_);
    queries_.clear();
    if (!ready) {
      return;
    }
    for (auto& [queued_at, query] : queries) {
      if (now - queued_at < base::Seconds(5)) {
        std::move(query).Run();
      }
    }
  }
 private:
  std::vector<std::pair<base::TimeTicks, base::OnceClosure>> queries_;
};

CosmeticReadinessQueue::CosmeticReadinessQueue() = default;
CosmeticReadinessQueue::~CosmeticReadinessQueue() = default;

struct State {
  base::SequenceBound<RuleSnapshot> snapshot;
  SEQUENCE_CHECKER(sequence_checker);
  bool attempted = false;
  bool failed = false;
  CosmeticReadinessQueue cosmetic_waiters;
  bool ready = false;
  std::string packaged_rules;
  std::optional<std::vector<SubscriptionInput>> queued_refresh;
  SubscriptionStats active_subscription_stats;
  uint64_t refresh_revision = 0;
  uint64_t active_refresh_revision = 0;
  uint64_t failed_refresh_revision = 0;
  bool refresh_in_flight = false;
  base::SequenceBound<RuleSnapshot> refresh_candidate;
  int pending = 0;
};

State& GetState() {
  static base::NoDestructor<State> state;
  DCHECK_CALLED_ON_VALID_SEQUENCE(state->sequence_checker);
  return *state;
}

std::optional<Resource> GetResourceType(int type) {
  for (auto allowed : {Resource::kScript, Resource::kStylesheet, Resource::kImage,
                       Resource::kFontResource, Resource::kXhr, Resource::kMedia, Resource::kPing,
                       Resource::kSubResource, Resource::kFavicon}) {
    if (type == static_cast<int>(allowed)) return allowed;
  }
  return std::nullopt;
}

class ScopedUserRulesSnapshot {
 public:
  explicit ScopedUserRulesSnapshot() = default;
  bool Install(std::string text) {
    auto count = CountSupportedCustomRules(text);
    if (!count || count->total() == 0) return false;
    const std::vector<uint8_t> bytes(text.begin(), text.end());
    auto fs = adblock::new_filter_set(false);
    if (fs->add_filter_list_with_permissions(bytes, 0).result_kind !=
        adblock::ResultKind::Success) return false;
    auto result = adblock::engine_from_filter_set(std::move(fs));
    if (result.result_kind != adblock::ResultKind::Success) return false;
    const auto report = result.value->get_debug_info();
    if (report.source_info.size() != 1 ||
        report.source_info[0].network_filter_count != count->network ||
        report.source_info[0].cosmetic_filter_count != count->cosmetic) return false;
    if (count->cosmetic != 0) {
      // Query only exact generic keys that appeared in this validated input.
      // ResolveGenericKeys accepts only native engine-admitted simple selectors.
      std::set<std::string> exact_generic;
      for (std::string_view body(text); !body.empty();) {
        const auto next = body.find('\n');
        auto line = body.substr(0, next);
        body.remove_prefix(next == body.npos ? body.size() : next + 1);
        if (line.ends_with('\r')) line.remove_suffix(1);
        if (!line.starts_with("##")) continue;
        auto parsed = ParseRawSCosmeticLine(line);
        if (!parsed || !parsed->generic) return false;
        exact_generic.emplace(parsed->selector);
      }
      ::sandium::port1442::SimpleGenericCensus keys(kRawSMaxCustomRuleLines);
      for (const auto& selector : exact_generic) {
        if (!keys.Add(selector)) return false;
      }
      generic_selectors_ = RuleSnapshot::ResolveGenericKeys(*result.value, keys);
      if (generic_selectors_.size() != exact_generic.size()) return false;
      has_cosmetics_ = true;
    }
    engine_.emplace(std::move(result.value));
    return true;
  }

  std::string Style(GURL url) {
    if (!engine_ || !has_cosmetics_ || !url.SchemeIsHTTPOrHTTPS()) return {};
    auto raw = (*engine_)->url_cosmetic_resources(url.spec());
    auto info = base::JSONReader::ReadDict(
        std::string_view(raw.data(), raw.size()), base::JSON_PARSE_RFC);
    if (!info) return {};
    std::set<std::string> hide, except;
    for (auto [key, output] : {std::pair{"hide_selectors", &hide},
                               std::pair{"exceptions", &except}}) {
      if (const auto* items = info->FindList(key)) {
        for (const auto& item : *items) {
          const auto* selector = item.GetIfString();
          if (selector && RawSSafeScopedCosmetic(*selector))
            output->insert(*selector);
        }
      }
    }
    if (!info->FindBool("generichide").value_or(false)) {
      for (const auto& selector : generic_selectors_) hide.insert(selector);
    }
    // User exceptions affect only their own list's hides. None of the other
    // cosmetic/scriptlet/resource fields can reach this fixed-declaration CSS.
    return ::sandium::port1442::HideStyles(hide, except);
  }

  bool Block(GURL url, int resource, url::Origin initiator, std::string method) {
    if (!engine_) return false;
    const auto type = GetResourceType(resource);
    if (!type) return false;
    auto result = MatchPass(**engine_, url, *type, initiator, method,
                            false, false);
    // A user @@ line excepts only another rule of the user's own layer. It
    // does not silently disable native curated protection or important rules.
    return result.matched && !result.has_exception &&
           !result.redirect.has_value && !result.rewritten_url.has_value;
  }

 private:
  bool has_cosmetics_ = false;
  std::vector<std::string> generic_selectors_;
  std::optional<rust::Box<adblock::Engine>> engine_;
};

class RequestFactory final : public network::mojom::URLLoaderFactory {
 public:
  RequestFactory(mojo::PendingRemote<network::mojom::URLLoaderFactory> downstream,
                 const url::Origin& document_origin,
                 base::RepeatingCallback<bool()> site_gate,
                 ScopedUserRuleQuery scoped_user_rules,
                 base::RepeatingClosure on_document_request_blocked)
      : downstream_(std::move(downstream)),
        document_origin_(document_origin),
        site_gate_(std::move(site_gate)),
        scoped_user_rules_(std::move(scoped_user_rules)),
        on_document_request_blocked_(std::move(on_document_request_blocked)) {}

  ~RequestFactory() override = default;

  void CreateLoaderAndStart(
      mojo::PendingReceiver<network::mojom::URLLoader> loader,
      int32_t request_id, uint32_t options,
      const network::ResourceRequest& request,
      mojo::PendingRemote<network::mojom::URLLoaderClient> client,
      const net::MutableNetworkTrafficAnnotationTag& annotation) override {
    auto& state = GetState();
    const auto type = GetResourceType(request.resource_type);
    // Install queues Initialize before this factory can exist. Match eligible
    // early requests on that same sequence, even before the UI ready reply.
    // The unchanged request deadline and pending cap still bound network delay.
    if ((site_gate_ && !site_gate_.Run()) ||
        !state.attempted || state.failed ||
        state.pending >= kMaxPendingChecks || !type ||
        request.trusted_params || request.request_body ||
        !request.request_initiator ||
        *request.request_initiator != document_origin_ ||
        !request.url.SchemeIsHTTPOrHTTPS() || request.url.spec().size() > 65536 ||
        (request.method != "GET" && request.method != "HEAD")) {
      downstream_->CreateLoaderAndStart(std::move(loader), request_id, options,
                                        request, std::move(client), annotation);
      return;
    }
    const uint64_t token = ++next_token_;
    auto pending = std::make_unique<Pending>();
    pending->complete = base::BindOnce(&RequestFactory::Finish,
        weak_factory_.GetWeakPtr(), std::move(loader), request_id, options,
        request, std::move(client), annotation);
    pending->timer.Start(FROM_HERE, kCheckTimeout,
                         base::BindOnce(&RequestFactory::Complete,
                             weak_factory_.GetWeakPtr(), token, Action::kAllow));
    auto* record = pending.get();
    pending_[token] = std::move(pending);
    ++state.pending;
    if (scoped_user_rules_ && state.pending < kMaxPendingChecks) {
      ++state.pending;
      record->waiting_custom = scoped_user_rules_.Run(
          request.url, request.resource_type, document_origin_, request.method,
          base::BindOnce(&RequestFactory::OnCustomEvaluated,
                         weak_factory_.GetWeakPtr(), token));
      if (!record->waiting_custom)
        --state.pending;
    }
    state.snapshot.AsyncCall(&RuleSnapshot::Evaluate)
        .WithArgs(request.url, *type, document_origin_, request.method)
        .Then(base::BindOnce(&RequestFactory::OnEvaluated,
                             weak_factory_.GetWeakPtr(), token));
  }

  void Clone(mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver)
      override {
    mojo::PendingRemote<network::mojom::URLLoaderFactory> clone;
    downstream_->Clone(clone.InitWithNewPipeAndPassReceiver());
    mojo::MakeSelfOwnedReceiver(
        std::make_unique<RequestFactory>(std::move(clone), document_origin_,
                                         site_gate_, scoped_user_rules_,
                                         on_document_request_blocked_),
        std::move(receiver));
  }

 private:
  struct Pending {
    base::OneShotTimer timer;
    base::OnceCallback<void(Action)> complete;
    bool waiting_custom = false;
    std::optional<Action> base_action;
  };

  // Global budget is released on worker reply, not timeout, so an engine
  // stalled by one task cannot accumulate new work indefinitely. This static
  // callback does not depend on the factory remaining alive.
  static void OnEvaluated(base::WeakPtr<RequestFactory> factory,
                          uint64_t token, Action action) {
    --GetState().pending;
    if (!factory) return;
    auto it = factory->pending_.find(token);
    if (it == factory->pending_.end()) return;
    if (action == Action::kBlock || !it->second->waiting_custom)
      factory->Complete(token, action);
    else
      it->second->base_action = action;
  }

  static void OnCustomEvaluated(base::WeakPtr<RequestFactory> factory,
                                uint64_t token, bool block) {
    --GetState().pending;
    if (!factory) return;
    auto it = factory->pending_.find(token);
    if (it == factory->pending_.end()) return;
    if (block) {
      factory->Complete(token, Action::kBlock);
      return;
    }
    it->second->waiting_custom = false;
    if (it->second->base_action)
      factory->Complete(token, *it->second->base_action);
  }

  void Complete(uint64_t token, Action action) {
    auto it = pending_.find(token);
    if (it == pending_.end()) return;
    auto complete = std::move(it->second->complete);
    pending_.erase(it);
    std::move(complete).Run(action);
  }

  void Finish(
      mojo::PendingReceiver<network::mojom::URLLoader> loader,
      int32_t request_id, uint32_t options,
      const network::ResourceRequest& request,
      mojo::PendingRemote<network::mojom::URLLoaderClient> client,
      const net::MutableNetworkTrafficAnnotationTag& annotation, Action action) {
    if (action == Action::kBlock && (!site_gate_ || site_gate_.Run())) {
      // This path already discards the loader receiver. No forwarded request
      // changes Mojo ownership or connection group. A bound Remote can still
      // report connected before its asynchronous disconnect handler runs.
      mojo::ScopedMessagePipeHandle blocked_loader_pipe;
      bool count_live_request = false;
      if (on_document_request_blocked_ && loader.is_valid() && client.is_valid()) {
        blocked_loader_pipe = loader.PassPipe();
        count_live_request =
            !blocked_loader_pipe.get().QuerySignalsState().peer_closed() &&
            !client.Pipe().get().QuerySignalsState().peer_closed();
      }
      mojo::Remote<network::mojom::URLLoaderClient> response(std::move(client));
      network::URLLoaderCompletionStatus status(net::ERR_BLOCKED_BY_CLIENT);
      // Preserve Chromium's native collapse behavior only for a definite blocked image.
      status.should_collapse_initiator = request.resource_type == static_cast<int>(Resource::kImage);
      response->OnComplete(status);
      // Count a browser terminal decision for still-observed-live endpoints,
      // not an acknowledgement that the renderer received OnComplete.
      if (count_live_request) on_document_request_blocked_.Run();
      return;
    }
    // No URLLoader proxy is created: downstream Chromium exclusively validates
    // and follows redirects. No flags or request details are mutated.
    downstream_->CreateLoaderAndStart(std::move(loader), request_id, options,
                                      request, std::move(client), annotation);
  }

  mojo::Remote<network::mojom::URLLoaderFactory> downstream_;
  const url::Origin document_origin_;
  const base::RepeatingCallback<bool()> site_gate_;
  const ScopedUserRuleQuery scoped_user_rules_;
  const base::RepeatingClosure on_document_request_blocked_;
  uint64_t next_token_ = 0;
  base::flat_map<uint64_t, std::unique_ptr<Pending>> pending_;
  base::WeakPtrFactory<RequestFactory> weak_factory_{this};
};

void StartQueuedRefresh();

void OnRefreshBuilt(uint64_t revision,
                    std::optional<SubscriptionStats> admitted) {
  const bool ok = admitted.has_value();
  auto& state = GetState();
  if (ok && revision == state.refresh_revision) {
    // Move the holder, not the engine or any of its sequence-affine Rust
    // handles. Previously posted decisions finish on the former sequence.
    state.snapshot = std::move(state.refresh_candidate);
    state.active_refresh_revision = revision;
    state.active_subscription_stats = std::move(*admitted);
  } else {
    state.refresh_candidate.Reset();
    if (!ok && revision == state.refresh_revision)
      state.failed_refresh_revision = revision;
    if (!ok)
      LOG(WARNING) << "RawS additional rules rejected; retaining previous snapshot";
  }
  state.refresh_in_flight = false;
  StartQueuedRefresh();
}

void StartQueuedRefresh() {
  auto& state = GetState();
  if (!state.ready || state.refresh_in_flight || !state.queued_refresh)
    return;
  // At most one refresh in flight and one coalesced pending generation. Matching
  // uses the last valid complete snapshot throughout rebuild, on its own queue.
  auto bodies = std::move(*state.queued_refresh);
  state.queued_refresh.reset();
  state.refresh_in_flight = true;
  state.refresh_candidate = base::SequenceBound<RuleSnapshot>(
      base::ThreadPool::CreateSequencedTaskRunner({base::TaskPriority::USER_VISIBLE}));
  state.refresh_candidate.AsyncCall(&RuleSnapshot::Initialize)
      .WithArgs(state.packaged_rules, std::move(bodies), false)
      .Then(base::BindOnce(&OnRefreshBuilt, state.refresh_revision));
}

void OnInitialized(std::optional<SubscriptionStats> admitted) {
  const bool ready = admitted.has_value();
  auto& state = GetState();
  state.failed = !ready;
  state.ready = ready;
  state.cosmetic_waiters.Finish(ready, base::TimeTicks::Now());
  if (!ready) {
    state.queued_refresh.reset();
    state.packaged_rules.clear();
    return;
  }
  StartQueuedRefresh();
}

