DEFINE_JNI(ChromeBackupWatcher)
// Scoped, passive user rules only. This never exports subscriptions, element
// rules, private rules, or the browser's broader adblock engine state.
namespace {
using sandium::adblock_native::CountSupportedCustomRules;
using sandium::adblock_native::ProfileUserNetworkRules;
constexpr size_t kRawSAdArchiveLimit = 256u * 1024;

bool CanAccessAdBackups(Profile* profile) {
  return content::BrowserThread::CurrentlyOn(content::BrowserThread::UI) &&
         profile && !profile->IsOffTheRecord() && !profile->ShutdownStarted();
}

bool IsSupportedAdBackupText(std::string_view text) {
  if (!base::IsStringUTF8(text) || !CountSupportedCustomRules(text)) {
    return false;
  }
  // A literal comment is allowed, but Brave-list preprocessing directives
  // must never be handled as opaque comments or evaluated during import.
  while (!text.empty()) {
    const auto next = text.find('\n');
    auto line = text.substr(0, next);
    while (!line.empty() && (line.front() == ' ' || line.front() == '\t')) {
      line.remove_prefix(1);
    }
    if (line.starts_with("!#")) return false;
    text.remove_prefix(next == text.npos ? text.size() : next + 1);
  }
  return true;
}

std::optional<std::string> DecodeAdRuleBackup(const std::string& archive) {
  if (archive.empty() || archive.size() > kRawSAdArchiveLimit) return std::nullopt;
  auto root = base::JSONReader::ReadDict(archive, base::JSON_PARSE_RFC);
  if (!root || root->size() != 4 || root->FindInt("version") != 1) {
    return std::nullopt;
  }
  const auto* format = root->FindString("format");
  const auto* kind = root->FindString("kind");
  const auto* rules = root->FindString("rules");
  if (!format || *format != "sandium-rules" || !kind ||
      *kind != "custom-ad-rules" || !rules || !IsSupportedAdBackupText(*rules)) {
    return std::nullopt;
  }
  return *rules;
}

std::optional<std::string> MergeAdRuleTexts(
    const std::string& current, const std::string& incoming) {
  if (!IsSupportedAdBackupText(current) || !IsSupportedAdBackupText(incoming)) {
    return std::nullopt;
  }
  if (incoming.empty() || current == incoming ||
      (current.size() > incoming.size() && current.ends_with(incoming) &&
       current[current.size() - incoming.size() - 1] == '\n')) {
    return current;
  }
  std::string merged = current;
  if (!merged.empty() && !merged.ends_with('\n')) merged += '\n';
  merged += incoming;
  if (!IsSupportedAdBackupText(merged)) return std::nullopt;
  return merged;
}
}  // namespace

static std::string JNI_RawSAdRuleBackupSettings_Export(Profile* profile) {
  if (!CanAccessAdBackups(profile)) return {};
  auto body = ProfileUserNetworkRules::For(*profile).CurrentText();
  if (!IsSupportedAdBackupText(body)) return {};
  base::DictValue root;
  root.Set("format", "sandium-rules");
  root.Set("version", 1);
  root.Set("kind", "custom-ad-rules");
  root.Set("rules", std::move(body));
  auto encoded = base::WriteJson(root);
  return encoded && encoded->size() <= kRawSAdArchiveLimit ? *encoded : std::string();
}

static std::string JNI_RawSAdRuleBackupSettings_PlanRestore(
    Profile* profile, const std::string& archive) {
  if (!CanAccessAdBackups(profile)) return {};
  const auto incoming = DecodeAdRuleBackup(archive);
  if (!incoming) return {};
  const auto current = ProfileUserNetworkRules::For(*profile).CurrentText();
  const auto merged = MergeAdRuleTexts(current, *incoming);
  if (!merged) return {};
  base::DictValue response;
  response.Set("changed", *merged != current);
  response.Set("importedBytes", static_cast<int>(incoming->size()));
  // This is a local profile snapshot and never a page value; retain exact text
  // for compare-before-write, not a timestamp or Java line parser.
  response.Set("expected", current);
  return base::WriteJson(response).value_or(std::string());
}

static bool JNI_RawSAdRuleBackupSettings_ApplyRestore(
    Profile* profile, const std::string& archive, const std::string& expected,
    base::OnceCallback<void(bool)> completion) {
  if (!CanAccessAdBackups(profile) || !completion) return false;
  const auto incoming = DecodeAdRuleBackup(archive);
  if (!incoming) return false;
  auto& owner = ProfileUserNetworkRules::For(*profile);
  const auto current = owner.CurrentText();
  if (current != expected) return false;
  auto merged = MergeAdRuleTexts(current, *incoming);
  if (!merged || *merged == current) return false;
  // Existing owner rejects a concurrent rebuild, admits all rules with native
  // permissions=0 and invokes completion after regular-profile pref commit.
  return owner.Replace(std::move(*merged), std::move(completion));
}

