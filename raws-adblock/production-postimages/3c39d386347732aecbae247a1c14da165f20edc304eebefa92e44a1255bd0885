  return GetState().active_subscription_stats;
}

void InvalidatePendingAdditionalRules() {
  auto& state = GetState();
  ++state.refresh_revision;
  state.queued_refresh.reset();
}

uint64_t InstallAdditionalRules(std::vector<SubscriptionInput> bodies) {
  auto& state = GetState();
  if (!state.attempted || state.failed) return 0;
  const uint64_t revision = ++state.refresh_revision;
  state.queued_refresh = std::move(bodies);
  StartQueuedRefresh();
  return revision;
}

OfflineRulesPhase AdditionalRulesPhase(uint64_t revision) {
  const auto& state = GetState();
  if (!revision || revision != state.refresh_revision)
    return OfflineRulesPhase::kUnknown;
  if (state.failed || revision == state.failed_refresh_revision)
    return OfflineRulesPhase::kFailed;
  if (revision == state.active_refresh_revision)
    return OfflineRulesPhase::kReady;
  return OfflineRulesPhase::kLoading;
}
// UI-sequence-only, like State::pending. A busy document must not exhaust
// all admissions for popup checks. This is not a second matcher or task runner.
unsigned& PendingPopupChecks() {
  static unsigned pending = 0;
  return pending;
}
void QueryPopup(GURL target, GURL frame, base::OnceCallback<void(bool)> reply) {
  auto& state = GetState();
  constexpr unsigned kMaxPendingPopups = 8;
  if (!state.ready || PendingPopupChecks() >= kMaxPendingPopups) {
    TRACE_EVENT_INSTANT("navigation", "RawS.PopupAdmissionSkipped", "ready", state.ready);
    // Reply asynchronously even when admission fails: Check() must return DEFER first.
    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
        FROM_HERE, base::BindOnce(std::move(reply), false));
    return;
  }
  ++PendingPopupChecks();
  state.snapshot.AsyncCall(&RuleSnapshot::Popup)
      .WithArgs(std::move(target), std::move(frame))
      .Then(base::BindOnce([](base::OnceCallback<void(bool)> cb, bool block) {
        --PendingPopupChecks();
        TRACE_EVENT_INSTANT("navigation", "RawS.PopupEngineResult", "blocked", block);
        std::move(cb).Run(block);
      }, std::move(reply)));
}
bool QueryObservedPackagedStyles(
    GURL url, std::vector<std::string> classes, std::vector<std::string> ids,
    base::OnceCallback<void(std::optional<std::string>)> reply) {
  auto& state = GetState();
  constexpr size_t kBatch = ::sandium::port1442::PackagedGenericDomIndex::kMaxDomKeys;
  if (!reply || !url.SchemeIsHTTPOrHTTPS() || url.spec().size() > 16 * 1024 ||
      !state.ready || state.pending_dom_cosmetics || state.pending >= 8 ||
      classes.size() > kBatch || ids.size() > kBatch - classes.size()) {
    return false;
  }
  state.pending_dom_cosmetics = true;
  const uint64_t revision = state.active_refresh_revision;
  state.snapshot.AsyncCall(&RuleSnapshot::StyleForObservedEngineKeys)
      .WithArgs(std::move(url), std::move(classes), std::move(ids))
      .Then(base::BindOnce(
          [](uint64_t revision,
             base::OnceCallback<void(std::optional<std::string>)> reply,
             std::optional<std::string> css) {
            auto& current = GetState();
            current.pending_dom_cosmetics = false;
            if (!current.ready || current.active_refresh_revision != revision)
              css.reset();
            std::move(reply).Run(std::move(css));
          },
          revision, std::move(reply)));
  return true;
}

bool ReviewedPassiveScriptletsEnabled() {
  return base::FeatureList::IsEnabled(kRawSReviewedPassiveScriptlets);
}

bool IsReviewedPassiveScriptletUrl(const GURL& url) {
  return url.is_valid() && url.SchemeIs("https") && !url.has_username() &&
         !url.has_password() && !url.has_query() && !url.has_ref() &&
         url.EffectiveIntPort() == 443 && url.spec().size() <= 2048 &&
         !url.DomainIs("thehindu.com") && !url.DomainIs("tinypass.com") &&
         !url.DomainIs("piano.io") &&
         !::sandium::port1442::SensitiveCompoundPath(
             base::ToLowerASCII(url.path()));
}

bool TryQueryReviewedPassiveScriptlets(
    GURL url, base::OnceCallback<void(uint32_t)> callback) {
  if (!base::FeatureList::IsEnabled(kRawSReviewedPassiveScriptlets) ||
      !callback || !IsReviewedPassiveScriptletUrl(url)) {
    return false;
  }
  auto& state = GetState();
  if (!state.ready || state.pending_passive_scriptlet ||
      state.active_refresh_revision == 0 ||
      state.active_refresh_revision != state.refresh_revision ||
      !CanAdmitCosmetic(state.pending_cosmetics, true) || state.pending >= 8) {
    return false;
  }
  state.pending_passive_scriptlet = true;
  ++state.pending_cosmetics;
  state.snapshot.AsyncCall(&RuleSnapshot::QueryReviewedPassiveScriptlets)
      .WithArgs(std::move(url))
      .Then(base::BindOnce(
          [](uint64_t revision, base::OnceCallback<void(uint32_t)> reply,
             uint32_t result) {
            auto& current = GetState();
            current.pending_passive_scriptlet = false;
            --current.pending_cosmetics;
            if (!current.ready || revision != current.active_refresh_revision ||
                revision != current.refresh_revision) {
              result = 0;
            }
            std::move(reply).Run(result);
          },
          state.active_refresh_revision, std::move(callback)));
  return true;
}

uint64_t AutomaticCosmeticRevision() {
  return GetState().active_refresh_revision;
}

void QueryRawSPassiveProcedures(
    GURL url, base::OnceCallback<void(std::string)> reply) {
  auto& state = GetState();
  if (!state.ready || state.pending_procedures >= 2) {
    std::move(reply).Run({});
    return;
  }
  ++state.pending_procedures;
  const uint64_t revision = state.active_refresh_revision;
  state.snapshot.AsyncCall(&RuleSnapshot::PassiveProcedures)
      .WithArgs(std::move(url))
      .Then(base::BindOnce(
          [](uint64_t revision,
             base::OnceCallback<void(std::string)> reply, std::string wire) {
            --GetState().pending_procedures;
            if (revision != GetState().active_refresh_revision) wire.clear();
            std::move(reply).Run(std::move(wire));
          }, revision, std::move(reply)));
}

bool TryQueryWarmHideStyles(
    GURL url, bool is_primary_main_frame,
    base::OnceCallback<void(std::string)> reply) {
  auto& state = GetState();
  if (!state.ready) return false;
  if (!CanAdmitCosmetic(state.pending_cosmetics, is_primary_main_frame)) {
    if (is_primary_main_frame) {
      TRACE_EVENT_INSTANT("navigation", "RawS.StaticCosmeticAdmissionSkipped");
    }
    return false;
  }
  ++state.pending_cosmetics;
  state.snapshot.AsyncCall(&RuleSnapshot::Style)
      .WithArgs(std::move(url))
      .Then(base::BindOnce(
          [](bool is_primary_main_frame,
             base::OnceCallback<void(std::string)> cb, std::string css) {
            --GetState().pending_cosmetics;
            if (is_primary_main_frame) {
              TRACE_EVENT_INSTANT("navigation", "RawS.StaticCosmeticResult",
                                  "has_css", !css.empty());
            }
            std::move(cb).Run(std::move(css));
          },
          is_primary_main_frame, std::move(reply)));
  return true;
}

void QueryHideStyles(GURL url,
                     bool is_primary_main_frame,
                     base::OnceCallback<void(std::string)> reply) {
  auto& state = GetState();
  if (!state.ready) {
    if (state.attempted && !state.failed && url.spec().size() <= 16 * 1024) {
      const bool queued = state.cosmetic_waiters.Push(
          base::TimeTicks::Now(), is_primary_main_frame,
          base::BindOnce(&QueryHideStyles, std::move(url),
                         is_primary_main_frame, std::move(reply)));
      if (is_primary_main_frame) {
        TRACE_EVENT_INSTANT("navigation", "RawS.StaticCosmeticCold",
                            "queued", queued);
      }
    }
    return;
  }

  TryQueryWarmHideStyles(std::move(url), is_primary_main_frame,
                         std::move(reply));
}

bool CheckSubframe(GURL target,const url::Origin& initiator,base::OnceCallback<void(bool)> reply) {
  auto& s=GetState();if(!s.ready || s.pending>=kMaxPendingChecks) return false;
  ++s.pending;s.snapshot.AsyncCall(&RuleSnapshot::Evaluate).WithArgs(std::move(target),Resource::kSubFrame,initiator,std::string("GET")).Then(
    base::BindOnce([](base::OnceCallback<void(bool)> cb,Action result){--GetState().pending;std::move(cb).Run(result==Action::kBlock);},std::move(reply)));
  return true;
}

void MaybeAppendDocumentSubresourceFactory(
    network::URLLoaderFactoryBuilder& builder,
    const url::Origin& document_origin,
    base::RepeatingCallback<bool()> site_gate,
    ScopedUserRuleQuery scoped_user_rules,
    base::RepeatingClosure on_document_request_blocked) {
  const auto& state = GetState();
  if (!state.attempted || state.failed || document_origin.opaque() ||
      (document_origin.scheme() != "http" && document_origin.scheme() != "https")) {
    return;
  }
  auto [receiver, downstream] = builder.Append();
  mojo::MakeSelfOwnedReceiver(
      std::make_unique<RequestFactory>(std::move(downstream), document_origin,
                                       std::move(site_gate), std::move(scoped_user_rules),
                                       std::move(on_document_request_blocked)),
      std::move(receiver));
}

