class ScopedUserRules::Impl {
 public:
  Impl() = default;
  ~Impl() = default;

  bool Replace(std::string rules, base::OnceCallback<bool()> may_publish,
               base::OnceCallback<void(bool)> completion) {
    auto count = CountSupportedCustomRules(rules);
    if (rebuilding_ || !count || !base::IsStringUTF8(rules)) return false;
    if (count->total() == 0) {
      if (may_publish && !std::move(may_publish).Run()) return false;
      ++generation_;
      active_.Reset();
      active_has_network_ = active_has_cosmetics_ = false;
      std::move(completion).Run(true);
      return true;
    }
    rebuilding_ = true;
    candidate_has_network_ = count->network != 0;
    candidate_has_cosmetics_ = count->cosmetic != 0;
    candidate_ = base::SequenceBound<ScopedUserRulesSnapshot>(
        base::ThreadPool::CreateSequencedTaskRunner(
            {base::TaskPriority::USER_VISIBLE}));
    candidate_.AsyncCall(&ScopedUserRulesSnapshot::Install)
        .WithArgs(std::move(rules))
        .Then(base::BindOnce(&Impl::OnCompiled, weak_.GetWeakPtr(),
                             std::move(may_publish), std::move(completion)));
    return true;
  }

  bool Query(GURL url, int resource, url::Origin initiator, std::string method,
             base::OnceCallback<void(bool)> result) {
    if (active_.is_null() || !active_has_network_) return false;
    active_.AsyncCall(&ScopedUserRulesSnapshot::Block)
        .WithArgs(std::move(url), resource, std::move(initiator),
                  std::move(method))
        .Then(base::BindOnce(
            [](base::WeakPtr<Impl> owner, uint64_t generation,
               base::OnceCallback<void(bool)> reply, bool block) {
              std::move(reply).Run(
                  owner && owner->generation_ == generation && block);
            },
            weak_.GetWeakPtr(), generation_, std::move(result)));
    return true;
  }

  void QueryStyles(GURL url, base::OnceCallback<void(std::string)> reply) {
    if (active_.is_null() || !active_has_cosmetics_) {
      if (rebuilding_ && candidate_has_cosmetics_ &&
          initial_style_waiters_.size() < 32) {
        initial_style_waiters_.emplace_back(std::move(url), std::move(reply));
      } else {
        std::move(reply).Run({});
      }
      return;
    }
    active_.AsyncCall(&ScopedUserRulesSnapshot::Style)
        .WithArgs(std::move(url))
        .Then(base::BindOnce(
            [](base::WeakPtr<Impl> owner, uint64_t generation,
               base::OnceCallback<void(std::string)> deliver, std::string css) {
              if (owner && owner->generation_ == generation)
                std::move(deliver).Run(std::move(css));
            },
            weak_.GetWeakPtr(), generation_, std::move(reply)));
  }

 private:
  void OnCompiled(base::OnceCallback<bool()> may_publish,
                  base::OnceCallback<void(bool)> completion, bool ready) {
    if (ready && may_publish) ready = std::move(may_publish).Run();
    rebuilding_ = false;
    if (ready) {
      ++generation_;
      active_ = std::move(candidate_);
      active_has_network_ = candidate_has_network_;
      active_has_cosmetics_ = candidate_has_cosmetics_;
    } else {
      candidate_.Reset();
    }
    // Queue only first cosmetics lookups for an otherwise empty layer.
    // This never participates in the URLLoader/network or navigation wait.
    for (auto& [url, reply] : std::exchange(initial_style_waiters_, {}))
      QueryStyles(std::move(url), std::move(reply));
    std::move(completion).Run(ready);
  }

  bool rebuilding_ = false;
  bool active_has_network_ = false;
  bool active_has_cosmetics_ = false;
  bool candidate_has_network_ = false;
  bool candidate_has_cosmetics_ = false;
  std::vector<std::pair<GURL, base::OnceCallback<void(std::string)>>> initial_style_waiters_;
  uint64_t generation_ = 0;
  base::SequenceBound<ScopedUserRulesSnapshot> active_, candidate_;
  base::WeakPtrFactory<Impl> weak_{this};
};

