# Isolated experimental target; no production target depends on it.
source_set("request_matcher") {
  sources = [
    "network_decision.h",
    "request_matcher.cc",
    "request_matcher.h",
    "standard_merge.h",
    "subresource_decision.cc",
    "subresource_decision.h",
  ]
  public_deps = [
    "//brave/components/brave_shields/core/common/adblock",
    "//third_party/blink/public/mojom:mojom_platform_headers",
    "//url",
  ]
  deps = [ "//net" ]
}

if (is_android) {
  source_set("document_subresource_factory") {
    public = [ "document_subresource_factory.h" ]
    sources = [ "document_subresource_factory.cc" ]
    deps = [
      ":request_matcher",
      "//base",
      "//mojo/public/cpp/bindings",
      "//net",
      "//services/network/public/cpp",
      "//services/network/public/mojom",
    ]
  }
}

executable("engine_smoke") {
  testonly = true
  sources = [ "engine_smoke.cc" ]
  deps = [ ":request_matcher" ]
}

# Diagnostic root in an Android GN configuration. Compile the runnable native
# smoke for the build host, not an Android binary the host cannot execute.
group("host_smoke") {
  testonly = true
  deps = [ ":engine_smoke($host_toolchain)" ]
}
