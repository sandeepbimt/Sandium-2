package org.chromium.chrome.browser.ui.appmenu;

import org.chromium.chrome.browser.ui.appmenu.internal.R;
import java.util.List;

/** Product presentation slots. A key never confers permission or creates a Chromium action. */
final class RawSParityMenuCatalog {
    private RawSParityMenuCatalog() {}

    static String canonical(String key) {
        return "homepage_menu_id".equals(key) ? "home_menu_id" : key;
    }

    static List<String> placeholders(boolean recentTabs) {
        if (recentTabs) return List.of(
                "new_tab_menu_id", "new_incognito_tab_menu_id", "add_to_group_menu_id",
                "recent_tabs_menu_id", "home_menu_id", "reload_menu_id", "info_menu_id",
                "exit_id", "sandium_add_home_shortcut", "bookmark_this_page_id",
                "download_page_id", "share_menu_id");
        return List.of(
                "new_tab_menu_id", "new_incognito_tab_menu_id", "find_in_page_id",
                "request_desktop_site_id", "sandium_add_home_shortcut", "brave_shred_id",
                "reload_menu_id", "exit_id", "share_menu_id", "download_page_id",
                "bookmark_this_page_id", "universal_install", "reader_mode_menu_id",
                "translate_id", "add_to_group_menu_id", "info_menu_id", "recent_tabs_menu_id",
                "home_menu_id");
    }

    static int placeholderTitle(String key) {
        return switch (key) {
            case "new_tab_menu_id" -> R.string.raws_parity_menu_new_tab;
            case "new_incognito_tab_menu_id" -> R.string.sandium_menu_private_tab;
            case "find_in_page_id" -> R.string.raws_parity_menu_find;
            case "request_desktop_site_id" -> R.string.raws_parity_menu_desktop;
            case "sandium_add_home_shortcut" -> R.string.sandium_menu_add_home;
            case "brave_shred_id" -> R.string.sandium_menu_shred;
            case "reload_menu_id" -> R.string.sandium_menu_reload;
            case "exit_id" -> R.string.raws_parity_menu_exit;
            case "share_menu_id" -> R.string.raws_parity_menu_share;
            case "download_page_id" -> R.string.sandium_menu_save_page;
            case "bookmark_this_page_id" -> R.string.sandium_menu_bookmark;
            case "universal_install" -> R.string.sandium_menu_install;
            case "reader_mode_menu_id" -> R.string.sandium_menu_reader;
            case "translate_id" -> R.string.sandium_menu_translate;
            case "add_to_group_menu_id" -> R.string.sandium_menu_group_tab;
            case "info_menu_id" -> R.string.raws_parity_menu_site_controls;
            case "recent_tabs_menu_id" -> R.string.raws_parity_menu_recent;
            case "home_menu_id" -> R.string.sandium_menu_home;
            default -> throw new IllegalArgumentException("Unknown placeholder");
        };
    }

    static boolean excluded(String key) {
        return "glic_menu_id".equals(key) || "default_browser_promo_menu_id".equals(key)
                || "brave_customize_menu_id".equals(key);
    }

    static int donorIcon(String key) {
        if (key == null) return 0;
        return switch (key) {
            case "new_tab_menu_id" -> R.drawable.raws_sandium_menu_new_tab;
            case "new_incognito_tab_menu_id", "new_incognito_window_menu_id" ->
                    R.drawable.raws_sandium_menu_private_tab;
            case "find_in_page_id" -> R.drawable.raws_sandium_menu_find;
            case "request_desktop_site_id" -> R.drawable.raws_sandium_menu_desktop;
            case "sandium_add_home_shortcut" -> R.drawable.raws_sandium_menu_add_home;
            case "brave_shred_id" -> R.drawable.raws_sandium_menu_shred;
            case "reload_menu_id" -> R.drawable.raws_sandium_menu_reload;
            case "exit_id" -> R.drawable.raws_sandium_menu_exit;
            case "share_menu_id" -> R.drawable.raws_sandium_menu_share;
            case "download_page_id" -> R.drawable.raws_sandium_menu_save;
            case "bookmark_this_page_id" -> R.drawable.raws_sandium_menu_bookmark;
            case "universal_install" -> R.drawable.raws_sandium_menu_install;
            case "reader_mode_menu_id" -> R.drawable.raws_sandium_menu_reader;
            case "translate_id" -> R.drawable.raws_sandium_menu_translate;
            case "add_to_group_menu_id" -> R.drawable.raws_sandium_menu_group;
            case "info_menu_id" -> R.drawable.raws_sandium_menu_site;
            case "recent_tabs_menu_id" -> R.drawable.raws_sandium_menu_recent;
            case "home_menu_id" -> R.drawable.raws_sandium_menu_home;
            case "raws_home_toggle_shortcuts" -> R.drawable.raws_sandium_menu_home;
            case "raws_home_upload_image" -> R.drawable.raws_sandium_menu_add_home;
            case "all_bookmarks_menu_id" -> R.drawable.raws_sandium_menu_bookmarks;
            case "open_history_menu_id" -> R.drawable.raws_sandium_menu_history;
            case "downloads_menu_id" -> R.drawable.raws_sandium_menu_downloads;
            case "preferences_id" -> R.drawable.raws_sandium_menu_settings;
            default -> 0;
        };
    }
}
