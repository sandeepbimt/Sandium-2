package org.chromium.chrome.browser.ntp;

import android.content.Context;
import android.util.AttributeSet;
import android.view.View;
import android.view.ViewGroup;
import android.view.ViewStub;
import android.widget.LinearLayout;

import org.chromium.base.Log;
import org.chromium.build.annotations.NullMarked;
import org.chromium.build.annotations.Nullable;
import org.chromium.chrome.R;
import org.chromium.chrome.browser.ui.theme.ChromeSemanticColorUtils;

/**
 * Layout for the new tab page. This positions the page elements in the correct vertical positions.
 * There are no separate phone and tablet UIs; this layout adapts based on the available space.
 */
@NullMarked
public class NewTabPageLayout extends LinearLayout {
    /** Delegate to handle layout-related events. */
    public interface Delegate {
        /**
         * Called during the {@link #onMeasure(int, int)} pass.
         *
         * @param width The measured width of the layout.
         */
        void onMeasure(int width);

        /** Called when the layout is attached to a window. */
        void onAttachedToWindow();

        /** Called when the layout's window visibility changes to {@link View#VISIBLE}. */
        void updateActionButtonVisibility();
    }

    private static final String TAG = "NewTabPageLayout";

    private boolean mRawSLowerShortcutsEnabled;
    private int mRawSLowerShortcutsViewport;
    private @Nullable View mRawSLowerShortcutSpacer;
    private @Nullable View mRawSHomeSearchSpacer;
    private @Nullable View mRawSHomeSearchLauncher;
    private @Nullable Delegate mDelegate;
    private @Nullable View mSearchBoxView;
    private @Nullable View mComposeplateAndMvtContainer;

    /** Constructor for inflating from XML. */
    public NewTabPageLayout(Context context, AttributeSet attrs) {
        super(context, attrs);
    }

    @Override
    protected void onFinishInflate() {
        super.onFinishInflate();

        setBackgroundColor(ChromeSemanticColorUtils.getHomeSurfaceBackgroundColor(getContext()));

        // TODO(crbug.com/347509698): Remove the log statements after fixing the bug.
        Log.i(TAG, "NewTabPageLayout.onFinishInflate before insertSiteSectionView");

        initializeSiteSectionView();

        Log.i(TAG, "NewTabPageLayout.onFinishInflate after insertSiteSectionView");
    }

    @Override
    protected void onMeasure(int widthMeasureSpec, int heightMeasureSpec) {
        if (mDelegate != null) {
            int width = MeasureSpec.getSize(widthMeasureSpec);
            mDelegate.onMeasure(width);
        }

        super.onMeasure(widthMeasureSpec, heightMeasureSpec);
        View lower = mRawSLowerShortcutSpacer;
        View upper = mRawSHomeSearchSpacer;
        if (lower == null && upper == null) return;
        int previousLower = lower == null ? 0 : lower.getLayoutParams().height;
        int previousUpper = upper == null ? 0 : upper.getLayoutParams().height;
        boolean trayAvailable = hasVisibleRawSShortcutTray();
        int lowerBudget = lower != null && trayAvailable
                ? measureRawSLowerShortcutsGap(lower, previousLower + previousUpper) : 0;
        int upperBudget = lowerBudget;
        if (!trayAvailable) {
            // My shortcuts Off does not move the search pill back to the top.
            upperBudget = rawSHomeSearchSpaceWithoutTray(
                    mRawSLowerShortcutsViewport, getMeasuredHeight() - previousUpper - previousLower,
                    getResources().getDisplayMetrics().density);
        }
        int upperGap = upper == null ? 0 : measureRawSHomeSearchGap(upperBudget, previousUpper);
        boolean changed = updateRawSSpacer(upper, upperGap);
        changed |= updateRawSSpacer(lower, Math.max(0, lowerBudget - upperGap));
        if (changed) super.onMeasure(widthMeasureSpec, heightMeasureSpec);
    }

    void setRawSHomeSearchLauncher(View launcher) {
        if (mRawSHomeSearchSpacer != null || launcher.getParent() != this) return;
        View spacer = new View(getContext());
        spacer.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
        mRawSHomeSearchSpacer = spacer;
        mRawSHomeSearchLauncher = launcher;
        addView(spacer, indexOfChild(launcher), new LinearLayout.LayoutParams(0, 0));
    }

    private static boolean updateRawSSpacer(@Nullable View spacer, int height) {
        if (spacer == null || spacer.getLayoutParams().height == height) return false;
        spacer.getLayoutParams().height = height;
        spacer.forceLayout();
        return true;
    }

    private boolean hasVisibleRawSShortcutTray() {
        View tray = findViewById(R.id.mv_tiles_container);
        return tray != null && tray.getParent() == this && tray.getVisibility() == VISIBLE
                && tray.getMeasuredHeight() > 0;
    }

    private int measureRawSHomeSearchGap(int budget, int previousUpper) {
        View launcher = mRawSHomeSearchLauncher;
        if (launcher == null || launcher.getVisibility() == GONE) return 0;
        int center = getPaddingTop();
        for (int i = 0; i < getChildCount(); i++) {
            View child = getChildAt(i);
            if (child == mRawSHomeSearchSpacer || child.getVisibility() == GONE) continue;
            var margins = (LinearLayout.LayoutParams) child.getLayoutParams();
            center += margins.topMargin;
            if (child == launcher) {
                return rawSHomeSearchUpperGap(mRawSLowerShortcutsViewport,
                        center + child.getMeasuredHeight() / 2, budget);
            }
            center += child.getMeasuredHeight() + margins.bottomMargin;
        }
        return previousUpper;
    }

    static int rawSHomeSearchUpperGap(int viewportHeight, int naturalSearchCenter, int budget) {
        int target = Math.round(viewportHeight * .51f);
        return Math.max(0, Math.min(budget, target - naturalSearchCenter));
    }

    static int rawSHomeSearchSpaceWithoutTray(int viewportHeight, int contentHeight, float density) {
        if (viewportHeight < Math.round(500f * density)) return 0;
        return Math.max(0, viewportHeight - Math.round(96f * density) - contentHeight);
    }

    /** Only RawS's regular phone Home opts in; the native tiles retain their original parent. */
    void setRawSLowerShortcutsEnabled(boolean enabled) {
        mRawSLowerShortcutsEnabled = enabled;
        if (!enabled || mRawSLowerShortcutSpacer != null) return;
        View tray = findViewById(R.id.mv_tiles_container);
        if (tray == null || tray.getParent() != this) return;
        View spacer = new View(getContext());
        spacer.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
        mRawSLowerShortcutSpacer = spacer;
        addView(spacer, indexOfChild(tray), new LinearLayout.LayoutParams(0, 0));
    }

    /** Supplies bounded native content height before the RecyclerView measures its header. */
    public boolean setRawSLowerShortcutsViewport(int viewportHeight) {
        if ((!mRawSLowerShortcutsEnabled && mRawSHomeSearchSpacer == null)
                || mRawSLowerShortcutsViewport == viewportHeight) {
            return false;
        }
        mRawSLowerShortcutsViewport = viewportHeight;
        return true;
    }

    private int measureRawSLowerShortcutsGap(View spacer, int previousGap) {
        View tray = findViewById(R.id.mv_tiles_container);
        if (tray == null || tray.getParent() != this || tray.getVisibility() != VISIBLE
                || tray.getMeasuredHeight() == 0) return 0;
        int trayTop = getPaddingTop();
        for (int i = 0; i < getChildCount(); i++) {
            View child = getChildAt(i);
            if (child == spacer || child == mRawSHomeSearchSpacer
                    || child.getVisibility() == GONE) continue;
            var margins = (LinearLayout.LayoutParams) child.getLayoutParams();
            trayTop += margins.topMargin;
            if (child == tray) break;
            trayTop += child.getMeasuredHeight() + margins.bottomMargin;
        }
        return rawSLowerShortcutsGap(
                mRawSLowerShortcutsViewport,
                trayTop + tray.getMeasuredHeight(),
                Math.max(getMeasuredHeight() - previousGap, trayTop + tray.getMeasuredHeight()),
                getResources().getDisplayMetrics().density);
    }

    static int rawSLowerShortcutsGap(
            int viewportHeight, int trayBottom, int contentBottom, float density) {
        if (viewportHeight < Math.round(500f * density)) return 0;
        // A fixed bottom edge above the edit affordance, with the original one-row
        // anchor as a ceiling. Adding whole rows therefore grows toward the top.
        int target = Math.round(viewportHeight * 0.79f + 38f * density);
        int availableBottom = viewportHeight - Math.round(96f * density);
        return Math.max(0, Math.min(target - trayBottom, availableBottom - contentBottom));
    }


    @Override
    protected void onAttachedToWindow() {
        super.onAttachedToWindow();
        if (mDelegate != null) {
            mDelegate.onAttachedToWindow();
        }
    }

    @Override
    protected void onWindowVisibilityChanged(int visibility) {
        super.onWindowVisibilityChanged(visibility);

        if (visibility == VISIBLE && mDelegate != null) {
            mDelegate.updateActionButtonVisibility();
        }
    }

    private void initializeSiteSectionView() {
        boolean isBesideMvt = NewTabPageUtils.isBesideMvtModuleEnabled();
        int stubId =
                isBesideMvt ? R.id.composeplate_and_mvt_container_stub : R.id.mv_tiles_layout_stub;
        var siteSectionView = (ViewGroup) ((ViewStub) findViewById(stubId)).inflate();
        if (isBesideMvt) {
            mComposeplateAndMvtContainer = siteSectionView;
        }
        siteSectionView.setVisibility(View.VISIBLE);
        // The page contents are initially hidden; otherwise they'll be drawn centered on the
        // page before the tiles are available and then jump upwards to make space once the
        // tiles are available.
        if (getVisibility() != View.VISIBLE) setVisibility(View.VISIBLE);
    }

    /**
     * Sets the layout width of the container holding the composeplate and most visited tiles when
     * the beside-MVT layout is enabled.
     *
     * @param width The target width in pixels.
     */
    void setComposeplateAndMvtContainerWidth(int width) {
        if (mComposeplateAndMvtContainer == null) {
            mComposeplateAndMvtContainer = findViewById(R.id.composeplate_and_mvt_container);
        }
        if (mComposeplateAndMvtContainer == null) return;

        ViewGroup.LayoutParams layoutParams = mComposeplateAndMvtContainer.getLayoutParams();
        if (layoutParams == null || layoutParams.width == width) return;

        layoutParams.width = width;
        mComposeplateAndMvtContainer.setLayoutParams(layoutParams);
    }

    /** Sets the delegate instance. */
    void setDelegate(Delegate delegate) {
        mDelegate = delegate;
    }

    /** Sets the search box view. */
    public void setSearchBoxView(View view) {
        mSearchBoxView = view;
    }

    /**
     * Sets the translation_y of the fakebox and all views above it, but not the views below. Used
     * when the url focus animation is combined with the omnibox suggestions list animation to
     * reduce the number of visual elements in motion.
     */
    void setTranslationYOfFakeboxAndAbove(float translationY) {
        for (int i = 0; i < getChildCount(); i++) {
            View view = getChildAt(i);
            view.setTranslationY(translationY);
            if (view == mSearchBoxView) return;
        }
    }
}
