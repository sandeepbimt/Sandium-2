package org.chromium.chrome.browser.night_mode;

import org.chromium.build.annotations.NullMarked;
import org.chromium.chrome.browser.profiles.Profile;
import org.chromium.components.browser_ui.site_settings.WebsitePreferenceBridge;
import org.chromium.components.content_settings.ContentSetting;
import org.chromium.components.content_settings.ContentSettingsType;
import org.chromium.url.GURL;

/** Sandium's controls for Chromium's native auto-dark content setting. */
@NullMarked
public final class RawSDarkPages {
    private static final int TYPE = ContentSettingsType.AUTO_DARK_WEB_CONTENT;

    private RawSDarkPages() {}

    private static boolean canManage(Profile profile) {
        return profile.isNativeInitialized()
                && !WebsitePreferenceBridge.isContentSettingManaged(profile, TYPE)
                && !WebsitePreferenceBridge.isContentSettingManagedByCustodian(profile, TYPE);
    }

    public static boolean canManageGlobal(Profile profile) {
        return canManage(profile) && !profile.isOffTheRecord();
    }

    public static boolean getGlobal(Profile profile) {
        return profile.isNativeInitialized()
                && WebContentsDarkModeController.isGlobalUserSettingsEnabled(profile);
    }

    public static boolean setGlobal(Profile profile, boolean enabled) {
        if (!canManageGlobal(profile)) return false;
        WebContentsDarkModeController.setGlobalUserSettings(profile, enabled);
        return getGlobal(profile) == enabled;
    }

    // Scope is native top-origin-only. Exclude browser/native/internal surfaces.
    public static boolean canManageSite(Profile profile, GURL url) {
        return isWebUrl(url) && canManage(profile);
    }

    public static boolean isDarkForSite(Profile profile, GURL url) {
        return isWebUrl(url) && profile.isNativeInitialized()
                && WebsitePreferenceBridge.getContentSetting(profile, TYPE, url, url)
                        == ContentSetting.ALLOW;
    }

    public static boolean setSite(Profile profile, GURL url, boolean enabled) {
        if (!canManageSite(profile, url)) return false;
        // Both choices are explicit, so they survive later global changes. OTR writes use
        // Chromium's OTR content-settings map; no fallback write to its regular Profile.
        WebsitePreferenceBridge.setContentSettingDefaultScope(
                profile, TYPE, url, url, enabled ? ContentSetting.ALLOW : ContentSetting.BLOCK);
        return isDarkForSite(profile, url) == enabled;
    }

    public static boolean resetSite(Profile profile, GURL url) {
        if (!canManageSite(profile, url)) return false;
        WebsitePreferenceBridge.setContentSettingDefaultScope(
                profile, TYPE, url, url, ContentSetting.DEFAULT);
        return isDarkForSite(profile, url)
                == (profile.isOffTheRecord()
                        ? isDarkForSite(profile.getOriginalProfile(), url)
                        : getGlobal(profile));
    }

    private static boolean isWebUrl(GURL url) {
        return url.isValid() && ("https".equals(url.getScheme()) || "http".equals(url.getScheme()));
    }
}
