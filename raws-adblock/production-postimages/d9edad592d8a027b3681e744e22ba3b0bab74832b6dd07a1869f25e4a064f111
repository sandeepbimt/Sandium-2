package org.chromium.components.webapps;

import android.content.Context;
import android.graphics.Bitmap;
import android.view.View;
import java.util.function.Consumer;
import org.chromium.build.annotations.NullMarked;
import org.chromium.build.annotations.Nullable;

/**
 * Used by {@link AddToHomescreenDialogView} to propagate view events to {@link
 * AddToHomescreenMediator}.
 */
@NullMarked
public interface AddToHomescreenViewDelegate {
    /** Optional embedder-owned controls. This component does not depend on Chrome resources. */
    interface LocalIconFactory {
        LocalIconControls create(Context context, Runnable choose, Runnable reset);
        boolean canUse();
        String pinButtonText();
    }

    interface LocalIconControls {
        View getView();
        void render(boolean eligible, boolean busy, boolean custom, boolean failed);
    }

    default void attachLocalIconUi(Consumer<LocalIconState> render) {}
    default void chooseLocalIcon() {}
    default void resetLocalIcon() {}

    /** Returns false when the selected local icon could not be installed. No implicit fallback. */
    default boolean trySubmit(String title) {
        onAddToHomescreen(title);
        return true;
    }

    record LocalIconState(
            boolean eligible, boolean busy, @Nullable Bitmap customIcon, boolean failed) {}

    /** Called when the user accepts adding the item to home screen with the provided title. */
    void onAddToHomescreen(String title);

    /**
     * Called when the user requests app details.
     *
     * @return Whether the view should be dismissed.
     */
    boolean onAppDetailsRequested();

    /** Called when the user doesn't accept adding the item to home screen and the view is dismissed. */
    void onViewDismissed();
}
