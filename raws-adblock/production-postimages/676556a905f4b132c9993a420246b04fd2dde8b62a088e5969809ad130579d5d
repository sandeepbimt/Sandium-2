package org.chromium.chrome.browser.settings;

import android.app.Activity;
import android.graphics.Color;
import android.graphics.Typeface;
import android.os.Handler;
import android.os.Looper;
import android.text.InputType;
import android.view.Gravity;
import android.view.View;
import android.view.ViewGroup;
import android.widget.Button;
import android.widget.EditText;
import android.widget.LinearLayout;
import android.widget.RadioButton;
import android.widget.RadioGroup;
import android.widget.ScrollView;
import android.widget.TextView;
import android.widget.Toast;

import androidx.appcompat.app.AlertDialog;

import org.chromium.build.annotations.NullMarked;
import org.chromium.build.annotations.Nullable;
import org.chromium.chrome.R;

/** Chrome-owned view for a single typed, immutable live element selection. */
@NullMarked
public final class RawSColorChooser {
    public interface Actions {
        void preview(int property, int rgb);
        void save(int property, int rgb);
        void clear();
        void cancel();
    }

    private RawSColorChooser() {}

    /** Called on the UI thread after a real native hit-test has selected the element. */
    public static Handle show(Activity activity, boolean image, Actions actions) {
        var wrapper = new LinearLayout(activity);
        wrapper.setOrientation(LinearLayout.VERTICAL);
        int inset = Math.round(20 * activity.getResources().getDisplayMetrics().density);
        wrapper.setPaddingRelative(inset, 0, inset, 0);
        var target = new RadioGroup(activity);
        target.setOrientation(LinearLayout.VERTICAL);
        target.setContentDescription(activity.getString(R.string.raws_shields_color_target));
        addTarget(activity, target, R.string.raws_shields_color_text, 0);
        int background = addTarget(activity, target, R.string.raws_shields_color_background, 1);
        if (image) addTarget(activity, target, R.string.raws_shields_color_artwork, 2);
        target.check(background);
        wrapper.addView(target, ViewGroup.LayoutParams.MATCH_PARENT,
                ViewGroup.LayoutParams.WRAP_CONTENT);

        var field = new EditText(activity);
        field.setContentDescription(activity.getString(R.string.raws_shields_color_hex));
        field.setHint(R.string.raws_shields_color_hex);
        field.setText("#EEEEEE");
        field.setSingleLine(true);
        field.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS
                | InputType.TYPE_TEXT_FLAG_CAP_CHARACTERS);
        field.setTypeface(Typeface.MONOSPACE);
        wrapper.addView(field, ViewGroup.LayoutParams.MATCH_PARENT,
                ViewGroup.LayoutParams.WRAP_CONTENT);

        var swatch = new TextView(activity);
        swatch.setImportantForAccessibility(TextView.IMPORTANT_FOR_ACCESSIBILITY_NO);
        swatch.setMinHeight(Math.round(20 * activity.getResources().getDisplayMetrics().density));
        swatch.setBackgroundColor(Color.rgb(238, 238, 238));
        wrapper.addView(swatch, ViewGroup.LayoutParams.MATCH_PARENT,
                ViewGroup.LayoutParams.WRAP_CONTENT);

        var presets = new LinearLayout(activity);
        for (String hex : new String[] {"#EEEEEE", "#1A1A1A", "#000000", "#408CFF"}) {
            var button = new Button(activity);
            button.setText("●");
            button.setTextColor(Color.parseColor(hex));
            button.setContentDescription(activity.getString(R.string.raws_shields_color_preset, hex));
            button.setMinWidth(0);
            button.setOnClickListener(view -> {
                field.setText(hex);
                swatch.setBackgroundColor(Color.parseColor(hex));
            });
            presets.addView(button, new LinearLayout.LayoutParams(
                    0, Math.round(48 * activity.getResources().getDisplayMetrics().density), 1));
        }
        wrapper.addView(presets);
        var reset = new Button(activity);
        reset.setText(R.string.raws_shields_color_reset);
        reset.setAllCaps(false);
        reset.setMinHeight(Math.round(48 * activity.getResources().getDisplayMetrics().density));
        wrapper.addView(reset);

        var scroll = new ScrollView(activity);
        scroll.addView(wrapper);
        var dialog = new AlertDialog.Builder(activity, R.style.ThemeOverlay_BrowserUI_AlertDialog)
                .setTitle(R.string.raws_shields_correct_colors)
                .setMessage(R.string.raws_shields_color_editor_help)
                .setView(scroll)
                .setPositiveButton(R.string.raws_shields_color_save, null)
                .setNeutralButton(R.string.raws_shields_color_preview, null)
                .setNegativeButton(android.R.string.cancel, null)
                .create();
        var handle = new Handle(activity, image, dialog, target, field, swatch, presets, reset, actions);
        reset.setOnClickListener(view -> handle.confirmClear());
        dialog.setOnDismissListener(ignored -> handle.onDismiss());
        dialog.setOnShowListener(ignored -> {
            dialog.getButton(AlertDialog.BUTTON_NEUTRAL)
                    .setOnClickListener(view -> handle.submit(false));
            dialog.getButton(AlertDialog.BUTTON_POSITIVE)
                    .setOnClickListener(view -> handle.submit(true));
        });
        dialog.show();
        var window = dialog.getWindow();
        if (window != null) window.setGravity(Gravity.BOTTOM);
        return handle;
    }

    private static int addTarget(Activity activity, RadioGroup group, int label, int property) {
        var choice = new RadioButton(activity);
        choice.setId(View.generateViewId());
        choice.setText(label);
        choice.setTag(property);
        group.addView(choice);
        return choice.getId();
    }

    public static final class Handle {
        private final Activity mActivity;
        private final boolean mArtworkAllowed;
        private final AlertDialog mDialog;
        private final RadioGroup mTarget;
        private final EditText mField;
        private final TextView mSwatch;
        private final LinearLayout mPresets;
        private final Button mReset;
        private final Actions mActions;
        private boolean mClosed;
        private boolean mInFlight;
        private boolean mSaving;
        private boolean mClearing;
        private @Nullable AlertDialog mClearDialog;
        private boolean mShowingPreview;
        private float mPreviewDim;
        private final Handler mHandler = new Handler(Looper.getMainLooper());
        private final Runnable mRestorePreviewWindow = this::restorePreviewWindow;

        private Handle(Activity activity, boolean image, AlertDialog dialog,
                RadioGroup target, EditText field, TextView swatch, LinearLayout presets,
                Button reset, Actions actions) {
            mActivity = activity;
            mArtworkAllowed = image;
            mDialog = dialog;
            mTarget = target;
            mField = field;
            mSwatch = swatch;
            mPresets = presets;
            mReset = reset;
            mActions = actions;
        }

        private void submit(boolean save) {
            if (mClosed || mInFlight || mClearDialog != null) return;
            var selected = mTarget.findViewById(mTarget.getCheckedRadioButtonId());
            if (selected == null || !(selected.getTag() instanceof Integer property)
                    || property < 0 || property > (mArtworkAllowed ? 2 : 1)) return;
            var input = mField.getText();
            int rgb = input == null ? -1 : parseOpaqueRgb(input.toString());
            if (rgb < 0) {
                mField.setError(mActivity.getString(R.string.raws_shields_color_invalid));
                return;
            }
            mSwatch.setBackgroundColor(0xff000000 | rgb);
            setBusy(true, save);
            if (save) {
                mActions.save(property, rgb);
            } else {
                mActions.preview(property, rgb);
            }
        }

        private void setBusy(boolean busy, boolean saving) {
            mInFlight = busy;
            mSaving = busy && saving;
            if (!busy) mClearing = false;
            mDialog.setCancelable(!mSaving);
            mDialog.getButton(AlertDialog.BUTTON_POSITIVE).setEnabled(!busy);
            mDialog.getButton(AlertDialog.BUTTON_NEUTRAL).setEnabled(!busy);
            mDialog.getButton(AlertDialog.BUTTON_NEGATIVE).setEnabled(!mSaving);
            mField.setEnabled(!busy);
            mReset.setEnabled(!busy);
            for (int i = 0; i < mTarget.getChildCount(); ++i) {
                mTarget.getChildAt(i).setEnabled(!busy);
            }
            for (int i = 0; i < mPresets.getChildCount(); ++i) {
                mPresets.getChildAt(i).setEnabled(!busy);
            }
        }

        /** Called only by the authoritative same-session native preview callback. */
        public void onPreviewResult(boolean applied) {
            if (mClosed || !mInFlight || mSaving || mShowingPreview) return;
            if (!applied) {
                setBusy(false, false);
                mField.setError(mActivity.getString(R.string.raws_shields_color_preview_failed));
                return;
            }
            var window = mDialog.getWindow();
            if (window == null) {
                setBusy(false, false);
                return;
            }
            // The browser dialog keeps the touch stream, but the live result is
            // visible. Never show a fake preview or let a tap through to the site.
            mShowingPreview = true;
            window.getDecorView().setAlpha(0f);
            mPreviewDim = window.getAttributes().dimAmount;
            window.setDimAmount(0f);
            mHandler.postDelayed(mRestorePreviewWindow, 1500);
        }

        private void restorePreviewWindow() {
            if (mClosed || !mShowingPreview) return;
            mShowingPreview = false;
            var window = mDialog.getWindow();
            if (window != null) {
                window.getDecorView().setAlpha(1f);
                window.setDimAmount(mPreviewDim);
            }
            setBusy(false, false);
        }

        /** The caller must pass true only once native verified durable persistence. */
        public void onSaveResult(boolean persisted) {
            if (mClosed || !mInFlight || !mSaving || mClearing) return;
            if (!persisted) {
                setBusy(false, false);
                mField.setError(mActivity.getString(R.string.raws_shields_color_save_failed));
                return;
            }
            close();
            Toast.makeText(mActivity, R.string.raws_shields_color_saved, Toast.LENGTH_SHORT).show();
        }

        private void confirmClear() {
            if (mClosed || mInFlight || mClearDialog != null) return;
            var confirmation =
                    new AlertDialog.Builder(mActivity, R.style.ThemeOverlay_BrowserUI_AlertDialog)
                            .setTitle(R.string.raws_shields_color_reset)
                            .setMessage(R.string.raws_shields_color_reset_question)
                            .setPositiveButton(R.string.raws_shields_color_reset_confirm,
                                    (ignored, which) -> requestClear())
                            .setNegativeButton(android.R.string.cancel, null)
                            .create();
            mClearDialog = confirmation;
            confirmation.setOnDismissListener(ignored -> {
                if (mClearDialog == confirmation) mClearDialog = null;
            });
            confirmation.show();
        }

        private void requestClear() {
            if (mClosed || mInFlight) return;
            setBusy(true, true);
            mClearing = true;
            mActions.clear();
        }

        /** True only when the exact owning native rule store confirmed durable clear. */
        public void onClearResult(boolean persisted) {
            if (mClosed || !mInFlight || !mClearing) return;
            if (!persisted) {
                setBusy(false, false);
                mField.setError(mActivity.getString(R.string.raws_shields_color_reset_failed));
                return;
            }
            close();
            Toast.makeText(mActivity, R.string.raws_shields_color_reset_done,
                    Toast.LENGTH_SHORT).show();
        }

        private void dismissClearConfirmation() {
            var clear = mClearDialog;
            mClearDialog = null;
            if (clear != null) clear.dismiss();
        }

        /** Lifecycle/controller-owned dismissal. Controller handles native cleanup. */
        public void close() {
            if (mClosed) return;
            mClosed = true;
            mHandler.removeCallbacks(mRestorePreviewWindow);
            dismissClearConfirmation();
            mDialog.dismiss();
        }

        private void onDismiss() {
            if (mClosed) return;
            mClosed = true;
            mHandler.removeCallbacks(mRestorePreviewWindow);
            dismissClearConfirmation();
            mActions.cancel();
        }
    }

    // Fixed six ASCII hex digits, with optional '#'. No CSS, alpha or named colors.
    static int parseOpaqueRgb(String value) {
        int start = value.startsWith("#") ? 1 : 0;
        if (value.length() != start + 6) return -1;
        int rgb = 0;
        for (int i = start; i < value.length(); ++i) {
            char c = value.charAt(i);
            int digit = c >= '0' && c <= '9' ? c - '0'
                    : c >= 'A' && c <= 'F' ? c - 'A' + 10
                    : c >= 'a' && c <= 'f' ? c - 'a' + 10 : -1;
            if (digit < 0) return -1;
            rgb = (rgb << 4) | digit;
        }
        return rgb;
    }
}
