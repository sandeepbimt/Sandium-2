/** Opt-in customization within Chromium's native menu, not a replacement window. */
final class RawSNativeMenu {
    private final Context context;
    private final RawSMenuStore store;
    private final LinkedHashMap<String, ListItem> catalog = new LinkedHashMap<>();
    private @Nullable ModelList nativeSource;
    private @Nullable ModelList projection;
    private @Nullable RawSMenuModel<ListItem> currentState;
    private @Nullable ListItem customizeItem;
    private @Nullable ListItem allOpenItem;
    private @Nullable ListItem allCloseItem;
    private boolean showingAll;
    private final ListObserver<Void> nativeObserver = new ListObserver<Void>() {
        @Override public void onItemRangeInserted(ListObservable source, int index, int count) { refresh(); }
        @Override public void onItemRangeRemoved(ListObservable source, int index, int count) { refresh(); }
        @Override public void onItemRangeChanged(ListObservable<Void> source, int index, int count,
                @Nullable Void payload) { refresh(); }
        @Override public void onItemMoved(ListObservable source, int from, int to) { refresh(); }
    };
    private final Map<String, Integer> groups = new HashMap<>();
    private @Nullable AlertDialog editorDialog;
    private @Nullable AlertDialog moveDialog;

    RawSNativeMenu(Context context) {
        this.context = context;
        store = new RawSMenuStore(context);
    }

    /** Never persist generated resource IDs or reinterpret compound/native protected rows. */
    @Nullable String key(ListItem item) {
        if (item.type != AppMenuItemType.STANDARD
                && item.type != AppMenuItemType.STANDARD_NO_ICON) return null;
        PropertyModel model = item.model;
        int itemId = model.get(AppMenuItemProperties.MENU_ITEM_ID);
        if (itemId == R.id.raws_customize_menu || itemId == R.id.raws_menu_show_all) return null;
        if ((model.containsKey(AppMenuItemProperties.MANAGED) && model.get(AppMenuItemProperties.MANAGED))
                || (model.containsKey(AppMenuItemProperties.ADDITIONAL_ICONS)
                    && model.get(AppMenuItemProperties.ADDITIONAL_ICONS) != null)) return null;
        try {
            String name = context.getResources().getResourceEntryName(
                    model.get(AppMenuItemProperties.MENU_ITEM_ID));
            // Keep access to settings and emergency/administrative controls immutable.
            if (name.equals("preferences_id") || name.equals("raws_global_shield_menu_id")
                    || name.contains("settings") || name.contains("update") || name.contains("exit"))
                return null;
            return name.matches("[a-z][a-z0-9_]{0,127}") ? name : null;
        } catch (Resources.NotFoundException exception) {
            return null;
        }
    }

    // Attached to the existing AppMenu ListView as a single, measured native row.
    // Deliberately no Window, Activity, Tab, URL, or page-transition dependencies here.
    private int gridType = -1;
    private int quickPage;
    private @Nullable ListItem gridRow;
    private java.util.function.@Nullable Consumer<PropertyModel> activate;

    void attachGrid(int type, java.util.function.Consumer<PropertyModel> activate) {
        if (nativeSource == null || currentState == null || catalog.isEmpty()) return;
        gridType = type;
        this.activate = activate;
        refresh();
    }
    static int tileHeight(Context context) {
        return Math.max(dp(context, 64), (int) Math.ceil(40 * context.getResources()
                .getDisplayMetrics().scaledDensity) + dp(context, 28));
    }
    static int gridHeight(Context context) {
        return 2 * tileHeight(context) + dp(context, 68);
    }
    private static int dp(Context context, int n) {
        return Math.round(context.getResources().getDisplayMetrics().density * n);
    }
    static final class Tiles extends android.widget.LinearLayout {
        final List<View> targets = new ArrayList<>();
        Tiles(Context c) { super(c); setOrientation(VERTICAL); }
        private void reset() { targets.clear(); removeAllViews(); }
    }
    void bindTiles(PropertyModel model, Tiles box) {
        box.reset();
        if (gridRow == null || gridRow.model != model || currentState == null) return;
        int pad = dp(context, 6);
        android.graphics.drawable.GradientDrawable bg = new android.graphics.drawable.GradientDrawable();
        bg.setColor(0xff1a1a1a);
        bg.setCornerRadius(dp(context, 16));
        bg.setStroke(dp(context, 1), 0xff626064);
        box.setBackground(bg);
        box.setPadding(pad, pad, pad, pad);
        var visible = currentState.page(0, 256);
        int pages = Math.max(1, (visible.size() + 7) / 8);
        quickPage = Math.max(0, Math.min(quickPage, pages - 1));
        for (int rowIndex = 0; rowIndex < 2; rowIndex++) {
            var row = new android.widget.LinearLayout(context);
            box.addView(row, -1, tileHeight(context));
            for (int col = 0; col < 4; col++) {
                int index = quickPage * 8 + rowIndex * 4 + col;
                if (index >= visible.size()) {
                    row.addView(new android.widget.Space(context), new android.widget.LinearLayout.LayoutParams(0, -1, 1));
                    continue;
                }
                var entry = visible.get(index);
                var action = entry.action.model;
                var label = chip(action.get(AppMenuItemProperties.TITLE));
                label.setEnabled(action.get(AppMenuItemProperties.ENABLED));
                if (!label.isEnabled()) label.setAlpha(.48f);
                if (action.containsKey(AppMenuItemProperties.ICON)) {
                    var icon = action.get(AppMenuItemProperties.ICON);
                    if (icon != null && icon.getConstantState() != null) {
                        var copy = icon.getConstantState().newDrawable(context.getResources()).mutate();
                        copy.setBounds(0, 0, dp(context, 20), dp(context, 20));
                        copy.setTint(0xffeeece5);
                        label.setCompoundDrawables(null, copy, null, null);
                        label.setCompoundDrawablePadding(dp(context, 3));
                    }
                }
                label.setOnClickListener(v -> {
                    // A recycled row or a source mutation must never dispatch a stale native action.
                    if (nativeSource == null || gridRow == null || gridRow.model != model || showingAll
                            || catalog.get(entry.key) != entry.action || nativeSource.indexOf(entry.action) < 0
                            || !action.get(AppMenuItemProperties.ENABLED) || activate == null) return;
                    activate.accept(action);
                });
                row.addView(label, new android.widget.LinearLayout.LayoutParams(0, -1, 1));
                box.targets.add(label);
            }
        }
        var nav = new android.widget.LinearLayout(context);
        box.addView(nav, -1, dp(context, 48));
        pageButton(nav, box, model, "‹", -1, quickPage > 0);
        var dots = chip((quickPage + 1) + " / " + pages);
        dots.setContentDescription(context.getString(R.string.sandium_menu_page, quickPage + 1, pages));
        dots.setClickable(false); dots.setFocusable(false);
        nav.addView(dots, new android.widget.LinearLayout.LayoutParams(0, -1, 1));
        pageButton(nav, box, model, "›", 1, quickPage + 1 < pages);
    }
    private android.widget.TextView chip(CharSequence title) {
        var v = new android.widget.TextView(context);
        v.setText(title); v.setContentDescription(title); v.setTextSize(12);
        v.setTextColor(0xfffafafa); v.setGravity(android.view.Gravity.CENTER);
        v.setMaxLines(2); v.setEllipsize(android.text.TextUtils.TruncateAt.END);
        v.setFocusable(true); v.setClickable(true);
        android.util.TypedValue ripple = new android.util.TypedValue();
        if (context.getTheme().resolveAttribute(android.R.attr.selectableItemBackground, ripple, true)
                && ripple.resourceId != 0) v.setBackgroundResource(ripple.resourceId);
        return v;
    }
    private void pageButton(android.widget.LinearLayout row, Tiles box, PropertyModel model,
            String glyph, int delta, boolean enabled) {
        var v = chip(glyph); v.setTextSize(20); v.setEnabled(enabled);
        v.setAlpha(enabled ? 1f : .4f);
        v.setContentDescription(context.getString(delta < 0 ? R.string.sandium_page_previous : R.string.sandium_page_next));
        v.setOnClickListener(ignored -> {
            if (gridRow == null || gridRow.model != model || nativeSource == null) return;
            quickPage += delta; bindTiles(model, box);
            box.announceForAccessibility(context.getString(R.string.sandium_menu_page,
                    quickPage + 1, Math.max(1, (currentState.page(0, 256).size() + 7) / 8)));
        });
        row.addView(v, dp(context, 48), -1); if (enabled) box.targets.add(v);
    }

    ModelList prepare(ModelList nativeItems) {
        dismissEditor();
        closeProjection();
        currentState = new RawSMenuModel<>(store.read());
        customizeItem = null;
        showingAll = false;
        projection = project(nativeItems, currentState);
        nativeSource = nativeItems;
        nativeSource.addObserver(nativeObserver);
        return projection;
    }
    void closeProjection() {
        if (nativeSource != null) nativeSource.removeObserver(nativeObserver);
        nativeSource = null; projection = null; gridType = -1; quickPage = 0; gridRow = null; activate = null;
    }
    void refresh() {
        if (nativeSource == null || projection == null || currentState == null) return;
        ModelList desired = project(nativeSource, currentState);
        // Native producers retain their own indices (including async Read Aloud insertion).
        // Only update the rendered projection with minimal native list notifications.
        for (int i = 0; i < desired.size(); i++) {
            ListItem wanted = desired.get(i);
            if (i < projection.size() && projection.get(i) == wanted) continue;
            int old = projection.indexOf(wanted);
            if (old >= 0) projection.removeAt(old);
            projection.add(i, wanted);
        }
        while (projection.size() > desired.size()) projection.removeAt(projection.size() - 1);
    }
    private ModelList project(ModelList nativeItems, RawSMenuModel<ListItem> state) {
        catalog.clear(); groups.clear();
        int groupIndex = 0;
        for (ListItem item : nativeItems) {
            String name = key(item);
            if (name == null) { groupIndex++; continue; }
            if (catalog.containsKey(name) || catalog.size() >= 256) {
                catalog.clear(); groups.clear();
                ModelList unchanged = new ModelList();
                unchanged.addAll(nativeItems); return unchanged;
            }
            catalog.put(name, item); groups.put(name, groupIndex);
        }
        state.bind(catalog);
        if (!state.writable()) {
            ModelList unchanged = new ModelList(); unchanged.addAll(nativeItems); return unchanged;
        }
        ModelList result = new ModelList();
        if (gridType < 0 || nativeItems.isEmpty() || catalog.isEmpty()) {
            result.addAll(nativeItems);
            return result;
        }
        if (showingAll) {
            result.addAll(nativeItems);
            if (allCloseItem == null) allCloseItem = command(R.id.raws_menu_show_all, R.string.raws_menu_show_customized);
        } else {
            gridRow = new ListItem(gridType, command(R.id.sandium_quick_grid, R.string.sandium_quick_actions).model);
            result.add(gridRow);
            if (allOpenItem == null) allOpenItem = command(R.id.raws_menu_show_all, R.string.raws_menu_all);
        }
        if (customizeItem == null) customizeItem = command(R.id.raws_customize_menu, R.string.raws_customize_menu);
        result.add(customizeItem);
        result.add(showingAll ? allCloseItem : allOpenItem);
        return result;
    }

    private ListItem command(int id, int title) {
        return new ListItem(AppMenuItemType.STANDARD_NO_ICON,
                new PropertyModel.Builder(AppMenuItemProperties.ALL_KEYS)
                        .with(AppMenuItemProperties.MENU_ITEM_ID, id)
                        .with(AppMenuItemProperties.TITLE, context.getString(title))
                        .with(AppMenuItemProperties.TITLE_CONDENSED, context.getString(title))
                        .with(AppMenuItemProperties.TITLE_MAX_LINES, 1)
                        .with(AppMenuItemProperties.ENABLED, true)
                        .build());
    }

    private void appendGroup(ModelList out, Map<String, ListItem> group, RawSMenuModel<ListItem> state) {
        for (String name : state.orderedKeys()) {
            ListItem item = group.get(name);
            if (item != null && (showingAll || state.isVisible(name))) out.add(item);
        }
        group.clear();
    }

    boolean handleAllMenu(PropertyModel model) {
        if (model.get(AppMenuItemProperties.MENU_ITEM_ID) != R.id.raws_menu_show_all) return false;
        ListItem command = showingAll ? allCloseItem : allOpenItem;
        if (nativeSource != null && projection != null && command != null
                && command.model == model && projection.indexOf(command) >= 0) {
            showingAll = !showingAll;
            refresh();
        }
        return true;  // Consume stale synthetic command IDs without native dispatch.
    }
    boolean isEditor(PropertyModel model) {
        return model.get(AppMenuItemProperties.MENU_ITEM_ID) == R.id.raws_customize_menu;
    }
    void dismissEditor() {
        if (moveDialog != null) moveDialog.dismiss();
        moveDialog = null;
        if (editorDialog != null) editorDialog.dismiss();
        editorDialog = null;
    }
    private boolean moveEditorItem(int position, int step, List<String> keys,
            CharSequence[] titles, boolean[] checked, Map<String, Boolean> visible, ListView list) {
        int target = position + step;
        if (!list.isEnabled() || position < 0 || position >= keys.size() || target < 0 || target >= keys.size()) return false;
        String name = keys.remove(position); keys.add(target, name);
        CharSequence label = titles[position]; titles[position] = titles[target]; titles[target] = label;
        list.invalidateViews();
        for (int i = 0; i < keys.size(); i++) {
            checked[i] = Boolean.TRUE.equals(visible.get(keys.get(i)));
            list.setItemChecked(i, checked[i]);
        }
        list.setSelection(target);
        return true;
    }
    private void addReorderAccessibility(View row, ListView list, List<String> keys,
            CharSequence[] titles, boolean[] checked, Map<String, Boolean> visible) {
        row.setAccessibilityDelegate(new View.AccessibilityDelegate() {
            @Override public void onInitializeAccessibilityNodeInfo(View host, AccessibilityNodeInfo info) {
                super.onInitializeAccessibilityNodeInfo(host, info);
                int position = list.getPositionForView(host);
                if (position > 0 && position < keys.size())
                    info.addAction(new AccessibilityNodeInfo.AccessibilityAction(R.id.raws_menu_move_up_action,
                            context.getString(R.string.raws_menu_move_up)));
                if (position >= 0 && position + 1 < keys.size())
                    info.addAction(new AccessibilityNodeInfo.AccessibilityAction(R.id.raws_menu_move_down_action,
                            context.getString(R.string.raws_menu_move_down)));
            }
            @Override public boolean performAccessibilityAction(View host, int action, Bundle arguments) {
                if (action == R.id.raws_menu_move_up_action || action == R.id.raws_menu_move_down_action)
                    return moveEditorItem(list.getPositionForView(host), action == R.id.raws_menu_move_up_action ? -1 : 1,
                            keys, titles, checked, visible, list);
                return super.performAccessibilityAction(host, action, arguments);
            }
        });
    }
    boolean showEditorFromSettings(ModelList nativeItems, Activity owner) {
        dismissEditor();
        closeProjection();
        customizeItem = null;
        showingAll = false;
        project(nativeItems, new RawSMenuModel<>(store.read()));
        return showEditor(owner);
    }

    boolean showEditor(Activity owner) {
        dismissEditor();
        if (owner.isFinishing() || owner.isDestroyed()
                || ApplicationStatus.getStateForActivity(owner) != ActivityState.RESUMED) return false;
        RawSMenuModel<ListItem> state = new RawSMenuModel<>(store.read());
        state.bind(catalog);
        if (!state.writable() || catalog.isEmpty()) return false;
        List<String> keys = new ArrayList<>();
        for (String name : state.orderedKeys()) if (catalog.containsKey(name)) keys.add(name);
        CharSequence[] titles = new CharSequence[keys.size()];
        boolean[] checked = new boolean[keys.size()];
        Map<String, Boolean> visible = new HashMap<>();
        for (int i = 0; i < keys.size(); i++) {
            String name = keys.get(i);
            titles[i] = catalog.get(name).model.get(AppMenuItemProperties.TITLE);
            checked[i] = state.isVisible(name);
            visible.put(name, checked[i]);
        }
        boolean[] resetRequested = {false};
        AlertDialog dialog = new AlertDialog.Builder(owner)
                .setTitle(R.string.raws_customize_menu)
                .setMultiChoiceItems(titles, checked, (ignored, which, selected) ->
                        visible.put(keys.get(which), selected))
                .setNegativeButton(android.R.string.cancel, (ignored, which) -> {})
                .setNeutralButton(R.string.raws_menu_reset, null)
                .setPositiveButton(R.string.raws_menu_done, null)
                .create();
        editorDialog = dialog;
        ApplicationStatus.ActivityStateListener ownerLifecycle = (activity, activityState) -> {
            if (editorDialog == dialog && (activityState == ActivityState.STOPPED
                    || activityState == ActivityState.DESTROYED)) dismissEditor();
        };
        ApplicationStatus.registerStateListenerForActivity(ownerLifecycle, owner);
        dialog.setOnDismissListener(ignored -> {
            ApplicationStatus.unregisterActivityStateListener(ownerLifecycle);
            if (editorDialog == dialog) {
                editorDialog = null;
                if (moveDialog != null) moveDialog.dismiss();
                moveDialog = null;
            }
        });
        dialog.setOnShowListener(ignored -> {
            ListView list = dialog.getListView();
            list.setContentDescription(context.getString(R.string.raws_menu_edit_hint));
            list.setTooltipText(context.getString(R.string.raws_menu_edit_hint));
            list.setOnKeyListener((view, code, event) -> {
                if (event.getAction() != KeyEvent.ACTION_DOWN || !event.isCtrlPressed()
                        || (code != KeyEvent.KEYCODE_DPAD_UP && code != KeyEvent.KEYCODE_DPAD_DOWN)) return false;
                return moveEditorItem(list.getSelectedItemPosition(), code == KeyEvent.KEYCODE_DPAD_UP ? -1 : 1,
                        keys, titles, checked, visible, list);
            });
            list.setOnHierarchyChangeListener(new ViewGroup.OnHierarchyChangeListener() {
                @Override public void onChildViewAdded(View parent, View child) {
                    addReorderAccessibility(child, list, keys, titles, checked, visible);
                }
                @Override public void onChildViewRemoved(View parent, View child) {}
            });
            for (int i = 0; i < list.getChildCount(); i++)
                addReorderAccessibility(list.getChildAt(i), list, keys, titles, checked, visible);
            dialog.getButton(AlertDialog.BUTTON_NEUTRAL).setOnClickListener(view -> {
                resetRequested[0] = true;
                keys.clear(); keys.addAll(RawSMenuModel.defaultOrder(catalog.keySet()));
                for (int i = 0; i < keys.size(); i++) {
                    titles[i] = catalog.get(keys.get(i)).model.get(AppMenuItemProperties.TITLE);
                    checked[i] = RawSMenuModel.defaultVisible(keys.get(i)); visible.put(keys.get(i), checked[i]); list.setItemChecked(i, checked[i]);
                }
                list.invalidateViews();
            });
            list.setOnItemLongClickListener((parent, view, position, id) -> {
                moveDialog = new AlertDialog.Builder(owner)
                        .setTitle(titles[position])
                        .setItems(new CharSequence[] {context.getString(R.string.raws_menu_move_up),
                                context.getString(R.string.raws_menu_move_down)}, (move, direction) -> {
                            if (editorDialog != dialog) return;
                            moveEditorItem(position, direction == 0 ? -1 : 1,
                                    keys, titles, checked, visible, list);
                        }).show();
                return true;
            });
            dialog.getButton(AlertDialog.BUTTON_POSITIVE).setOnClickListener(view -> {
                RawSMenuModel<ListItem>.Editor draft = state.edit();
                if (resetRequested[0]) draft.resetToDefaults();
                draft.reorderAvailable(keys);
                for (int i = 0; i < keys.size(); i++) {
                    draft.setVisible(keys.get(i), Boolean.TRUE.equals(visible.get(keys.get(i))));
                }
                dialog.setCancelable(false);
                dialog.getButton(AlertDialog.BUTTON_NEGATIVE).setEnabled(false);
                dialog.getButton(AlertDialog.BUTTON_POSITIVE).setEnabled(false);
                list.setEnabled(false);
                dialog.getButton(AlertDialog.BUTTON_NEUTRAL).setEnabled(false);
                PostTask.postTask(TaskTraits.USER_VISIBLE_MAY_BLOCK, () -> {
                    boolean saved = draft.save(store);
                    new Handler(Looper.getMainLooper()).post(() -> {
                        if (editorDialog != dialog) return;
                        if (saved) {
                            if (nativeSource != null) {
                                currentState = new RawSMenuModel<>(store.read());
                                refresh();
                            }
                            dialog.dismiss();
                        }
                        else {
                            dialog.setCancelable(true);
                            dialog.getButton(AlertDialog.BUTTON_NEGATIVE).setEnabled(true);
                            dialog.getButton(AlertDialog.BUTTON_POSITIVE).setEnabled(true);
                            list.setEnabled(true);
                            dialog.getButton(AlertDialog.BUTTON_NEUTRAL).setEnabled(true);
                            dialog.setTitle(R.string.raws_menu_save_failed);
                        }
                    });
                });
            });
        });
        dialog.show();
        return true;
    }
}
