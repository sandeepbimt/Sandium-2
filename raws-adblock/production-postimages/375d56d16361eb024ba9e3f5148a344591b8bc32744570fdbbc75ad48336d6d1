#ifndef COMPONENTS_SANDIUM_ADBLOCK_RAW_CUSTOM_NETWORK_RULES_POLICY_H_
#define COMPONENTS_SANDIUM_ADBLOCK_RAW_CUSTOM_NETWORK_RULES_POLICY_H_

#include <cstddef>
#include <optional>
#include <string_view>

namespace sandium::adblock_native {

inline constexpr size_t kRawSMaxCustomRuleBytes = 32 * 1024;
inline constexpr size_t kRawSMaxCustomRuleLines = 256;

inline constexpr bool RawSRuleLetterOrDigit(char c) {
  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
         (c >= '0' && c <= '9');
}

inline bool RawSRuleHostname(std::string_view host) {
  if (host.size() < 3 || host.size() > 253 || host.ends_with('.') ||
      host.find('.') == host.npos)
    return false;
  while (!host.empty()) {
    const auto dot = host.find('.');
    const auto label = host.substr(0, dot);
    if (label.empty() || label.size() > 63 || label.starts_with('-') ||
        label.ends_with('-'))
      return false;
    for (char c : label)
      if (!RawSRuleLetterOrDigit(c) && c != '-') return false;
    host.remove_prefix(dot == host.npos ? host.size() : dot + 1);
  }
  return true;
}

inline bool RawSRuleDomainRestriction(std::string_view domains) {
  if (domains.empty() || domains.ends_with('|')) return false;
  size_t count = 0;
  while (!domains.empty()) {
    const auto bar = domains.find('|');
    auto item = domains.substr(0, bar);
    if (item.starts_with('~')) item.remove_prefix(1);
    if (++count > 16 || !RawSRuleHostname(item)) return false;
    domains.remove_prefix(bar == domains.npos ? domains.size() : bar + 1);
  }
  return true;
}

// Limit to passive ABP patterns. The prefix/right anchor and literal path
// remain input for the native parser, not a rewritten URL or injected action.
inline bool RawSRuleNetworkPattern(std::string_view pattern) {
  if (pattern.starts_with("||")) {
    pattern.remove_prefix(2);
    const auto host_end = pattern.find_first_of("/^?|");
    if (!RawSRuleHostname(pattern.substr(0, host_end))) return false;
  } else if (pattern.starts_with('|')) {
    pattern.remove_prefix(1);
  }
  if (pattern.ends_with('|')) pattern.remove_suffix(1);
  // The native parser interprets slash-delimited patterns as regex, including
  // after removing exact anchors. Require a simple non-regex trailing token.
  if (pattern.empty() || (pattern.starts_with('/') && pattern.ends_with('/')))
    return false;
  size_t content = 0, wildcards = 0;
  constexpr std::string_view kPatternSymbols = "/:?&=%+_-.~@!*^";
  for (char c : pattern) {
    if (RawSRuleLetterOrDigit(c)) {
      ++content;
    } else if (kPatternSymbols.find(c) == kPatternSymbols.npos) {
      return false;
    } else if (c == '*' && ++wildcards > 8) {
      return false;
    }
  }
  return content >= 3;
}

inline bool RawSRuleNetworkModifiers(std::string_view modifiers) {
  if (modifiers.empty() || modifiers.ends_with(',')) return false;
  size_t options = 0;
  bool has_domains = false;
  while (!modifiers.empty()) {
    const auto comma = modifiers.find(',');
    auto opt = modifiers.substr(0, comma);
    if (++options > 12) return false;
    if (opt.starts_with("domain=")) {
      if (has_domains || !RawSRuleDomainRestriction(opt.substr(7))) return false;
      has_domains = true;
    } else {
      if (opt.starts_with('~')) opt.remove_prefix(1);
      if (opt != "first-party" && opt != "third-party" && opt != "script" &&
          opt != "stylesheet" && opt != "image" && opt != "font" &&
          opt != "xmlhttprequest" && opt != "media" && opt != "ping" &&
          opt != "other")
        return false;
    }
    modifiers.remove_prefix(comma == modifiers.npos ? modifiers.size()
                                                   : comma + 1);
  }
  return true;
}

// Native parsing must independently accept every non-comment line, with
// permissions=0; only matched/exception booleans are consumed by this layer.
inline std::optional<size_t> CountSupportedCustomNetworkRules(
    std::string_view text) {
  if (text.size() > kRawSMaxCustomRuleBytes || text.find('\0') != text.npos)
    return std::nullopt;
  size_t count = 0, lines = 0;
  while (!text.empty()) {
    const auto split = text.find('\n');
    auto line = text.substr(0, split);
    text.remove_prefix(split == text.npos ? text.size() : split + 1);
    if (++lines > kRawSMaxCustomRuleLines || line.size() > 512)
      return std::nullopt;
    if (line.ends_with('\r')) line.remove_suffix(1);
    if (line.empty() || line.starts_with('!')) continue;
    if (line.starts_with("@@")) line.remove_prefix(2);
    const auto delimiter = line.find('$');
    if (!RawSRuleNetworkPattern(line.substr(0, delimiter)) ||
        (delimiter != line.npos &&
         !RawSRuleNetworkModifiers(line.substr(delimiter + 1))))
      return std::nullopt;
    ++count;
  }
  return count;
}
// A typed subset, not a general CSS parser. No declarations, pseudo classes,
// unrestricted attributes, escapes, lists, scripts or resource URLs can enter.
struct RawSAdRuleCounts {
  size_t network = 0;
  size_t cosmetic = 0;
  size_t total() const { return network + cosmetic; }
};

inline bool RawSCosmeticIdentifier(std::string_view id) {
  if (id.empty() || id.size() > 64) return false;
  if (id.starts_with('-')) id.remove_prefix(1);
  if (id.empty() || (id.front() >= '0' && id.front() <= '9')) return false;
  for (char c : id) {
    if (!RawSRuleLetterOrDigit(c) && c != '-' && c != '_') return false;
  }
  return id.front() != '-';
}

// Bounded author-specified HTML attributes only. Presence and ordinary CSS
// value matches are allowed; names and values cannot contain a URL, escape,
// CSS declarations, a match flag, namespace, or another selector.
inline bool RawSSafeCosmeticAttribute(std::string_view attribute) {
  const auto end = attribute.find_first_of("=^$*~");
  auto name = attribute.substr(0, end);
  if (name != "id" && name != "class") {
    if (!name.starts_with("data-") || name.size() <= 5 || name.size() > 48)
      return false;
    name.remove_prefix(5);
    if (name.front() == '-' || name.back() == '-') return false;
    for (char c : name) {
      if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-'))
        return false;
    }
  }
  if (end == attribute.npos) return true;
  attribute.remove_prefix(end);
  if (!attribute.starts_with('=')) attribute.remove_prefix(1);
  if (!attribute.starts_with('=')) return false;
  attribute.remove_prefix(1);
  if (attribute.size() < 3 || attribute.size() > 66 ||
      (attribute.front() != '"' && attribute.front() != '\'') ||
      attribute.back() != attribute.front()) return false;
  attribute.remove_prefix(1);
  attribute.remove_suffix(1);
  for (char c : attribute) {
    if (!RawSRuleLetterOrDigit(c) && c != '-' && c != '_' && c != '.')
      return false;
  }
  return true;
}

inline bool RawSCosmeticCompound(std::string_view segment) {
  if (segment.empty()) return false;
  const auto keys = segment.find_first_of(".#[");
  auto tag = segment.substr(0, keys);
  if (!tag.empty()) {
    if (tag.size() > 40 || (tag.front() >= '0' && tag.front() <= '9') ||
        tag.front() == '-') return false;
    for (char c : tag) {
      if (!RawSRuleLetterOrDigit(c) && c != '-') return false;
    }
  }
  if (keys == segment.npos) return !tag.empty();
  segment.remove_prefix(keys);
  size_t count = 0;
  while (!segment.empty()) {
    if (++count > 4) return false;
    auto kind = segment.front();
    segment.remove_prefix(1);
    if (kind == '[') {
      const auto end = segment.find(']');
      if (end == segment.npos || !RawSSafeCosmeticAttribute(segment.substr(0, end)))
        return false;
      segment.remove_prefix(end + 1);
    } else if (kind == '.' || kind == '#') {
      const auto end = segment.find_first_of(".#[");
      if (!RawSCosmeticIdentifier(segment.substr(0, end))) return false;
      segment.remove_prefix(end == segment.npos ? segment.size() : end);
    } else {
      return false;
    }
  }
  return true;
}

// Key-sourced generic filtering is restricted to exact, simple classes/IDs,
// like RawS's existing generic census. Domain rules permit bounded descendant
// and child chains (but no arbitrary CSS grammar).
inline bool RawSSimpleGenericCosmetic(std::string_view selector) {
  if (selector.empty() || (selector.front() != '.' && selector.front() != '#'))
    return false;
  selector.remove_prefix(1);
  return !selector.empty() && !selector.starts_with('-') &&
         RawSCosmeticIdentifier(selector);
}

inline bool RawSSafeScopedCosmetic(std::string_view selector) {
  if (selector.empty() || selector.size() > 256 ||
      selector.front() == ' ' || selector.back() == ' ') return false;
  size_t compounds = 0;
  while (!selector.empty()) {
    const auto end = selector.find_first_of(" >");
    if (++compounds > 4 || !RawSCosmeticCompound(selector.substr(0, end)))
      return false;
    if (end == selector.npos) return true;
    selector.remove_prefix(end);
    while (selector.starts_with(' ')) selector.remove_prefix(1);
    if (selector.starts_with('>')) {
      selector.remove_prefix(1);
      while (selector.starts_with(' ')) selector.remove_prefix(1);
    }
    if (selector.empty()) return false;
  }
  return false;
}

inline bool RawSCosmeticScope(std::string_view names) {
  bool positive = false;
  size_t count = 0;
  if (names.empty() || names.ends_with(',')) return false;
  while (!names.empty()) {
    const auto end = names.find(',');
    auto name = names.substr(0, end);
    if (name.starts_with('~')) name.remove_prefix(1);
    else positive = true;
    if (++count > 12 || !RawSRuleHostname(name)) return false;
    names.remove_prefix(end == names.npos ? names.size() : end + 1);
  }
  return positive;
}

struct RawSCosmeticLine {
  std::string_view selector;
  bool generic = false;
};

inline std::optional<RawSCosmeticLine> ParseRawSCosmeticLine(
    std::string_view text) {
  const auto hide = text.find("##");
  const auto except = text.find("#@#");
  if (hide == text.npos && except == text.npos) return std::nullopt;
  // In `host#@##id`, the last '#' of the actual marker is adjacent to
  // the selector's '#' and also produces an overlapping "##".
  const bool exception = except < hide;
  const auto marker = exception ? except : hide;
  auto selector = text.substr(marker + (exception ? 3 : 2));
  auto hosts = text.substr(0, marker);
  if (hosts.empty()) {
    if (exception || !RawSSimpleGenericCosmetic(selector)) return std::nullopt;
    return RawSCosmeticLine{selector, true};
  }
  if (!RawSCosmeticScope(hosts) || !RawSSafeScopedCosmetic(selector))
    return std::nullopt;
  return RawSCosmeticLine{selector, false};
}

// Count both rule types before loading the candidate and cross-check both
// against the native engine. A single unsupported line rejects everything.
inline std::optional<RawSAdRuleCounts> CountSupportedCustomRules(
    std::string_view text) {
  if (text.size() > kRawSMaxCustomRuleBytes || text.find('\0') != text.npos)
    return std::nullopt;
  RawSAdRuleCounts count;
  size_t lines = 0;
  while (!text.empty()) {
    const auto next = text.find('\n');
    auto line = text.substr(0, next);
    text.remove_prefix(next == text.npos ? text.size() : next + 1);
    if (++lines > kRawSMaxCustomRuleLines || line.size() > 512)
      return std::nullopt;
    if (line.ends_with('\r')) line.remove_suffix(1);
    if (line.starts_with("!#")) return std::nullopt;
    if (line.empty() || line.starts_with('!')) continue;
    if (line.find("##") != line.npos || line.find("#@#") != line.npos) {
      if (!ParseRawSCosmeticLine(line)) return std::nullopt;
      ++count.cosmetic;
    } else {
      auto network = CountSupportedCustomNetworkRules(line);
      if (network != 1u) return std::nullopt;
      ++count.network;
    }
  }
  return count;
}
}  // namespace sandium::adblock_native

#endif  // COMPONENTS_SANDIUM_ADBLOCK_RAW_CUSTOM_NETWORK_RULES_POLICY_H_
