    private long mLastRetryMs = -1000;
    private boolean mSaveFailed;
    private int mAdsStaged = ADS_UNAVAILABLE;
    private int mAdsCommitted = ADS_UNAVAILABLE;
    private boolean mAdsExplicit;
    private int mAdsWriteToken;
