    @Override
    public View onCreateView(LayoutInflater inflater, @Nullable ViewGroup container,
            @Nullable Bundle state) {
        FirstRunActivity host = (FirstRunActivity) requireActivity();
        Profile profile = assumeNonNull(host.getProfileProviderSupplier().get()).getOriginalProfile();
        mProfile = profile;
        mAdsStaged = RawsProtectionCopy.globalAdFilteringState(profile);
        mAdsCommitted = ADS_UNAVAILABLE;
        mAdsExplicit = false;
        mStagedDarkPages = RawSDarkPages.getGlobal(profile);
        mInitialBlur = RawSNavigationAppearance.getBlurLevel();
        mStagedBlur = mInitialBlur;
        var profilePrefs = UserPrefs.get(profile);
        mInitialBlockThirdPartyCookies = profilePrefs.getInteger(COOKIE_CONTROLS_MODE)
                == CookieControlsMode.BLOCK_THIRD_PARTY;
        mBlockThirdPartyCookies = mInitialBlockThirdPartyCookies;
        if (state != null) {
            int restoredAds = state.getInt("explicit_ads_choice", ADS_UNAVAILABLE);
            if (restoredAds == ADS_ON || restoredAds == ADS_OFF) {
                mAdsStaged = restoredAds;
                mAdsExplicit = true;
            }
            mStagedDarkPages = state.getBoolean("dark_pages", mStagedDarkPages);
            @Nullable String restoredBlur = RawSNavigationAppearance.normalizeStoredBlurLevel(
                    state.getString("blur", mStagedBlur));
            if (restoredBlur != null) mStagedBlur = restoredBlur;
            mRequestNotifications = state.getBoolean("notifications", true);
            mBlockThirdPartyCookies = state.getBoolean("cookie_block", mBlockThirdPartyCookies);
        }

        ScrollView scroll = new ScrollView(host);
        scroll.setFillViewport(true);
        scroll.setBackgroundColor(BACKGROUND);
        LinearLayout body = column();
        body.setPadding(dp(16), dp(12), dp(16), dp(16));
        scroll.addView(body);
        LinearLayout heading = new LinearLayout(host);
        heading.setGravity(Gravity.CENTER_VERTICAL);
        heading.setPadding(dp(16), dp(8), dp(16), dp(8));
        heading.setBackground(rounded(CARD, 24));
        ImageView mark = new ImageView(host);
        mark.setScaleType(ImageView.ScaleType.FIT_CENTER);
        mark.setPadding(dp(8), dp(8), dp(8), dp(8));
        mark.setBackground(rounded(0xFF242424, 28));
        mark.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
        var logo = host.getDrawable(R.drawable.raws_frozen_shields_mark);
        if (logo != null) {
            SandiumBalancedTracer tracer = new SandiumBalancedTracer(mark, logo);
            mTracer = tracer;
            mark.setImageDrawable(tracer);
            tracer.setEnabled(true);
        }
        heading.addView(mark, new LinearLayout.LayoutParams(dp(56), dp(56)));
        LinearLayout titleBlock = column();
        titleBlock.setPaddingRelative(dp(14), 0, 0, 0);
        TextView title = text(R.string.raws_setup_title, 24, TEXT);
        title.setTypeface(Typeface.DEFAULT, Typeface.BOLD);
        title.setAccessibilityHeading(true);
        mHeader = title;
        titleBlock.addView(title);
        titleBlock.addView(text(R.string.raws_setup_choose, 13, SECONDARY));
        heading.addView(titleBlock,
                new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1));
        body.addView(heading);

        LinearLayout readiness = card(body);
        TextView status = text(R.string.raws_setup_preparing, 15, TEXT);
        status.setAccessibilityLiveRegion(View.ACCESSIBILITY_LIVE_REGION_POLITE);
        status.setPadding(dp(12), dp(10), dp(12), dp(10));
        readiness.addView(status);
        mStatus = status;
        Button retry = rowButton(readiness, R.string.raws_setup_retry, this::retryProtection);
        retry.setVisibility(View.GONE);
        mRetry = retry;

        LinearLayout settings = card(body);
        addSwitch(settings, R.string.raws_setup_ads, R.string.raws_setup_ads_summary,
                mAdsStaged == ADS_ON,
                RawsProtectionCopy.globalAdFilteringState(profile) != ADS_UNAVAILABLE,
                checked -> {
                    mAdsStaged = checked ? ADS_ON : ADS_OFF;
                    mAdsExplicit = true;
                });
        divider(settings);
        addSwitch(settings, R.string.raws_setup_night, R.string.raws_setup_night_summary,
                mStagedDarkPages, RawSDarkPages.canManageGlobal(profile),
                checked -> mStagedDarkPages = checked);
        divider(settings);
        Button blur = addInlineChoice(settings, R.string.raws_setup_blur, 0);
        updateBlurLabel(blur);
        blur.setOnClickListener(v -> showBlurPicker(blur));
        divider(settings);
        addInlineDnsPicker(settings, host);
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU
                && host.checkSelfPermission(Manifest.permission.POST_NOTIFICATIONS)
                        != android.content.pm.PackageManager.PERMISSION_GRANTED) {
            divider(settings);
            addSwitch(settings, R.string.raws_setup_notifications,
                    R.string.raws_setup_notifications_summary, mRequestNotifications, true,
                    enabled -> mRequestNotifications = enabled);
        }

        divider(settings);
        addSwitch(settings, R.string.raws_setup_cookie_block, R.string.raws_setup_cookie_summary,
                mBlockThirdPartyCookies, !profilePrefs.isManagedPreference(COOKIE_CONTROLS_MODE),
                enabled -> mBlockThirdPartyCookies = enabled);

        TextView later = text(R.string.raws_setup_later, 13, SECONDARY);
        later.setPadding(dp(4), dp(10), dp(4), dp(4));
        body.addView(later);
        TextView terms = createTermsDisclosure();
        mTermsDisclosure = terms;
        body.addView(terms);
        Button start = new Button(host);
        start.setAllCaps(false);
        start.setTextSize(16);
        start.setMinimumHeight(dp(52));
        start.setOnClickListener(v -> requestSetupCompletion());
        body.addView(start);
        mStart = start;
        start.addOnAttachStateChangeListener(new View.OnAttachStateChangeListener() {
            @Override
            public void onViewAttachedToWindow(View view) { updateButton(); }

            @Override
            public void onViewDetachedFromWindow(View view) { stopPreparingDots(); }
        });
        updateButton();
        return scroll;
    }

    @Override
    public void onSaveInstanceState(Bundle state) {
        super.onSaveInstanceState(state);
        if (mAdsExplicit) state.putInt("explicit_ads_choice", mAdsStaged);
        state.putBoolean("dark_pages", mStagedDarkPages);
        state.putString("blur", mStagedBlur);
        state.putBoolean("notifications", mRequestNotifications);
        state.putBoolean("cookie_block", mBlockThirdPartyCookies);
    }

    @Override
    public void onResume() {
        super.onResume();
        refreshInlineDnsPicker();
        poll();
    }

    @Override
    public void onPause() {
        clearTermsAttempt();
        stopPreparingDots();
        dismissInlineDnsPicker();
        mUi.removeCallbacksAndMessages(null);
        mCountdownEnd = 0;
        mStartProgress = null;
        mRenderedButtonText = 0;
        if (mAdsWritePending) mAdsSaveInterrupted = true;
        else restoreOptions();
        super.onPause();
    }

    @Override
    public void onDestroyView() {
        clearTermsAttempt();
        stopPreparingDots();
        dismissInlineDnsPicker();
        mDnsChoice = null;
        ++mAdsWriteToken;
        mAdsWritePending = false;
        mFrozenControls.clear();
        mUi.removeCallbacksAndMessages(null);
        if (mTracer != null) mTracer.close();
        mTermsDisclosure = null;
        mTracer = null;
        mHeader = null;
        mProfile = null;
        mStatus = null;
        mRetry = null;
        mStart = null;
        mStartProgress = null;
        mRenderedButtonText = 0;
        super.onDestroyView();
    }

    @Override
    public void setInitialA11yFocus() {
        TextView header = mHeader;
        if (header != null) header.sendAccessibilityEvent(
                android.view.accessibility.AccessibilityEvent.TYPE_VIEW_FOCUSED);
    }

    private boolean restartNeeded() {
        return !mInitialBlur.equals(mStagedBlur);
    }

    private static int blurIndex(String value) {
        for (int i = 0; i < BLUR_VALUES.length; i++) if (BLUR_VALUES[i].equals(value)) return i;
        return -1;
    }

    private static final int[] BLUR_LABELS = {
            R.string.raws_setup_blur_off, R.string.raws_setup_blur_on};

    private void updateBlurLabel(Button blur) {
        String selected = getString(BLUR_LABELS[Math.max(0, blurIndex(mStagedBlur))]);
        blur.setText(selected);
        blur.setContentDescription(getString(R.string.raws_setup_blur_value, selected));
    }

    private void showBlurPicker(Button blur) {
        CharSequence[] labels = new CharSequence[BLUR_VALUES.length];
        for (int i = 0; i < labels.length; i++) labels[i] = getString(BLUR_LABELS[i]);
        new AlertDialog.Builder(requireContext())
                .setTitle(R.string.raws_setup_blur)
                .setSingleChoiceItems(labels, blurIndex(mStagedBlur), (dialog, which) -> {
                    mStagedBlur = BLUR_VALUES[which];
                    updateBlurLabel(blur);
                    updateButton();
                    dialog.dismiss();
                })
                .setNegativeButton(android.R.string.cancel, null).show();
    }

    private @Nullable AdSubscriptionState protectionState() {
        Profile profile = mProfile;
        return profile == null ? null : RawsProtectionCopy.adSubscriptionState(profile);
    }

    private boolean protectionReady() {
        var state = protectionState();
        return state != null && FirstRunActivityBase.isRawSProtectionReady(state);
    }

    private void retryProtection() {
        Profile profile = mProfile;
        if (!isResumed() || mConfirmed || mAdsWritePending || mCountdownEnd != 0 || profile == null
                || SystemClock.uptimeMillis() - mLastRetryMs < 1000) return;
        if (!((FirstRunActivity) requireActivity()).canRetryRawSProtection(
                RawsProtectionCopy.adSubscriptionState(profile))) return;
        mLastRetryMs = SystemClock.uptimeMillis();
        if (!RawsProtectionCopy.retryAdSubscriptions(profile)) {
            android.widget.Toast.makeText(requireContext(), R.string.raws_setup_retry_unavailable,
                    android.widget.Toast.LENGTH_SHORT).show();
        }
    }

    private void poll() {
        TextView status = mStatus;
        if (!isResumed() || status == null || mConfirmed) return;
        if (mAdsWritePending
                && SystemClock.uptimeMillis() - mAdsSaveStarted >= AD_SAVE_TIMEOUT_MS) {
            // An unacknowledged native write cannot release first run. Explicit retry re-flushes.
            ++mAdsWriteToken;
            mAdsWritePending = false;
            showSaveFailure();
        }
        var state = protectionState();
        boolean ready = state != null && FirstRunActivityBase.isRawSProtectionReady(state);
        if (mCountdownEnd != 0 && !ready) {
            // A replacement generation or failed backend invalidates this setup attempt.
            mTermsConsentForSetup = false;
            mCountdownEnd = 0;
            mStartProgress = null;
            mRenderedButtonText = 0;
            restoreOptions();
            refreshInlineDnsPicker();
        }
        var activity = (FirstRunActivity) requireActivity();
        CharSequence label = ready && state != null && mAdsStaged == ADS_OFF
                ? getString(R.string.raws_setup_lists_ready_ads_off, state.enabled)
                : activity.rawSProtectionMessage(state);
        if (mSaveFailed && ready) label = getString(R.string.raws_setup_save_failed);
        if (mAdsWritePending) label = getString(R.string.raws_setup_saving_ads);
        if (!android.text.TextUtils.equals(label, status.getText())) status.setText(label);
        mAnimatePreparing = (state == null || state.phase != RawsProtectionCopy.AD_FILTER_FAILED)
                && RawsProtectionCopy.adFilteringPhase() != RawsProtectionCopy.AD_FILTER_FAILED;
        Button retry = mRetry;
        if (retry != null) {
            boolean canRetry = !mAdsWritePending && activity.canRetryRawSProtection(state);
            retry.setVisibility(canRetry ? View.VISIBLE : View.GONE);
            retry.setEnabled(canRetry && SystemClock.uptimeMillis() - mLastRetryMs >= 1000);
        }
        if (mCountdownEnd == 0) updateButton();
        mUi.postDelayed(this::poll, 400);
    }

    private void updateButton() {
        Button start = mStart;
        if (start == null || mCountdownEnd != 0 || mConfirmed || mAdsWritePending) return;
        boolean ready = protectionReady();
        boolean requiresConsent = !FirstRunUtils.isFirstRunEulaAccepted();
        TextView terms = mTermsDisclosure;
        if (terms != null) terms.setVisibility(requiresConsent ? View.VISIBLE : View.GONE);
        int label = ready ? readyActionLabel(requiresConsent, restartNeeded())
                          : R.string.raws_setup_preparing_button;
        if (label != mRenderedButtonText) {
            int previous = mRenderedButtonText;
            mRenderedButtonText = label;
            start.setEnabled(ready);
            start.setBackground(rounded(ready ? START_READY : START_DISABLED, 28));
            start.setTextColor(ready ? PRIMARY_TEXT : SECONDARY);
            start.setText(ready ? label : R.string.raws_setup_preparing_dots);
            if (ready || previous != R.string.raws_setup_preparing_button) mDotPhase = 0;
        }
        TextView status = mStatus;
        CharSequence description = ready || status == null ? getString(label) : status.getText();
        if (!android.text.TextUtils.equals(description, start.getContentDescription())) {
            start.setContentDescription(description);
        }
        if (ready) {
            stopPreparingDots();
        } else if (mAnimatePreparing && ValueAnimator.areAnimatorsEnabled()) {
            if (!mDotScheduled) tickPreparingDots();
        } else {
            stopPreparingDots();
            if (start.getText() instanceof Spanned) start.setText(R.string.raws_setup_preparing_dots);
        }
    }

    private void stopPreparingDots() {
        mUi.removeCallbacks(mPreparingDots);
        mDotScheduled = false;
    }

    private void tickPreparingDots() {
        mDotScheduled = false;
        Button start = mStart;
        if (!isResumed() || start == null || !start.isAttachedToWindow()
                || mRenderedButtonText != R.string.raws_setup_preparing_button
                || mCountdownEnd != 0 || mAdsWritePending || mConfirmed) return;
        if (!mAnimatePreparing || !ValueAnimator.areAnimatorsEnabled()) {
            start.setText(R.string.raws_setup_preparing_dots);
            return;
        }
        SpannableString dots = new SpannableString(getString(R.string.raws_setup_preparing_dots));
        for (int i = 0; i < 3; ++i) {
            int index = i * 2;
            dots.setSpan(new ForegroundColorSpan(i == mDotPhase ? SECONDARY : DIM_DOT),
                    index, index + 1, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
        }
        start.setText(dots);
        mDotPhase = (mDotPhase + 1) % 3;
        mDotScheduled = mUi.postDelayed(mPreparingDots, DOT_STEP_MS);
    }

    private boolean canStartSetupAttempt() {
        return isResumed() && !mConfirmed && !mAdsWritePending && mCountdownEnd == 0
                && mStart != null && protectionReady()
                && getActivity() instanceof FirstRunActivity activity
                && activity.isRawSSetupCurrent();
    }

    private TextView createTermsDisclosure() {
        var context = requireContext();
        TextView terms = text(R.string.raws_setup_terms_consent, 13, SECONDARY);
        terms.setText(SpanApplier.applySpans(getString(R.string.raws_setup_terms_consent),
                new SpanApplier.SpanInfo("<TOS_LINK>", "</TOS_LINK>",
                        new ChromeClickableSpan(context, view -> {
                            var delegate = getPageDelegate();
                            if (mTermsDisclosure == view && isResumed() && !mConfirmed
                                    && mCountdownEnd == 0 && !mAdsWritePending && delegate != null) {
                                delegate.showInfoPage(R.string.google_terms_of_service_dark_mode_url);
                            }
                        }))));
        terms.setMovementMethod(LinkMovementMethod.getInstance());
        terms.setPadding(dp(4), dp(6), dp(4), dp(8));
        terms.setVisibility(FirstRunUtils.isFirstRunEulaAccepted() ? View.GONE : View.VISIBLE);
        return terms;
    }

    private static int readyActionLabel(boolean requiresConsent, boolean restart) {
        if (requiresConsent) {
            return restart ? R.string.raws_setup_agree_restart : R.string.raws_setup_agree_start;
        }
        return restart ? R.string.raws_setup_restart : R.string.raws_setup_start;
    }

    private void requestSetupCompletion() {
        dismissInlineDnsPicker();
        if (!canStartSetupAttempt()) return;
        Button start = mStart;
        if (start == null || !start.isEnabled() || !start.isAttachedToWindow()) return;
        boolean requiresConsent = !FirstRunUtils.isFirstRunEulaAccepted();
        if (requiresConsent) {
            TextView terms = mTermsDisclosure;
            int consentLabel = readyActionLabel(true, restartNeeded());
            // An already-rendered plain Start/Restart tap cannot be turned into consent.
            if (terms == null || !terms.isAttachedToWindow() || !terms.isShown()
                    || mRenderedButtonText != consentLabel
                    || !TextUtils.equals(start.getText(), getString(consentLabel))) {
                updateButton();
                return;
            }
        }
        mTermsConsentForSetup = requiresConsent;
        beginCountdown();
    }

    private void clearTermsAttempt() {
        mTermsConsentForSetup = false;
    }

    private void beginCountdown() {
        if (!canStartSetupAttempt()
                || (!FirstRunUtils.isFirstRunEulaAccepted() && !mTermsConsentForSetup)) {
            mTermsConsentForSetup = false;
            return;
        }
        Button start = mStart;
        if (start == null) return;
        mSaveFailed = false;
        stopPreparingDots();
        start.setEnabled(false);
        // No settings capture after the user accepts the action.
        View root = getView();
        if (root != null) disableOptions(root, start);
        if (!ValueAnimator.areAnimatorsEnabled()) {
            finishSetup();
            return;
        }
        mRenderedButtonText = 0;
        android.graphics.drawable.ClipDrawable fill = new android.graphics.drawable.ClipDrawable(
                rounded(START_PROGRESS, 28), Gravity.START,
                android.graphics.drawable.ClipDrawable.HORIZONTAL);
        mStartProgress = fill;
        start.setBackground(new android.graphics.drawable.LayerDrawable(
                new android.graphics.drawable.Drawable[] {rounded(START_READY, 28), fill}));
        mCountdownEnd = SystemClock.uptimeMillis() + COUNTDOWN_MS;
        tickCountdown();
    }

    private static int remainingCountdownSteps(long elapsed) {
        return Math.max(1, COUNTDOWN_STEPS - (int) (Math.max(0, elapsed) / COUNTDOWN_STEP_MS));
    }

    private void tickCountdown() {
        Button start = mStart;
        if (!isResumed() || start == null || mCountdownEnd == 0) return;
        long left = mCountdownEnd - SystemClock.uptimeMillis();
        if (left > 0) {
            long elapsed = COUNTDOWN_MS - left;
            if (mStartProgress != null) {
                mStartProgress.setLevel((int) Math.min(10000, (10000 * elapsed) / COUNTDOWN_MS));
            }
            String label = getString(restartNeeded() ? R.string.raws_setup_restarting
                                                    : R.string.raws_setup_starting,
                    remainingCountdownSteps(elapsed));
            if (!label.contentEquals(start.getText())) {
                start.setText(label);
                start.setContentDescription(label);
            }
            long untilNextStep = COUNTDOWN_STEP_MS - elapsed % COUNTDOWN_STEP_MS;
            mUi.postDelayed(this::tickCountdown, Math.min(left, Math.min(33, untilNextStep)));
            return;
        }
        if (mStartProgress != null) mStartProgress.setLevel(10000);
        mCountdownEnd = 0;
        finishSetup();
    }

    private void persistAcceptedAdsChoice(Profile profile) {
        mAdsWritePending = true;
        TextView status = mStatus;
        if (status != null) status.setText(R.string.raws_setup_saving_ads);
        Button start = mStart;
        if (start != null) {
            start.setText(R.string.raws_setup_saving_ads);
            start.setContentDescription(getString(R.string.raws_setup_saving_ads));
        }
        mAdsSaveInterrupted = false;
        mAdsSaveStarted = SystemClock.uptimeMillis();
        mAdsCommitted = ADS_UNAVAILABLE;
        final int token = ++mAdsWriteToken;
        final int wanted = mAdsStaged;
        WeakReference<RawSSetupFirstRunFragment> reference = new WeakReference<>(this);
        boolean accepted = RawsProtectionCopy.setGlobalAdFilteringEnabled(
                profile, wanted == ADS_ON, success -> {
                    RawSSetupFirstRunFragment fragment = reference.get();
                    if (fragment != null) fragment.onAdsChoicePersisted(token, wanted, success);
                });
        if (!accepted) onAdsChoicePersisted(token, wanted, false);
    }

    private void onAdsChoicePersisted(int token, int wanted, boolean success) {
        if (!mAdsWritePending || token != mAdsWriteToken) return;
        mAdsWritePending = false;
        Profile profile = mProfile;
        boolean committed = success && profile != null
                && RawsProtectionCopy.globalAdFilteringState(profile) == wanted;
        mAdsCommitted = committed ? wanted : ADS_UNAVAILABLE;
        if (mAdsSaveInterrupted || !isResumed()) {
            // The explicit choice may already be saved, but don't resume an interrupted action.
            mSaveFailed = !committed;
            mRenderedButtonText = 0;
            mStartProgress = null;
            restoreOptions();
            if (isResumed()) refreshInlineDnsPicker();
            return;
        }
        if (!committed) {
            showSaveFailure();
            return;
        }
        finishSetup(); // Rechecks the generation and active page after the write callback.
    }

    // The existing legal acceptance and pending-intent launch stay in FirstRunActivity.
    @android.annotation.SuppressLint("ApplySharedPref")
    private void finishSetup() {
        if (!isResumed() || mAdsWritePending || mConfirmed) return;
        var delegate = getPageDelegate();
        Profile profile = mProfile;
        var prefs = ContextUtils.getAppSharedPreferences();
        if (delegate == null || profile == null || prefs == null
                || !(getActivity() instanceof FirstRunActivity activity)
                || !activity.isRawSSetupCurrent()) {
            showSaveFailure();
            return;
        }
        if (!FirstRunUtils.isFirstRunEulaAccepted() && !mTermsConsentForSetup) {
            showSaveFailure();
            return;
        }
        if (!protectionReady()) {
            mTermsConsentForSetup = false;
            mRenderedButtonText = 0;
            mStartProgress = null;
            restoreOptions();
            refreshInlineDnsPicker();
            updateButton();
            return;
        }
        if (mAdsExplicit) {
            int currentAds = RawsProtectionCopy.globalAdFilteringState(profile);
            if (profile.isOffTheRecord() || currentAds == ADS_UNAVAILABLE) {
                showSaveFailure();
                return;
            }
            if (mAdsCommitted != mAdsStaged || currentAds != mAdsStaged) {
                persistAcceptedAdsChoice(profile);
                return;
            }
        }
        if (RawSDarkPages.canManageGlobal(profile)
                && RawSDarkPages.getGlobal(profile) != mStagedDarkPages
                && !RawSDarkPages.setGlobal(profile, mStagedDarkPages)) {
            showSaveFailure();
            return;
        }
        if (restartNeeded()
                && !RawSNavigationAppearance.commitBlurLevel(mStagedBlur)) {
            showSaveFailure();
            return;
        }
        var profilePrefs = UserPrefs.get(profile);
        if (mInitialBlockThirdPartyCookies != mBlockThirdPartyCookies
                && !profilePrefs.isManagedPreference(COOKIE_CONTROLS_MODE)) {
            // Match Chromium's native cookie settings owner; keep incognito protection when
            // the user explicitly turns off stricter blocking for ordinary tabs.
            profilePrefs.setInteger(COOKIE_CONTROLS_MODE, mBlockThirdPartyCookies
                    ? CookieControlsMode.BLOCK_THIRD_PARTY : CookieControlsMode.INCOGNITO_ONLY);
        }
        SharedPreferences.Editor next = prefs.edit();
        NotificationPermissionController.putRawSSetupChoice(next, mRequestNotifications);
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q
                && !prefs.getBoolean(DEFAULT_ROLE_OFFERED, false)) {
            next.putBoolean(DEFAULT_ROLE_PENDING, true);
        }
        if (restartNeeded()) next.putBoolean(RESTART_PENDING, true);
        else next.remove(RESTART_PENDING);
        if (!next.commit()) { showSaveFailure(); return; }
        mConfirmed = true;
        mTermsConsentForSetup = false;
        if (!FirstRunUtils.isFirstRunEulaAccepted()) {
            // Explicit agreement, still-current setup, and successful settings writes
            // are all required. Preserve Chromium's single acceptance owner.
            delegate.acceptTermsOfService(/* allowMetricsAndCrashUploading= */ false);
        }
        delegate.advanceToNextPage();
    }

    private void showSaveFailure() {
        mTermsConsentForSetup = false;
        mSaveFailed = true;
        mRenderedButtonText = 0;
        mStartProgress = null;
        restoreOptions();
        refreshInlineDnsPicker();
        TextView status = mStatus;
        if (status != null) status.setText(R.string.raws_setup_save_failed);
        updateButton();
    }

    private void restoreOptions() {
        for (View control : mFrozenControls) control.setEnabled(true);
        mFrozenControls.clear();
    }

    private void disableOptions(View view, View except) {
        if (view instanceof ViewGroup group) {
            for (int i = 0; i < group.getChildCount(); i++) disableOptions(group.getChildAt(i), except);
        } else if (view != except && view.isClickable() && view.isEnabled()) {
            mFrozenControls.add(view);
            view.setEnabled(false);
        }
    }

    private int dp(float dp) {
        return Math.round(dp * getResources().getDisplayMetrics().density);
    }

    private LinearLayout column() {
        LinearLayout layout = new LinearLayout(requireContext());
        layout.setOrientation(LinearLayout.VERTICAL);
        return layout;
    }

    private LinearLayout card(LinearLayout parent) {
        LinearLayout card = column();
        card.setBackground(rounded(CARD, 24));
        LinearLayout.LayoutParams p = new LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
        p.topMargin = dp(8);
        parent.addView(card, p);
        return card;
    }

    private GradientDrawable rounded(int color, int radius) {
        GradientDrawable drawable = new GradientDrawable();
        drawable.setColor(color);
        drawable.setCornerRadius(dp(radius));
        return drawable;
    }

    private TextView text(int id, float size, int color) {
        TextView t = new TextView(requireContext());
        t.setText(id);
        t.setTextSize(size);
        t.setTextColor(color);
        return t;
    }

    private Button addInlineChoice(LinearLayout parent, int title, int summary) {
        LinearLayout row = new LinearLayout(parent.getContext());
        row.setGravity(Gravity.CENTER_VERTICAL);
        row.setPaddingRelative(dp(12), dp(4), dp(12), dp(4));
        row.setMinimumHeight(dp(48));
        LinearLayout labels = column();
        labels.setPaddingRelative(0, 0, dp(8), 0);
        labels.addView(text(title, 16, TEXT));
        if (summary != 0) {
            labels.addView(text(summary, 13, SECONDARY));
        } else {
            // The choice announces the full title and value together.
            labels.setImportantForAccessibility(
                    View.IMPORTANT_FOR_ACCESSIBILITY_NO_HIDE_DESCENDANTS);
        }
        row.addView(labels, new LinearLayout.LayoutParams(0,
                ViewGroup.LayoutParams.WRAP_CONTENT, 1));
        Button choice = new Button(parent.getContext(), null, android.R.attr.borderlessButtonStyle);
        choice.setAllCaps(false);
        choice.setGravity(Gravity.CENTER);
        choice.setTextSize(13);
        choice.setTextColor(TEXT);
        choice.setPaddingRelative(dp(6), 0, dp(6), 0);
        choice.setMaxLines(1);
        choice.setEllipsize(TextUtils.TruncateAt.END);
        choice.setBackground(rounded(0xFF242424, 12));
        row.addView(choice, new LinearLayout.LayoutParams(dp(112), dp(48)));
        parent.addView(row);
        return choice;
    }

    private void addInlineDnsPicker(LinearLayout parent, FirstRunActivity host) {
        Button choice =
                addInlineChoice(parent, R.string.raws_setup_dns, R.string.raws_setup_dns_global);
        mDnsChoice = choice;
        refreshInlineDnsPicker();
        choice.setOnClickListener(v -> {
            refreshInlineDnsPicker();
            if (mCountdownEnd != 0 || mConfirmed || !choice.isEnabled() || !isResumed()) return;
            if (mDnsPopup != null) mDnsPopup.dismiss();
            var choices = SecureDnsSettings.getInlineProviders(host);
            int selected = SecureDnsSettings.getInlineSelectedProviderIndex(choices);
            var popup = new android.widget.PopupMenu(host, choice);
            mDnsPopup = popup;
            for (int i = 0; i < choices.size(); i++) {
                popup.getMenu().add(1, i + 1, i, choices.get(i).getLabel())
                        .setCheckable(true).setChecked(i == selected);
            }
            popup.getMenu().setGroupCheckable(1, true, true);
            popup.getMenu().add(0, choices.size() + 1, choices.size(),
                    R.string.raws_setup_dns_custom);
            popup.setOnMenuItemClickListener(item -> {
                if (!isResumed() || mConfirmed || mCountdownEnd != 0) return true;
                int index = item.getItemId() - 1;
                if (index == choices.size() && SecureDnsSettings.canSelectInlineProvider()) {
                    // Native screen owns custom template validation, probe and any policy copy.
                    SettingsNavigationFactory.createSettingsNavigation(host)
                            .startSettings(host, SecureDnsSettings.class);
                } else if (index >= 0 && index < choices.size()
                        && !SecureDnsSettings.selectInlineProvider(host, choices.get(index))) {
                    android.widget.Toast.makeText(host, R.string.raws_setup_dns_failed,
                            android.widget.Toast.LENGTH_SHORT).show();
                }
                refreshInlineDnsPicker();
                return true;
            });
            popup.setOnDismissListener(dismissed -> {
                if (mDnsPopup == dismissed) mDnsPopup = null;
                if (isResumed()) refreshInlineDnsPicker();
            });
            popup.show();
        });
    }

    private void refreshInlineDnsPicker() {
        Button choice = mDnsChoice;
        if (choice == null || mConfirmed || mCountdownEnd != 0) return;
        var context = choice.getContext();
        String label = SecureDnsSettings.getInlineProviderLabel(context);
        choice.setText(label);
        choice.setContentDescription(context.getString(R.string.raws_setup_dns_selected, label));
        boolean allowed = SecureDnsSettings.canSelectInlineProvider();
        choice.setEnabled(allowed);
        choice.setAlpha(allowed ? 1f : 0.5f);
    }

    private void dismissInlineDnsPicker() {
        var popup = mDnsPopup;
        mDnsPopup = null;
        if (popup != null) popup.dismiss();
    }

    private void divider(LinearLayout parent) {
        View line = new View(requireContext());
        line.setBackgroundColor(SEPARATOR);
        line.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
        LinearLayout.LayoutParams p = new LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, dp(1));
        p.setMarginStart(dp(14));
        p.setMarginEnd(dp(14));
        parent.addView(line, p);
    }

    private Button rowButton(LinearLayout parent, int title, Runnable action) {
        Button button = new Button(requireContext(), null, android.R.attr.borderlessButtonStyle);
        button.setAllCaps(false);
        button.setGravity(Gravity.START | Gravity.CENTER_VERTICAL);
        button.setPaddingRelative(dp(12), dp(4), dp(12), dp(4));
        button.setMinHeight(dp(48));
        button.setTextColor(TEXT);
        button.setText(title);
        button.setOnClickListener(v -> action.run());
        parent.addView(button);
        return button;
    }

    private Switch addSwitch(LinearLayout parent, int name, int summary, boolean checked,
            boolean enabled, java.util.function.Consumer<Boolean> listener) {
        LinearLayout row = new LinearLayout(requireContext());
        row.setGravity(Gravity.CENTER_VERTICAL);
        row.setPaddingRelative(dp(12), dp(5), dp(12), dp(5));
        row.setMinimumHeight(dp(48));
        LinearLayout labels = column();
        labels.addView(text(name, 16, TEXT));
        labels.addView(text(summary, 13, SECONDARY));
        row.addView(labels, new LinearLayout.LayoutParams(0,
                ViewGroup.LayoutParams.WRAP_CONTENT, 1));
        Switch toggle = new Switch(requireContext());
        toggle.setContentDescription(getString(name));
        toggle.setChecked(checked);
        toggle.setEnabled(enabled);
        toggle.setThumbTintList(android.content.res.ColorStateList.valueOf(Color.WHITE));
        toggle.setTrackTintList(new android.content.res.ColorStateList(
                new int[][] {{-android.R.attr.state_enabled}, {android.R.attr.state_checked}, {}},
                new int[] {START_DISABLED, PRIMARY, SEPARATOR}));
        toggle.setOnCheckedChangeListener((view, on) -> listener.accept(on));
        row.addView(toggle);
        parent.addView(row);
        return toggle;
    }
}
