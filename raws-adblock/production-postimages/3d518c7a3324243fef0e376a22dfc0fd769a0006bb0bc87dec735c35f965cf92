/**
 * Handles WebAPK and PWA install actions from the app menu.
 *
 * <p>Provides entry points for Universal Install, Add to Homescreen, and opening an already
 * installed WebAPK without depending on ChromeActivity.
 */
@NullMarked
public class AppInstallMenuHandler {
    private static final String TAG = "AppInstallMenu";

    /**
     * Shows the Universal Install bottom sheet or falls back to Add To Homescreen.
     *
     * <p>If the bottom sheet controller is unavailable, this method directly triggers the Install
     * App flow to match the menu item that would have been shown when Universal Install is
     * disabled.
     *
     * @param activity The hosting activity used for UI and intents.
     * @param windowAndroid Window context for bottom sheet presentation.
     * @param currentTab The tab from which installation is triggered.
     * @return True when an install flow was started.
     */
    public static boolean doUniversalInstall(
            Activity activity,
            WindowAndroid windowAndroid,
            ModalDialogManager modalDialogManager,
            Tab currentTab) {
        @Nullable WebContents webContents = currentTab.getWebContents();
        if (webContents == null) return false;

        String manifestId = WebappRegistry.getManifestIdOrUrl(currentTab);

        boolean isPending = WebappRegistry.getInstance().isWebApkPending(manifestId);
        if (isPending) {
            String appName = currentTab.getTitle();
            android.widget.Toast.makeText(
                            activity,
                            activity.getString(
                                    R.string.notification_webapk_install_in_progress, appName),
                            android.widget.Toast.LENGTH_SHORT)
                    .show();
            return true;
        }

        if (WebappRegistry.getInstance().wasWebApkRecentlyInstalled(manifestId, 10000)) {
            return doOpenWebApp(activity, currentTab);
        }

        @Nullable BottomSheetController controller =
                BottomSheetControllerProvider.from(windowAndroid);
        if (controller == null) {
            // We have three options when this function fails. One is to abort the operation and do
            // nothing (by returning false), or we can make one of the two options of the Universal
            // Install dialog the default and go with that in case of errors. Since Install App is
            // the menu item that would have been shown, if Universal Install was disabled, we
            // fall back to the Install App option.
            return doAddToHomescreen(
                    activity,
                    windowAndroid,
                    modalDialogManager,
                    currentTab,
                    AppMenuVerbiage.APP_MENU_OPTION_INSTALL);
        }

        boolean webAppInstalled =
                WebappRegistry.getInstance().isAppInstalledForUrl(currentTab.getUrl());

        PwaUniversalInstallBottomSheetCoordinator pwaUniversalInstallBottomSheetCoordinator =
                new PwaUniversalInstallBottomSheetCoordinator(
                        activity,
                        webContents,
                        () -> {
                            doAddToHomescreen(
                                    activity,
                                    windowAndroid,
                                    modalDialogManager,
                                    currentTab,
                                    AppMenuVerbiage.APP_MENU_OPTION_INSTALL);
                        },
                        () -> {
                            doAddToHomescreen(
                                    activity,
                                    windowAndroid,
                                    modalDialogManager,
                                    currentTab,
                                    AppMenuVerbiage.APP_MENU_OPTION_ADD_TO_HOMESCREEN);
                        },
                        () -> {
                            doOpenWebApp(activity, currentTab);
                        },
                        webAppInstalled,
                        controller,
                        R.drawable.outline_chevron_right_24dp,
                        R.drawable.down_arrow_on_circular_background,
                        R.drawable.chrome_logo_on_circular_background);
        pwaUniversalInstallBottomSheetCoordinator.showBottomSheetAsync();
        return true;
    }

    /**
     * Triggers the Add To Homescreen or Install App flow.
     *
     * <p>When the menu item represents Install App, this method first attempts to expand the PWA
     * bottom sheet installer. Otherwise it falls back to the standard Add To Homescreen
     * coordinator.
     *
     * @param activity The hosting activity.
     * @param windowAndroid Window context.
     * @param modalDialogManager Manager for confirmation dialogs, may be null.
     * @param currentTab The tab being installed.
     * @param menuItemType Menu action type from {@link AppMenuVerbiage}.
     * @return True when an installation UI was shown.
     */
    public static boolean doAddToHomescreen(
            Activity activity,
            WindowAndroid windowAndroid,
            ModalDialogManager modalDialogManager,
            Tab currentTab,
            int menuItemType) {
        @Nullable WebContents webContents = currentTab.getWebContents();
        if (webContents == null) return false;
        AddToHomescreenViewDelegate.@Nullable LocalIconFactory iconFactory = null;
        if (menuItemType == AppMenuVerbiage.APP_MENU_OPTION_INSTALL) {
            iconFactory = localIconFactory(activity, windowAndroid, currentTab, webContents);
            @Nullable PwaBottomSheetController controller =
                    PwaBottomSheetControllerProvider.from(windowAndroid);
            if (controller != null
                    && controller.requestOrExpandBottomSheetInstaller(
                            webContents, InstallTrigger.MENU)) {
                var factory = iconFactory;
                if (factory != null && factory.canUse()) {
                    TextView action = localIconAction(activity, R.string.raws_pwa_local_icon_choose);
                    controller.addLocalIconAction(webContents, action, factory::canUse, () -> {
                        if (!factory.canUse()) return;
                        AddToHomescreenCoordinator.showForAppMenu(activity, windowAndroid,
                                modalDialogManager, webContents, menuItemType, factory);
                    });
                }
                return true;
            }
        }

        if (iconFactory != null && iconFactory.canUse()) {
            AddToHomescreenCoordinator.showForAppMenu(
                    activity, windowAndroid, modalDialogManager, webContents, menuItemType, iconFactory);
        } else {
            AddToHomescreenCoordinator.showForAppMenu(
                    activity, windowAndroid, modalDialogManager, webContents, menuItemType);
        }
        return true;
    }

    private static AddToHomescreenViewDelegate.@Nullable LocalIconFactory localIconFactory(
            Activity activity, WindowAndroid window, Tab tab, WebContents contents) {
        if (!"io.github.sandeepbimt.raws".equals(activity.getPackageName())
                || tab.isIncognito()) {
            return null;
        }
        var url = contents.getLastCommittedUrl();
        return new AddToHomescreenViewDelegate.LocalIconFactory() {
            @Override
            public boolean canUse() {
                if (activity.isFinishing() || activity.isDestroyed()
                        || tab.isDestroyed() || tab.isHidden() || tab.isIncognito()
                        || tab.getWebContents() != contents || contents.isDestroyed()
                        || contents.getTopLevelNativeWindow() != window
                        || !"https".equals(url.getScheme())
                        || !url.equals(contents.getLastCommittedUrl())
                        || !url.equals(contents.getVisibleUrl())) {
                    return false;
                }
                ShortcutManager shortcuts = activity.getSystemService(ShortcutManager.class);
                if (shortcuts == null || !shortcuts.isRequestPinShortcutSupported()) return false;
                var registry = WebappRegistry.getInstance();
                // Browser-managed pins can leave registry entries after launcher removal.
                // This is an explicit new pin, not an in-place edit of an installed app.
                return !registry.isWebApkPending(WebappRegistry.getManifestIdOrUrl(tab))
                        && !registry.isAppInstalledForUrl(url);
            }

            @Override
            public String pinButtonText() {
                return activity.getString(R.string.raws_pwa_local_icon_pin);
            }

            @Override
            public AddToHomescreenViewDelegate.LocalIconControls create(
                    Context context, View content, ImageView icon, Runnable choose, Runnable reset) {
                return new RawSLocalIconControls(context, content, icon, choose, reset);
            }
        };
    }

    private static TextView localIconAction(Context context, int title) {
        var view = new Button(context, null, android.R.attr.borderlessButtonStyle);
        view.setText(title);
        view.setTextColor(context.getColor(R.color.raws_shields_text));
        view.setAllCaps(false);
        view.setGravity(Gravity.START | Gravity.CENTER_VERTICAL);
        view.setMinimumHeight(Math.round(48 * context.getResources().getDisplayMetrics().density));
        return view;
    }

    /** Chrome owns the appearance. The Webapps component retains its install model and buttons. */
    private static final class RawSLocalIconControls
            implements AddToHomescreenViewDelegate.LocalIconControls {
        private final FrameLayout mRim;
        private final FrameLayout mIconTarget;
        private final ImageView mIcon;
        private final View mBadge;
        private boolean mEligible;
        private boolean mBusy;
        private boolean mCustom;
        private boolean mFailed;
        private @Nullable AlertDialog mIconChoice;

        RawSLocalIconControls(Context context, View content, ImageView icon,
                Runnable choose, Runnable reset) {
            mIcon = icon;
            mRim = new FrameLayout(context);
            content.setBackgroundResource(R.drawable.raws_frozen_shields_card);
            mRim.addView(content, new FrameLayout.LayoutParams(
                    ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));

            mIconTarget = new FrameLayout(context);
            // This slot overlays the actual 36dp stock image and its spinner in the content frame.
            // Keep the stock ImageView in place: native install and preview continue to own it.
            var root = (FrameLayout) content;
            FrameLayout.LayoutParams iconParams = (FrameLayout.LayoutParams) icon.getLayoutParams();
            var target = new FrameLayout.LayoutParams(dp(context, 48), dp(context, 48),
                    iconParams.gravity);
            target.setMarginStart(iconParams.getMarginStart() - dp(context, 3));
            target.topMargin = iconParams.topMargin;
            root.addView(mIconTarget, target);

            mBadge = new View(context);
            int badgeSize = dp(context, 19);
            var badge = new FrameLayout.LayoutParams(badgeSize, badgeSize, Gravity.END | Gravity.BOTTOM);
            mIconTarget.addView(mBadge, badge);
            mBadge.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
            mBadge.setBackground(new PencilBadge(context));
            mIconTarget.setContentDescription(context.getString(R.string.raws_pwa_local_icon_choose));
            mIconTarget.setOnClickListener(v -> showIconChoice(context, choose, reset));
            mIconTarget.setFilterTouchesWhenObscured(true);
            mIconTarget.addOnAttachStateChangeListener(new View.OnAttachStateChangeListener() {
                @Override public void onViewAttachedToWindow(View view) {}
                @Override public void onViewDetachedFromWindow(View view) { dismissIconChoice(); }
            });
            renderIcon();
        }

        @Override
        public View getView() {
            return mRim;
        }

        @Override
        public android.graphics.drawable.Drawable getDialogBackground() {
            Context context = mRim.getContext();
            var background = new android.graphics.drawable.LayerDrawable(
                    new android.graphics.drawable.Drawable[] {
                            java.util.Objects.requireNonNull(
                                    context.getDrawable(R.drawable.raws_frozen_shields_rim)).mutate(),
                            java.util.Objects.requireNonNull(
                                    context.getDrawable(R.drawable.raws_frozen_shields_card)).mutate()
                    });
            int inset = dp(context, 6);
            background.setPaddingMode(android.graphics.drawable.LayerDrawable.PADDING_MODE_STACK);
            background.setLayerInset(1, inset, inset, inset, inset);
            return background;
        }

        @Override
        public void render(boolean eligible, boolean busy, boolean custom, boolean failed) {
            boolean firstFailure = failed && !mFailed;
            mEligible = eligible;
            mBusy = busy;
            mCustom = custom;
            mFailed = failed;
            if (!mEligible || mBusy) dismissIconChoice();
            renderIcon();
            if (firstFailure && mIconTarget.isAttachedToWindow()) {
                android.widget.Toast.makeText(mIconTarget.getContext(), R.string.raws_pwa_local_icon_failed,
                        android.widget.Toast.LENGTH_SHORT).show();
            }
        }

        @Override
        public void renderIcon() {
            boolean editable = mEligible && mIcon.getVisibility() == View.VISIBLE;
            mIconTarget.setVisibility(editable ? View.VISIBLE : View.GONE);
            mIconTarget.setEnabled(editable && !mBusy);
            mIconTarget.setFocusable(editable && !mBusy);
            mIcon.setImportantForAccessibility(editable
                    ? View.IMPORTANT_FOR_ACCESSIBILITY_NO : View.IMPORTANT_FOR_ACCESSIBILITY_AUTO);
        }

        private void showIconChoice(Context context, Runnable choose, Runnable reset) {
            if (!mIconTarget.isAttachedToWindow() || !mEligible || mBusy || mIconChoice != null) return;
            var builder = new AlertDialog.Builder(context)
                    .setTitle(R.string.raws_pwa_local_icon_choose)
                    .setMessage(R.string.raws_pwa_local_icon_explanation)
                    .setNegativeButton(android.R.string.cancel, null)
                    .setPositiveButton(R.string.raws_pwa_local_icon_choose_image, (dialog, which) -> {
                        if (dialog == mIconChoice && mEligible && !mBusy) choose.run();
                    });
            if (mCustom || mFailed) {
                builder.setNeutralButton(R.string.raws_pwa_local_icon_default, (dialog, which) -> {
                    if (dialog == mIconChoice && mEligible && !mBusy) reset.run();
                });
            }
            var dialog = builder.create();
            mIconChoice = dialog;
            dialog.setOnDismissListener(dismissed -> {
                if (mIconChoice == dismissed) mIconChoice = null;
            });
            dialog.show();
        }

        private void dismissIconChoice() {
            var dialog = mIconChoice;
            mIconChoice = null;
            if (dialog != null) dialog.dismiss();
        }

        private static int dp(Context context, int value) {
            return Math.round(context.getResources().getDisplayMetrics().density * value);
        }
    }

    private static final class PencilBadge extends android.graphics.drawable.Drawable {
        private final android.graphics.Paint mPaint = new android.graphics.Paint(
                android.graphics.Paint.ANTI_ALIAS_FLAG);
        private final android.graphics.Path mPencil = new android.graphics.Path();
        private final int mColor;

        PencilBadge(Context context) {
            boolean night = (context.getResources().getConfiguration().uiMode
                    & android.content.res.Configuration.UI_MODE_NIGHT_MASK)
                    == android.content.res.Configuration.UI_MODE_NIGHT_YES;
            mColor = night ? 0xffa8c7fa : 0xff0b57d0;
            mPencil.moveTo(6.1f, 10.6f);
            mPencil.lineTo(11.5f, 5.2f);
            mPencil.lineTo(13.8f, 7.5f);
            mPencil.lineTo(8.4f, 12.9f);
            mPencil.lineTo(5.1f, 13.9f);
            mPencil.close();
        }

        @Override
        public void draw(android.graphics.Canvas canvas) {
            var bounds = getBounds();
            int saved = canvas.save();
            canvas.translate(bounds.left, bounds.top);
            canvas.scale(bounds.width() / 19f, bounds.height() / 19f);
            mPaint.setColor(0xe62b3340);
            canvas.drawCircle(9.5f, 9.5f, 9f, mPaint);
            mPaint.setColor(mColor);
            canvas.drawPath(mPencil, mPaint);
            canvas.restoreToCount(saved);
        }

        @Override public void setAlpha(int alpha) { mPaint.setAlpha(alpha); }
        @Override public void setColorFilter(@Nullable ColorFilter filter) {
            mPaint.setColorFilter(filter);
        }
        @Override public int getOpacity() { return android.graphics.PixelFormat.TRANSLUCENT; }
    }

    /**
     * Launches an installed web app for the current URL.
     *
     * <p>Queries the system for a matching web app package and starts it. Displays a toast when no
     * handler is available.
     *
     * @param activity The activity used to start the intent.
     * @param currentTab The tab whose URL should be opened.
     * @return True after the launch attempt.
     */
    public static boolean doOpenWebApp(Activity activity, Tab currentTab) {
        OpenInAppDelegate delegate = OpenInAppDelegate.from(currentTab);
        if (delegate != null) {
            OpenInAppDelegate.OpenInAppInfo openInAppInfo = delegate.getCurrentOpenInAppInfo();
            if (openInAppInfo != null && openInAppInfo.action != null) {
                openInAppInfo.action.run();
                return true;
            }
        }

        Context context = ContextUtils.getApplicationContext();
        @Nullable String packageName = null;
        @Nullable WebContents webContents = currentTab.getWebContents();
        if (webContents != null) {
            String manifestId = WebappRegistry.getManifestIdOrUrl(currentTab);
            packageName = WebappRegistry.getInstance().findWebApkWithManifestId(manifestId);
        }

        String currentTabUrl = currentTab.getUrl().getSpec();
        if (packageName == null) {
            packageName = WebApkValidator.queryFirstWebApkPackage(context, currentTabUrl);
        }

        // Try launching a WebAPK first.
        if (packageName != null) {
            Intent launchIntent =
                    WebApkNavigationClient.createLaunchWebApkIntent(
                            packageName, currentTabUrl, false);
            try {
                context.startActivity(launchIntent);
            } catch (ActivityNotFoundException | SecurityException e) {
                Log.w(TAG, "Failed to launch WebAPK: " + packageName, e);
                Toast.makeText(context, R.string.open_webapk_failed, Toast.LENGTH_SHORT).show();
            }
            return true;
        }

        // Fallback to launching a TWA instead if a WebApk is not found.
        String twaPackage = TwaValidator.queryFirstTwaPackage(currentTab.getUrl());
        if (twaPackage != null) {
            Intent launchIntent = new Intent(Intent.ACTION_VIEW, Uri.parse(currentTabUrl));
            launchIntent.setPackage(twaPackage);
            launchIntent.addCategory(Intent.CATEGORY_BROWSABLE);
            launchIntent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
            try {
                context.startActivity(launchIntent);
            } catch (ActivityNotFoundException | SecurityException e) {
                Log.w(TAG, "Failed to launch TWA: " + twaPackage, e);
                Toast.makeText(context, R.string.open_webapk_failed, Toast.LENGTH_SHORT).show();
            }
            return true;
        }

        // Neither a WebApk or a TWA was found.
        Toast.makeText(context, R.string.open_webapk_failed, Toast.LENGTH_SHORT).show();
        return true;
    }
}
