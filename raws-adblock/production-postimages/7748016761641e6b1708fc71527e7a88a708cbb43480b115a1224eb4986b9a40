    /** Optional first-run/update readback on the real, attached browsing Home view. */
    private static final class RawSHomeFilterProgress implements View.OnAttachStateChangeListener {
        static final int HIDDEN = 0;
        static final int LOADING = 1;
        static final int APPLYING = 2;
        private static final long POLL_MS = 850;
        private static final int UNKNOWN_POLLS = 12;

        private final FrameLayout mRoot;
        private final Profile mProfile;
        private final ActivityLifecycleDispatcher mLifecycle;
        private final BooleanSupplier mCurrentHome;
        private final Runnable mSample = this::sample;
        private final int[] mWindowLocation = new int[2];
        private @Nullable LinearLayout mBadge;
        private @Nullable TextView mLabel;
        private @Nullable ProgressBar mBar;
        private int mUnknownPollsRemaining;
        private boolean mDestroyed;

        RawSHomeFilterProgress(
                FrameLayout root,
                Profile profile,
                ActivityLifecycleDispatcher lifecycle,
                BooleanSupplier currentHome) {
            mRoot = root;
            mProfile = profile;
            mLifecycle = lifecycle;
            mCurrentHome = currentHome;
            mRoot.addOnAttachStateChangeListener(this);
        }

        static int displayState(int global, int phase, int enabled, int cached, int active) {
            if (global != 1 || phase != RawsProtectionCopy.AD_FILTER_PREPARING
                    || enabled <= 0 || cached < 0 || cached > enabled || active < 0
                    || active > cached || active >= enabled) {
                return HIDDEN;
            }
            return cached == enabled ? APPLYING : LOADING;
        }

        void resample() {
            mUnknownPollsRemaining = UNKNOWN_POLLS;
            mRoot.removeCallbacks(mSample);
            sample();
        }

        void stop() {
            mRoot.removeCallbacks(mSample);
            hide();
        }

        void destroy() {
            mDestroyed = true;
            stop();
            mRoot.removeOnAttachStateChangeListener(this);
        }

        @Override
        public void onViewAttachedToWindow(View view) {
            resample();
        }

        @Override
        public void onViewDetachedFromWindow(View view) {
            stop();
        }

        private void sample() {
            if (mDestroyed || !mRoot.isAttachedToWindow() || !mRoot.isShown()
                    || mRoot.getWindowVisibility() != View.VISIBLE
                    || mLifecycle.getCurrentActivityState()
                            != ActivityLifecycleDispatcher.ActivityState.RESUMED_WITH_NATIVE
                    || !mCurrentHome.getAsBoolean()) {
                hide();
                return;
            }
            int global = RawsProtectionCopy.globalAdFilteringState(mProfile);
            if (global == 0) {
                hide();
                return;
            }
            RawsProtectionCopy.AdSubscriptionState state =
                    RawsProtectionCopy.adSubscriptionState(mProfile);
            int mode = displayState(global, state.phase, state.enabled, state.cached, state.active);
            if (mode == HIDDEN) {
                hide();
            } else {
                render(mode, state.active, state.enabled);
            }
            // Track only real unit changes while visible and work is outstanding.
            // A ready, failed, or off page never keeps an idle polling task.
            boolean unknown = global == -1 || state.phase == RawsProtectionCopy.AD_FILTER_UNKNOWN
                    || (state.phase == RawsProtectionCopy.AD_FILTER_PREPARING && state.enabled == 0);
            if (mode != HIDDEN || (unknown && mUnknownPollsRemaining-- > 0)) {
                mRoot.postDelayed(mSample, POLL_MS);
            }
        }

        private void render(int mode, int active, int enabled) {
            WindowInsetsCompat insets = ViewCompat.getRootWindowInsets(mRoot);
            int inset = insets == null ? 0 : insets.getInsets(
                    WindowInsetsCompat.Type.statusBars() | WindowInsetsCompat.Type.displayCutout()).top;
            mRoot.getLocationInWindow(mWindowLocation);
            int top = Math.max(0, inset - mWindowLocation[1]) + dp(18);
            if (mRoot.getHeight() < top + dp(380)
                    || (insets != null && insets.isVisible(WindowInsetsCompat.Type.ime()))) {
                hide();
                return;
            }
            LinearLayout badge = mBadge;
            TextView label = mLabel;
            ProgressBar bar = mBar;
            if (badge == null || label == null || bar == null) {
                Context context = mRoot.getContext();
                badge = new LinearLayout(context);
                badge.setOrientation(LinearLayout.VERTICAL);
                badge.setGravity(Gravity.CENTER_HORIZONTAL);
                badge.setPadding(dp(14), dp(7), dp(14), dp(7));
                badge.setClickable(false);
                badge.setFocusable(false);
                GradientDrawable plate = new GradientDrawable();
                plate.setColor(0xD922201D);
                plate.setCornerRadius(dp(15));
                badge.setBackground(plate);
                label = new TextView(context);
                label.setTextColor(0xFFF4EBDD);
                label.setTextSize(12);
                label.setGravity(Gravity.CENTER);
                label.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_YES);
                label.setMaxWidth(dp(264));
                badge.addView(label);
                bar = new ProgressBar(context, null, android.R.attr.progressBarStyleHorizontal);
                bar.setProgressTintList(ColorStateList.valueOf(0xFFD7BD8C));
                bar.setIndeterminateTintList(ColorStateList.valueOf(0xFFD7BD8C));
                bar.setProgressBackgroundTintList(ColorStateList.valueOf(0x4DD7BD8C));
                bar.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
                LinearLayout.LayoutParams barParams = new LinearLayout.LayoutParams(
                        dp(92), dp(6));
                barParams.topMargin = dp(4);
                badge.addView(bar, barParams);
                FrameLayout.LayoutParams params = new FrameLayout.LayoutParams(
                        ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT,
                        Gravity.TOP | Gravity.CENTER_HORIZONTAL);
                params.topMargin = top;
                mRoot.addView(badge, params);
                mBadge = badge;
                mLabel = label;
                mBar = bar;
            } else if (badge.getLayoutParams() instanceof FrameLayout.LayoutParams params
                    && params.topMargin != top) {
                params.topMargin = top;
                badge.setLayoutParams(params);
            }
            final boolean applying = mode == APPLYING;
            String text = applying
                    ? mRoot.getResources().getString(R.string.raws_home_filters_applying)
                    : mRoot.getResources().getString(R.string.raws_home_filters_loading, active, enabled);
            if (!text.contentEquals(label.getText())) label.setText(text);
            if (bar.isIndeterminate() != applying) bar.setIndeterminate(applying);
            if (!applying) {
                if (bar.getMax() != enabled) bar.setMax(enabled);
                if (bar.getProgress() != active) bar.setProgress(active);
            }
        }

        private int dp(int size) {
            return Math.round(size * mRoot.getResources().getDisplayMetrics().density);
        }

        private void hide() {
            LinearLayout badge = mBadge;
            if (badge == null) return;
            mRoot.removeView(badge);
            mBadge = null;
            mLabel = null;
            mBar = null;
        }
    }

    private void recordFcpOnFirstDraw() {
        View view = getView();
        if (view == null) return;

        FirstDrawDetector.waitForFirstDraw(
                view,
                () -> {
                    if (mRecordedFcp) return;
                    mRecordedFcp = true;
                    long durationMs = SystemClock.uptimeMillis() - mNavigationStartMs;
                    // LINT.IfChange(page_load_histogram)
                    RecordHistogram.recordCustomTimesHistogram(
                            "NewTabPage.LoadTime.FirstContentfulPaint2",
                            durationMs,
                            10,
                            10 * TimeUtils.MILLISECONDS_PER_MINUTE,
                            100);
                    // LINT.ThenChange(/components/page_load_metrics/browser/page_load_metrics_util.h:page_load_histogram)
                });
    }

