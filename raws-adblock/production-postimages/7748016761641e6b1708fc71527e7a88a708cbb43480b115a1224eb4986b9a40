    /**
     * Update the margins for the content when browser controls constraints or bottom control height
     * are changed.
     */
    private void updateMargins() {
        // TODO(mdjones): can this be merged with BasicNativePage's updateMargins?

        View view = getView();
        ViewGroup.MarginLayoutParams layoutParams =
                ((ViewGroup.MarginLayoutParams) view.getLayoutParams());
        if (layoutParams == null) return;

        // Negative |topControlsDistanceToRest| means the controls Y position is above the rest
        // position and the controls height is increasing with animation, while positive
        // |topControlsDistanceToRest| means the controls Y position is below the rest position and
        // the controls height is decreasing with animation. |getToolbarExtraYOffset()| returns
        // the margin when the controls are at rest, so |getToolbarExtraYOffset()
        // + topControlsDistanceToRest| will give the margin for the current animation frame.
        final int topControlsDistanceToRest =
                mBrowserControlsStateProvider.getContentOffset()
                        - mBrowserControlsStateProvider.getTopControlsHeight();
        final int topMargin = getToolbarExtraYOffset() + topControlsDistanceToRest;

        final int bottomMargin =
                mBrowserControlsStateProvider.getBottomControlsHeight()
                        - mBrowserControlsStateProvider.getBottomControlOffset();

        if (topMargin != layoutParams.topMargin || bottomMargin != layoutParams.bottomMargin) {
            layoutParams.topMargin = topMargin;
            layoutParams.bottomMargin = bottomMargin;
            view.setLayoutParams(layoutParams);
        }
    }

    // TODO(sinansahin): This is the same as {@link ToolbarManager#getToolbarExtraYOffset}. So, we
    // should look into sharing the logic.
    /**
     * @return The height that is included in the top controls but not in the toolbar or the tab
     *     strip.
     */
    private int getToolbarExtraYOffset() {
        return mBrowserControlsStateProvider.getTopControlsHeight()
                - mToolbarHeight
                - mTabStripHeightSupplier.get();
    }

    /**
     * Whether a real, committed regular web page can be saved to the browser's native Home.
     * This does not install or pin an Android launcher icon.
     */
    public static boolean canAddCurrentPageToRawSHome(Context context, @Nullable Tab tab) {
        return getRawSHomeShortcutUrl(context, tab) != null;
    }

    /** Save the current page at the front in one native profile-store mutation. */
    public static boolean addCurrentPageToRawSHome(Context context, @Nullable Tab tab) {
        GURL url = getRawSHomeShortcutUrl(context, tab);
        if (url == null || tab == null) return false;
        Profile profile = tab.getProfile();
        if (profile == null || profile.isOffTheRecord()) return false;
        String title = getRawSHomeShortcutLabel(url);
        if (!TileUtils.isValidCustomTileName(title)) return false;

        // Upstream enables both history tiles and profile custom links on this Android
        // bridge. Leave existing shortcuts/order intact; C++ owns duplicates and capacity.
        MostVisitedSitesBridge bridge = new MostVisitedSitesBridge(profile);
        try {
            return bridge.addCustomLink(title, url, /* pos= */ 0);
        } finally {
            bridge.destroy();
        }
    }

    private static @Nullable GURL getRawSHomeShortcutUrl(Context context, @Nullable Tab tab) {
        if (!"io.github.sandeepbimt.raws".equals(context.getPackageName())
                || DeviceFormFactor.isNonMultiDisplayContextOnTablet(context)
                || tab == null || tab.isDestroyed() || tab.isOffTheRecord()
                || tab.isNativePage() || tab.isShowingErrorPage()
                || !NtpCustomizationConfigManager.getInstance().getPrefIsMvtToggleOn()) {
            return null;
        }
        Profile profile = tab.getProfile();
        WebContents webContents = tab.getWebContents();
        if (profile == null || profile.isOffTheRecord()
                || webContents == null || webContents.isDestroyed()) {
            return null;
        }
        GURL committed = webContents.getLastCommittedUrl();
        String scheme = committed.getScheme();
        if (!("http".equals(scheme) || "https".equals(scheme))
                || !committed.equals(tab.getUrl())
                || !TileUtils.isValidCustomTileUrl(committed)) {
            return null;
        }
        return committed;
    }

    /** Native public suffix policy, retaining hosts for IP, intranet and canonical IDN names. */
    private static String getRawSHomeShortcutLabel(GURL url) {
        String domain = UrlUtilities.getDomainAndRegistry(url.getSpec(), true);
        String host = url.getHost();
        if (domain == null || domain.isEmpty()) return TileUtils.formatCustomTileName(host, url);
        int dot = domain.indexOf('.');
        String name = dot < 0 ? domain : domain.substring(0, dot);
        if (name.isEmpty() || name.startsWith("xn--")) {
            return TileUtils.formatCustomTileName(host, url);
        }
        int first = name.offsetByCodePoints(0, 1);
        return TileUtils.formatCustomTileName(
                name.substring(0, first).toUpperCase(Locale.ROOT) + name.substring(first), url);
    }

