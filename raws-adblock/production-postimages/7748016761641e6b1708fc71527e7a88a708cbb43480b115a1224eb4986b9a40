    private void updateRawSHomeFakeboxVisibility() {
        if (mIsDestroyed || (mRawSNativeHomeUrlView == null && !mRawSHomeFakeboxHidden)) return;
        @Nullable View nativeUrl = mRawSNativeHomeUrlView;
        boolean ownsBottom =
                nativeUrl != null
                        && nativeUrl.isAttachedToWindow()
                        && nativeUrl.isEnabled()
                        && mBrowserControlsStateProvider.getControlsPosition()
                                == ControlsPosition.BOTTOM;
        View fakebox = getSearchBoxView();
        if (nativeUrl == null || !ownsBottom
                || mNewTabPageCoordinator.usesRawSHomeSearchLauncher()) {
            if (mRawSHomeFakeboxHidden) {
                mRawSHomeFakeboxHidden = false;
                fakebox.setVisibility(mRawSHomePreviousFakeboxVisibility);
                fakebox.setImportantForAccessibility(mRawSHomePreviousFakeboxAccessibility);
            }
            return;
        }
        // Once committed, browser-controls scrolling does not resurrect a second field.
        if (mRawSHomeFakeboxHidden
                || fakebox.hasFocus()
                || !nativeUrl.isShown()
                || !nativeUrl.isFocusable()
                || nativeUrl.getHeight() <= 0
                || !nativeUrl.getGlobalVisibleRect(mRawSHomeVisibleBounds)
                || mRawSHomeVisibleBounds.height() < nativeUrl.getHeight()) {
            return;
        }
        mRawSHomePreviousFakeboxVisibility = fakebox.getVisibility();
        mRawSHomePreviousFakeboxAccessibility = fakebox.getImportantForAccessibility();
        mRawSHomeFakeboxHidden = true;
        // Preserve the native Home row's measured spacing; no duplicate painted or tappable field.
        fakebox.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO_HIDE_DESCENDANTS);
        fakebox.setVisibility(View.INVISIBLE);
    }

    /** Sets the OmniboxStub that this page interacts with. */
    public void setOmniboxStub(OmniboxStub omniboxStub) {
        mOmniboxStub = omniboxStub;
