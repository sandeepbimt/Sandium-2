    /**
     * Announces a native replacement owner. Keep the fallback fakebox until the native bottom
     * position and actual attached, visible input have both been observed.
     */
    public void setRawSNativeHomeOmniboxRoute(@Nullable View urlView) {
        if (mIsDestroyed) return;
        if (mIsLff || mTab.isOffTheRecord()) urlView = null;
        if (mRawSNativeHomeUrlView != urlView) {
            if (mRawSNativeHomeUrlView != null) {
                mRawSNativeHomeUrlView.removeOnLayoutChangeListener(mRawSHomeNativeUrlLayoutListener);
            }
            mRawSNativeHomeUrlView = urlView;
            if (urlView != null) {
                urlView.addOnLayoutChangeListener(mRawSHomeNativeUrlLayoutListener);
            }
        }
        updateRawSHomeFakeboxVisibility();
    }

