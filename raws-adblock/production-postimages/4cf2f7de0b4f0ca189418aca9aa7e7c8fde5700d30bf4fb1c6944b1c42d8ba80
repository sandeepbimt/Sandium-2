inline constexpr size_t kListLimit =
    network::SimpleURLLoader::kMaxBoundedStringDownloadSize;
inline constexpr size_t kAllLimit = 96u << 20;
static_assert(std::string_view(kCatalog[adblock_native::kUrlhausVivaldiOnlineIndex].url) ==
              "https://malware-filter.gitlab.io/urlhaus-filter/urlhaus-filter-vivaldi-online.txt");
inline constexpr size_t ListLimit(size_t index) {
  return index == adblock_native::kUrlhausVivaldiOnlineIndex
             ? adblock_native::SubscriptionRulesLimit(index)
             : kListLimit;
}
// Sandium's accepted bootstrap budget: 8 running downloads, up to 64
// scheduled catalogue entries. Apply only to subscription fetches, not to
// Chromium's unrelated native Download Service.
inline constexpr size_t kMaxRunningSubscriptionDownloads = 8;
inline constexpr size_t kMaxScheduledSubscriptionDownloads = 64;
static_assert(std::size(kCatalog) <= kMaxScheduledSubscriptionDownloads);
using Flags = std::array<Subscription, std::size(kCatalog)>;
using CachePresence = std::array<bool, std::size(kCatalog)>;
using CacheSizes = std::array<int, std::size(kCatalog)>;
struct Startup {
  bool valid = true;
  Flags flags{};
  CachePresence cached{};
  CacheSizes cached_bytes{};
  std::vector<size_t> missing;
  std::vector<adblock_native::SubscriptionInput> bodies;
};
// The filenames are SHA-256 of the full catalogue URL, not indexes or user input.
class ListCache {
 public:
  explicit ListCache(base::FilePath dir) : dir_(std::move(dir)) {}
  Startup Read() {
    Startup out;
    std::string state;
    std::optional<base::DictValue> data;
    if (base::PathExists(dir_.AppendASCII("state.json"))) {
      if (base::ReadFileToStringWithMaxSize(dir_.AppendASCII("state.json"), &state, 256*1024))
        data = base::JSONReader::ReadDict(state, base::JSON_PARSE_RFC);
      // Do not resurrect disabled or deleted subscriptions after state corruption.
      if (!data) {
        out.valid = false;
        for (auto& v : out.flags) v.enabled = false;
        return out;
      }
    }
    size_t budget = kAllLimit;
    for (size_t i = 0; i < out.flags.size(); ++i) {
      auto& f = out.flags[i];
      if (const auto* d = data ? data->FindDict(kCatalog.at(i).url) : nullptr) {
        f.enabled = d->FindBool("enabled").value_or(false);
        f.deleted = d->FindBool("deleted").value_or(false);
        f.expires_hours = std::clamp(d->FindInt("expires").value_or(kDefaultHours), 0, kMaxHours);
        f.attempt = static_cast<int64_t>(std::clamp(d->FindDouble("attempt").value_or(0.0),0.0,253402300799.0));
        f.success = static_cast<int64_t>(std::clamp(d->FindDouble("success").value_or(0.0),0.0,253402300799.0));
      }
      if (!f.Available()) {
        // A disabled catalogue entry need not be read into memory or parsed.
        // This is local cache presence only, never an active byte/rule count.
        base::File::Info info;
        if (f.success > 0 &&
            base::GetFileInfo(dir_.AppendASCII(kCatalog.at(i).key), &info) &&
            !info.is_directory && info.size > 0 &&
            static_cast<uint64_t>(info.size) <= ListLimit(i)) {
          out.cached[i] = true;
          out.cached_bytes[i] = static_cast<int>(info.size);
        }
        continue;
      }
      std::string body;
      if (f.success <= 0 ||
          !base::ReadFileToStringWithMaxSize(dir_.AppendASCII(kCatalog.at(i).key), &body, ListLimit(i)) ||
          !Accept(i, body)) { out.missing.push_back(i); continue; }
      // Never install an arbitrary prefix of an oversized multi-list generation.
      if (body.size() > budget) { LOG(WARNING) << "RawS filter snapshot exceeds byte limit; retaining active rules"; out.valid=false;out.bodies.clear(); return out; }
      budget -= body.size();
      out.cached[i] = true;
      out.cached_bytes[i] = static_cast<int>(body.size());
      out.bodies.push_back({i, std::move(body)});
    }
    return out;
  }
  static bool Accept(size_t index, const std::string& s) {
    const std::string_view view(s);
    const auto text = view.starts_with("\xEF\xBB\xBF") ? view.substr(3) : view;
    const auto first = text.find_first_not_of(" \t\r\n");
    return first != text.npos && text[first] != '<' && s.size() <= ListLimit(index) &&
           s.find('\0') == s.npos && base::IsStringUTF8(s);
  }
  int Store(size_t i, std::string body) {
    if (!Accept(i, body))
      return -1;
    const auto expiry = adblock_native::InspectSubscription(body, i);
    // A response with no parsed rules must never replace the last good file.
    if (!expiry || !base::CreateDirectory(dir_) ||
        !base::ImportantFileWriter::WriteFileAtomically(dir_.AppendASCII(kCatalog.at(i).key), body))
      return -1;
    return *expiry;
  }
  // Ownership follows the worker task even on rejection or service teardown.
  // Its destruction schedules deletion after this bounded read and parse.
  int StoreTemp(size_t index, base::FilePath path,
                base::ScopedClosureRunner /*cleanup*/) {
    std::string body;
    if (!base::ReadFileToStringWithMaxSize(path, &body, ListLimit(index)))
      return -1;
    return Store(index, std::move(body));
  }
  void Save(Flags flags) { (void)SaveChoice(std::move(flags)); }

  bool SaveChoice(Flags flags) {
    base::DictValue all;
    for (size_t i = 0; i < flags.size(); ++i) {
      const auto& f = flags[i]; base::DictValue v;
      v.Set("enabled", f.enabled); v.Set("deleted", f.deleted); v.Set("expires", f.expires_hours);
      v.Set("attempt", static_cast<double>(f.attempt)); v.Set("success", static_cast<double>(f.success));
      all.Set(kCatalog.at(i).url, std::move(v));
    }
    const auto serialized = base::WriteJson(all);
    return serialized && base::CreateDirectory(dir_) &&
           base::ImportantFileWriter::WriteFileAtomically(
               dir_.AppendASCII("state.json"), *serialized);
  }
 private:
  base::FilePath dir_;
};
class UrlSubscriptions final : public base::SupportsUserData::Data {
 public:
  explicit UrlSubscriptions(Profile* profile);
  ~UrlSubscriptions() override;

  std::string GetDetails() const {
    if (!started_ || !choices_known_) return {};
    std::array<const adblock_native::AdmittedSubscriptionStats*, std::size(kCatalog)>
        by_index{};
    for (const auto& info : adblock_native::ActiveSubscriptionStats()) {
      if (info.catalog_index < by_index.size()) by_index[info.catalog_index] = &info;
    }
    const bool applying = choice_write_pending_ || snapshot_read_pending_ ||
                          !queue_.empty() || !busy_.empty() ||
                          adblock_native::AdditionalRulesPhase(snapshot_revision_) ==
                              adblock_native::OfflineRulesPhase::kLoading;
    base::ListValue lists;
    for (size_t i = 0; i < flags_.size(); ++i) {
      const auto& item = kCatalog[i];
      const auto* active = by_index[i];
      base::DictValue entry;
      entry.Set("id", static_cast<int>(i));
      entry.Set("title", item.title);
      entry.Set("url", item.url);
      const bool enabled = flags_[i].Available();
      entry.Set("enabled", enabled);
      entry.Set("editable", !flags_[i].deleted);
      entry.Set("activation", enabled == (active != nullptr) ? "applied" :
                              applying ? "pending" : "not_applied");
      entry.Set("cached", cached_[i]);
      if (cached_[i] && flags_[i].success > 0) {
        entry.Set("lastDownloadEpochSeconds", static_cast<double>(flags_[i].success));
        if (cached_bytes_[i] > 0)
          entry.Set("cachedBytes", cached_bytes_[i]);
      }
      entry.Set("active", active != nullptr);
      if (active) {
        // Each native source body and its parser counts are bounded by the
        // per-list byte limit and provenance in the installed generation.
        entry.Set("activeBytes", static_cast<int>(active->source_bytes));
        entry.Set("networkRules", static_cast<int>(active->network_rules));
        entry.Set("cosmeticRules", static_cast<int>(active->cosmetic_rules));
      }
      lists.Append(std::move(entry));
    }
    base::DictValue out;
    out.Set("lists", std::move(lists));
    out.Set("choiceGeneration", base::NumberToString(generation_));
    out.Set("choiceWritable", CanWriteChoice());
    out.Set("refreshInProgress", applying);
    return base::WriteJson(out).value_or(std::string());
  }

  using Phase = adblock_native::OfflineRulesPhase;
  struct Readiness {
    Phase phase;
    unsigned enabled;
    unsigned cached;
    unsigned active;
  };

  Readiness GetReadiness() const {
    unsigned enabled = 0;
    for (const auto& f : flags_) enabled += f.Available() ? 1 : 0;
    if (!started_) return {Phase::kLoading, 0, 0, 0};
    const auto offline = adblock_native::GetOfflineRulesPhase();
    const auto snapshot = adblock_native::AdditionalRulesPhase(snapshot_revision_);
    const unsigned active = snapshot == Phase::kReady ? cached_count_ : 0;
    if (!cache_valid_ || offline == Phase::kUnknown || offline == Phase::kFailed)
      return {Phase::kFailed, enabled, cached_count_, active};
    if (snapshot == Phase::kReady && enabled != 0 && active == enabled)
      return {Phase::kReady, enabled, cached_count_, active};
    if (snapshot_read_pending_ || !busy_.empty() || !queue_.empty() ||
        offline == Phase::kLoading || snapshot == Phase::kLoading)
      return {Phase::kLoading, enabled, cached_count_, active};
    return {Phase::kFailed, enabled, cached_count_, active};
  }

  bool RetryReadiness() {
    if (choice_write_pending_ || !started_ ||
        GetReadiness().phase != Phase::kFailed ||
        adblock_native::GetOfflineRulesPhase() != Phase::kReady ||
        !busy_.empty() || !queue_.empty() || snapshot_read_pending_)
      return false;
    // Re-read local metadata and re-queue only missing feeds, or rebuild an
    // active candidate that failed to parse. Do not wipe the last valid engine.
    ReadCandidate(true);
    return true;
  }
  // Validate against the exact read snapshot, not a caller-supplied URL.
  bool SetEnabled(size_t index, std::string_view expected_generation, bool enabled,
                  base::OnceCallback<void(bool)> persisted) {
    if (!persisted || !CanWriteChoice() || index >= flags_.size() ||
        expected_generation != base::NumberToString(generation_) ||
        flags_[index].deleted || flags_[index].enabled == enabled)
      return false;
    // Write only after all currently posted cache work. While this write is
    // outstanding there are no competing downloads, retries or choice writes.
    Flags desired = flags_;
    desired[index].enabled = enabled;
    choice_write_pending_ = true;
    cache_.AsyncCall(&ListCache::SaveChoice)
        .WithArgs(std::move(desired))
        .Then(base::BindOnce(&UrlSubscriptions::OnChoiceSaved,
                             weak_.GetWeakPtr(), index, enabled,
                             std::move(persisted)));
    return true;
  }

  // Accept at most one manual batch per minute, and don't overlap an existing
  // batch. Acceptance acknowledges scheduling, not download or activation.
  bool RequestManualRefresh() {
    const auto now = base::TimeTicks::Now();
    if (choice_write_pending_ || !started_ || !queue_.empty() || !busy_.empty() ||
        (!last_manual_refresh_.is_null() &&
         now - last_manual_refresh_ < base::Minutes(1)) ||
        std::none_of(flags_.begin(), flags_.end(),
                     [](const Subscription& flag) { return flag.Available(); })) {
      return false;
    }
    last_manual_refresh_ = now;
    Refresh(true);
    return true;
  }
  void Refresh(bool manual) {
    if (!started_ || choice_write_pending_) return;
    for (size_t i=0;i<flags_.size();++i)
      if (flags_[i].Due(Now(), false, manual)) Queue(i);
    Pump();
  }
 private:
  bool CanWriteChoice() const {
    return started_ && cache_valid_ && !choice_write_pending_ &&
           !snapshot_read_pending_ && queue_.empty() && busy_.empty();
  }

  void OnChoiceSaved(size_t index, bool enabled,
                     base::OnceCallback<void(bool)> persisted, bool saved) {
    choice_write_pending_ = false;
    if (saved) {
      flags_[index].enabled = enabled;
      ++generation_;
      // Preserve the last good *installed* engine while this newly durable
      // choice is built. An older still-running candidate must not publish.
      adblock_native::InvalidatePendingAdditionalRules();
      snapshot_revision_ = 0;
      cached_count_ = 0;
      ReadCandidate(false, enabled ? std::make_optional(index) : std::nullopt);
    }
    // TRUE means the selection was written; installation is independent.
    std::move(persisted).Run(saved);
  }

  static int64_t Now() { return base::Time::Now().InMillisecondsSinceUnixEpoch() / 1000; }
  void Start(Startup out) {
    flags_=out.flags; started_=true;
    choices_known_ = out.valid;
    cached_ = out.cached;
    cached_bytes_ = out.cached_bytes;
    cache_valid_ = out.valid;
    // Fresh profiles already initialize the bundled matcher; do not recompile
    // it while the first subscription bodies are still downloading.
    if (!out.bodies.empty()) PublishCandidate(out);
    for (auto i:out.missing) Queue(i);
    Pump();
    initial_.Start(FROM_HERE,base::Seconds(kInitialSeconds),base::BindOnce(&UrlSubscriptions::OnInitial,weak_.GetWeakPtr()));
  }
  void OnInitial() {
    Refresh(false);
    timer_.Start(FROM_HERE,base::Seconds(kTickSeconds),base::BindRepeating(&UrlSubscriptions::Refresh,weak_.GetWeakPtr(),false));
  }
  void Queue(size_t i) { if(flags_[i].Available() && !busy_.contains(i)) queue_.insert(i); }
  void Pump() {
    while (busy_.size() < kMaxRunningSubscriptionDownloads && !queue_.empty()) {
      size_t i=*queue_.begin();queue_.erase(i);
      if (!flags_[i].Available()) continue;
      busy_.insert(i);
      auto req=std::make_unique<network::ResourceRequest>();req->url=GURL(kCatalog.at(i).url);
      req->credentials_mode=network::mojom::CredentialsMode::kOmit;
      req->redirect_mode=network::mojom::RedirectMode::kFollow;
      auto tag=net::DefineNetworkTrafficAnnotation("raws_curated_filter_download", R"(
        semantics { sender: "RawS content blocker" description: "Refresh enabled content filter rules." trigger: "Profile startup, expiry or explicit refresh." data: "HTTPS request for the public list, without page URLs or cookies." destination: OTHER }
        policy { cookies_allowed: NO setting: "Enabled URL subscriptions" policy_exception_justification: "This experimental browser does not expose an enterprise policy." })");
      auto load=network::SimpleURLLoader::Create(std::move(req),tag);
      load->SetOnRedirectCallback(base::BindRepeating(&UrlSubscriptions::Redirect,weak_.GetWeakPtr(),i));
      load->SetTimeoutDuration(base::Seconds(45));
      auto* ptr=load.get();loads_[i]=std::move(load);
      if (ListLimit(i) > kListLimit) {
        // DownloadToString cannot accept a larger limit than Chromium's 5 MiB.
        ptr->DownloadToTempFile(
            factory_.get(),
            base::BindOnce(
                [](base::WeakPtr<UrlSubscriptions> owner, size_t index,
                   base::FilePath path) {
                  auto cleanup = AdoptTemporaryDownload(path);
                  if (owner)
                    owner->GotFile(index, std::move(path), std::move(cleanup));
                },
                weak_.GetWeakPtr(), i),
            ListLimit(i));
      } else {
        ptr->DownloadToString(
            factory_.get(),
            base::BindOnce(&UrlSubscriptions::Got, weak_.GetWeakPtr(), i),
            kListLimit);
      }
    }
    if (busy_.empty() && dirty_) {
      dirty_=false;
      ReadCandidate(false);
    }
  }
  void ReadCandidate(bool retry,
                     std::optional<size_t> newly_enabled = std::nullopt) {
    snapshot_read_pending_ = true;
    cache_.AsyncCall(&ListCache::Read).Then(base::BindOnce(
        &UrlSubscriptions::Reload, weak_.GetWeakPtr(), generation_,
        ++cache_read_revision_, retry, newly_enabled));
  }
  void Reload(uint64_t generation, uint64_t read_revision, bool retry,
              std::optional<size_t> newly_enabled, Startup out) {
    if (read_revision != cache_read_revision_) return;
    snapshot_read_pending_ = false;
    if (generation != generation_) return;
    for (size_t i = 0; i < flags_.size(); ++i) {
      if (flags_[i].Available() != out.flags[i].Available()) {
        // A failed cache metadata write must not claim the newly selected
        // generation ready based on a stale set with coincidentally equal count.
        out.valid = false;
        break;
      }
    }
    PublishCandidate(out);
    if ((retry || newly_enabled) && out.valid) {
      for (auto i : out.missing) {
        if (retry || (newly_enabled && i == *newly_enabled)) Queue(i);
      }
      Pump();
    }
  }
  void PublishCandidate(Startup& out) {
    cache_valid_ = out.valid;
    snapshot_revision_ = 0;
    cached_count_ = 0;
    if (!out.valid) return;
    cached_ = out.cached;
    cached_bytes_ = out.cached_bytes;
    cached_count_ = static_cast<unsigned>(out.bodies.size());
    snapshot_revision_ =
        adblock_native::InstallAdditionalRules(std::move(out.bodies));
  }
  void Redirect(size_t i,const GURL&,const net::RedirectInfo& info,
                const network::mojom::URLResponseHead&,std::vector<std::string>*) {
    const GURL& u=info.new_url;
    // The catalog authorizes only the originally configured origin; do not
    // send even credential-free requests to arbitrary third parties or ports.
    const url::Origin source = url::Origin::Create(GURL(kCatalog.at(i).url));
    if (!u.SchemeIs("https") || u.has_username() || u.has_password() ||
        url::Origin::Create(u) != source) {
      LOG(WARNING) << "RawS subscription rejected redirect index=" << i;
      loads_.erase(i);flags_[i].attempt=Now();End(i,false,kDefaultHours);
    }
  }
  static base::ScopedClosureRunner AdoptTemporaryDownload(base::FilePath path) {
    if (path.empty()) return base::ScopedClosureRunner();
    return base::ScopedClosureRunner(base::BindOnce(
        [](base::FilePath file) {
          // The successful loader handed off ownership; do not delete on UI.
          base::ThreadPool::PostTask(
              FROM_HERE,
              {base::MayBlock(), base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
              base::BindOnce(
                  [](base::FilePath path) { (void)base::DeleteFile(path); },
                  std::move(file)));
        },
        std::move(path)));
  }
  bool TakeTransportResult(size_t index, bool has_body) {
    auto found = loads_.find(index);
    if (found == loads_.end()) return false;
    const auto* loader = found->second.get();
    const int net_error = loader->NetError();
    const auto* response = loader->ResponseInfo();
    const int http = response && response->headers
                         ? response->headers->response_code()
                         : 0;
    const bool ok = net_error == net::OK && has_body && flags_[index].Available();
    loads_.erase(found);
    flags_[index].attempt = Now();
    if (!ok) {
      LOG(WARNING) << "RawS subscription transfer failed index=" << index
                   << " net_error=" << net_error << " http_status=" << http
                   << " body_present=" << has_body;
      End(index, false, kDefaultHours);
    }
    return ok;
  }
  void Got(size_t i, std::optional<std::string> body) {
    if (!TakeTransportResult(i, body && !body->empty())) return;
    cache_.AsyncCall(&ListCache::Store).WithArgs(i, std::move(*body)).Then(
        base::BindOnce(&UrlSubscriptions::Stored, weak_.GetWeakPtr(), i));
  }
  void GotFile(size_t index, base::FilePath path, base::ScopedClosureRunner cleanup) {
    if (!TakeTransportResult(index, !path.empty())) return;
    cache_.AsyncCall(&ListCache::StoreTemp)
        .WithArgs(index, std::move(path), std::move(cleanup))
        .Then(base::BindOnce(&UrlSubscriptions::Stored, weak_.GetWeakPtr(), index));
  }
  void Stored(size_t index, int hours) {
    if (hours < 0) LOG(WARNING) << "RawS subscription cache admission failed index=" << index;
    End(index, hours >= 0, hours);
  }
  void End(size_t i,bool ok,int hours) {
    if(ok){flags_[i].success=flags_[i].attempt;flags_[i].expires_hours=hours;dirty_=true;
      cached_[i] = true;
    }
    else if(flags_[i].success==flags_[i].attempt) --flags_[i].success;
    cache_.AsyncCall(&ListCache::Save).WithArgs(flags_);busy_.erase(i);Pump();
  }
  scoped_refptr<network::SharedURLLoaderFactory> factory_;
  base::SequenceBound<ListCache> cache_;
  Flags flags_{};std::set<size_t> queue_,busy_;
  CachePresence cached_{};
  CacheSizes cached_bytes_{};
  std::map<size_t,std::unique_ptr<network::SimpleURLLoader>> loads_;
  base::OneShotTimer initial_;base::RepeatingTimer timer_;
  base::TimeTicks last_manual_refresh_;
  uint64_t generation_=0;
  bool started_=false,dirty_=false;
  bool cache_valid_ = false;
  bool snapshot_read_pending_ = false;
  bool choice_write_pending_ = false;
  bool choices_known_ = false;
  uint64_t cache_read_revision_ = 0;
  uint64_t snapshot_revision_ = 0;
  unsigned cached_count_ = 0;
  base::WeakPtrFactory<UrlSubscriptions> weak_{this};
};
inline constexpr char kSubscriptionServiceKey[]="raws-1442-filter-service";
inline UrlSubscriptions* GetSubscriptions(Profile* profile) {
  if (!profile || profile->IsOffTheRecord()) return nullptr;
  return static_cast<UrlSubscriptions*>(profile->GetUserData(kSubscriptionServiceKey));
}
inline void StartSubscriptions(Profile* profile) {
  if (!profile || profile->IsOffTheRecord() || GetSubscriptions(profile)) return;
  profile->SetUserData(kSubscriptionServiceKey,std::make_unique<UrlSubscriptions>(profile));
}
