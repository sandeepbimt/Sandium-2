package org.chromium.chrome.browser.settings;

import org.jni_zero.JNINamespace;
import org.jni_zero.JniType;
import org.jni_zero.NativeMethods;

import org.chromium.base.Callback;
import org.chromium.base.ThreadUtils;
import org.chromium.base.library_loader.LibraryLoader;
import org.chromium.build.annotations.NullMarked;
import org.chromium.build.annotations.Nullable;
import org.chromium.chrome.R;
import org.chromium.chrome.browser.profiles.Profile;
import org.chromium.content_public.browser.WebContents;

/** Maps one authoritative snapshot; never starts or observes the blocker. */
@JNINamespace("android")
@NullMarked
public final class RawsProtectionCopy {
    public static final int AD_FILTER_UNKNOWN = 0;
    public static final int AD_FILTER_FAILED = 1;
    public static final int AD_FILTER_PREPARING = 2;
    public static final int AD_FILTER_READY = 3;

    private RawsProtectionCopy() {}

    /** UI-thread snapshot of the built-in offline matcher, not subscription readiness. */
    public static int adFilteringPhase() {
        ThreadUtils.assertOnUiThread();
        if (!LibraryLoader.getInstance().isInitialized()) return AD_FILTER_UNKNOWN;
        return switch (RawsProtectionCopyJni.get().getAdFilteringPhase()) {
            case AD_FILTER_FAILED -> AD_FILTER_FAILED;
            case AD_FILTER_PREPARING -> AD_FILTER_PREPARING;
            case AD_FILTER_READY -> AD_FILTER_READY;
            default -> AD_FILTER_UNKNOWN;
        };
    }

    /** Non-persisted readiness of this process's enabled subscription generation. */
    public static final class AdSubscriptionState {
        public final int phase;
        public final int enabled;
        public final int cached;
        public final int active;

        private AdSubscriptionState(int packed) {
            phase = packed & 0x3;
            enabled = (packed >>> 2) & 0x3f;
            cached = (packed >>> 8) & 0x3f;
            active = (packed >>> 14) & 0x3f;
        }
    }

    public static AdSubscriptionState adSubscriptionState(Profile profile) {
        ThreadUtils.assertOnUiThread();
        return new AdSubscriptionState(
                canReadSubscriptions(profile)
                        ? RawsProtectionCopyJni.get().getAdSubscriptionState(profile)
                        : 0);
    }

    public static boolean retryAdSubscriptions(Profile profile) {
        ThreadUtils.assertOnUiThread();
        return canReadSubscriptions(profile)
                && RawsProtectionCopyJni.get().retryAdSubscriptions(profile);
    }

    private static boolean canReadSubscriptions(Profile profile) {
        return LibraryLoader.getInstance().isInitialized()
                && profile.isNativeInitialized()
                && !profile.isOffTheRecord();
    }

    public static boolean isGoogleDeAmpEnabled(Profile profile) {
        ThreadUtils.assertOnUiThread();
        return profile.isNativeInitialized()
                && RawsProtectionCopyJni.get().isGoogleDeAmpEnabled(profile);
    }

    public static boolean setGoogleDeAmpEnabled(Profile profile, boolean enabled) {
        ThreadUtils.assertOnUiThread();
        return profile.isNativeInitialized() && !profile.isOffTheRecord()
                && RawsProtectionCopyJni.get().setGoogleDeAmpEnabled(profile, enabled);
    }

    public static int currentStatusStringId() {
        return statusStringId(adFilteringPhase());
    }

    static int statusStringId(int phase) {
        return switch (phase) {
            case AD_FILTER_FAILED -> stringId(Phase.FAILED, false, false);
            case AD_FILTER_PREPARING -> stringId(Phase.LOADING, false, false);
            case AD_FILTER_READY -> R.string.raws_ui_builtin_ad_filtering_active;
            default -> stringId(Phase.UNKNOWN, false, false);
        };
    }

    /** Snapshot for the regular profile, or empty if unavailable. No user rules are returned. */
    public static String subscriptionDetails(Profile profile) {
        ThreadUtils.assertOnUiThread();
        return canReadSubscriptions(profile)
                ? RawsProtectionCopyJni.get().subscriptionDetails(profile) : "";
    }

    /** Accepted writes report only durable selection, not installed filter activation. */
    public static boolean setSubscriptionEnabled(
            Profile profile, int id, String choiceGeneration, boolean enabled,
            Callback<Boolean> durable) {
        ThreadUtils.assertOnUiThread();
        return id >= 0 && !choiceGeneration.isEmpty() && choiceGeneration.length() <= 20
                && canReadSubscriptions(profile)
                && RawsProtectionCopyJni.get().setSubscriptionEnabled(
                        profile, id, choiceGeneration, enabled, durable);
    }

    static boolean requestFilterRefresh(Profile profile) {
        return !profile.isOffTheRecord() && profile.isNativeInitialized()
                && RawsProtectionCopyJni.get().requestFilterRefresh(profile);
    }

    /** Effective global ads setting for this profile: -1 unknown, 0 off, 1 on. */
    public static int globalAdFilteringState(Profile profile) {
        ThreadUtils.assertOnUiThread();
        return canAccessGlobalAdSetting(profile)
                ? RawsProtectionCopyJni.get().globalAdFilteringState(profile)
                : -1;
    }

    /**
     * Changes the current profile's global filter setting. A regular profile callback
     * completes after the native preferences commit callback; a private change never persists.
     */
    public static boolean setGlobalAdFilteringEnabled(
            Profile profile, boolean enabled, Callback<Boolean> completion) {
        ThreadUtils.assertOnUiThread();
        return canAccessGlobalAdSetting(profile)
                && RawsProtectionCopyJni.get()
                        .setGlobalAdFilteringEnabled(profile, enabled, completion);
    }

    private static boolean canAccessGlobalAdSetting(Profile profile) {
        return LibraryLoader.getInstance().isInitialized() && profile.isNativeInitialized();
    }

    /** Opaque identity for a current eligible same-tab document; empty if not possible. */
    public static String elementDocumentToken(WebContents contents) {
        ThreadUtils.assertOnUiThread();
        return LibraryLoader.getInstance().isInitialized()
                ? RawsProtectionCopyJni.get().elementDocumentToken(contents) : "";
    }

    /** Starts non-mutating preview. Callback contains only an opaque native session. */
    public static boolean beginElementPicker(WebContents contents, Callback<String> started) {
        ThreadUtils.assertOnUiThread();
        return LibraryLoader.getInstance().isInitialized()
                && RawsProtectionCopyJni.get().beginElementPicker(contents, started);
    }

    /** One event-driven watch: "0" no target, "1" selectable target, empty ended. */
    public static boolean watchElementPicker(WebContents contents, String token,
            Callback<String> state) {
        ThreadUtils.assertOnUiThread();
        return LibraryLoader.getInstance().isInitialized()
                && RawsProtectionCopyJni.get().watchElementPicker(contents, token, state);
    }

    /** Called only by the trusted native Element Blocker button. */
    public static boolean commitElementPicker(WebContents contents, String token,
            Callback<Boolean> completion) {
        ThreadUtils.assertOnUiThread();
        return LibraryLoader.getInstance().isInitialized()
                && RawsProtectionCopyJni.get().commitElementPicker(contents, token, completion);
    }

    public static void cancelElementPicker(WebContents contents) {
        ThreadUtils.assertOnUiThread();
        if (LibraryLoader.getInstance().isInitialized()) {
            RawsProtectionCopyJni.get().cancelElementPicker(contents);
        }
    }

    /** The clear confirmation must pass the token captured before showing the dialog. */
    public static boolean clearElementRules(WebContents contents, String documentToken) {
        ThreadUtils.assertOnUiThread();
        return LibraryLoader.getInstance().isInitialized()
                && RawsProtectionCopyJni.get().clearElementRules(contents, documentToken);
    }

    /** -1 when not an eligible current document; 0 off; 1 enabled for this site. */
    public static int siteAdFilteringState(WebContents contents, String documentToken) {
        ThreadUtils.assertOnUiThread();
        return LibraryLoader.getInstance().isInitialized()
                ? RawsProtectionCopyJni.get().siteAdFilteringState(contents, documentToken) : -1;
    }

    public static boolean setSiteAdFilteringEnabled(
            WebContents contents, String documentToken, boolean enabled) {
        ThreadUtils.assertOnUiThread();
        return LibraryLoader.getInstance().isInitialized()
                && RawsProtectionCopyJni.get().setSiteAdFilteringEnabled(
                        contents, documentToken, enabled);
    }

    /** Native supported custom network rules for this profile only. */
    public static String customNetworkRules(Profile profile) {
        ThreadUtils.assertOnUiThread();
        return profile.isNativeInitialized() && LibraryLoader.getInstance().isInitialized()
                ? RawsProtectionCopyJni.get().customNetworkRules(profile) : "";
    }

    public static boolean replaceCustomNetworkRules(Profile profile,
            String rules, Callback<Boolean> completion) {
        ThreadUtils.assertOnUiThread();
        return profile.isNativeInitialized() && LibraryLoader.getInstance().isInitialized()
                && RawsProtectionCopyJni.get().replaceCustomNetworkRules(profile, rules, completion);
    }

    static final int MAIN_PAGE_NETWORK_BLOCKS = 0;
    static final int POPUP_OPEN_OR_NAVIGATION_BLOCKS = 1;
    static final int EMBEDDED_NAVIGATION_BLOCKS = 2;

    /** Browser-only count snapshot; -1 unless an attributed positive count exists. */
    static int readTerminalBlockCount(WebContents contents, String document, int bucket) {
        ThreadUtils.assertOnUiThread();
        if (!LibraryLoader.getInstance().isInitialized() || document.isEmpty()
                || bucket < MAIN_PAGE_NETWORK_BLOCKS || bucket > EMBEDDED_NAVIGATION_BLOCKS) {
            return -1;
        }
        int count = RawsProtectionCopyJni.get().readTerminalBlockCount(contents, document, bucket);
        return count > 0 ? count : -1;
    }

    @NativeMethods
    interface Natives {
        int readTerminalBlockCount(
                @JniType("content::WebContents*") WebContents contents,
                @JniType("std::string") String document, int bucket);
        boolean isGoogleDeAmpEnabled(@JniType("Profile*") Profile profile);
        boolean setGoogleDeAmpEnabled(@JniType("Profile*") Profile profile, boolean enabled);
        int getAdFilteringPhase();
        int globalAdFilteringState(@JniType("Profile*") Profile profile);
        boolean setGlobalAdFilteringEnabled(
                @JniType("Profile*") Profile profile,
                boolean enabled,
                @JniType("base::OnceCallback<void(bool)>") Callback<Boolean> completion);
        int getAdSubscriptionState(@JniType("Profile*") Profile profile);
        boolean retryAdSubscriptions(@JniType("Profile*") Profile profile);
        @JniType("std::string")
        String customNetworkRules(@JniType("Profile*") Profile profile);
        boolean replaceCustomNetworkRules(@JniType("Profile*") Profile profile,
                @JniType("std::string") String rules,
                @JniType("base::OnceCallback<void(bool)>") Callback<Boolean> completion);
        int siteAdFilteringState(
                @JniType("content::WebContents*") WebContents contents,
                @JniType("std::string") String documentToken);
        boolean setSiteAdFilteringEnabled(
                @JniType("content::WebContents*") WebContents contents,
                @JniType("std::string") String documentToken, boolean enabled);
        @JniType("std::string")
        String subscriptionDetails(@JniType("Profile*") Profile profile);
        boolean setSubscriptionEnabled(
                @JniType("Profile*") Profile profile, int id,
                @JniType("std::string") String choiceGeneration, boolean enabled,
                @JniType("base::OnceCallback<void(bool)>") Callback<Boolean> durable);
        boolean requestFilterRefresh(@JniType("Profile*") Profile profile);
        @JniType("std::string")
        String elementDocumentToken(@JniType("content::WebContents*") WebContents contents);
        boolean beginElementPicker(
                @JniType("content::WebContents*") WebContents contents,
                @JniType("base::OnceCallback<void(std::string)>") Callback<String> started);
        boolean watchElementPicker(
                @JniType("content::WebContents*") WebContents contents,
                @JniType("std::string") String token,
                @JniType("base::OnceCallback<void(std::string)>") Callback<String> state);
        boolean commitElementPicker(
                @JniType("content::WebContents*") WebContents contents,
                @JniType("std::string") String token,
                @JniType("base::OnceCallback<void(bool)>") Callback<Boolean> completion);
        void cancelElementPicker(@JniType("content::WebContents*") WebContents contents);
        boolean clearElementRules(
                @JniType("content::WebContents*") WebContents contents,
                @JniType("std::string") String documentToken);
    }

    public enum Phase { UNKNOWN, OFF, FAILED, LOADING, READY }

    public static int stringId(@Nullable Phase phase, boolean rulesAccepted, boolean filteringLive) {
        if (phase == null) return R.string.raws_ui_unknown;
        return switch (phase) {
            case OFF -> R.string.raws_ui_off;
            case FAILED -> R.string.raws_ui_unavailable;
            case LOADING -> R.string.raws_ui_preparing;
            case READY -> rulesAccepted && filteringLive
                    ? R.string.raws_ui_active : R.string.raws_ui_unknown;
            case UNKNOWN -> R.string.raws_ui_unknown;
        };
    }
}
