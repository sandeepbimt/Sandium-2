// Detached same-snapshot worker seam. The trusted caller supplies the exact
// bundled EasyList bytes already admitted to the packaged Rust engine. An
// independently failed or over-limit build never substitutes another source.
class PackagedGenericDomIndex {
 public:
  PackagedGenericDomIndex(const PackagedGenericDomIndex&);
  PackagedGenericDomIndex(PackagedGenericDomIndex&&) noexcept;
  PackagedGenericDomIndex& operator=(const PackagedGenericDomIndex&);
  PackagedGenericDomIndex& operator=(PackagedGenericDomIndex&&) noexcept;
  ~PackagedGenericDomIndex();

  static constexpr size_t kMaxSourceBytes = 4 * 1024 * 1024;
  static constexpr size_t kMaxCandidates = 16 * 1024;
  static constexpr size_t kEngineChunk = 256;
  static constexpr size_t kMaxDomKeys = 64;

  struct Keys {
    std::vector<std::string> classes;
    std::vector<std::string> ids;
  };

  struct ScopePolicy {
    bool suppress_generic;
    std::set<std::string, std::less<>> exceptions;
  };

  // Engine callback must return nullopt on a failed CXX/Rust query, or the
  // independently confirmed selector results for THIS batch. It is invoked
  // only once per chunk during snapshot build; never during DOM matching.
  template <typename QueryPackagedEngine>
  static std::optional<PackagedGenericDomIndex> Build(
      std::string_view packaged_source,
      QueryPackagedEngine query_packaged_engine) {
    if (packaged_source.empty() || packaged_source.size() > kMaxSourceBytes ||
        packaged_source.find('\0') != packaged_source.npos) {
      return std::nullopt;
    }

    std::set<std::string, std::less<>> candidates;
    while (!packaged_source.empty()) {
      const size_t lf = packaged_source.find('\n');
      auto line = packaged_source.substr(0, lf);
      packaged_source.remove_prefix(lf == packaged_source.npos
                                        ? packaged_source.size()
                                        : lf + 1);
      if (line.ends_with('\r')) line.remove_suffix(1);
      if (!line.starts_with("##") || !IsSimpleGenericSelector(line.substr(2)))
        continue;
      candidates.emplace(line.substr(2));
      // Refuse a changed package that no longer fits; silently taking its
      // first subset would recreate the fixed-census omission.
      if (candidates.size() > kMaxCandidates) return std::nullopt;
    }

    std::vector<std::string> confirmed;
    confirmed.reserve(candidates.size());
    for (auto it = candidates.begin(); it != candidates.end();) {
      Keys keys;
      std::set<std::string_view, std::less<>> sent;
      for (; it != candidates.end() && sent.size() < kEngineChunk; ++it) {
        std::string_view selector(*it);
        sent.insert(selector);
        auto& bucket = selector.front() == '.' ? keys.classes : keys.ids;
        bucket.emplace_back(selector.substr(1));
      }
      auto native_matches = query_packaged_engine(keys);
      if (!native_matches || native_matches->size() > kMaxCandidates)
        return std::nullopt;
      for (const auto& hit : *native_matches) {
        if (sent.erase(std::string_view(hit))) confirmed.push_back(hit);
      }
    }
    std::sort(confirmed.begin(), confirmed.end());
    confirmed.erase(std::unique(confirmed.begin(), confirmed.end()),
                    confirmed.end());
    return PackagedGenericDomIndex(std::move(confirmed));
  }

  size_t confirmed_count() const { return selectors_.size(); }

  // Limit even malformed/overly broad Rust result arrays. A valid exact
  // typed batch can contribute no more than 64 distinct hide selectors.
  static constexpr size_t kMaxObservedResults = 1024;

  // The bounded engine IPC shape also applies when this API is used without
  // renderer collection. Reject an invalid batch before calling either matcher.
  static bool ValidObservedKeys(const Keys& observed) {
    if (observed.classes.size() > kMaxDomKeys ||
        observed.ids.size() > kMaxDomKeys - observed.classes.size()) {
      return false;
    }
    for (const auto& [prefix, tokens] :
         {std::pair{'.', &observed.classes}, std::pair{'#', &observed.ids}}) {
      for (const auto& token : *tokens) {
        if (token.empty() || token.size() > 64 ||
            !IsSimpleGenericSelector(std::string(1, prefix) + token)) {
          return false;
        }
      }
    }
    return true;
  }

  // Only exact exceptions for the typed observed keys are relevant here.
  // Keep the input to Rust at the same bound as the original key batch.
  static std::vector<std::string> ObservedExceptions(
      const Keys& observed, const ScopePolicy& packaged_policy,
      const ScopePolicy& additional_policy) {
    if (!ValidObservedKeys(observed)) return {};
    std::set<std::string, std::less<>> merged;
    for (const auto& [prefix, tokens] :
         {std::pair{'.', &observed.classes}, std::pair{'#', &observed.ids}}) {
      for (const auto& token : *tokens) {
        std::string selector = std::string(1, prefix) + token;
        if (packaged_policy.exceptions.contains(selector) ||
            additional_policy.exceptions.contains(selector)) {
          merged.insert(std::move(selector));
        }
      }
    }
    return {merged.begin(), merged.end()};
  }

  // A missing policy or malformed renderer batch is refusal (nullopt).
  // A valid suppression, no match, or all-exempt batch is an empty string.
  // Both policies must come from the same admitted snapshot for the committed
  // document URL. The caller must revalidate token, generation and enablement
  // on delivery; nothing here can navigate, log or mutate a document.
  std::optional<std::string> MatchCss(const Keys& observed,
                                      const ScopePolicy* packaged_policy,
                                      const ScopePolicy* additional_policy,
                                      const std::vector<std::string>&
                                          additional_matches = {}) const {
    if (!packaged_policy || !additional_policy || !ValidObservedKeys(observed))
      return std::nullopt;

    // Only a bounded response may contribute new additional-engine keys.
    // Exact observed intersection below excludes CSS grammar and unrelated
    // selectors, even when Rust returns a complex hit for a supplied class.
    const bool accept_additional = additional_matches.size() <= kMaxObservedResults;

    // Both engines' generic suppression is absolute for generic rules, not
    // for the existing independent scoped stylesheet.
    const bool suppressed =
        packaged_policy->suppress_generic || additional_policy->suppress_generic;
    std::set<std::string, std::less<>> matching;
    for (const auto& [prefix, tokens] :
         {std::pair{'.', &observed.classes}, std::pair{'#', &observed.ids}}) {
      for (const auto& token : *tokens) {
        std::string selector = std::string(1, prefix) + token;
        if (suppressed || packaged_policy->exceptions.contains(selector) ||
            additional_policy->exceptions.contains(selector)) {
          continue;
        }
        if (std::binary_search(selectors_.begin(), selectors_.end(), selector) ||
            (accept_additional &&
             std::ranges::find(additional_matches, selector) !=
                 additional_matches.end())) {
          matching.insert(std::move(selector));
        }
      }
    }

    // Existing locked declaration and type guard. A 64-key batch of at most
    // 65-byte selectors cannot reach that helper's 64 KiB generic CSS budget.
    std::string css;
    AppendSimpleGenericStyles(
        css, /*suppress_generic=*/false,
        std::vector<std::string>(matching.begin(), matching.end()),
        /*scoped=*/{}, /*exceptions=*/{});
    return css;
  }

  // Both inputs are the live snapshot's complete Rust engines, not a
  // packaged text index or an enabled-list per-list census. Bound each reply
  // independently so one failing engine cannot drop the other's safe hits.
  template <typename Query>
  static std::optional<std::string> MatchObservedEngineCss(
      const Keys& observed,
      const ScopePolicy& packaged_policy,
      const ScopePolicy& additional_policy,
      Query query) {
    if (!ValidObservedKeys(observed)) return std::nullopt;
    if (packaged_policy.suppress_generic || additional_policy.suppress_generic ||
        (observed.classes.empty() && observed.ids.empty())) {
      return std::string();
    }
    const auto exceptions = ObservedExceptions(
        observed, packaged_policy, additional_policy);
    auto packaged = query(/*packaged=*/true, observed, exceptions);
    auto additional = query(/*packaged=*/false, observed, exceptions);
    const auto oversized = [](const auto& matches) {
      return matches && matches->size() > kMaxObservedResults;
    };
    if (oversized(packaged)) packaged.reset();
    if (oversized(additional)) additional.reset();
    if (!packaged && !additional) return std::nullopt;

    // Reuse the existing exact typed-key intersection and fixed declaration;
    // this temporary holds only the bounded matches for one observed batch.
    std::vector<std::string> primary_hits;
    if (packaged) {
      primary_hits = std::move(*packaged);
      std::sort(primary_hits.begin(), primary_hits.end());
    }
    const PackagedGenericDomIndex batch(std::move(primary_hits));
    return batch.MatchCss(observed, &packaged_policy, &additional_policy,
                          additional ? *additional
                                     : std::vector<std::string>{});
  }

 private:
  explicit PackagedGenericDomIndex(std::vector<std::string> selectors);

  std::vector<std::string> selectors_;
};

