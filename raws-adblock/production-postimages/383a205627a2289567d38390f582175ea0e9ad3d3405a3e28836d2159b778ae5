// Match only an exact ASCII simple class/ID. This syntax cannot introduce a
// declaration, pseudo-selector, combinator, attribute, or selector group.
inline bool IsSimpleGenericSelector(std::string_view selector) {
  constexpr auto letter = [](char c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
  };
  return selector.size() >= 2 && selector.size() <= 65 &&
         (selector[0] == '.' || selector[0] == '#') && letter(selector[1]) &&
         std::all_of(selector.begin() + 2, selector.end(), [letter](char c) {
           return letter(c) || (c >= '0' && c <= '9') || c == '-';
         });
}

inline constexpr size_t kPackagedGenericCandidateLimit = 1536;
inline constexpr size_t kSubscriptionGenericCandidateLimit = 2048;
inline constexpr size_t kSubscriptionGenericPerList = 96;
inline constexpr size_t kGenericStylesByteLimit = 64 * 1024;
inline constexpr size_t kGenericGroupSize = 64;

// Collect index keys when constructing the rule snapshot, not on document
// commit. Preserve input order and cap each download separately so a large
// first list cannot consume the whole subscription budget.
class SimpleGenericCensus {
 public:
  explicit SimpleGenericCensus(size_t max_count);
  SimpleGenericCensus(size_t max_count, size_t max_per_kind);
  ~SimpleGenericCensus();

  bool Add(std::string_view selector) {
    if (!IsSimpleGenericSelector(selector) || ordered_.size() >= max_count_) {
      return false;
    }
    size_t& count = selector.front() == '.' ? class_count_ : id_count_;
    if (count >= max_per_kind_ || !exact_.emplace(selector).second) {
      return false;
    }
    ++count;
    ordered_.emplace_back(selector);
    return true;
  }

  size_t AddList(std::string_view text, size_t list_limit) {
    size_t accepted = 0;
    while (!text.empty() && accepted < list_limit &&
           ordered_.size() < max_count_) {
      const size_t n = text.find('\n');
      auto line = text.substr(0, n);
      if (n == text.npos) {
        text = {};
      } else {
        text.remove_prefix(n + 1);
      }
      if (!line.empty() && line.back() == '\r') {
        line.remove_suffix(1);
      }
      if (line.starts_with("##") && Add(line.substr(2))) {
        ++accepted;
      }
    }
    return accepted;
  }

  // The exact adblock-rust engine remains authoritative: a line that its parser
  // ignored cannot introduce a selector. Complex matches returned for a key
  // are rejected. Resolve once and preserve deterministic source order.
  template <typename QueryEngine>
  std::vector<std::string> Resolve(QueryEngine query) const {
    if (ordered_.empty()) {
      return {};
    }
    std::vector<std::string> classes;
    std::vector<std::string> ids;
    classes.reserve(ordered_.size());
    ids.reserve(ordered_.size());
    for (const auto& selector : ordered_) {
      (selector.front() == '.' ? classes : ids).push_back(selector.substr(1));
    }
    std::set<std::string, std::less<>> matched;
    for (const auto& result : query(classes, ids)) {
      const std::string_view selector(result.data(), result.size());
      if (IsSimpleGenericSelector(selector) && exact_.contains(selector)) {
        matched.emplace(selector);
      }
    }
    std::vector<std::string> ordered_matches;
    ordered_matches.reserve(matched.size());
    for (const auto& selector : ordered_) {
      if (matched.contains(selector)) {
        ordered_matches.push_back(selector);
      }
    }
    return ordered_matches;
  }

 private:
  size_t max_count_;
  size_t max_per_kind_;
  size_t class_count_ = 0;
  size_t id_count_ = 0;
  std::vector<std::string> ordered_;
  std::set<std::string, std::less<>> exact_;
};

// Deduplicate once at snapshot construction, preserving packaged precedence.
inline std::vector<std::string> MergeSimpleGeneric(
    std::vector<std::string> packaged,
    std::vector<std::string> subscriptions) {
  const std::set<std::string, std::less<>> known(packaged.begin(), packaged.end());
  packaged.reserve(packaged.size() + subscriptions.size());
  for (auto& selector : subscriptions) {
    if (!known.contains(selector)) {
      packaged.push_back(std::move(selector));
    }
  }
  return packaged;
}

// One document stylesheet handles both initial and later DOM nodes. Honor
// the union of both engines' URL-specific exceptions and $generichide. Keep
// existing scoped rules first and preserve their independent budget.
inline void AppendSimpleGenericStyles(
    std::string& css,
    bool suppress_generic,
    const std::vector<std::string>& selectors,
    const std::set<std::string>& scoped,
    const std::set<std::string>& exceptions) {
  if (suppress_generic) {
    return;
  }
  constexpr std::string_view declaration = " { display:none !important; }\n";
  constexpr size_t kExistingTotalByteLimit = 256 * 1024;
  constexpr size_t kGenericByteLimit = kGenericStylesByteLimit;
  if (css.size() >= kExistingTotalByteLimit) {
    return;
  }
  const size_t end = css.size() +
      std::min(kGenericByteLimit, kExistingTotalByteLimit - css.size());
  size_t group = 0;
  for (const auto& selector : selectors) {
    if (!IsSimpleGenericSelector(selector) || exceptions.contains(selector) ||
        scoped.contains(selector)) {
      continue;
    }
    if (css.size() + selector.size() + (group != 0) + declaration.size() >
        end) {
      continue;
    }
    if (group != 0) {
      css += ',';
    }
    css += selector;
    if (++group == kGenericGroupSize) {
      css += declaration;
      group = 0;
    }
  }
  if (group != 0) {
    css += declaration;
  }
}

// Compound selectors are opt-in for the reviewed native source census only.
// The rightmost element must itself be an ad slot. Never select a parent based
// on a descendant, or accept source-supplied declarations/conditions.
inline constexpr std::string_view kUnfilledAdSlotRules = R"RAW(
##.adsbygoogle[data-ad-status="unfilled"]
##.ad-slot[data-ad-status="unfilled"]
)RAW";

inline std::string_view AdCompoundIdentifier(std::string_view selector) {
  if (selector.empty() || (selector.front() != '.' && selector.front() != '#'))
    return {};
  const size_t end = selector.find_first_not_of(
      "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-", 1);
  const auto token = selector.substr(0, end);
  return IsSimpleGenericSelector(token) ? token : std::string_view();
}

struct AdCompoundKeys {
  std::string_view first;
  std::string_view ad_subject;
};

inline AdCompoundKeys ParseAdCompound(std::string_view selector) {
  if (selector.size() < 4 || selector.size() > 160) return {};
  const auto first = AdCompoundIdentifier(selector);
  if (first.empty()) return {};
  std::string_view ad_subject;
  bool ad_class = false;
  bool ad_format = false;
  bool unfilled = false;
  size_t groups = 1;
  size_t count = 0;
  while (!selector.empty()) {
    const auto token = AdCompoundIdentifier(selector);
    if (token.empty() || ++count > 8) return {};
    selector.remove_prefix(token.size());
    if (token == ".adsbygoogle" || token == ".ad-slot" ||
        token == ".ad-unit" || token == ".adunit" || token == ".ads__slot") {
      if (!ad_subject.empty() && ad_subject != token) return {};
      ad_subject = token;
    } else if (token == ".ad") {
      ad_class = true;
    } else if (token == ".size-300x250" || token == ".desktop-970x250" ||
               token == ".size-160x600" || token == ".size-728x90" ||
               token == ".size-970x250") {
      ad_format = true;
    }
    if (selector.empty()) break;
    if (selector == R"RAW([data-ad-status="unfilled"])RAW" ||
        selector == "[data-ad-status='unfilled']") {
      unfilled = !ad_subject.empty() &&
                 (ad_subject == ".adsbygoogle" || ad_subject == ".ad-slot");
      if (!unfilled) return {};
      break;
    }
    if (selector.front() == '.' || selector.front() == '#') continue;
    bool separated = false;
    while (selector.starts_with(' ')) {
      selector.remove_prefix(1);
      separated = true;
    }
    if (selector.starts_with('>')) {
      selector.remove_prefix(1);
      separated = true;
      while (selector.starts_with(' ')) selector.remove_prefix(1);
    }
    if (!separated || selector.empty() || ++groups > 3) return {};
    ad_subject = {};
    ad_class = false;
    ad_format = false;
  }
  if (!unfilled && count < 2) return {};
  if (!ad_subject.empty()) return {first, ad_subject};
  if (ad_class && ad_format) return {first, ".ad"};
  return {};
}

class AdCompoundCensus {
 public:
  AdCompoundCensus();
  ~AdCompoundCensus();

  static constexpr size_t kLimit = 256;
  static constexpr size_t kPerSubscription = 32;

  void AddList(std::string_view text, size_t list_limit) {
    constexpr size_t kMaxInputBytes = 4 * 1024 * 1024;
    const size_t size = std::min({remaining_bytes_, kMaxInputBytes, text.size()});
    if (size < text.size()) {
      // Never interpret a partially scanned filter line as a whole selector.
      text = text.substr(0, size);
      const size_t boundary = text.find_last_of('\n');
      text = boundary == text.npos ? std::string_view() : text.substr(0, boundary + 1);
    }
    remaining_bytes_ -= size;
    while (!text.empty() && list_limit && ordered_.size() < kLimit) {
      const size_t end = text.find('\n');
      auto line = text.substr(0, end);
      text.remove_prefix(end == text.npos ? text.size() : end + 1);
      if (line.ends_with('\r')) line.remove_suffix(1);
      if (!line.starts_with("##")) continue;
      line.remove_prefix(2);
      if (ParseAdCompound(line).first.empty() || !exact_.emplace(line).second)
        continue;
      ordered_.emplace_back(line);
      --list_limit;
    }
  }

  template <typename QueryEngine>
  std::vector<std::string> Resolve(QueryEngine query) const {
    if (ordered_.empty()) return {};
    std::set<std::string> class_keys, id_keys;
    for (const auto& candidate : ordered_) {
      const auto key = ParseAdCompound(candidate).first;
      (key.front() == '.' ? class_keys : id_keys).emplace(key.substr(1));
    }
    const std::vector<std::string> classes(class_keys.begin(), class_keys.end());
    const std::vector<std::string> ids(id_keys.begin(), id_keys.end());
    std::set<std::string, std::less<>> admitted;
    for (const auto& hit : query(classes, ids)) {
      const std::string_view selector(hit.data(), hit.size());
      if (exact_.contains(selector)) admitted.emplace(selector);
    }
    std::vector<std::string> out;
    for (const auto& candidate : ordered_) {
      if (admitted.contains(candidate)) out.push_back(candidate);
    }
    return out;
  }

 private:
  size_t remaining_bytes_ = 16 * 1024 * 1024;
  std::vector<std::string> ordered_;
  std::set<std::string, std::less<>> exact_;
};

inline bool SensitiveCompoundPath(std::string_view lower_path) {
  if (lower_path.find('%') != lower_path.npos) return true;
  while (!lower_path.empty()) {
    const size_t i = lower_path.find('/');
    const auto component = lower_path.substr(0, i);
    for (auto marker : {"buy", "checkout", "auth", "login", "consent", "subscribe",
                        "account", "signin", "signup", "register", "pay", "sso",
                        "oauth", "payment", "subscription", "billing"}) {
      if (component.starts_with(marker)) return true;
    }
    lower_path.remove_prefix(i == lower_path.npos ? lower_path.size() : i + 1);
  }
  return false;
}

inline void AppendAdCompoundStyles(
    std::string& css,
    bool suppress_generic,
    const std::vector<std::string>& selectors,
    const std::set<std::string>& scoped,
    const std::set<std::string>& exceptions) {
  constexpr size_t kTotalLimit = 256 * 1024;
  constexpr size_t kExtraLimit = 16 * 1024;
  constexpr std::string_view kDeclaration = " { display:none !important; }\n";
  if (suppress_generic || css.size() >= kTotalLimit) return;
  const size_t end = css.size() + std::min(kExtraLimit, kTotalLimit - css.size());
  for (const auto& s : selectors) {
    const auto keys = ParseAdCompound(s);
    if (keys.first.empty() || scoped.contains(s) || exceptions.contains(s) ||
        exceptions.contains(std::string(keys.first)) ||
        exceptions.contains(std::string(keys.ad_subject)) ||
        css.size() + s.size() + kDeclaration.size() > end) {
      continue;
    }
    css += s;
    css += kDeclaration;
  }
}

