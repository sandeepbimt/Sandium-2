/** Opt-in local archive handling. Validation and merge decisions stay in the native profile store. */
@NullMarked
public final class RawSColorRulesSettings extends ChromeBaseSettingsFragment {
    private static final int EXPORT = 9401;
    private static final int IMPORT = 9402;
    static final int MAX_BYTES = 8 * 1024 * 1024;
    private static final String STATE_REQUEST = "raws_color_backup_request";
    private final SettableMonotonicObservableSupplier<String> mTitle =
            ObservableSuppliers.createMonotonic();
    private final ExecutorService mFiles = Executors.newSingleThreadExecutor();
    private final Handler mUi = new Handler(Looper.getMainLooper());
    private @Nullable AlertDialog mDialog;
    private boolean mBusy;
    private boolean mDestroyed;
    private boolean mAwaitingRestoreConfirmation;
    private int mPickerRequest;

    @Override
    public MonotonicObservableSupplier<String> getPageTitle() { return mTitle; }

    @Override
    public void onCreatePreferences(@Nullable Bundle state, @Nullable String key) {
        mTitle.set(getString(R.string.raws_color_rules_title));
        PreferenceScreen screen = getPreferenceManager().createPreferenceScreen(requireContext());
        setPreferenceScreen(screen);
        if (state != null) {
            int request = state.getInt(STATE_REQUEST);
            if (request == EXPORT || request == IMPORT) {
                mBusy = true;
                mPickerRequest = request;
            }
        }
        if (!available(getProfile())) {
            addRow(screen, R.string.raws_color_rules_unavailable, 0, null);
            return;
        }
        addRow(screen, R.string.raws_color_rules_local_title,
                R.string.raws_color_rules_local_summary, null);
        addRow(screen, R.string.raws_color_rules_view,
                R.string.raws_color_rules_view_summary, this::viewRules);
        addRow(screen, R.string.raws_color_rules_export,
                R.string.raws_color_rules_export_summary, () -> choose(EXPORT));
        addRow(screen, R.string.raws_color_rules_import,
                R.string.raws_color_rules_import_summary, () -> choose(IMPORT));
    }

    @Override
    public void onSaveInstanceState(Bundle state) {
        state.putInt(STATE_REQUEST, mPickerRequest);
        super.onSaveInstanceState(state);
    }

    @Override
    public void onViewCreated(View view, @Nullable Bundle state) {
        super.onViewCreated(view, state);
        MainSettings.styleRawSSettingsList(getListView());
    }

    @Override
    public void onDestroyView() {
        if (mAwaitingRestoreConfirmation) {
            mAwaitingRestoreConfirmation = false;
            mBusy = false;
        }
        if (mDialog != null) {
            mDialog.dismiss();
            mDialog = null;
        }
        super.onDestroyView();
    }

    @Override
    public void onDestroy() {
        mDestroyed = true;
        mFiles.shutdownNow();
        mUi.removeCallbacksAndMessages(null);
        super.onDestroy();
    }

    private void addRow(PreferenceScreen screen, @StringRes int title,
            @StringRes int summary, @Nullable Runnable action) {
        Preference row = new Preference(requireContext());
        row.setTitle(title);
        if (summary != 0) row.setSummary(summary);
        row.setSelectable(action != null);
        if (action != null) row.setOnPreferenceClickListener(preference -> {
            if (mBusy) toast(R.string.raws_color_rules_busy);
            else if (available(getProfile())) action.run();
            return true;
        });
        screen.addPreference(row);
    }

    private boolean available(Profile profile) {
        return !mDestroyed && isAdded() && LibraryLoader.getInstance().isInitialized()
                && profile.isNativeInitialized() && !profile.shutdownStarted()
                && !profile.isOffTheRecord();
    }

    private boolean stillViewing(Profile profile) {
        return available(profile) && getView() != null && getProfile() == profile;
    }

    private void toast(@StringRes int message) {
        if (!mDestroyed && isAdded()) {
            Toast.makeText(requireContext(), message, Toast.LENGTH_SHORT).show();
        }
    }

    @SuppressWarnings("deprecation")
    private void choose(int request) {
        boolean export = request == EXPORT;
        Intent intent = new Intent(export ? Intent.ACTION_CREATE_DOCUMENT : Intent.ACTION_OPEN_DOCUMENT)
                .addCategory(Intent.CATEGORY_OPENABLE)
                .putExtra(Intent.EXTRA_LOCAL_ONLY, true)
                .setType(export ? "application/json" : "*/*");
        if (export) intent.putExtra(Intent.EXTRA_TITLE, "Sandium-color-rules.json");
        mBusy = true;
        mPickerRequest = request;
        try {
            startActivityForResult(intent, request);
        } catch (ActivityNotFoundException | SecurityException fail) {
            mBusy = false;
            mPickerRequest = 0;
            toast(R.string.raws_color_rules_no_picker);
        }
    }

    @Override
    @SuppressWarnings("deprecation")
    public void onActivityResult(int request, int result, @Nullable Intent data) {
        super.onActivityResult(request, result, data);
        if ((request != EXPORT && request != IMPORT) || request != mPickerRequest) return;
        mPickerRequest = 0;
        mBusy = false;
        if (result != Activity.RESULT_OK || data == null || !isAdded()) return;
        Profile profile = getProfile();
        if (!available(profile)) return;
        @Nullable Uri uri = data.getData();
        if (uri == null || !ContentResolver.SCHEME_CONTENT.equals(uri.getScheme())) {
            toast(R.string.raws_color_rules_bad_file);
            return;
        }
        ContentResolver resolver = requireContext().getContentResolver();
        mBusy = true;
        if (request == EXPORT) {
            String archive = RawSColorRulesSettingsJni.get().export(profile);
            if (archive.isEmpty()) {
                mBusy = false;
                toast(R.string.raws_color_rules_export_failed);
                return;
            }
            mFiles.execute(() -> {
                boolean success = false;
                try {
                    writeArchive(resolver, uri, archive);
                    success = true;
                } catch (IOException | SecurityException ignored) {
                    // A document provider may have left a blank or partial file on failure.
                }
                boolean written = success;
                mUi.post(() -> {
                    mBusy = false;
                    if (stillViewing(profile)) {
                        toast(written ? R.string.raws_color_rules_export_done
                                : R.string.raws_color_rules_export_failed);
                    }
                });
            });
        } else {
            mFiles.execute(() -> {
                String archive = "";
                try (InputStream input = resolver.openInputStream(uri)) {
                    if (input != null) archive = readArchive(input);
                } catch (IOException | SecurityException ignored) {
                    archive = "";
                }
                String file = archive;
                mUi.post(() -> confirmRestore(profile, file));
            });
        }
    }

    static String readArchive(InputStream input) throws IOException {
        ByteArrayOutputStream buffered = new ByteArrayOutputStream();
        byte[] chunk = new byte[16384];
        int count;
        while ((count = input.read(chunk)) != -1) {
            if (Thread.currentThread().isInterrupted() || count <= 0
                    || count > MAX_BYTES - buffered.size()) {
                throw new IOException("Backup read interrupted or over limit");
            }
            buffered.write(chunk, 0, count);
        }
        return StandardCharsets.UTF_8.newDecoder()
                .onMalformedInput(CodingErrorAction.REPORT)
                .onUnmappableCharacter(CodingErrorAction.REPORT)
                .decode(ByteBuffer.wrap(buffered.toByteArray())).toString();
    }

    private static void writeArchive(ContentResolver resolver, Uri uri, String archive)
            throws IOException {
        byte[] bytes = archive.getBytes(StandardCharsets.UTF_8);
        if (bytes.length == 0 || bytes.length > MAX_BYTES
                || Thread.currentThread().isInterrupted()) throw new IOException("Bad archive");
        try (OutputStream out = resolver.openOutputStream(uri, "wt")) {
            if (out == null) throw new IOException("Document is not writable");
            out.write(bytes);
            out.flush();
        }
    }

    private void confirmRestore(Profile profile, String archive) {
        mBusy = false;
        if (!stillViewing(profile)) return;
        String dryRun = archive.isEmpty() ? ""
                : RawSColorRulesSettingsJni.get().planRestore(profile, archive);
        if (dryRun.isEmpty()) {
            toast(R.string.raws_color_rules_bad_file);
            return;
        }
        try {
            JSONObject plan = new JSONObject(dryRun);
            int added = plan.getInt("added");
            if (added == 0) {
                toast(R.string.raws_color_rules_nothing_to_merge);
                return;
            }
            String revision = plan.getString("revision");
            if (mDialog != null) mDialog.dismiss();
            mBusy = true;
            mAwaitingRestoreConfirmation = true;
            mDialog = new AlertDialog.Builder(requireContext())
                    .setTitle(R.string.raws_color_rules_import)
                    .setMessage(getString(R.string.raws_color_rules_import_confirm, added,
                            plan.getInt("conflicts"), plan.getInt("duplicates")))
                    .setNegativeButton(android.R.string.cancel, (dialog, which) -> cancelConfirmation())
                    .setPositiveButton(R.string.raws_color_rules_import_apply,
                            (dialog, which) -> {
                                mAwaitingRestoreConfirmation = false;
                                restore(profile, archive, revision);
                            })
                    .setOnCancelListener(dialog -> cancelConfirmation())
                    .show();
        } catch (JSONException badPlan) {
            toast(R.string.raws_color_rules_bad_file);
        }
    }

    private void cancelConfirmation() {
        mAwaitingRestoreConfirmation = false;
        mBusy = false;
    }

    private void restore(Profile profile, String archive, String revision) {
        if (!stillViewing(profile) || !RawSColorRulesSettingsJni.get().applyRestore(
                profile, archive, revision, success -> {
                    mBusy = false;
                    if (stillViewing(profile)) {
                        toast(success ? R.string.raws_color_rules_import_done
                                : R.string.raws_color_rules_import_stale);
                    }
                })) {
            mBusy = false;
            toast(R.string.raws_color_rules_import_stale);
        }
    }

    private void viewRules() {
        Profile profile = getProfile();
        String archive = RawSColorRulesSettingsJni.get().export(profile);
        if (archive.isEmpty()) {
            toast(R.string.raws_color_rules_view_failed);
            return;
        }
        final String[] labels = {getString(R.string.raws_color_rules_property_text),
                getString(R.string.raws_color_rules_property_background),
                getString(R.string.raws_color_rules_property_image)};
        final String structural = getString(R.string.raws_color_rules_structural_match);
        mBusy = true;
        mFiles.execute(() -> {
            String list = "";
            boolean parsed = false;
            try {
                list = describeRules(archive, labels, structural);
                parsed = true;
            } catch (JSONException ignored) {
                // Do not present partial/invalid rule listings.
            }
            String summary = list;
            boolean success = parsed;
            mUi.post(() -> {
                mBusy = false;
                if (!stillViewing(profile)) return;
                if (success) showList(summary);
                else toast(R.string.raws_color_rules_view_failed);
            });
        });
    }

    static String describeRules(String archive, String[] labels, String structural)
            throws JSONException {
        JSONObject sites = new JSONObject(archive).getJSONObject("rules");
        ArrayList<String> origins = new ArrayList<>();
        for (Iterator<String> keys = sites.keys(); keys.hasNext();) origins.add(keys.next());
        Collections.sort(origins);
        StringBuilder text = new StringBuilder();
        for (String origin : origins) {
            JSONArray rules = sites.getJSONArray(origin);
            if (rules.length() == 0) continue;
            text.append(origin).append('\n');
            for (int index = 0; index < rules.length(); index++) {
                JSONObject rule = rules.getJSONObject(index);
                String id = rule.getString("id");
                text.append("• ").append(rule.getString("tag"));
                if (id.isEmpty()) text.append(" (").append(structural).append(')');
                // Website-authored IDs are display text only; isolate their direction.
                else text.append(" #").append('\u2068').append(cleanDisplayId(id)).append('\u2069');
                text.append(" · ").append(labels[rule.getInt("property")]).append(" · ")
                    .append(String.format(Locale.ROOT, "#%06X", rule.getInt("rgb"))).append('\n');
            }
            text.append('\n');
        }
        return text.toString();
    }

    private static String cleanDisplayId(String id) {
        StringBuilder text = new StringBuilder(id.length());
        for (int offset = 0; offset < id.length();) {
            int value = id.codePointAt(offset);
            offset += Character.charCount(value);
            int kind = Character.getType(value);
            if (kind != Character.FORMAT && kind != Character.LINE_SEPARATOR
                    && kind != Character.PARAGRAPH_SEPARATOR && !Character.isISOControl(value)) {
                text.appendCodePoint(value);
            }
        }
        return text.toString();
    }

    private void showList(String text) {
        TextView body = new TextView(requireContext());
        body.setText(text.isEmpty() ? getString(R.string.raws_color_rules_empty) : text);
        body.setTextIsSelectable(true);
        int padding = Math.round(16 * getResources().getDisplayMetrics().density);
        body.setPadding(padding, padding, padding, padding);
        ScrollView content = new ScrollView(requireContext());
        content.addView(body);
        if (mDialog != null) mDialog.dismiss();
        mDialog = new AlertDialog.Builder(requireContext())
                .setTitle(R.string.raws_color_rules_view)
                .setView(content)
                .setPositiveButton(android.R.string.ok, null)
                .show();
    }

    @NativeMethods
    interface Natives {
        @JniType("std::string") String export(@JniType("Profile*") Profile profile);
        @JniType("std::string") String planRestore(@JniType("Profile*") Profile profile,
                @JniType("std::string") String archive);
        boolean applyRestore(@JniType("Profile*") Profile profile,
                @JniType("std::string") String archive, @JniType("std::string") String revision,
                @JniType("base::OnceCallback<void(bool)>") Callback<Boolean> completion);
    }
}
