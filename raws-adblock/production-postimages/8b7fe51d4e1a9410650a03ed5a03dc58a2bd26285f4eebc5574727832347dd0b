inline constexpr char kGlobalAdsEnabledPref[] = "sandium.global_ad_filtering_enabled";
inline constexpr char kSiteAdsDisabledPref[] = "sandium.site_ad_filtering_disabled";
inline constexpr char kRawSGoogleDeAmpPref[] = "sandium.google_de_amp_enabled";
inline constexpr char kSiteAdsControllerKey[] = "raws-site-ad-policy";

class SiteAdsController final : public base::SupportsUserData::Data {
 public:
  static SiteAdsController& For(Profile& profile) {
    auto* controller = static_cast<SiteAdsController*>(
        profile.GetUserData(kSiteAdsControllerKey));
    if (!controller) {
      auto item = std::make_unique<SiteAdsController>(profile);
      controller = item.get();
      profile.SetUserData(kSiteAdsControllerKey, std::move(item));
    }
    return *controller;
  }

  explicit SiteAdsController(Profile& profile);
  ~SiteAdsController() override;

  bool GlobalEnabled() const {
    if (!profile_->IsOffTheRecord())
      return profile_->GetPrefs()->GetBoolean(kGlobalAdsEnabledPref);
    if (private_global_enabled_)
      return *private_global_enabled_;
    // An incognito session starts with the user's standing choice. Its own
    // explicit choice never changes the original profile or a fresh session.
    auto* original = profile_->GetOriginalProfile();
    return !original || original->GetPrefs()->GetBoolean(kGlobalAdsEnabledPref);
  }

  bool InheritsGlobalFrom(Profile& original) const {
    return profile_->IsOffTheRecord() && !private_global_enabled_ &&
           profile_->GetOriginalProfile() == &original;
  }

  bool SetGlobalEnabled(bool enabled) {
    if (profile_->IsOffTheRecord()) {
      private_global_enabled_ = enabled;
      return true;
    }
    auto* prefs = profile_->GetPrefs();
    prefs->SetBoolean(kGlobalAdsEnabledPref, enabled);
    return prefs->GetBoolean(kGlobalAdsEnabledPref) == enabled;
  }

  bool IsEnabled(const url::Origin& origin) const {
    if (!GlobalEnabled()) return false;
    auto key = ElementRulesOriginKey(origin);
    if (!key) return true;  // Unscoped context cannot inherit an exception.
    return !Exceptions().FindBool(*key).value_or(false);
  }

  bool SetEnabled(const url::Origin& origin, bool enabled) {
    // A site exception cannot override the global master. Do not silently
    // store a site preference in response to a contradictory UI action.
    if (!GlobalEnabled()) return false;
    auto key = ElementRulesOriginKey(origin);
    if (!key) return false;
    if (IsEnabled(origin) == enabled) return true;
    if (!enabled && Exceptions().size() >= kMaxElementRuleOrigins) return false;
    const auto update = [&](base::DictValue& exceptions) {
      if (enabled)
        exceptions.Remove(*key);
      else
        exceptions.Set(*key, true);
    };
    if (profile_->IsOffTheRecord()) {
      update(private_exceptions_);
    } else {
      {
        ScopedDictPrefUpdate dict(profile_->GetPrefs(), kSiteAdsDisabledPref);
        update(dict.Get());
      }
      profile_->GetPrefs()->CommitPendingWrite();
    }
    return true;
  }

  base::RepeatingCallback<bool()> Gate(url::Origin top_origin) {
    // This callback is invoked only on the browser UI sequence. It does not
    // contain a raw Profile pointer, Mojo endpoint, or renderer-provided site.
    return base::BindRepeating(
        [](base::WeakPtr<SiteAdsController> controller,
           const url::Origin& origin) {
          return !controller || controller->IsEnabled(origin);
        },
        weak_.GetWeakPtr(), std::move(top_origin));
  }

 private:
  const base::DictValue& Exceptions() const {
    return profile_->IsOffTheRecord()
               ? private_exceptions_
               : profile_->GetPrefs()->GetDict(kSiteAdsDisabledPref);
  }

  const raw_ptr<Profile> profile_;
  std::optional<bool> private_global_enabled_;
  base::DictValue private_exceptions_;
  base::WeakPtrFactory<SiteAdsController> weak_{this};
};

inline bool IsSiteAdsEnabled(content::BrowserContext* context,
                             const url::Origin& top_origin) {
  auto* profile = context ? Profile::FromBrowserContext(context) : nullptr;
  return !profile || SiteAdsController::For(*profile).IsEnabled(top_origin);
}

inline bool IsFrameSiteAdsEnabled(content::RenderFrameHost& frame) {
  return IsSiteAdsEnabled(
      frame.GetBrowserContext(),
      frame.GetOutermostMainFrame()->GetLastCommittedOrigin());
}

inline bool IsContentsSiteAdsEnabled(content::WebContents& contents) {
  auto* top = contents.GetPrimaryMainFrame();
  return !top || IsFrameSiteAdsEnabled(*top);
}

inline void SetAutomaticElementStyles(content::RenderFrameHost& frame,
                                      const std::string& css) {
  auto token = frame.GetEmbeddingToken();
  if (frame.IsActive() && frame.IsRenderFrameLive() && token) {
    mojo::AssociatedRemote<chrome::mojom::ChromeRenderFrame> remote;
    frame.GetRemoteAssociatedInterfaces()->GetInterface(&remote);
    remote->ApplyRawSHideStyles(*token, css);
  }
}

inline void SetCustomCosmeticStyles(content::RenderFrameHost& frame,
                                    const std::string& css) {
  auto token = frame.GetEmbeddingToken();
  if (frame.IsActive() && frame.IsRenderFrameLive() && token) {
    mojo::AssociatedRemote<chrome::mojom::ChromeRenderFrame> remote;
    frame.GetRemoteAssociatedInterfaces()->GetInterface(&remote);
    remote->ApplyRawSMyFiltersStyles(*token, css);
  }
}

inline void RefreshCustomCosmeticStyles(content::RenderFrameHost& frame) {
  auto* profile = Profile::FromBrowserContext(frame.GetBrowserContext());
  if (!profile || profile->ShutdownStarted()) return;
  // For(*profile) is this exact regular or off-the-record profile instance;
  // never pass GetOriginalProfile() or share a worker with another context.
  ProfileUserNetworkRules::For(*profile).QueryStyles(
      frame.GetLastCommittedURL(),
      base::BindOnce(
          [](content::WeakDocumentPtr document, const GURL& url, std::string css) {
            auto* target = document.AsRenderFrameHostIfValid();
            if (!target || target->GetLastCommittedURL() != url ||
                !IsFrameSiteAdsEnabled(*target)) return;
            SetCustomCosmeticStyles(*target, css);
          },
          frame.GetWeakDocumentPtr(), frame.GetLastCommittedURL()));
}


// Only this ordinary publisher search host may ever have an active plan. On a
// same-document route change, send zero to remove its existing reversible paint.
inline void RefreshProceduralCosmetic(content::RenderFrameHost& frame) {
  const auto& url = frame.GetLastCommittedURL();
  if (!frame.IsInPrimaryMainFrame() || !frame.IsActive() ||
      !frame.IsRenderFrameLive() || frame.IsErrorDocument() ||
      !::raws::cosmetic::MayHaveProceduralCosmetic(url))
    return;
  auto* profile = Profile::FromBrowserContext(frame.GetBrowserContext());
  auto token = frame.GetEmbeddingToken();
  if (!profile || profile->IsOffTheRecord() || profile->ShutdownStarted() ||
      !token)
    return;
  const uint32_t rule = IsFrameSiteAdsEnabled(frame)
                            ? ::raws::cosmetic::RuleForDocument(url)
                            : 0;
  mojo::AssociatedRemote<chrome::mojom::ChromeRenderFrame> remote;
  frame.GetRemoteAssociatedInterfaces()->GetInterface(&remote);
  remote->SetRawSProceduralCosmetic(*token, rule);
}

inline void RefreshRawSPassiveProcedures(content::RenderFrameHost& frame) {
  auto* profile = Profile::FromBrowserContext(frame.GetBrowserContext());
  auto token = frame.GetEmbeddingToken();
  const auto url = frame.GetLastCommittedURL();
  if (!profile || profile->IsOffTheRecord() || profile->ShutdownStarted() ||
      !frame.IsInPrimaryMainFrame() || !frame.IsActive() ||
      !frame.IsRenderFrameLive() || frame.IsErrorDocument() || !token ||
      !url.SchemeIs("https") || url.has_username() || url.has_password() ||
      url.spec().size() > 2048 ||
      frame.GetLastCommittedOrigin() != url::Origin::Create(url)) return;
  if (!IsFrameSiteAdsEnabled(frame)) {
    mojo::AssociatedRemote<chrome::mojom::ChromeRenderFrame> remote;
    frame.GetRemoteAssociatedInterfaces()->GetInterface(&remote);
    remote->SetRawSPassiveProcedures(*token, url, "");
    return;
  }
  QueryRawSPassiveProcedures(
      url, base::BindOnce(
          [](content::WeakDocumentPtr doc, base::UnguessableToken token,
             GURL expected, std::string data) {
            auto* frame = doc.AsRenderFrameHostIfValid();
            if (!frame || !frame->IsActive() || !frame->IsRenderFrameLive() ||
                !frame->IsInPrimaryMainFrame() || frame->IsErrorDocument() ||
                frame->GetEmbeddingToken() != token ||
                frame->GetLastCommittedURL() != expected ||
                !IsFrameSiteAdsEnabled(*frame)) return;
            auto* profile = Profile::FromBrowserContext(frame->GetBrowserContext());
            if (!profile || profile->IsOffTheRecord() || profile->ShutdownStarted()) return;
            mojo::AssociatedRemote<chrome::mojom::ChromeRenderFrame> remote;
            frame->GetRemoteAssociatedInterfaces()->GetInterface(&remote);
            remote->SetRawSPassiveProcedures(token, expected, data);
          }, frame.GetWeakDocumentPtr(), *token, url));
}

inline void RefreshAutomaticElementStyles(
    content::RenderFrameHost& frame, bool query_automatic = true) {
  if (!frame.IsActive() || !frame.IsRenderFrameLive() ||
      frame.IsErrorDocument() ||
      !frame.GetLastCommittedURL().SchemeIsHTTPOrHTTPS()) return;
  RefreshProceduralCosmetic(frame);
  RefreshRawSPassiveProcedures(frame);
  if (!IsFrameSiteAdsEnabled(frame)) {
    // An explicit disable can stop future pruning in the active document.
    // Enabling is never installed by late IPC; reload starts another commit.
    if (frame.IsInPrimaryMainFrame() &&
        frame.GetLastCommittedOrigin().Serialize() == "https://m.youtube.com") {
      if (auto document = frame.GetEmbeddingToken()) {
        mojo::AssociatedRemote<chrome::mojom::ChromeRenderFrame> remote;
        frame.GetRemoteAssociatedInterfaces()->GetInterface(&remote);
        remote->StopRawSMobilePlayerFiltering(*document);
      }
    }
    SetAutomaticElementStyles(frame, {});
    SetCustomCosmeticStyles(frame, {});
    return;
  }
  RefreshCustomCosmeticStyles(frame);
  if (!query_automatic) return;
  QueryHideStyles(
      frame.GetLastCommittedURL(), frame.IsInPrimaryMainFrame(),
      base::BindOnce(
          [](content::WeakDocumentPtr document, GURL url, std::string css) {
            auto* target = document.AsRenderFrameHostIfValid();
            if (!target || target->GetLastCommittedURL() != url ||
                !IsFrameSiteAdsEnabled(*target)) return;
            // Empty success is a real result and removes an older keyed sheet.
            SetAutomaticElementStyles(*target, css);
          },
          frame.GetWeakDocumentPtr(), frame.GetLastCommittedURL()));
}

