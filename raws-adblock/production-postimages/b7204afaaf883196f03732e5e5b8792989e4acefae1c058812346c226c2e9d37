using sandium::adblock_native::RawSElementPicker;
using sandium::adblock_native::CanUseElementRules;

bool CanAcceptElementControls(content::WebContents* contents) {
  return content::BrowserThread::CurrentlyOn(content::BrowserThread::UI) &&
         contents && !contents->IsBeingDestroyed();
}

RawSElementPicker* GetPicker(content::WebContents* contents, bool create) {
  if (!CanAcceptElementControls(contents)) return nullptr;
  if (create) RawSElementPicker::CreateForWebContents(contents);
  return RawSElementPicker::FromWebContents(contents);
}

}  // namespace

static std::string JNI_RawsProtectionCopy_ElementDocumentToken(
    content::WebContents* contents) {
  if (!CanAcceptElementControls(contents) ||
      contents->GetVisibility() != content::Visibility::VISIBLE)
    return {};
  auto* frame = contents->GetPrimaryMainFrame();
  return CanUseElementRules(frame) ? frame->GetEmbeddingToken()->ToString()
                                   : std::string();
}

namespace {

jint PositiveBlockCount(
    std::initializer_list<std::optional<uint32_t>> counts) {
  uint64_t result = 0;
  for (const auto& count : counts) {
    result += count.value_or(0);
  }
  if (result == 0) return -1;
  return static_cast<jint>(
      std::min<uint64_t>(result, std::numeric_limits<jint>::max()));
}

}  // namespace

static jint JNI_RawsProtectionCopy_ReadTerminalBlockCount(
    content::WebContents* contents,
    const std::string& expected_document,
    jint bucket) {
  if (bucket < 0 || bucket > 2 || expected_document.empty() ||
      expected_document != JNI_RawsProtectionCopy_ElementDocumentToken(contents)) {
    return -1;
  }
  // The token method already checks Browser UI thread and live visible contents.
  auto* root = contents->GetPrimaryMainFrame();
  if (!root || !root->IsActive() || !root->IsInPrimaryMainFrame() ||
      &root->GetPage() != &contents->GetPrimaryPage()) {
    return -1;
  }
  if (bucket == 0) {
    return root->GetPage().ReadRawSMainDocumentBlockedNetworkRequests().value_or(-1);
  }
  const auto events = sandium::adblock_native::ReadActivePageEvents(
      *contents, root->GetWeakDocumentPtr());
  if (!events) return -1;
  if (bucket == 1) {
    return PositiveBlockCount(
        {events->popup_opens, events->popup_navigations, events->popup_redirects});
  }
  return PositiveBlockCount(
      {events->embedded_frame_navigations, events->embedded_frame_redirects});
}

static bool JNI_RawsProtectionCopy_BeginElementPicker(
    content::WebContents* contents,
    base::OnceCallback<void(std::string)> reply) {
