// Read or edit saved colors only from the local regular-profile settings UI.
namespace {
constexpr size_t kRawSColorBackupLimit = 8u * 1024 * 1024;

bool CanAccessColorBackups(Profile* profile) {
  return content::BrowserThread::CurrentlyOn(content::BrowserThread::UI) &&
         profile && !profile->IsOffTheRecord() && !profile->ShutdownStarted();
}

std::optional<std::string> UnwrapColorBackup(const std::string& archive) {
  if (archive.empty() || archive.size() > kRawSColorBackupLimit) {
    return std::nullopt;
  }
  auto root = base::JSONReader::ReadDict(archive, base::JSON_PARSE_RFC);
  if (!root || root->size() != 4 || root->FindInt("version") != 1) {
    return std::nullopt;
  }
  const auto* format = root->FindString("format");
  const auto* kind = root->FindString("kind");
  const auto* rules = root->FindDict("rules");
  if (!format || *format != "sandium-rules" || !kind ||
      *kind != "element-colors" || !rules) {
    return std::nullopt;
  }
  return base::WriteJson(*rules);
}
}  // namespace

static std::string JNI_RawSColorRulesSettings_Export(Profile* profile) {
  if (!CanAccessColorBackups(profile)) return {};
  auto& store = sandium::ElementColorRuleStore::ForProfile(*profile);
  auto rules = base::JSONReader::ReadDict(store.ExportRules(), base::JSON_PARSE_RFC);
  if (!rules) return {};
  base::DictValue archive;
  archive.Set("format", "sandium-rules");
  archive.Set("version", 1);
  archive.Set("kind", "element-colors");
  archive.Set("rules", std::move(*rules));
  auto encoded = base::WriteJson(archive);
  return encoded && encoded->size() <= kRawSColorBackupLimit ? *encoded : std::string();
}

static std::string JNI_RawSColorRulesSettings_PlanRestore(
    Profile* profile, const std::string& archive) {
  if (!CanAccessColorBackups(profile)) return {};
  auto rules = UnwrapColorBackup(archive);
  if (!rules) return {};
  auto& store = sandium::ElementColorRuleStore::ForProfile(*profile);
  auto plan = store.ImportRules(*rules, false);
  if (plan.FindBool("ok") != true) return {};
  plan.Set("revision", base::NumberToString(store.revision()));
  return base::WriteJson(plan).value_or(std::string());
}

static bool JNI_RawSColorRulesSettings_ApplyRestore(
    Profile* profile, const std::string& archive, const std::string& expected_revision,
    base::OnceCallback<void(bool)> completion) {
  if (!CanAccessColorBackups(profile) || !completion) return false;
  auto& store = sandium::ElementColorRuleStore::ForProfile(*profile);
  if (expected_revision != base::NumberToString(store.revision())) return false;
  auto rules = UnwrapColorBackup(archive);
  if (!rules || store.ImportRules(*rules, true).FindBool("ok") != true) return false;
  profile->GetPrefs()->CommitPendingWrite(base::BindOnce(std::move(completion), true));
  return true;
}

DEFINE_JNI(RawSColorRulesSettings)
