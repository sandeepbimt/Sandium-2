namespace {

void RefreshProfileAutomaticAdStyles(Profile& changed_profile) {
  using sandium::adblock_native::SiteAdsController;
  for (TabModel* model : TabModelList::models()) {
    for (int i = 0; i < model->GetTabCount(); ++i) {
      auto* contents = model->GetWebContentsAt(i);
      if (!contents || contents->IsBeingDestroyed()) continue;
      auto* candidate =
          Profile::FromBrowserContext(contents->GetBrowserContext());
      if (!candidate ||
          (candidate != &changed_profile &&
           !SiteAdsController::For(*candidate)
                .InheritsGlobalFrom(changed_profile))) {
        continue;
      }
      auto* root = contents->GetPrimaryMainFrame();
      if (!root) continue;
      root->ForEachRenderFrameHost([](content::RenderFrameHost* frame) {
        sandium::adblock_native::RefreshAutomaticElementStyles(*frame);
      });
    }
  }
}

}  // namespace

static bool JNI_RawsProtectionCopy_SetGlobalAdFilteringEnabled(
    Profile* profile, bool enabled, base::OnceCallback<void(bool)> completion) {
  if (!content::BrowserThread::CurrentlyOn(content::BrowserThread::UI) ||
      !profile || !completion)
    return false;
  auto& controller = sandium::adblock_native::SiteAdsController::For(*profile);
  const bool was_enabled = controller.GlobalEnabled();
  if (!controller.SetGlobalEnabled(enabled)) return false;
  if (was_enabled != enabled) RefreshProfileAutomaticAdStyles(*profile);

  if (profile->IsOffTheRecord()) {
    std::move(completion).Run(true);
  } else {
    // Match the existing native settings persistence contract; callers that
    // might relaunch immediately must wait for this posted write completion.
    profile->GetPrefs()->CommitPendingWrite(
        base::BindOnce(std::move(completion), true));
  }
  return true;
}

static jint JNI_RawsProtectionCopy_SiteAdFilteringState(
    content::WebContents* contents, const std::string& expected_document) {
  if (expected_document.empty() || expected_document !=
      JNI_RawsProtectionCopy_ElementDocumentToken(contents)) return -1;
  auto* frame = contents->GetPrimaryMainFrame();
  return sandium::adblock_native::IsFrameSiteAdsEnabled(*frame) ? 1 : 0;
}

static bool JNI_RawsProtectionCopy_SetSiteAdFilteringEnabled(
    content::WebContents* contents, const std::string& expected_document,
    bool enabled) {
  if (JNI_RawsProtectionCopy_SiteAdFilteringState(contents, expected_document) < 0)
    return false;
  auto* frame = contents->GetPrimaryMainFrame();
  auto* profile = Profile::FromBrowserContext(frame->GetBrowserContext());
  if (!profile ||
      !sandium::adblock_native::SiteAdsController::For(*profile).SetEnabled(
          frame->GetLastCommittedOrigin(), enabled)) return false;
  frame->ForEachRenderFrameHost([](content::RenderFrameHost* candidate) {
    sandium::adblock_native::RefreshAutomaticElementStyles(*candidate);
  });
  return true;
}

