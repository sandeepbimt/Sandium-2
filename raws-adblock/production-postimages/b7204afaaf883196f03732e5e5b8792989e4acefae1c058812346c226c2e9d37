static bool JNI_RawsProtectionCopy_IsGoogleDeAmpEnabled(Profile* profile) {
  return profile &&
         profile->GetPrefs()->GetBoolean(sandium::adblock_native::kRawSGoogleDeAmpPref);
}

static bool JNI_RawsProtectionCopy_SetGoogleDeAmpEnabled(Profile* profile, bool value) {
  if (!profile || profile->IsOffTheRecord()) return false;
  profile->GetPrefs()->SetBoolean(sandium::adblock_native::kRawSGoogleDeAmpPref, value);
  return profile->GetPrefs()->GetBoolean(sandium::adblock_native::kRawSGoogleDeAmpPref) == value;
}

static jint JNI_RawsProtectionCopy_GetAdFilteringPhase() {
  if (!content::BrowserThread::CurrentlyOn(content::BrowserThread::UI)) {
    return static_cast<jint>(
        sandium::adblock_native::OfflineRulesPhase::kUnknown);
  }
  return static_cast<jint>(sandium::adblock_native::GetOfflineRulesPhase());
}

static jint JNI_RawsProtectionCopy_GetAdSubscriptionState(Profile* profile) {
  if (!content::BrowserThread::CurrentlyOn(content::BrowserThread::UI))
    return 0;
  const auto* service = sandium::port1442::GetSubscriptions(profile);
  if (!service) return 0;
  const auto state = service->GetReadiness();
  static_assert(std::size(sandium::port1442::kCatalog) < 64);
  return static_cast<jint>(static_cast<unsigned>(state.phase) |
                           (state.enabled << 2) | (state.cached << 8) |
                           (state.active << 14));
}

static bool JNI_RawsProtectionCopy_RetryAdSubscriptions(Profile* profile) {
  if (!content::BrowserThread::CurrentlyOn(content::BrowserThread::UI))
    return false;
  auto* service = sandium::port1442::GetSubscriptions(profile);
  return service && service->RetryReadiness();
}

