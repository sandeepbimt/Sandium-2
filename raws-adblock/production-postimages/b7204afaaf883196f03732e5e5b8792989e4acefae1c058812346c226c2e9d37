DEFINE_JNI(ChromeBackupWatcher)
// One explicit local backup for My Filters plus regular-profile picker rules.
// Keep private stores, subscriptions, engine state, and color rules excluded.
namespace {
using sandium::adblock_native::CountSupportedCustomRules;
using sandium::adblock_native::kRawSElementRulesPref;
using sandium::adblock_native::MergeAdBackupElementRules;
using sandium::adblock_native::ProfileUserNetworkRules;
using sandium::adblock_native::ValidateAdBackupElementRules;
constexpr size_t kRawSAdArchiveLimit = 256u * 1024;

bool CanAccessAdBackups(Profile* profile) {
  return content::BrowserThread::CurrentlyOn(content::BrowserThread::UI) &&
         profile && !profile->IsOffTheRecord() && !profile->ShutdownStarted();
}

bool IsSupportedAdBackupText(std::string_view text) {
  return base::IsStringUTF8(text) &&
         CountSupportedCustomRules(text).has_value();
}

struct AdBackupRules {
  std::string my_filters;
  std::optional<base::DictValue> elements;
};

std::optional<AdBackupRules> DecodeAdRuleBackup(const std::string& archive) {
  if (archive.empty() || archive.size() > kRawSAdArchiveLimit ||
      !base::IsStringUTF8(archive)) return std::nullopt;
  auto root = base::JSONReader::ReadDict(archive, base::JSON_PARSE_RFC);
  if (!root) {
    // The donor My Filters preference is plaintext. Import only the subset
    // independently admitted by RawS's passive rules parser, not a browser
    // configuration package or unsupported scriptlets/procedural rules.
    const auto count = CountSupportedCustomRules(archive);
    if (!count || count->total() == 0)
      return std::nullopt;
    return AdBackupRules{archive, std::nullopt};
  }
  const auto version = root->FindInt("version");
  if ((version != 1 && version != 2) || root->size() != (version == 1 ? 4u : 5u))
    return std::nullopt;
  const auto* format = root->FindString("format");
  const auto* kind = root->FindString("kind");
  const auto* rules = root->FindString("rules");
  if (!format || *format != "sandium-rules" || !kind ||
      *kind != "custom-ad-rules" || !rules || !IsSupportedAdBackupText(*rules)) {
    return std::nullopt;
  }
  if (version == 1) return AdBackupRules{*rules, std::nullopt};
  const auto* elements = root->FindDict("elementRules");
  if (!elements || !ValidateAdBackupElementRules(*elements)) return std::nullopt;
  return AdBackupRules{*rules, elements->Clone()};
}

std::optional<std::string> EncodeAdRuleBackup(
    const std::string& rules, const base::DictValue* elements) {
  if (!IsSupportedAdBackupText(rules) ||
      (elements && !ValidateAdBackupElementRules(*elements))) return std::nullopt;
  base::DictValue root;
  root.Set("format", "sandium-rules");
  root.Set("version", elements ? 2 : 1);
  root.Set("kind", "custom-ad-rules");
  root.Set("rules", rules);
  if (elements) root.Set("elementRules", elements->Clone());
  auto result = base::WriteJson(root);
  if (!result || result->size() > kRawSAdArchiveLimit) return std::nullopt;
  return result;
}

std::optional<std::string> MergeAdRuleTexts(
    const std::string& current, const std::string& incoming) {
  if (!IsSupportedAdBackupText(current) || !IsSupportedAdBackupText(incoming)) {
    return std::nullopt;
  }
  if (incoming.empty() || current == incoming ||
      (current.size() > incoming.size() && current.ends_with(incoming) &&
       current[current.size() - incoming.size() - 1] == '\n')) {
    return current;
  }
  std::string merged = current;
  if (!merged.empty() && !merged.ends_with('\n')) merged += '\n';
  merged += incoming;
  if (!IsSupportedAdBackupText(merged)) return std::nullopt;
  return merged;
}

bool CanWriteAdBackupPrefs(Profile* profile, bool elements) {
  if (!CanAccessAdBackups(profile)) return false;
  const auto* prefs = profile->GetPrefs();
  const auto* rules =
      prefs->FindPreference(sandium::adblock_native::kScopedUserNetworkRulesPref);
  const auto* picked = prefs->FindPreference(kRawSElementRulesPref);
  return rules && rules->IsUserModifiable() &&
         (!elements || (picked && picked->IsUserModifiable()));
}

std::optional<std::string> AdBackupExpectedSnapshot(
    Profile& profile, const std::string& current, bool with_elements) {
  // Preserve v1's comparison contract. A v2 snapshot compares both stores.
  if (!with_elements) return current;
  return EncodeAdRuleBackup(current,
                            &profile.GetPrefs()->GetDict(kRawSElementRulesPref));
}
}  // namespace

static std::string JNI_RawSAdRuleBackupSettings_Export(Profile* profile) {
  if (!CanAccessAdBackups(profile)) return {};
  const auto& elements = profile->GetPrefs()->GetDict(kRawSElementRulesPref);
  return EncodeAdRuleBackup(
      ProfileUserNetworkRules::For(*profile).CurrentText(),
      elements.empty() ? nullptr : &elements).value_or(std::string());
}

static std::string JNI_RawSAdRuleBackupSettings_PlanRestore(
    Profile* profile, const std::string& archive) {
  if (!CanAccessAdBackups(profile)) return {};
  const auto incoming = DecodeAdRuleBackup(archive);
  if (!incoming || !CanWriteAdBackupPrefs(profile, incoming->elements.has_value()))
    return {};
  const auto current = ProfileUserNetworkRules::For(*profile).CurrentText();
  const auto merged = MergeAdRuleTexts(current, incoming->my_filters);
  if (!merged) return {};
  bool changed = *merged != current;
  if (incoming->elements) {
    const auto& existing = profile->GetPrefs()->GetDict(kRawSElementRulesPref);
    const auto combined = MergeAdBackupElementRules(existing, *incoming->elements);
    if (!combined || !EncodeAdRuleBackup(*merged, &*combined)) return {};
    changed |= *combined != existing;
  }
  auto expected =
      AdBackupExpectedSnapshot(*profile, current, incoming->elements.has_value());
  if (!expected) return {};
  base::DictValue response;
  response.Set("changed", changed);
  response.Set("importedBytes", static_cast<int>(
      incoming->elements ? archive.size() : incoming->my_filters.size()));
  response.Set("expected", std::move(*expected));
  return base::WriteJson(response).value_or(std::string());
}

static bool JNI_RawSAdRuleBackupSettings_ApplyRestore(
    Profile* profile, const std::string& archive, const std::string& expected,
    base::OnceCallback<void(bool)> completion) {
  if (!CanAccessAdBackups(profile) || !completion) return false;
  const auto incoming = DecodeAdRuleBackup(archive);
  if (!incoming || !CanWriteAdBackupPrefs(profile, incoming->elements.has_value()))
    return false;
  auto& owner = ProfileUserNetworkRules::For(*profile);
  auto current = owner.CurrentText();
  if (AdBackupExpectedSnapshot(*profile, current,
                               incoming->elements.has_value()) != expected)
    return false;
  auto merged = MergeAdRuleTexts(current, incoming->my_filters);
  if (!merged) return false;
  if (!incoming->elements)
    return *merged != current &&
           owner.Replace(std::move(*merged), std::move(completion));

  auto* prefs = profile->GetPrefs();
  const auto& existing = prefs->GetDict(kRawSElementRulesPref);
  auto elements = MergeAdBackupElementRules(existing, *incoming->elements);
  if (!elements || !EncodeAdRuleBackup(*merged, &*elements)) return false;
  if (*merged == current) {
    if (*elements == existing) return false;
    {
      ScopedDictPrefUpdate update(prefs, kRawSElementRulesPref);
      update.Get() = std::move(*elements);
    }
    prefs->CommitPendingWrite(base::BindOnce(std::move(completion), true));
    return true;
  }

  // This callback is owned by the native matcher inside this Profile's user
  // data; destruction invalidates the pending publish before the callback.
  // A fresh picker edit or My Filters change must not be overwritten while
  // the mixed import's candidate engine is being admitted on its worker.
  return owner.ReplaceWithAdRuleBackup(
      std::move(*merged), std::move(*elements),
      base::BindOnce(
          [](Profile* profile, std::string text, base::DictValue picked) {
            return CanWriteAdBackupPrefs(profile, /*elements=*/true) &&
                   ProfileUserNetworkRules::For(*profile).CurrentText() == text &&
                   profile->GetPrefs()->GetDict(kRawSElementRulesPref) == picked;
          },
          base::Unretained(profile), std::move(current), existing.Clone()),
      std::move(completion));
}

