#ifndef CHROME_BROWSER_RAWS_RAW_ELEMENT_RULES_H_
#define CHROME_BROWSER_RAWS_RAW_ELEMENT_RULES_H_

#include <algorithm>
#include <memory>
#include <optional>
#include <string>
#include <string_view>
#include <vector>

#include "base/supports_user_data.h"
#include "base/values.h"
#include "chrome/browser/profiles/profile.h"
#include "chrome/browser/raws/raw_element_rule_policy.h"
#include "components/prefs/pref_service.h"
#include "components/prefs/scoped_user_pref_update.h"
#include "content/public/browser/browser_thread.h"
#include "url/gurl.h"
#include "url/origin.h"

namespace sandium::adblock_native {

// Registered as a local, non-syncable dictionary on the Chromium profile.
inline constexpr char kRawSElementRulesPref[] = "sandium.element_rules";

inline std::optional<std::string> ElementRulesOriginKey(
    const url::Origin& committed_origin) {
  if (committed_origin.opaque() ||
      (committed_origin.scheme() != "https" &&
       committed_origin.scheme() != "http")) {
    return std::nullopt;
  }
  std::string key = committed_origin.Serialize();
  if (key.size() > kMaxElementRulesOriginBytes) return std::nullopt;
  return key;
}

namespace internal {
inline constexpr char kPrivateElementRules[] = "raws-private-element-rules";
struct PrivateElementRules final : base::SupportsUserData::Data {
  base::DictValue origins;
};

inline PrivateElementRules* GetPrivateElementRules(Profile& profile,
                                                   bool create) {
  auto* value = static_cast<PrivateElementRules*>(
      profile.GetUserData(kPrivateElementRules));
  if (!value && create) {
    auto item = std::make_unique<PrivateElementRules>();
    value = item.get();
    profile.SetUserData(kPrivateElementRules, std::move(item));
  }
  return value;
}

inline const base::DictValue* Origins(Profile& profile) {
  if (!profile.IsOffTheRecord())
    return &profile.GetPrefs()->GetDict(kRawSElementRulesPref);
  auto* private_rules = GetPrivateElementRules(profile, false);
  return private_rules ? &private_rules->origins : nullptr;
}

inline std::vector<std::string> ParseOriginRules(const base::DictValue& origins,
                                                const std::string& key) {
  std::vector<std::string> items;
  if (const auto* list = origins.FindList(key)) {
    size_t remaining = kMaxElementRulesPerOrigin;
    for (const auto& value : *list) {
      if (remaining-- == 0) break;
      const std::string* selector = value.GetIfString();
      if (selector && IsSafePickedSelector(*selector))
        items.push_back(*selector);
    }
  }
  return items;
}

inline void WriteOriginRules(Profile& profile, const std::string& key,
                             const std::vector<std::string>& selectors) {
  auto update = [&](base::DictValue& origins) {
    if (selectors.empty()) {
      origins.Remove(key);
      return;
    }
    base::ListValue values;
    for (const auto& selector : selectors)
      values.Append(selector);
    origins.Set(key, std::move(values));
  };
  if (profile.IsOffTheRecord()) {
    // Never read from or bridge writes into the original profile.
    if (auto* storage = GetPrivateElementRules(profile, !selectors.empty()))
      update(storage->origins);
    return;
  }
  {
    ScopedDictPrefUpdate dict(profile.GetPrefs(), kRawSElementRulesPref);
    update(dict.Get());
  }
  profile.GetPrefs()->CommitPendingWrite();
}
}  // namespace internal

// Archive origin keys must be exact canonical, non-opaque HTTP(S) origins;
// never import URLs with paths, credentials, queries, or default-port aliases.
inline bool IsAdBackupElementOrigin(std::string_view key) {
  if (key.empty() || key.size() > kMaxElementRulesOriginBytes) return false;
  return ElementRulesOriginKey(url::Origin::Create(GURL(key))) == key;
}

inline bool ValidateAdBackupElementRules(const base::DictValue& origins) {
  if (origins.size() > kMaxElementRuleOrigins) return false;
  for (const auto& [origin, value] : origins) {
    const auto* list = value.GetIfList();
    if (!IsAdBackupElementOrigin(origin) || !list || list->empty() ||
        list->size() > kMaxElementRulesPerOrigin) return false;
    std::vector<std::string> selectors;
    for (const auto& item : *list) {
      const auto* selector = item.GetIfString();
      if (!selector || !IsSafePickedSelector(*selector) ||
          std::ranges::find(selectors, *selector) != selectors.end()) return false;
      selectors.push_back(*selector);
    }
  }
  return true;
}

inline std::optional<base::DictValue> MergeAdBackupElementRules(
    const base::DictValue& current, const base::DictValue& incoming) {
  if (!ValidateAdBackupElementRules(current) ||
      !ValidateAdBackupElementRules(incoming)) return std::nullopt;
  auto merged = current.Clone();
  for (const auto& [origin, value] : incoming) {
    const auto* prev = merged.FindList(origin);
    auto next = prev ? prev->Clone() : base::ListValue();
    for (const auto& item : value.GetList()) {
      if (std::ranges::find(next, item) != next.end()) continue;
      if (next.size() == kMaxElementRulesPerOrigin) return std::nullopt;
      next.Append(item.GetString());
    }
    if (!prev && merged.size() == kMaxElementRuleOrigins) return std::nullopt;
    merged.Set(origin, std::move(next));
  }
  return merged;
}

// Only use the primary frame's committed, current origin. Never accept an
// origin string from Java, JavaScript, or the renderer response.
inline std::vector<std::string> ReadElementRules(Profile& profile,
                                                 const url::Origin& origin) {
  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
  auto key = ElementRulesOriginKey(origin);
  const auto* origins = internal::Origins(profile);
  if (!key || !origins) return {};
  return internal::ParseOriginRules(*origins, *key);
}

// Call only after the trusted, document-bound picker session has been
// explicitly confirmed in browser-owned UI.
inline bool AddElementRule(Profile& profile, const url::Origin& origin,
                           const std::string& selector) {
  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
  if (!IsSafePickedSelector(selector)) return false;
  auto key = ElementRulesOriginKey(origin);
  if (!key) return false;
  const auto* origins = internal::Origins(profile);
  std::vector<std::string> items;
  if (origins) {
    if (!origins->FindList(*key) && origins->size() >= kMaxElementRuleOrigins)
      return false;
    items = internal::ParseOriginRules(*origins, *key);
  }
  if (std::ranges::find(items, selector) != items.end()) return true;
  if (items.size() >= kMaxElementRulesPerOrigin) return false;
  items.push_back(selector);
  internal::WriteOriginRules(profile, *key, items);
  return true;
}

inline bool ClearElementRules(Profile& profile, const url::Origin& origin) {
  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
  auto key = ElementRulesOriginKey(origin);
  if (!key) return false;
  internal::WriteOriginRules(profile, *key, {});
  return true;
}
}  // namespace sandium::adblock_native
#endif  // CHROME_BROWSER_RAWS_RAW_ELEMENT_RULES_H_
