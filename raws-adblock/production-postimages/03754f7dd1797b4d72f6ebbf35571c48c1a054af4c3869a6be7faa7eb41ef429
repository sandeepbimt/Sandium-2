package org.chromium.chrome.browser.sandium.video;

import android.app.Activity;
import android.content.Context;
import android.media.AudioManager;
import android.os.SystemClock;
import android.provider.Settings;
import android.view.WindowManager;

import org.chromium.content_public.browser.MediaSession;
import org.chromium.content_public.browser.MediaSessionObserver;
import org.chromium.media_session.mojom.MediaSession.SuspendType;
import org.chromium.services.media_session.MediaPosition;
import org.chromium.media_session.mojom.MediaSessionAction;

import java.util.Set;

/** Native host bridge; retains Chromium decoding, URL handling, cookies, DRM and audio focus. */
public final class SandiumVideoSessionAdapter implements SandiumVideoGestureView.Host {
    public interface Owner {
        // Must verify current tab/WebContents, exactly one known active video, fullscreen,
        // focused/resumed activity, explicit opt-in, not PiP, and current session identity.
        boolean eligible(MediaSession session);
        long generation();
        void feedback(SandiumVideoGestureState.Kind kind, double delta);
        void clearFeedback();
        void playbackChanged();
        void controlsTapped();
    }
    private final Activity mActivity;
    private final Owner mOwner;
    private final MediaSession mSession;
    private final MediaSessionObserver mObserver;
    private final AudioManager mAudio;
    private final float mOriginalBrightness;
    private boolean mClosed;
    private boolean mControllable;
    private boolean mSuspended;
    private boolean mSupportsSeek;
    private boolean mBrightnessChanged;
    private MediaPosition mPosition;
    private float mBrightnessAtDown;
    private int mVolumeAtDown;

    public SandiumVideoSessionAdapter(Activity activity, MediaSession session, Owner owner) {
        mActivity = activity;
        mOwner = owner;
        mSession = session;
        mAudio = (AudioManager) activity.getSystemService(Context.AUDIO_SERVICE);
        mOriginalBrightness = activity.getWindow().getAttributes().screenBrightness;
        mControllable = session.isControllable();
        mObserver = new MediaSessionObserver(session) {
            @Override public void mediaSessionStateChanged(boolean controllable, boolean suspended) {
                mControllable = controllable;
                mSuspended = suspended;
                mOwner.playbackChanged();
            }
            @Override public void mediaSessionPositionChanged(MediaPosition position) {
                mPosition = position;
                mOwner.playbackChanged();
            }
            @Override public void mediaSessionActionsChanged(Set<Integer> actions) {
                mSupportsSeek = actions.contains(MediaSessionAction.SEEK_TO);
                mOwner.playbackChanged();
            }
            @Override public void mediaSessionDestroyed() { close(); }
        };
    }

    @Override public boolean isEligible() {
        return !mClosed && !mActivity.isFinishing() && !mActivity.isDestroyed()
                && !mActivity.isInPictureInPictureMode() && mControllable
                && mSession.isControllable() && mOwner.eligible(mSession);
    }
    @Override public long generation() { return mOwner.generation(); }
    @Override public void onTap() {
        if (isEligible()) mOwner.controlsTapped();
    }
    public boolean isPaused() { return mSuspended; }
    public long durationMillis() { return canSeek() ? mPosition.getDuration() : -1; }
    public long positionMillis() {
        if (!canSeek()) return -1;
        long duration = mPosition.getDuration();
        double elapsed = mSuspended ? 0 : Math.max(0,
                SystemClock.elapsedRealtime() - mPosition.getLastUpdatedTime())
                * mPosition.getPlaybackRate();
        return (long) SandiumVideoGestureState.clamp(
                mPosition.getPosition() + elapsed, 0, duration);
    }
    public void seekToPosition(long millis) {
        if (!canSeek()) return;
        mSession.seekTo((long) SandiumVideoGestureState.clamp(
                millis, 0, mPosition.getDuration()));
    }
    @Override public boolean canSeek() {
        // Reject unknown/live/sentinel durations. Position timestamps are extrapolation
        // anchors, not heartbeats; identity/lifetime invalidation belongs to the owner.
        if (!isEligible() || !mSupportsSeek || mPosition == null) return false;
        long duration = mPosition.getDuration();
        long age = SystemClock.elapsedRealtime() - mPosition.getLastUpdatedTime();
        return duration > 0 && duration < 7L * 24 * 60 * 60 * 1000
                && mPosition.getPosition() >= 0 && mPosition.getPosition() <= duration
                && age >= 0 && Float.isFinite(mPosition.getPlaybackRate());
    }
    @Override public void togglePlayback() {
        if (!isEligible()) return;
        if (mSuspended) mSession.resume(SuspendType.UI);
        else mSession.suspend(SuspendType.UI);
    }
    @Override public void seekBy(long millis) {
        if (!canSeek() || millis == 0) return;
        // The session retains final authority and its normal site-specific seek handling.
        long duration = mPosition.getDuration();
        double elapsed = mSuspended ? 0 : Math.max(0,
                SystemClock.elapsedRealtime() - mPosition.getLastUpdatedTime())
                * mPosition.getPlaybackRate();
        long target = (long) SandiumVideoGestureState.clamp(
                mPosition.getPosition() + elapsed + millis, 0, duration);
        mSession.seekTo(target);
    }
    @Override public void beginAdjustment() {
        if (!isEligible()) return;
        float brightness = mActivity.getWindow().getAttributes().screenBrightness;
        if (brightness < 0) {
            try {
                brightness = Settings.System.getInt(mActivity.getContentResolver(),
                        Settings.System.SCREEN_BRIGHTNESS, 128) / 255f;
            } catch (SecurityException ignored) {
                brightness = .5f; // Window-only fallback, never change global settings.
            }
        }
        mBrightnessAtDown = brightness;
        try {
            mVolumeAtDown = mAudio == null ? 0 : mAudio.getStreamVolume(AudioManager.STREAM_MUSIC);
        } catch (SecurityException ignored) {
            mVolumeAtDown = -1;
        }
    }
    @Override public void preview(SandiumVideoGestureState.Kind kind, double delta) {
        if (isEligible()) mOwner.feedback(kind, delta);
    }
    @Override public void adjustBrightness(double fraction) {
        if (!isEligible()) return;
        WindowManager.LayoutParams params = mActivity.getWindow().getAttributes();
        params.screenBrightness = (float) SandiumVideoGestureState.clamp(
                mBrightnessAtDown + fraction, .02, 1);
        mActivity.getWindow().setAttributes(params);
        mBrightnessChanged = true;
    }
    @Override public void adjustVolume(double fraction) {
        if (!isEligible() || mAudio == null || mVolumeAtDown < 0) return;
        try {
            if (mAudio.isVolumeFixed()) return;
            int max = mAudio.getStreamMaxVolume(AudioManager.STREAM_MUSIC);
            int min = mAudio.getStreamMinVolume(AudioManager.STREAM_MUSIC);
            int target = (int) Math.round(SandiumVideoGestureState.clamp(
                    mVolumeAtDown + fraction * (max - min), min, max));
            mAudio.setStreamVolume(AudioManager.STREAM_MUSIC, target, 0);
        } catch (SecurityException ignored) {
            // Managed-device/audio-policy restrictions keep system behavior; no bypass.
        }
    }
    @Override public void clearPreview() { mOwner.clearFeedback(); }

    /** Owner calls on opt-out, tab switch, navigation, fullscreen exit, pause, PiP or destruction. */
    public void close() {
        if (mClosed) return;
        mClosed = true;
        mObserver.stopObserving();
        mPosition = null;
        if (mBrightnessChanged && !mActivity.isDestroyed()) {
            WindowManager.LayoutParams params = mActivity.getWindow().getAttributes();
            params.screenBrightness = mOriginalBrightness;
            mActivity.getWindow().setAttributes(params);
        }
        mOwner.clearFeedback();
        // Volume is an explicit user change, not restored on exit. Playback is never restarted.
    }
}
