#ifndef CHROME_RENDERER_RAWS_COLOR_RENDERER_H_
#define CHROME_RENDERER_RAWS_COLOR_RENDERER_H_

#include <cmath>
#include <optional>
#include <vector>

#include "base/memory/raw_ptr.h"
#include "base/memory/weak_ptr.h"
#include "base/timer/timer.h"
#include "base/unguessable_token.h"
#include "chrome/renderer/raws_color_locator.h"
#include "content/public/renderer/render_frame.h"
#include "mojo/public/cpp/bindings/associated_receiver_set.h"
#include "third_party/blink/public/common/tokens/tokens.h"
#include "third_party/blink/public/web/web_frame_widget.h"
#include "third_party/blink/public/web/web_hit_test_result.h"
#include "third_party/blink/public/web/web_local_frame.h"
#include "ui/gfx/geometry/point_f.h"

namespace sandium::color_picker {

// Owned by the existing ChromeRenderFrameObserver, but has a distinct
// typed associated receiver; ad CSS transport cannot mutate this state.
class RawSColorRenderer final : public wire::RawSColorCorrector {
 public:
  explicit RawSColorRenderer(content::RenderFrame* frame);
  ~RawSColorRenderer() override;
  void ResetForNewDocument() {
    StopObservingTargets();
    EndSelection();
    document_.reset();
    bound_.clear();
    generation_ = 0;
  }
  base::WeakPtr<RawSColorRenderer> GetWeakPtr() { return weak_.GetWeakPtr(); }

  void Bind(mojo::PendingAssociatedReceiver<wire::RawSColorCorrector> receiver) {
    receivers_.Add(this, std::move(receiver));
  }

  void Select(const base::UnguessableToken& embedding,
              const base::UnguessableToken& request,
              const gfx::PointF& point,
              SelectCallback reply) override;

  void Preview(const base::UnguessableToken& embedding,
               const base::UnguessableToken& request,
               wire::RawSColorProperty property, uint32_t rgb,
               PreviewCallback reply) override;

  void ConfirmIdentity(const base::UnguessableToken& embedding,
                       const base::UnguessableToken& request,
                       wire::RawSColorProperty property, uint32_t rgb,
                       ConfirmIdentityCallback reply) override;

  void Commit(const base::UnguessableToken& embedding,
              const base::UnguessableToken& request,
              wire::RawSColorProperty property, uint32_t rgb,
              CommitCallback reply) override;

  void Cancel(const base::UnguessableToken& embedding,
              const base::UnguessableToken& request) override;

  void Restore(const base::UnguessableToken& embedding, uint64_t generation,
               std::vector<wire::RawSColorRulePtr> rules) override;

  void PauseRestore(const base::UnguessableToken& embedding,
                    uint64_t generation) override;
  void Clear(const base::UnguessableToken& embedding, uint64_t generation,
             ClearCallback reply) override;

 private:
  std::optional<blink::WebDocument> Current(const base::UnguessableToken& embedding) {
    auto* frame = frame_->GetWebFrame();
    if (!frame || !frame_->IsMainFrame() || frame->Parent() || frame->IsProvisional() ||
        frame->GetEmbeddingToken() != embedding) return std::nullopt;
    auto current = frame->GetDocument();
    if (current.IsNull() || !current.IsActive() || !current.IsHTMLDocument())
      return std::nullopt;
    if (!document_ || *document_ != current.Token()) {
      StopObservingTargets();
      EndSelection();
      bound_.clear();
      generation_ = 0;
      document_ = current.Token();
    }
    return current;
  }

  std::optional<blink::WebDocument> MatchingSelection(
      const base::UnguessableToken& embedding, const base::UnguessableToken& request) {
    auto current = Current(embedding);
    if (!current || request_ != request || !identity_ || selected_.IsNull() ||
        !selected_.IsConnected() || selected_.GetDocument() != *current) {
      return std::nullopt;
    }
    return current;
  }

  void EndSelection() {
    if (selected_document_) selected_document_->SandiumCancelElementColorPreview();
    selected_document_.reset();
    selected_ = blink::WebElement();
    identity_.reset();
    request_.reset();
    confirmed_.reset();
  }

  struct Bound {
    wire::RawSColorIdentityPtr identity;
    wire::RawSColorProperty property;
    int node_id;
    uint32_t rgb;
  };

  bool AlreadyBound(const wire::RawSColorIdentity& id,
                    wire::RawSColorProperty property, const blink::WebElement& node,
                    uint32_t rgb) const;
  void MarkBound(const wire::RawSColorIdentity& id,
                 wire::RawSColorProperty property, const blink::WebElement& node,
                 uint32_t rgb);
  void ApplyRestoreRules(blink::WebDocument& current);
  void ScheduleTargetRebind();
  void RebindTargets();
  void StopObservingTargets();

  raw_ptr<content::RenderFrame> frame_;
  std::optional<blink::DocumentToken> document_;
  std::optional<base::UnguessableToken> request_;
  std::optional<wire::RawSColorProperty> confirmed_;
  uint32_t confirmed_rgb_ = 0;
  std::optional<blink::WebDocument> selected_document_;
  blink::WebElement selected_;
  wire::RawSColorIdentityPtr identity_;
  std::vector<Bound> bound_;
  uint64_t generation_ = 0;
  std::optional<base::UnguessableToken> restore_embedding_;
  std::optional<blink::WebDocument> observed_document_;
  std::vector<wire::RawSColorRulePtr> restore_rules_;
  unsigned rebinds_remaining_ = 0;
  base::OneShotTimer rebind_timer_;
  base::OneShotTimer observation_deadline_;
  mojo::AssociatedReceiverSet<wire::RawSColorCorrector> receivers_;
  base::WeakPtrFactory<RawSColorRenderer> weak_{this};
};

}  // namespace sandium::color_picker
#endif  // CHROME_RENDERER_RAWS_COLOR_RENDERER_H_
