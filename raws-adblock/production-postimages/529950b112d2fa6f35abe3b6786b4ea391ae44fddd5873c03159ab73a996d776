package org.chromium.chrome.browser.ui.appmenu;

import java.util.ArrayList;
import java.util.Collections;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

/** Original RawS model: contains no Android window, animation, or Chromium action code.
 * Stable symbolic keys, never generated Android integer resource IDs, are persisted.
 * The native host supplies policy-filtered actions for each popup lifetime.
 */
public final class RawSMenuModel<T> {
    private static final String HEADER = "raws-menu-v1\n";
    private static final int MAX_ITEMS = 256;
    private final LinkedHashMap<String, Boolean> layout = new LinkedHashMap<>();
    private final LinkedHashMap<String, T> available = new LinkedHashMap<>();
    private long generation;
    private boolean writable = true;
    private String persistedSnapshot;

    public interface Store {
        String read();
        /** Return true only when the complete value is durably written. */
        boolean write(String value);
        /** Durable implementations must make this check and commit atomic across editors. */
        default boolean writeIfUnchanged(String expected, String value) {
            return read().equals(expected) && write(value);
        }
    }
    public interface Dispatcher<T> {
        /** Native owner rechecks live visibility/enabled policy before dispatching. */
        boolean canExecute(T action);
        /** Invoke the original Chromium handler, including dismissal and bundle extraction. */
        void execute(T action);
    }
    public static final class Entry<T> {
        public final String key;
        public final T action;
        private final long generation;
        private final boolean directory;
        private Entry(String key, T action, long generation) {
            this(key, action, generation, false);
        }
        private Entry(String key, T action, long generation, boolean directory) {
            this.key = key; this.action = action; this.generation = generation;
            this.directory = directory;
        }
    }

    public RawSMenuModel(String saved) {
        persistedSnapshot = saved == null ? "" : saved;
        if (saved == null || saved.isEmpty()) return;
        if (!saved.startsWith(HEADER) || saved.length() > 65536) {
            writable = false; return;
        }
        String[] rows = saved.substring(HEADER.length()).split("\n", -1);
        for (int i = 0; i < rows.length; i++) {
            String row = rows[i];
            if (i == rows.length - 1 && row.isEmpty()) continue;
            String[] fields = row.split("\t", -1);
            if (fields.length != 2 || !validKey(fields[0])
                    || !(fields[1].equals("0") || fields[1].equals("1"))
                    || layout.containsKey(fields[0]) || layout.size() >= MAX_ITEMS) {
                layout.clear(); writable = false; return;
            }
            layout.put(fields[0], fields[1].equals("1"));
        }
    }
    private static boolean validKey(String key) {
        return key != null && key.matches("[a-z][a-z0-9_]{0,127}");
    }

    /** Replace the ephemeral live catalog, never the remembered unavailable items.
     * Invoke on reopen, tab/profile/context changes and policy changes, before presenting.
     */
    public void bind(Map<String, T> catalog) {
        LinkedHashMap<String, T> next = new LinkedHashMap<>();
        if (catalog.size() > MAX_ITEMS) throw new IllegalArgumentException("Too many actions");
        for (Map.Entry<String, T> entry : catalog.entrySet()) {
            if (!validKey(entry.getKey()) || entry.getValue() == null)
                throw new IllegalArgumentException("Invalid native action");
            next.put(entry.getKey(), entry.getValue());
        }
        available.clear(); available.putAll(next); generation++;
        for (String key : next.keySet()) {
            if (!layout.containsKey(key)) {
                if (layout.size() >= MAX_ITEMS) { writable = false; continue; }
                layout.put(key, true);
            }
        }
    }
    /** Dismissal invalidates every previously issued action token. */
    public void close() { available.clear(); generation++; }

    public List<Entry<T>> page(int requestedPage, int capacity) {
        if (capacity < 1 || capacity > MAX_ITEMS) throw new IllegalArgumentException("capacity");
        List<Entry<T>> all = new ArrayList<>();
        if (!writable) {
            for (Map.Entry<String, T> item : available.entrySet())
                all.add(new Entry<>(item.getKey(), item.getValue(), generation));
        } else {
            for (Map.Entry<String, Boolean> item : layout.entrySet()) {
                T action = available.get(item.getKey());
                if (item.getValue() && action != null)
                    all.add(new Entry<>(item.getKey(), action, generation));
            }
        }
        int pages = Math.max(1, (all.size() + capacity - 1) / capacity);
        int start = Math.max(0, Math.min(requestedPage, pages - 1)) * capacity;
        return Collections.unmodifiableList(all.subList(start, Math.min(start + capacity, all.size())));
    }
    /** All Menu includes items hidden from quick pages, but only currently available actions.
     * Directory tokens are issued here, not constructed by callers. Native policy still applies.
     */
    public List<Entry<T>> directory() {
        List<Entry<T>> entries = new ArrayList<>();
        if (writable) {
            for (String key : layout.keySet()) {
                T action = available.get(key);
                if (action != null) entries.add(new Entry<>(key, action, generation, true));
            }
        } else {
            for (Map.Entry<String, T> entry : available.entrySet())
                entries.add(new Entry<>(entry.getKey(), entry.getValue(), generation, true));
        }
        return Collections.unmodifiableList(entries);
    }
    public boolean dispatch(Entry<T> entry, Dispatcher<T> dispatcher) {
        if (entry == null || entry.generation != generation
                || available.get(entry.key) != entry.action
                || (writable && !entry.directory && !Boolean.TRUE.equals(layout.get(entry.key)))
                || !dispatcher.canExecute(entry.action)) return false;
        // Invalidate before calling native code: reentrant/double callbacks cannot execute twice.
        close(); dispatcher.execute(entry.action); return true;
    }
    public Editor edit() { return new Editor(generation, new LinkedHashMap<>(layout)); }
    public List<String> orderedKeys() { return Collections.unmodifiableList(new ArrayList<>(layout.keySet())); }
    public boolean isVisible(String key) { return Boolean.TRUE.equals(layout.get(key)); }
    public boolean writable() { return writable; }
    public String serialize() { return serialize(layout); }
    private static String serialize(Map<String, Boolean> value) {
        StringBuilder out = new StringBuilder(HEADER);
        for (Map.Entry<String, Boolean> item : value.entrySet())
            out.append(item.getKey()).append('\t').append(item.getValue() ? '1' : '0').append('\n');
        return out.toString();
    }
    public final class Editor {
        private final long openedGeneration;
        private final LinkedHashMap<String, Boolean> draft;
        private boolean finished;
        private Editor(long openedGeneration, LinkedHashMap<String, Boolean> draft) {
            this.openedGeneration = openedGeneration; this.draft = draft;
        }
        public boolean setVisible(String key, boolean visible) {
            if (finished || !draft.containsKey(key)) return false;
            draft.put(key, visible); return true;
        }
        public boolean move(String key, int index) {
            if (finished || !draft.containsKey(key)) return false;
            List<String> keys = new ArrayList<>(draft.keySet());
            keys.remove(key); keys.add(Math.max(0, Math.min(index, keys.size())), key);
            LinkedHashMap<String, Boolean> reordered = new LinkedHashMap<>();
            for (String item : keys) reordered.put(item, draft.get(item));
            draft.clear(); draft.putAll(reordered); return true;
        }
        /** Reorder only the supplied live catalog slots; unavailable remembered keys stay put. */
        public boolean reorderAvailable(List<String> keys) {
            if (finished || keys.size() != new java.util.HashSet<>(keys).size()) return false;
            for (String key : keys) if (!draft.containsKey(key)) return false;
            java.util.HashSet<String> selected = new java.util.HashSet<>(keys);
            LinkedHashMap<String, Boolean> reordered = new LinkedHashMap<>();
            int next = 0;
            for (String existing : draft.keySet()) {
                String key = selected.contains(existing) ? keys.get(next++) : existing;
                reordered.put(key, draft.get(key));
            }
            draft.clear(); draft.putAll(reordered); return true;
        }
        public boolean resetToDefaults() {
            if (finished) return false;
            draft.clear();
            for (String key : available.keySet()) draft.put(key, true);
            return true;
        }
        public void cancel() { finished = true; }
        /** Call through a serial worker, then update UI on its owner thread.
         * Host must exclude concurrent bind/dispatch during this synchronous transaction.
         */
        public boolean save(Store store) {
            if (finished || !writable || openedGeneration != generation) return false;
            String next = serialize(draft);
            if (!store.writeIfUnchanged(persistedSnapshot, next)) return false;
            persistedSnapshot = next;
            layout.clear(); layout.putAll(draft); generation++; finished = true; return true;
        }
    }
}
