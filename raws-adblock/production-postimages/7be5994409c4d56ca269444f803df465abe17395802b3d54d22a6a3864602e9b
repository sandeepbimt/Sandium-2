#ifndef CONTENT_BROWSER_LOADER_RAWS_DOCUMENT_BLOCK_COUNT_H_
#define CONTENT_BROWSER_LOADER_RAWS_DOCUMENT_BLOCK_COUNT_H_

#include <cstdint>
#include <limits>
#include <optional>

#include "base/functional/bind.h"
#include "base/functional/callback.h"
#include "base/memory/weak_ptr.h"
#include "base/sequence_checker.h"
#include "third_party/blink/public/common/tokens/tokens.h"

namespace content {

// Browser UI-sequence-only. NavigationRequest initially owns this object for
// the prospective primary document; the exact committed Page may adopt the
// same object, not a newly allocated equivalent. A network factory gets a
// weak capability that survives its own clones but cannot own the Page.
class RawSDocumentBlockCount final {
 public:
  explicit RawSDocumentBlockCount(blink::DocumentToken intended_document)
      : token_(intended_document) {}
  RawSDocumentBlockCount(const RawSDocumentBlockCount&) = delete;
  RawSDocumentBlockCount& operator=(const RawSDocumentBlockCount&) = delete;
  ~RawSDocumentBlockCount() { DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_); }

  base::RepeatingClosure BindFinalBlock(blink::DocumentToken driver_document) {
    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_);
    if (driver_document != token_) {
      return {};
    }
    return base::BindRepeating(&RawSDocumentBlockCount::OnFinalBlock,
                               weak_.GetWeakPtr());
  }

  bool CommitForDocument(blink::DocumentToken installed_document) {
    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_);
    if (installed_document != token_ || committed_) {
      return false;
    }
    committed_ = true;
    return true;
  }

  std::optional<uint32_t> ReadForVisibleDocument(
      blink::DocumentToken actual_document) const {
    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_);
    if (!committed_ || actual_document != token_) {
      return std::nullopt;
    }
    return final_blocks_;
  }

 private:
  void OnFinalBlock() {
    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_);
    // JNI/Android can eventually use signed int without changing the range.
    if (final_blocks_ < static_cast<uint32_t>(std::numeric_limits<int32_t>::max())) {
      ++final_blocks_;
    }
  }

  const blink::DocumentToken token_;
  bool committed_ = false;
  uint32_t final_blocks_ = 0;
  SEQUENCE_CHECKER(sequence_);
  base::WeakPtrFactory<RawSDocumentBlockCount> weak_{this};
};

}  // namespace content
#endif  // CONTENT_BROWSER_LOADER_RAWS_DOCUMENT_BLOCK_COUNT_H_
