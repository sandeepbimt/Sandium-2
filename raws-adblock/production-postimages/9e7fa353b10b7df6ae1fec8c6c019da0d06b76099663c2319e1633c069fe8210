#include "components/sandium_adblock/subresource_decision.h"

#include <cstddef>

namespace sandium::adblock_native {
namespace {

bool IsEligibleType(blink::mojom::ResourceType resource) {
  using Resource = blink::mojom::ResourceType;
  switch (resource) {
    case Resource::kScript:
    case Resource::kStylesheet:
    case Resource::kImage:
    case Resource::kSubResource:
    case Resource::kFavicon:
    case Resource::kSubFrame:
    case Resource::kXhr:
    case Resource::kMedia:
    case Resource::kPing:
    case Resource::kFontResource:
      return true;
    default:
      return false;
  }
}

}  // namespace

SubresourceAction DecideDocumentSubresource(
    const adblock::Engine* default_engine,
    const adblock::Engine* additional_engine,
    const GURL& url,
    blink::mojom::ResourceType resource,
    const url::Origin& initiator,
    const std::string& method) {
  constexpr std::size_t kMaxUrlLength = 64 * 1024;
  if (!default_engine || !additional_engine || !url.is_valid() ||
      !url.SchemeIsHTTPOrHTTPS() || url.spec().size() > kMaxUrlLength ||
      initiator.opaque() ||
      (initiator.scheme() != "https" && initiator.scheme() != "http") ||
      (method != "GET" && method != "HEAD") || !IsEligibleType(resource)) {
    return SubresourceAction::kNotEvaluated;
  }
  const auto match = MatchStandard(*default_engine, *additional_engine, url,
                                   resource, initiator, method);
  if (match.redirect.has_value || match.rewritten_url.has_value) {
    return SubresourceAction::kUnsupportedAction;
  }
  const auto decision = ResolveDecision(match, {}, method, false);
  return decision.history.blocked() ? SubresourceAction::kBlock
                                    : SubresourceAction::kAllow;
}

}  // namespace sandium::adblock_native
