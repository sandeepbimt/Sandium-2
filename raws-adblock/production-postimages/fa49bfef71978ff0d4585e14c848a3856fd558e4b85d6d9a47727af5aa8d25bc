package org.chromium.chrome.browser.appearance.settings;

import android.app.AlertDialog;
import android.content.Context;
import android.graphics.Color;
import android.graphics.drawable.GradientDrawable;
import android.graphics.text.LineBreaker;
import android.widget.CheckBox;
import android.widget.LinearLayout;
import android.widget.ScrollView;
import android.widget.SeekBar;
import android.widget.TextView;
import android.widget.Toast;

import org.chromium.build.annotations.NullMarked;
import org.chromium.chrome.R;
import org.chromium.chrome.browser.profiles.Profile;

/** Native settings-only preview. The browser next-commit snapshot owns website styling. */
@NullMarked
final class RawSPageTextDialog {
    private RawSPageTextDialog() {}

    static boolean show(Context context, Profile profile) {
        if (!RawSPageText.canWrite(profile)) return false;
        int initial = RawSPageText.read(profile);
        float density = context.getResources().getDisplayMetrics().density;
        int pad = Math.round(20 * density);

        LinearLayout body = new LinearLayout(context);
        body.setOrientation(LinearLayout.VERTICAL);
        body.setPadding(pad, pad / 2, pad, 0);
        TextView size = new TextView(context);
        size.setTextSize(16);
        body.addView(size);

        SeekBar scale = new SeekBar(context);
        scale.setMax((RawSPageText.MAX - RawSPageText.MIN) / RawSPageText.STEP);
        scale.setProgress((RawSPageText.scale(initial) - RawSPageText.MIN) / RawSPageText.STEP);
        scale.setContentDescription(context.getString(R.string.raws_page_text_scale_label));
        body.addView(scale);

        CheckBox justify = new CheckBox(context);
        justify.setText(R.string.raws_page_text_justify);
        justify.setChecked(RawSPageText.justify(initial));
        body.addView(justify);

        TextView sample = new TextView(context);
        sample.setPadding(pad, pad, pad, pad);
        sample.setTextColor(Color.rgb(232, 234, 237));
        sample.setText(R.string.raws_page_text_sample);
        sample.setLineSpacing(0f, 1.30f);
        GradientDrawable sampleBg = new GradientDrawable();
        sampleBg.setColor(Color.rgb(24, 26, 29));
        sampleBg.setCornerRadius(12 * density);
        sample.setBackground(sampleBg);
        LinearLayout.LayoutParams params = new LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT);
        params.topMargin = pad / 2;
        body.addView(sample, params);

        if (profile.isOffTheRecord()) {
            TextView privateNote = new TextView(context);
            privateNote.setText(R.string.raws_page_text_private);
            privateNote.setTextSize(13);
            body.addView(privateNote);
        }
        Runnable preview = () -> {
            int percent = RawSPageText.MIN + RawSPageText.STEP * scale.getProgress();
            size.setText(percent == RawSPageText.DEFAULT
                    ? context.getString(R.string.raws_page_text_size_default)
                    : context.getString(R.string.raws_page_text_size_value, percent));
            sample.setTextSize(16f * percent / RawSPageText.DEFAULT);
            sample.setJustificationMode(justify.isChecked()
                    ? LineBreaker.JUSTIFICATION_MODE_INTER_WORD
                    : LineBreaker.JUSTIFICATION_MODE_NONE);
        };
        scale.setOnSeekBarChangeListener(new SeekBar.OnSeekBarChangeListener() {
            @Override public void onStartTrackingTouch(SeekBar slider) {}
            @Override public void onStopTrackingTouch(SeekBar slider) {}
            @Override public void onProgressChanged(SeekBar slider, int step, boolean fromUser) {
                preview.run();
            }
        });
        justify.setOnCheckedChangeListener((view, checked) -> preview.run());
        preview.run();

        ScrollView scroll = new ScrollView(context);
        scroll.addView(body);
        AlertDialog dialog = new AlertDialog.Builder(context)
                .setTitle(R.string.raws_page_text_title)
                .setNegativeButton(android.R.string.cancel, null)
                .setPositiveButton(R.string.raws_page_text_save, null)
                .create();
        dialog.setView(scroll, 0, 0, 0, 0);
        dialog.setOnShowListener(ignored -> dialog.getButton(AlertDialog.BUTTON_POSITIVE)
                .setOnClickListener(view -> {
                    int percent = RawSPageText.MIN + RawSPageText.STEP * scale.getProgress();
                    if (!RawSPageText.save(profile, percent, justify.isChecked())) {
                        Toast.makeText(context, R.string.raws_page_text_save_error,
                                       Toast.LENGTH_SHORT).show();
                        return;
                    }
                    dialog.dismiss();
                    Toast.makeText(context, R.string.raws_page_text_next_load,
                                   Toast.LENGTH_SHORT).show();
                }));
        dialog.show();
        return true;
    }
}
