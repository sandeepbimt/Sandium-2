<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <org.chromium.components.browser_ui.settings.ChromeBasePreference
        android:key="raws_global_protection_status"
        android:title="@string/raws_ui_protection"
        android:summary="@string/raws_ui_unknown"
        android:selectable="false" />
    <org.chromium.components.browser_ui.settings.ChromeSwitchPreference
        android:key="raws_global_ad_filtering"
        android:title="@string/raws_global_ads_title"
        android:summary="@string/raws_global_ads_scope"
        android:enabled="false"
        android:persistent="false" />
    <org.chromium.components.browser_ui.settings.ChromeBasePreference
        android:key="raws_refresh_filters"
        android:title="@string/raws_ui_refresh_filters"
        android:summary="@string/raws_ui_refresh_filters_description"
        android:persistent="false" />
    <org.chromium.components.browser_ui.settings.ChromeBasePreference
        android:key="raws_filter_list_details"
        android:title="@string/raws_list_details_title"
        android:summary="@string/raws_list_details_summary"
        android:persistent="false" />
    <org.chromium.components.browser_ui.settings.ChromeBasePreference
        android:key="raws_my_filters"
        android:title="@string/raws_my_filters_title"
        android:summary="@string/raws_my_filters_summary"
        android:persistent="false" />
    <org.chromium.components.browser_ui.settings.ChromeBasePreference
        android:key="raws_custom_ad_rule_backups"
        android:title="@string/raws_ad_backup_title"
        android:summary="@string/raws_ad_backup_summary"
        android:persistent="false"
        android:fragment="org.chromium.chrome.browser.settings.RawSAdRuleBackupSettings" />
    <org.chromium.components.browser_ui.settings.ChromeBasePreference
        android:key="raws_protection_secure_dns"
        android:title="@string/settings_secure_dns_title"
        android:summary="@string/raws_shields_dns_global"
        android:fragment="org.chromium.chrome.browser.privacy.secure_dns.SecureDnsSettings" />
    <org.chromium.components.browser_ui.settings.ChromeBasePreference
        android:key="raws_protection_privacy"
        android:title="@string/prefs_privacy_security"
        android:fragment="org.chromium.chrome.browser.privacy.settings.PrivacySettings" />
</PreferenceScreen>
