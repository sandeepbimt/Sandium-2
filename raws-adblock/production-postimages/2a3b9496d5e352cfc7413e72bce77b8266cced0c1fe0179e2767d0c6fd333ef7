<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/raws_frozen_shields_rim">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingStart="8dp" android:paddingEnd="8dp" android:text="@string/raws_ui_protection" android:textSize="20sp" android:textColor="@color/raws_shields_text" android:fontFamily="sans-serif-medium" android:accessibilityHeading="true" />
            <ImageView android:id="@+id/raws_frozen_shields_header_mark" android:layout_width="36dp" android:layout_height="40dp" android:layout_marginEnd="8dp" android:src="@drawable/raws_frozen_shields_mark" android:scaleType="fitCenter" android:importantForAccessibility="no" android:clickable="false" android:focusable="false" />
        </LinearLayout>
        <LinearLayout android:id="@+id/raws_group_ads" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:background="@drawable/raws_frozen_shields_card" android:clipToOutline="true">
            <com.google.android.material.materialswitch.MaterialSwitch style="@style/Widget.Sandium.ShieldsSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/raws_shields_ads" android:textSize="16sp" android:textColor="@color/raws_shields_text" android:enabled="false" android:alpha="0.55" android:minHeight="48dp" android:paddingHorizontal="16dp" android:paddingVertical="4dp" android:gravity="center_vertical" android:id="@+id/raws_shields_ads" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:background="@color/raws_shields_divider" android:importantForAccessibility="no" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/raws_shields_block_element" android:textSize="16sp" android:textColor="@color/raws_shields_disabled" android:enabled="false" android:clickable="false" android:focusable="false" android:minHeight="48dp" android:paddingHorizontal="16dp" android:paddingVertical="4dp" android:gravity="center_vertical" android:id="@+id/raws_shields_block_element" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:background="@color/raws_shields_divider" android:importantForAccessibility="no" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/raws_shields_clear_elements" android:textSize="16sp" android:textColor="@color/raws_shields_disabled" android:enabled="false" android:clickable="false" android:focusable="false" android:minHeight="48dp" android:paddingHorizontal="16dp" android:paddingVertical="4dp" android:gravity="center_vertical" android:id="@+id/raws_shields_clear_elements" />
        </LinearLayout>
        <LinearLayout android:id="@+id/raws_group_dark" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:background="@drawable/raws_frozen_shields_card" android:clipToOutline="true">
            <com.google.android.material.materialswitch.MaterialSwitch style="@style/Widget.Sandium.ShieldsSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/raws_shields_dark_pages" android:textSize="16sp" android:textColor="@color/raws_shields_text" android:enabled="false" android:alpha="0.55" android:minHeight="48dp" android:paddingHorizontal="16dp" android:paddingVertical="4dp" android:gravity="center_vertical" android:id="@+id/raws_shields_dark_pages" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:background="@color/raws_shields_divider" android:importantForAccessibility="no" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/raws_shields_correct_colors" android:textSize="16sp" android:textColor="@color/raws_shields_disabled" android:enabled="false" android:clickable="false" android:focusable="false" android:minHeight="48dp" android:paddingHorizontal="16dp" android:paddingVertical="4dp" android:gravity="center_vertical" android:id="@+id/raws_shields_correct_colors" />
        </LinearLayout>
        <LinearLayout android:id="@+id/raws_group_cookies" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:background="@drawable/raws_frozen_shields_card" android:clipToOutline="true">
            <com.google.android.material.materialswitch.MaterialSwitch style="@style/Widget.Sandium.ShieldsSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/raws_shields_third_party_cookies" android:textSize="16sp" android:textColor="@color/raws_shields_text" android:enabled="false" android:alpha="0.55" android:minHeight="48dp" android:paddingHorizontal="16dp" android:paddingVertical="4dp" android:gravity="center_vertical" android:id="@+id/raws_shields_block_cookies" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:background="@color/raws_shields_divider" android:importantForAccessibility="no" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/raws_shields_shred" android:textSize="16sp" android:textColor="@color/raws_shields_disabled" android:enabled="false" android:clickable="false" android:focusable="false" android:minHeight="48dp" android:paddingHorizontal="16dp" android:paddingVertical="4dp" android:gravity="center_vertical" android:id="@+id/raws_shields_shred" />
        </LinearLayout>
        <LinearLayout android:id="@+id/raws_group_dns" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:background="@drawable/raws_frozen_shields_card" android:clipToOutline="true">
            <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="12dp" android:paddingVertical="8dp">
                <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_secure_dns_title" android:textColor="@color/raws_shields_text" android:textSize="16sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/raws_shields_dns_global" android:textColor="@color/raws_shields_secondary" android:textSize="12sp" />
                </LinearLayout>
                <Button style="?android:attr/borderlessButtonStyle" android:id="@+id/raws_global_shield_dns_picker" android:layout_width="112dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:background="@drawable/raws_frozen_shields_dns_picker" android:gravity="center" android:textColor="@color/raws_shields_text" android:textSize="14sp" android:paddingHorizontal="10dp" android:maxLines="1" android:ellipsize="end" android:textAllCaps="false" android:minWidth="0dp" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/raws_global_shield_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:gravity="center" android:text="@string/raws_ui_unknown" android:textSize="12sp" android:textColor="@color/raws_shields_secondary" />
        <LinearLayout android:id="@+id/raws_shields_native_count_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingTop="6dp" android:visibility="gone">
            <TextView android:id="@+id/raws_shields_network_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/raws_shields_secondary" android:visibility="gone" />
            <TextView android:id="@+id/raws_shields_popup_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/raws_shields_secondary" android:visibility="gone" />
            <TextView android:id="@+id/raws_shields_embedded_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/raws_shields_secondary" android:visibility="gone" />
        </LinearLayout>
        <com.google.android.material.materialswitch.MaterialSwitch style="@style/Widget.Sandium.ShieldsSwitch" android:id="@+id/raws_shields_private_ads" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/raws_private_ads_title" android:textColor="@color/raws_shields_text" android:visibility="gone" android:enabled="false" android:minHeight="48dp" android:paddingHorizontal="16dp" />
        <Button android:id="@+id/raws_global_shield_settings" style="?android:attr/borderlessButtonStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:textAllCaps="false" android:gravity="start|center_vertical" android:text="@string/raws_global_shield_settings" />
    </LinearLayout>
</ScrollView>
